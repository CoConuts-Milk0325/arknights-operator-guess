{"中文":{"登录":[{"url":"bwiki:5/54/gtk6e1x1gc2udg8bpp90mztloyg4rpg.mp3","text":"博士，只要告诉我今天的工作内容就行了。","alt":"voice_cn/char_502_nblade/cn_001.mp3"}],"交谈":[{"url":"bwiki:1/1f/g272rj9yuu0oceqcuq4zux6cw4oiq78.mp3","text":"即使在工作之外的时间里，我也会注意您的状况。","alt":"voice_cn/char_502_nblade/cn_002.mp3"},{"url":"bwiki:b/b9/tlkakey8az5507rtzw18ilx041rsnga.mp3","text":"嗯？有什么事吗？","alt":"voice_cn/char_502_nblade/cn_003.mp3"},{"url":"bwiki:1/1b/5p9eao2ratcfb84a96tyqasmtkomg0o.mp3","text":"我的皮肤对阳光的抵抗力非常弱，所以我希望您尽可能地把夜间行动的任务安排给我。","alt":"voice_cn/char_502_nblade/cn_004.mp3"}],"信赖":[{"url":"bwiki:6/68/md23cfu3zw7vxych25n45er6rp2jtiy.mp3","text":"虽然我们能做到的事有限，但我还是希望能帮忙减轻您的负担。","alt":"voice_cn/char_502_nblade/cn_007.mp3"},{"url":"bwiki:6/69/n7uq33zyawbvxe0m5n3rnwpypgn1j16.mp3","text":"每当我看到其他小队的干员们的活跃表现，总是会特别羡慕......","alt":"voice_cn/char_502_nblade/cn_008.mp3"},{"url":"bwiki:5/5c/7uqv2316r8zlvxa07b36uvdm4no0b3h.mp3","text":"我想为博士出战的心情，是不需要理由的。希望总有一天，我们也能活跃在日常战斗的最前线......","alt":"voice_cn/char_502_nblade/cn_009.mp3"}],"闲置":[{"url":"bwiki:8/8a/l2zmjc4rehfj9ehbt6jpwqet88tq7i0.mp3","text":"博士，让我今后也一直守护着您吧。","alt":"voice_cn/char_502_nblade/cn_010.mp3"}],"报到":[{"url":"bwiki:8/8b/e21yi8kldowi9hvjvc1unl8cay7achp.mp3","text":"先锋干员夜刀，你——就是我要保护的人吗？","alt":"voice_cn/char_502_nblade/cn_011.mp3"}],"作战记录":[{"url":"bwiki:b/bd/axdu8h9phc8377j7jw0v66si31vbti1.mp3","text":"非常感谢。","alt":"voice_cn/char_502_nblade/cn_012.mp3"}],"编入":[{"url":"bwiki:5/57/76jw5h6p3k8et8fhhe05v93p1da5y2n.mp3","text":"夜刀，入队。","alt":"voice_cn/char_502_nblade/cn_017.mp3"}],"任命队长":[{"url":"bwiki:a/a1/k0964bsmc8py499g9ok1ud1u4jughix.mp3","text":"各位都会配合您的战术的，博士。","alt":"voice_cn/char_502_nblade/cn_018.mp3"}],"行动出发":[{"url":"bwiki:f/f1/l13n21lefpp7xau6zxy44j88fmc8f7s.mp3","text":"全队，从现在起进入警戒模式。","alt":"voice_cn/char_502_nblade/cn_019.mp3"}],"行动开始":[{"url":"bwiki:a/a1/hvh5cjjzdviqy11h68ie18q9xmbsson.mp3","text":"目标出现了，做好战斗准备。","alt":"voice_cn/char_502_nblade/cn_020.mp3"}],"选中":[{"url":"bwiki:7/73/cal4yfu1tnvx3f7bx94rm0vgk377tkq.mp3","text":"是。","alt":"voice_cn/char_502_nblade/cn_021.mp3"},{"url":"bwiki:3/33/3h4zilm3hcieov7mgt5f69cw4g360zu.mp3","text":"请说。","alt":"voice_cn/char_502_nblade/cn_022.mp3"}],"部署":[{"url":"bwiki:3/34/pvw6aty8m66tbcv276267lv18t57yme.mp3","text":"我知道了。","alt":"voice_cn/char_502_nblade/cn_023.mp3"},{"url":"bwiki:b/bd/hgs6va00yrjg9pfv7ulkj1o8ue41lj6.mp3","text":"我明白。","alt":"voice_cn/char_502_nblade/cn_024.mp3"}],"技能":[{"url":"bwiki:a/a0/od86usqh8rf8bjmmxagx3dt2oi7i8e4.mp3","text":"一闪！","alt":"voice_cn/char_502_nblade/cn_025.mp3"},{"url":"bwiki:4/44/nfag3g6jpq29k8ailseehbw8mgib6x1.mp3","text":"觉悟吧！","alt":"voice_cn/char_502_nblade/cn_026.mp3"},{"url":"bwiki:3/3d/6os17qrjveujn26hwgidxoa9s6ud8hp.mp3","text":"哈......","alt":"voice_cn/char_502_nblade/cn_027.mp3"},{"url":"bwiki:0/04/ibn5ta018rms6ys53kjee2jb2wocl3j.mp3","text":"斩！","alt":"voice_cn/char_502_nblade/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:c/c9/b4evs1vhcdl5loyi311m532jv2w169v.mp3","text":"只要我们将博士的战术坚持到底，就绝不会发生任何问题。","alt":"voice_cn/char_502_nblade/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:9/95/n88r9ssg8u7y1w59nwtzoztzzdf3got.mp3","text":"博士完美的指挥，是开启这场胜利的钥匙。","alt":"voice_cn/char_502_nblade/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:a/ae/hh40upzzn6tbnoh8j647jgv7abmvdrs.mp3","text":"胜利就是最好的消息。","alt":"voice_cn/char_502_nblade/cn_031.mp3"}],"失败":[{"url":"bwiki:1/12/iiyt5csqg5v3a80wnseungkjxq5c60f.mp3","text":"对不起，是我没有执行好您的战术......","alt":"voice_cn/char_502_nblade/cn_032.mp3"}],"进驻":[{"url":"bwiki:d/d1/rl0v7zh4ut9bucvuvzxcbegctyu1nvm.mp3","text":"请让我去一个照射不到阳光的地方。","alt":"voice_cn/char_502_nblade/cn_033.mp3"}],"戳一下":[{"url":"bwiki:7/7f/tb1ltxz5z8azsoal3e39yrq55evvylz.mp3","text":"唔。","alt":"voice_cn/char_502_nblade/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:c/c2/qt7cfcacqqvjrmxq5gru4olz0lobvxy.mp3","text":"博士，谢谢您一直守护着我们。","alt":"voice_cn/char_502_nblade/cn_036.mp3"}],"标题":[{"url":"bwiki:b/b9/88jkl3y2fu7gry01u043rx55ghsttmi.mp3","text":"明日方舟。","alt":"voice_cn/char_502_nblade/cn_037.mp3"}],"新年":[{"url":"bwiki:d/d4/gasdjee0t2y8r4fe4gne2sp7pxo8w6z.mp3","text":"博士，节日快乐。一年来的工作辛苦了，新的一年也请继续带领我们。","alt":"voice_cn/char_502_nblade/cn_038.mp3"}],"问候":[{"url":"bwiki:b/bd/5je1jy23636ma42dgcpvnjj0up7oj7a.mp3","text":"博士，由我来保护。","alt":"voice_cn/char_502_nblade/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:6/66/qjp3y186npoppy4meiba6yoonb9n7o0.mp3","text":"博士，只要告诉我今天的工作内容就行了。","alt":"voice/char_502_nblade/cn_001.mp3"}],"交谈":[{"url":"bwiki:e/e0/3pusm4pef8rvfhngkj3kkd0bwl4dthl.mp3","text":"即使在工作之外的时间里，我也会注意您的状况。","alt":"voice/char_502_nblade/cn_002.mp3"},{"url":"bwiki:1/12/osu6yl0i792eea0kxnkacdw0uds65y4.mp3","text":"嗯？有什么事吗？","alt":"voice/char_502_nblade/cn_003.mp3"},{"url":"bwiki:2/2d/ngqdsl9zltv6p835lz8c1hszwrgc2z0.mp3","text":"我的皮肤对阳光的抵抗力非常弱，所以我希望您尽可能地把夜间行动的任务安排给我。","alt":"voice/char_502_nblade/cn_004.mp3"}],"信赖":[{"url":"bwiki:f/fb/1thxylcgdfmm7uumv6egqgj5ynggytg.mp3","text":"虽然我们能做到的事有限，但我还是希望能帮忙减轻您的负担。","alt":"voice/char_502_nblade/cn_007.mp3"},{"url":"bwiki:8/8a/1smx5741p19pmd8n3e2fxqxlm6t3qtk.mp3","text":"每当我看到其他小队的干员们的活跃表现，总是会特别羡慕......","alt":"voice/char_502_nblade/cn_008.mp3"},{"url":"bwiki:9/93/ry14zrmsdbprsyypdfsgprx35ebqwkc.mp3","text":"我想为博士出战的心情，是不需要理由的。希望总有一天，我们也能活跃在日常战斗的最前线......","alt":"voice/char_502_nblade/cn_009.mp3"}],"闲置":[{"url":"bwiki:9/96/23n30b61qiw9vmq2qbiafrjcepjrc7j.mp3","text":"博士，让我今后也一直守护着您吧。","alt":"voice/char_502_nblade/cn_010.mp3"}],"报到":[{"url":"bwiki:6/63/oo8y5zeo3aaxd7l10v99zgxsivwrms4.mp3","text":"先锋干员夜刀，你——就是我要保护的人吗？","alt":"voice/char_502_nblade/cn_011.mp3"}],"作战记录":[{"url":"bwiki:c/c6/67bq391ltzpd7jqfjxipsl94ehe7e8w.mp3","text":"非常感谢。","alt":"voice/char_502_nblade/cn_012.mp3"}],"编入":[{"url":"bwiki:9/96/9nezfmfeh4fqm30w4gs7c5ppgxtrnpq.mp3","text":"夜刀，入队。","alt":"voice/char_502_nblade/cn_017.mp3"}],"任命队长":[{"url":"bwiki:1/1a/94zsm81053hg91f09z7t30ed72x4kf9.mp3","text":"各位都会配合您的战术的，博士。","alt":"voice/char_502_nblade/cn_018.mp3"}],"行动出发":[{"url":"bwiki:a/a0/dq99v71qauukmgn6at7li5osxlm0rc8.mp3","text":"全队，从现在起进入警戒模式。","alt":"voice/char_502_nblade/cn_019.mp3"}],"行动开始":[{"url":"bwiki:3/33/irlsdl62s2j1ka794vd