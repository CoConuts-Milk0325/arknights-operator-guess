iki:a/ad/ny7d6049f83dr2syaz70d8tmifl6vx7.mp3","text":"明日方舟。","alt":"voice/char_365_aprl/cn_037.mp3"}],"新年":[{"url":"bwiki:1/1e/pcetvvqvnf89g59hfqymgigckfmggwx.mp3","text":"往年这个时候，我可能正在荒野上，一个人靠着篝火取暖。看到远处城市里升起烟花，就知道新年到了。虽然也很刺激，但还是更喜欢和大家一起跨年呢。新年快乐博士，新的一年也请多关照啦。","alt":"voice/char_365_aprl/cn_038.mp3"}],"问候":[{"url":"bwiki:5/56/6yi6rfgow0oniwxix6hkw6iocspg5mr.mp3","text":"博士，要听歌吗？","alt":"voice/char_365_aprl/cn_042.mp3"}]}}