_017.mp3"}],"任命队长":[{"url":"bwiki:4/49/fzwuruhiieotxybs9olpzdxc56wsc5m.mp3","text":"大家的安全帽都戴好了吗？再检查一遍！","alt":"voice/char_464_cement/cn_018.mp3"}],"行动出发":[{"url":"bwiki:7/76/8ipaycc80wt3iphi5qndukpvj49gxmb.mp3","text":"矿井构造复杂，跟紧我。","alt":"voice/char_464_cement/cn_019.mp3"}],"行动开始":[{"url":"bwiki:5/59/iic51v7t4lb73bn8bgk6q6zf12yi0r3.mp3","text":"咦，钻头怎么卡住了？！","alt":"voice/char_464_cement/cn_020.mp3"}],"选中":[{"url":"bwiki:a/ab/a1ynz1ob12h2ofahyn9om9mwh6fj63i.mp3","text":"唔......什么味道？","alt":"voice/char_464_cement/cn_021.mp3"},{"url":"bwiki:c/c3/iccw92gh8ehamdoma4npmlh4npp3l04.mp3","text":"博士，你准点来验收就行了。","alt":"voice/char_464_cement/cn_022.mp3"}],"部署":[{"url":"bwiki:3/3c/er3qifx1ikhayew7icg5xtpkyyitqzd.mp3","text":"图纸没有问题，正常施工吧。","alt":"voice/char_464_cement/cn_023.mp3"},{"url":"bwiki:4/40/14fwxmj01gflo11f27fn6o1b95wx8zy.mp3","text":"钻孔位置的偏差应该控制在两厘米内。","alt":"voice/char_464_cement/cn_024.mp3"}],"技能":[{"url":"bwiki:3/34/slvm6z35h75m72i6clj17d34h74w29u.mp3","text":"别在操纵钻机的时候走神！","alt":"voice/char_464_cement/cn_025.mp3"},{"url":"bwiki:d/d5/ff06i1x6bhj4ahqck5fqvfa5ztkcx88.mp3","text":"被三倍强光的矿灯照到会致盲哦！","alt":"voice/char_464_cement/cn_026.mp3"},{"url":"bwiki:1/18/pg5ieb1qqaizpfhws55fs3viuwznj9t.mp3","text":"再不让开，混凝土要浇到你们头上了！","alt":"voice/char_464_cement/cn_027.mp3"},{"url":"bwiki:c/c4/8git0swoxixtya6p81316x8xc1dqh76.mp3","text":"向下，向下，向下！","alt":"voice/char_464_cement/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:d/db/qpf4e3tkr9ci7n5pu7qm5gxw24atb4v.mp3","text":"博士，我们、我们完成了一项大工程！","alt":"voice/char_464_cement/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:c/c4/obatzvgbzk0qhcc7vey25webmwbr672.mp3","text":"关系到工人生命安全的事情，当然一丝一毫都马虎不得。","alt":"voice/char_464_cement/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:6/6a/3r6229h4py7k5kthaz8yqatgesw25vo.mp3","text":"竣工后才觉得不如意，已经来不及了，所以我们最好在图纸绘制阶段就尽可能发现问题。","alt":"voice/char_464_cement/cn_031.mp3"}],"失败":[{"url":"bwiki:c/c3/49ucldweloe8pjf4nv8t5c07i3hpdxa.mp3","text":"哎呀，别在意，善后本身也是工程的一部分，补建和加固的活儿交给我就好了，放心吧博士。","alt":"voice/char_464_cement/cn_032.mp3"}],"进驻":[{"url":"b