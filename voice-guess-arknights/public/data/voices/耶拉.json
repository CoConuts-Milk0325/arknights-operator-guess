:[{"url":"bwiki:5/59/ccz177rupfekzt98uk3chbqh5ax617c.mp3","text":"博士，要一起散步吗？","alt":"voice/char_4013_kjera/cn_036.mp3"}],"标题":[{"url":"bwiki:2/28/oqidc61pqlj7uzdztwobdns4lvn0ieh.mp3","text":"明日方舟。","alt":"voice/char_4013_kjera/cn_037.mp3"}],"新年":[{"url":"bwiki:c/c6/sg2sv6ipvf66pmhh0nir6d9fdsppv6k.mp3","text":"原来不只是谢拉格，还有许多地方都会庆祝这个节日呀。倒不是觉得奇怪。只是好像刚庆祝过节日，一眨眼就到了下一个节日，真是奇妙呢。不过，有理由开心就是件好事。博士，想吃奶酪火锅吗？","alt":"voice/char_4013_kjera/cn_038.mp3"}],"问候":[{"url":"bwiki:3/3f/r8ykzqu8rpsq60vb21ao3uwhi332vpn.mp3","text":"博士，昨天晚上睡得好吗？","alt":"voice/char_4013_kjera/cn_042.mp3"}]}}