{"中文":{"登录":[{"url":"bwiki:6/63/6iy367qe37hpjgj7s3l0l5su8izd7zq.mp3","text":"我来啦！棒球和桌上游戏，挑一个来玩吧？诶？工作中？","alt":"voice_cn/char_150_snakek/cn_001.mp3"}],"交谈":[{"url":"bwiki:b/b5/e2ovbdw4vpv9lc4obf3jissfn26t9aq.mp3","text":"你问我，我是在哪儿出生的？唔，嗯......不太清楚。管它呢！","alt":"voice_cn/char_150_snakek/cn_002.mp3"},{"url":"bwiki:1/19/4jn0qcqlfk9hvon4bw50klcflmatfxk.mp3","text":"你好，罗德岛老师！嗯......好像你不是叫这个名字？","alt":"voice_cn/char_150_snakek/cn_003.mp3"},{"url":"bwiki:a/a9/6b9v4yy92v4sr7palqj07ktwl9dxyxo.mp3","text":"唔，我今天的工作是什么来着？是不是要抓一些细长的生物？","alt":"voice_cn/char_150_snakek/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:f/fa/hccg5v8h7r80zx9al4kf4s8fgr0s0kg.mp3","text":"不行！不要敲我的背包！啊，对不起，我不是冲你生气，不小心一点的话，手会受伤的。让我来给你演示一下！","alt":"voice_cn/char_150_snakek/cn_005.mp3"},{"url":"bwiki:b/b5/16blb192vbha1rfn8gudfi5nv08vpwl.mp3","text":"以后谁要是敢欺负你，我就用球棍扁他们！呃，还、还真有？其实我对打架不太在行，嘿嘿......","alt":"voice_cn/char_150_snakek/cn_006.mp3"}],"信赖":[{"url":"bwiki:7/73/8mz38hy9y54ps6ogvazlb2x2tro8z3f.mp3","text":"我啊，喜欢花一天时间从街头走到街尾，一边晒太阳一边观察行人，然后......然后就迷路啦！","alt":"voice_cn/char_150_snakek/cn_007.mp3"},{"url":"bwiki:5/59/o7jmqs07a5nd3z6nrthkh33jr9wee0u.mp3","text":"帮我看病，还给我住的地方，博士真是个好人......","alt":"voice_cn/char_150_snakek/cn_008.mp3"},{"url":"bwiki:3/3d/866b4wojwibngjw2czb2hd21wh6jkh0.mp3","text":"博士是我的哥哥？还是姐姐？没关系，哪种都行！......就算你赶我走，我也是不会离开的！反正我也走不了多远嘛。","alt":"voice_cn/char_150_snakek/cn_009.mp3"}],"闲置":[{"url":"bwiki:1/1f/8amkci66soaicgcop75283njeekueld.mp3","text":"博士没时间理我，我一个人玩会儿吧......","alt":"voice_cn/char_150_snakek/cn_010.mp3"}],"报到":[{"url":"bwiki:3/31/ilufyyzp1uex5wr83aqr6w3uwsvzjro.mp3","text":"欸？这里是什么地方？我是谁？","alt":"voice_cn/char_150_snakek/cn_011.mp3"}],"作战记录":[{"url":"bwiki:1/16/iv55w1gerogedi3vyxqt25prk0f25rs.mp3","text":"变硬！除了变硬我什么都不会！","alt":"voice_cn/char_150_snakek/cn_012.mp3"}],"精英化1":[{"url":"bwiki:3/30/dxfix643664bcxr8y4vztkl6uo4bh78.mp3","text":"晋升？我不懂啊......比起这个，再玩一会儿吧，我们两个一起！！","alt":"voice_cn/char_150_snakek/cn_013.mp3"}],"精英化2":[{"url":"bwiki:a/aa/m18ke90xmoshoprgev39wgcmu2idzq2.mp3","text":"博士博士，我不在乎什么新职位哦，我只要每天都有博士陪伴着我就好了，你能答应我吗？","alt":"voice_cn/char_150_snakek/cn_014.mp3"}],"编入":[{"url":"bwiki:f/fc/s2dczpaji4ju02krt8gnpp9nk8vnwom.mp3","text":"有很多朋友在这里呢！","alt":"voice_cn/char_150_snakek/cn_017.mp3"}],"任命队长":[{"url":"bwiki:e/ed/n0diqg8h05b1fztf2k8rbneg2z06s6k.mp3","text":"大家一起出发吧！","alt":"voice_cn/char_150_snakek/cn_018.mp3"}],"行动出发":[{"url":"bwiki:1/1e/4v6gbrw97lk41wsa9m8pmgd3cppf00o.mp3","text":"大家一起的话，一定没问题的！","alt":"voice_cn/char_150_snakek/cn_019.mp3"}],"行动开始":[{"url":"bwiki:6/6f/9jg1gipug3ytgcq3jl5wyb6w3sr537a.mp3","text":"大家一起玩吧！","alt":"voice_cn/char_150_snakek/cn_020.mp3"}],"选中":[{"url":"bwiki:c/c5/74wlwvl3t1i0l3y3vqwnm5q4zmt8dub.mp3","text":"是——","alt":"voice_cn/char_150_snakek/cn_021.mp3"},{"url":"bwiki:5/56/saghtx4j8es85wwhkpbbct1d5gpcgpn.mp3","text":"博士！","alt":"voice_cn/char_150_snakek/cn_022.mp3"}],"部署":[{"url":"bwiki:7/79/gymg6kz9vtx0oq2y92kshzrg6wshg4a.mp3","text":"来吧来吧！","alt":"voice_cn/char_150_snakek/cn_023.mp3"},{"url":"bwiki:7/75/g1g04j8mxo56jgx9efgepsv00iwgfij.mp3","text":"你们这些笨蛋！我才是你们的对手！","alt":"voice_cn/char_150_snakek/cn_024.mp3"}],"技能":[{"url":"bwiki:d/d2/qeylv93pzmfsfa4z9120o5ymzcymxw1.mp3","text":"没用没用没用！","alt":"voice_cn/char_150_snakek/cn_025.mp3"},{"url":"bwiki:3/33/d0x0r4cb5iiyo48nxvnh9r80l4gweo0.mp3","text":"来陪我玩玩吧！","alt":"voice_cn/char_150_snakek/cn_026.mp3"},{"url":"bwiki:9/9e/rnfdxvlivzxi83q34l0ptdn1vt85xyj.mp3","text":"这是我的主场！","alt":"voice_cn/char_150_snakek/cn_027.mp3"},{"url":"bwiki:7/73/ht8bwmb417o01ksm9n9sf0xaz0ou4q8.mp3","text":"绝对不会后退的！","alt":"voice_cn/char_150_snakek/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:8/87/hyf97nhafl9gyzsftkdcgap6y8med79.mp3","text":"很难吗？感觉和平时的战斗也没什么区别啊？","alt":"voice_cn/char_150_snakek/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:4/44/i2u6tzyvqau1oa8qavomjr23pk9s1js.mp3","text":"全垒打！！","alt":"voice_cn/char_150_snakek/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:6/67/j1xm95qbelqxj9p52s9povfmpp6q69k.mp3","text":"安打！","alt":"voice_cn/char_150_snakek/cn_031.mp3"}],"失败":[{"url":"bwiki:e/e0/nkphnfbrqz7a5r8cw03nlp2dc4qcmo7.mp3","text":"呜啊啊啊啊......出局了....","alt":"voice_cn/char_150_snakek/cn_032.mp3"}],"进驻":[{"url":"bwiki:e/e4/bxdbq6kvw2neh1kx675h9a4rlqo0x3p.mp3","text":"别用火球打我哦？","alt":"voice_cn/char_150_snakek/cn_033.mp3"}],"戳一下":[{"url":"bwiki:1/10/rbq189rq1rkzy292x4cgxqqsokrnswi.mp3","text":"哇，好玩！","alt":"voice_cn/char_150_snakek/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:a/ac/a1igaqnzffjwvur24z9wj7i8a0d60z6.mp3","text":"博士，博士！再稍微玩一会儿吧？就一小会儿！","alt":"voice_cn/char_150_snakek/cn_036.mp3"}],"标题":[{"url":"bwiki:0/04/9nb1felutbfc92a6g07hk60v32hrkpr.mp3","text":"明日方舟。","alt":"voice_cn/char_150_snakek/cn_037.mp3"}],"新年":[{"url":"bwiki:6/6c/6o7ffhii3je8bpbemhtk4ykpxfqqnid.mp3","text":"新年快乐，博士！我在找最开始被发现的那块甲板。是这里呢，还是那里呢？为什么要找？因为那天的午觉睡得真的好舒服啊......太阳暖暖的，我还想再睡一遍！嘿嘿......","alt":"voice_cn/char_150_snakek/cn_038.mp3"}],"问候":[{"url":"bwiki:b/b1/f02320t1jwa3hj8j7dujg0lmy2ygur3.mp3","text":"博士！你好！","alt":"voice_cn/char_150_snakek/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:8/8a/450rx3uwy9yrvsnkemk36hb3az825up.mp3","text":"我来啦！棒球和桌上游戏，挑一个来玩吧？诶？工作中？","alt":"voice/char_150_snakek/cn_001.mp3"}],"交谈":[{"url":"bwiki:6/66/pjviffmfpsopytwd6xu4q9aoq8qpckp.mp3","text":"你问我，我是在哪儿出生的？唔，嗯......不太清楚。管它呢！","alt":"voice/char_150_snakek/cn_002.mp3"},{"url":"bwiki:4/4a/ifkgnu4ecow3yl3mc3333u7gaijwmgf.mp3","text":"你好，罗德岛老师！嗯......好像你不是叫这个名字？","alt":"voice/char_150_snakek/cn_003.mp3"},{"url":"bwiki:2/29/ctg19mx426cgi7mczczmt0pu2oh03nb.mp3","text":"唔，我今天的工作是什么来着？是不是要抓一些细长的生物？","alt":"voice/char_150_snakek/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:2/29/eqrxpq25i8v7vu9uhxbl4ti3etdvy9n.mp3","text":"不行！不要敲我的背包！啊，对不起，我不是冲你生气，不小心一点的话，手会受伤的。让我来给你演示一下！","alt":"voice/char_150_snakek/cn_005.mp3"},{"url":"bwiki:a/aa/h26jbc8tmkb6s7lahpwggo93m6cew21.mp3","text":"以后谁要是敢欺负你，我就用球棍扁他们！呃，还、还真有？其实我对打架不太在行，嘿嘿......","alt":"voice/char_150_snakek/cn_006.mp3"}],"信赖":[{"url":"bwiki:d/d7/a14ze4ywrnbeyk3sd8liibu5x8eqvsb.mp3","text":"我啊，喜欢花一天时间从街头走到街尾，一边晒太阳一边观察行人，然后......然后就迷路啦！","alt":"voice/char_150_snakek/cn_007.mp3"},{"url":"bwiki:5/54/0r8y2ec