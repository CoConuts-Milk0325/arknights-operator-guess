{"中文":{"登录":[{"url":"bwiki:f/f1/kbandpbycxzs9ex2ppln2cy798ud5vj.mp3","text":"博士，我安排下去的基础训练项目，新人们都有在认真练习吗？","alt":"voice_cn/char_130_doberm/cn_001.mp3"}],"交谈":[{"url":"bwiki:1/1a/5d9yjmkiqwvtvc9syqmuu79x6rt09xr.mp3","text":"合理且有规律的饮食也是日常训练的一环。凡是抗议这项规则的人，首先到甲板上跑五十圈再说。","alt":"voice_cn/char_130_doberm/cn_002.mp3"},{"url":"bwiki:f/f6/clxrvwh235w91d8q7e006s0yt0t2tjo.mp3","text":"作为教官，日常教学理应不断在严厉和宽容间寻求平衡。老实说，我觉得，我对芬是不是有些太苛刻了。","alt":"voice_cn/char_130_doberm/cn_003.mp3"},{"url":"bwiki:e/e3/5j73yhh6qutafpijf0ww8pnp4t4634k.mp3","text":"为干员编排小组时，要记得做到人尽其才，让每个人能最大程度地发挥力量。干员的个人能力至关重要，但博士你的判断能力才是最需要考验的。","alt":"voice_cn/char_130_doberm/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:2/22/ircskejuz500fewdesysijy52g5jqy7.mp3","text":"博士，干员的训练，不仅要改善他们的体质，增进他们的能力，还要注重提升他们精神方面的修养。别忘了，他们必须拥有能对抗审讯和种种精神干扰的心理素质。","alt":"voice_cn/char_130_doberm/cn_005.mp3"},{"url":"bwiki:4/42/m737e58xmcikgb9189i069u0kyokwdl.mp3","text":"你在找那些新人？他们正在罗德岛甲板上训练。啊，我当然知道这会儿外面是什么天气。","alt":"voice_cn/char_130_doberm/cn_006.mp3"}],"信赖":[{"url":"bwiki:3/30/s10kthooh6qo5wmof9eoy77wyroxwmd.mp3","text":"异常的变化......呵呵，“猎犬”的眼睛是无法被欺瞒的。","alt":"voice_cn/char_130_doberm/cn_007.mp3"},{"url":"bwiki:d/df/tnhqqoowndviw3g0yz8nlqcrk9zxcdh.mp3","text":"如果你觉得，“只要坐在指挥官的位子上，就可以随便放松懈怠”，我一定会纠正你的想法，博士。","alt":"voice_cn/char_130_doberm/cn_008.mp3"},{"url":"bwiki:d/d6/lw9ugvsswa18bq7ulr5vsa6hau6f7ci.mp3","text":"要与博士共度艰难的时光，我就必须更加严格地要求自己。在这种环境下，想与你一起走得更远，唯一的出路，就只有无止尽地磨练自己的心性。","alt":"voice_cn/char_130_doberm/cn_009.mp3"}],"闲置":[{"url":"bwiki:8/8d/1ydtacjzvr122ee2kg0fkfnyy95kbd0.mp3","text":"不许偷懒！","alt":"voice_cn/char_130_doberm/cn_010.mp3"}],"报到":[{"url":"bwiki:b/b7/ductl150cksbju060qhtgtx4oo929xw.mp3","text":"敬礼！曾属玻利瓦尔国民警备队，我是教官杜宾。长话短说，请把需受训干员的名单给我看一下。","alt":"voice_cn/char_130_doberm/cn_011.mp3"}],"作战记录":[{"url":"bwiki:9/96/q4htcchzyik5fgt8r6v67oiar82zi5m.mp3","text":"这正是平时训练的成果。","alt":"voice_cn/char_130_doberm/cn_012.mp3"}],"精英化1":[{"url":"bwiki:d/d5/f8zy93pusavvz3uej8nf5grk6b9xb8k.mp3","text":"晋升啊，感谢。我不过是在履行自己的职责。","alt":"voice_cn/char_130_doberm/cn_013.mp3"}],"精英化2":[{"url":"bwiki:1/18/8imagbxvtsxrg6l87pncd2sln2vdeoh.mp3","text":"我肩负着为罗德岛培养未来人才的重任，因此，为了配得上这份职责，我会尽我所能。","alt":"voice_cn/char_130_doberm/cn_014.mp3"}],"编入":[{"url":"bwiki:9/93/dg7j1h5pzao9p7pg4osrile0vx39uvo.mp3","text":"了解。","alt":"voice_cn/char_130_doberm/cn_017.mp3"}],"任命队长":[{"url":"bwiki:6/6b/r9njxjhwc4jhrxtpekyz833zgtd2f1e.mp3","text":"那么，请给我看一下任务简报。","alt":"voice_cn/char_130_doberm/cn_018.mp3"}],"行动出发":[{"url":"bwiki:2/2f/nra804dme3izge7s9ox682tfyl1qvqd.mp3","text":"通知全体人员，这一次，不是训练！","alt":"voice_cn/char_130_doberm/cn_019.mp3"}],"行动开始":[{"url":"bwiki:1/12/0xirzzhfw06utigo1kq8s24vz86nktl.mp3","text":"审问时间到了。","alt":"voice_cn/char_130_doberm/cn_020.mp3"}],"选中":[{"url":"bwiki:2/26/0508y7xbwc7wpgetq0jpzjap0mfqob8.mp3","text":"待命中。","alt":"voice_cn/char_130_doberm/cn_021.mp3"},{"url":"bwiki:2/2d/i05m1kpkuq8zsp53zbmd48nkkysmks0.mp3","text":"请给我命令。","alt":"voice_cn/char_130_doberm/cn_022.mp3"}],"部署":[{"url":"bwiki:8/8d/tjstodulsmy4kp26022819u4xrcws8b.mp3","text":"了解。","alt":"voice_cn/char_130_doberm/cn_023.mp3"},{"url":"bwiki:5/5f/51yjztf1z0v6g9nbcqo2nrz5jx9wgre.mp3","text":"开始追踪。","alt":"voice_cn/char_130_doberm/cn_024.mp3"}],"技能":[{"url":"bwiki:d/d7/rmf97g79t6c5zhnuy7uvgboij0gl4n3.mp3","text":"你们这些恶徒。","alt":"voice_cn/char_130_doberm/cn_025.mp3"},{"url":"bwiki:1/13/9pgxfbjuheeyqberphp77l3b29m5vzq.mp3","text":"接招！","alt":"voice_cn/char_130_doberm/cn_026.mp3"},{"url":"bwiki:e/e4/dx5zlknfc9xq45huvt2q6w0krgh1j3q.mp3","text":"撕裂！","alt":"voice_cn/char_130_doberm/cn_027.mp3"},{"url":"bwiki:c/cd/52ydewgaaiu6xhkzyjy3o1lnhy015s1.mp3","text":"坚持住！","alt":"voice_cn/char_130_doberm/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:c/cb/n8y9fqi35s8w0c7mu3m4359oamkb491.mp3","text":"不管局面有多艰难，只要牢记最基础的战斗方法，关键时刻就能救下自己的命。","alt":"voice_cn/char_130_doberm/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:1/1e/8xmif7u6bjdgz4hgr8eakza0h7nicb6.mp3","text":"磨练好技巧再来吧，废物们。","alt":"voice_cn/char_130_doberm/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:d/de/2fksqc4og5vaonapmaeob166e7im2dt.mp3","text":"虽然作战是成功的，但细节仍有改善的余地。","alt":"voice_cn/char_130_doberm/cn_031.mp3"}],"失败":[{"url":"bwiki:e/e4/8hcz0f2jlk8e5tqhmumpbj3l4btvo6m.mp3","text":"这次作战失败，责任由我承担。","alt":"voice_cn/char_130_doberm/cn_032.mp3"}],"进驻":[{"url":"bwiki:b/be/l1nglgwbgnjirb5ubvwxai61ivliako.mp3","text":"新人们有点害怕我？这是理所当然的。","alt":"voice_cn/char_130_doberm/cn_033.mp3"}],"戳一下":[{"url":"bwiki:0/0e/mugv8ase3b78307449qtfvxev93wh2z.mp3","text":"请注意自己的言行举止。","alt":"voice_cn/char_130_doberm/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:a/a4/px2fb3lwjkmjweoecyalqro1s7su2s2.mp3","text":"让我心情变好的方法啊......哼，也许，参与一场审讯也可以。","alt":"voice_cn/char_130_doberm/cn_036.mp3"}],"标题":[{"url":"bwiki:f/f7/444mr1jip8lrgxnwzgkxyy6gdag8awp.mp3","text":"明日方舟。","alt":"voice_cn/char_130_doberm/cn_037.mp3"}],"新年":[{"url":"bwiki:0/01/9ucdhm5j58wq8dtdhk2wqaho29c3h74.mp3","text":"不管平时还是节假日，我都随时待命。博士也不应当过于松懈。","alt":"voice_cn/char_130_doberm/cn_038.mp3"}],"问候":[{"url":"bwiki:5/5a/ql5ts5fjv1c051kt1wse5vuhwoamyeu.mp3","text":"早上好，博士。","alt":"voice_cn/char_130_doberm/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:f/f2/hsyf2ay4akvk7d2b0eqmotjj05z2se2.mp3","text":"博士，我安排下去的基础训练项目，新人们都有在认真练习吗？","alt":"voice/char_130_doberm/cn_001.mp3"}],"交谈":[{"url":"bwiki:3/3c/inrrqent9iyywahfl1w3lk1c4nklqh8.mp3","text":"合理且有规律的饮食也是日常训练的一环。凡是抗议这项规则的人，首先到甲板上跑五十圈再说。","alt":"voice/char_130_doberm/cn_002.mp3"},{"url":"bwiki:9/99/n8bklfs7b2swki94xssj6b2rt4f1oai.mp3","text":"作为教官，日常教学理应不断在严厉和宽容间寻求平衡。老实说，我觉得，我对芬是不是有些太苛刻了。","alt":"voice/char_130_doberm/cn_003.mp3"},{"url":"bwiki:3/36/e0uic1ilzer4fa15riae8ayzpm50siy.mp3","text":"为干员编排小组时，要记得做到人尽其才，让每个人能最大程度地发挥力量。干员的个人能力至关重要，但博士你的判断能力才是最需要考验的。","alt":"voice/char_130_doberm/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:2/21/elahqvlnsbtb2i9ckkjai5xux7bld1w.mp3","text":"博士，干员的训练，不仅要改善他们的体质，增进他们的能力，还要注重提升他们精神方面的修养。别忘了，他们必须拥有能对抗审讯和种种精神干扰的心理素质。","alt":"voice/char_130_doberm/cn_005.mp3"},{"url":"bwiki:f/f9/5y3kyjshemrmnaxrh910j6c5o6101c6.mp3","text":"你在找那些新人？他们正在罗德岛甲板上训练。啊，我当然知道这会儿外面是什么天气。","alt":"voice/char_130_doberm/cn_006.mp3"}],"信赖":[{"url":"bwiki:9/93/3kw989awks04ifpnrgmvhphcexh5co4.mp3","text":"异常的变化......呵呵，“猎犬”的眼睛是无法被欺瞒的。","alt":"voice/char_130_doberm/cn_007.mp3"},{"url":"bwiki:9/9e/oi903o3l0lq3c5h98g5hzouoqpcmmv0.mp3","text":"如果你觉得，“只要坐在指挥官的位子上，就可以随便放松懈怠”，我一定会纠正你的想法，博士。","alt":"voice/char_130_doberm/cn_008.mp3"},{"url":"bwiki:3/3f/2xilrbgieassvwel5c73z9lk6q8mj99.mp3","text":"要与博士共度艰难的时光，我就必须更加严格地要求自己。在这种环境下，想与你一起走得更远，唯一的出路，就只有无止尽地磨练自己的心性。","alt":"voice/char_130_doberm/cn_009.mp3"}],"闲置":[{"url":"bwiki:f/f1/dviwrjruxmun0vip6y5ptp00anxvmm0.mp3","text":"不许偷懒！","alt":"voice/char_130_doberm/cn_010.mp3"}],"报到":[{"url":"bwiki:3/37/7hl6mmfqmo1onwc5byg3cxjbd2xqk6s.mp3","text":"敬礼！曾属玻利瓦尔国民警备队，我是教官杜宾。长话短说，请把需受训干员的名单给我看一下。","alt":"voice/char_130_doberm/cn_011.mp3"}],"作战记录":[{"url":"bwiki:b/b4/sh2deb6r61gmbfyf8r9ymujw86f95ju.mp3","text":"这正是平时训练的成果。","alt":"voice/char_130_doberm/cn_012.mp3"}],"精英化1":[{"url":"bwiki:2/2a/g78uph1v91mm630673ruvnkfwkz87s3.mp3","text":"晋升啊，感谢。我不过是在履行自己的职责。","alt":"voice/char_130_doberm/cn_013.mp3"}],"精英化2":[{"url":"bwiki:a/a9/c050vpzl37yxo2ygrh903ejowbhy5sq.mp3","text":"我肩负着为罗德岛培养未来人才的重任，因此，为了配得上这份职责，我会尽我所能。","alt":"voice/char_130_doberm/cn_014.mp3"}],"编入":[{"url":"bwiki:f/f8/pkpj53xgsf7vhddoz3i3a389x6zpyy3.mp3","text":"了解。","alt":"voice/char_130_doberm/cn_017.mp3"}],"任命队长":[{"url":"bwiki:7/70/886w9rcxvuxc8adkpwi2w2kdo9ay6a0.mp3","text":"那么，请给我看一下任务简报。","alt":"voice/char_130_doberm/cn_018.mp3"}],"行动出发":[{"url":"bwiki:4/4a/0jhyhdpz8jhj14g1vuimh68b6cnnfix.mp3","text":"通知全体人员，这一次，不是训练！","alt":"voice/char_130_doberm/cn_019.mp3"}],"行动开始":[{"url":"bwiki:d/d7/rl4js2tf6ps3ew8hyx8ce9hiro56o8c.mp3","text":"审问时间到了。","alt":"voice/char_130_doberm/cn_020.mp3"}],"选中":[{"url":"bwiki:d/d7/izhr2lszdat46fmuuyv0dujud8ro2ta.mp3","text":"待命中。","alt":"voice/char_130_doberm/cn_021.mp3"},{"url":"bwiki:d/d5/fp9hispi6co84pt2d0up1j4q0lxxedn.mp3","text":"请给我命令。","alt":"voice/char_130_doberm/cn_022.mp3"}],"部署":[{"url":"bwiki:3/3f/j7dg4ybv2m66qf9q3ne2m3nuxw52d22.mp3","text":"了解。","alt":"voice/char_130_doberm/cn_023.mp3"},{"url":"bwiki:5/5b/ejclh44tdnnwbkzjn04uiiwvgy7vzbp.mp3","text":"开始追踪。","alt":"voice/char_130_doberm/cn_024.mp3"}],"技能":[{"url":"bwiki:0/09/c2dcq4elaevja3czw1ojk5ks6vl4zbv.mp3","text":"你们这些恶徒。","alt":"voice/char_130_doberm/cn_025.mp3"},{"url":"bwiki:6/6e/ct8cf8aq1umu9d5gwrg3spdvlpvzzv2.mp3","text":"接招！","alt":"voice/char_130_doberm/cn_026.mp3"},{"url":"bwiki:f/f5/m2zvd718t8qvuz91gf1a01lfjm8o0zo.mp3","text":"撕裂！","alt":"voice/char_130_doberm/cn_027.mp3"},{"url":"bwiki:1/12/epggmvvcxin9me3jufqniw7ulm74875.mp3","text":"坚持住！","alt":"voice/char_130_doberm/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:a/ab/fnd87bzd9ztuyjwu0z6sceql6rkqhpw.mp3","text":"不管局面有多艰难，只要牢记最基础的战斗方法，关键时刻就能救下自己的命。","alt":"voice/char_130_doberm/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:e/e5/579hehk2zv5mhybfmfdsz3dgngf06ea.mp3","text":"磨练好技巧再来吧，废物们。","alt":"voice/char_130_doberm/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:9/95/rm4cyoi90sgsis44bv2l0mvzlzld30a.mp3","text":"虽然作战是成功的，但细节仍有改善的余地。","alt":"voice/char_130_doberm/cn_031.mp3"}],"失败":[{"url":"bwiki:b/bf/mw1qv73fhd72xs1oo3zppd02j9n13z2.mp3","text":"这次作战失败，责任由我承担。","alt":"voice/char_130_doberm/cn_032.mp3"}],"进驻":[{"url":"bwiki:7/75/sfvxcsqkc5vpnxe7180ch02yhwcwp0l.mp3","text":"新人们有点害怕我？这是理所当然的。","alt":"voice/char_130_doberm/cn_033.mp3"}],"戳一下":[{"url":"bwiki:f/f3/t48384tfmtdatjeyvhbe8celkq3ci98.mp3","text":"请注意自己的言行举止。","alt":"voice/char_130_doberm/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:a/a5/dv2oebum4le7q7ef3xpl1e61h78kvji.mp3","text":"让我心情变好的方法啊......哼，也许，参与一场审讯也可以。","alt":"voice/char_130_doberm/cn_036.mp3"}],"标题":[{"url":"bwiki:4/49/82bn6gkymojg4z2eh40l0weev8ijkt7.mp3","text":"明日方舟。","alt":"voice/char_130_doberm/cn_037.mp3"}],"新年":[{"url":"bwiki:7/7b/0ymhn8ebwkf1h5n8x8bw7n3jcguu03k.mp3","text":"不管平时还是节假日，我都随时待命。博士也不应当过于松懈。","alt":"voice/char_130_doberm/cn_038.mp3"}],"问候":[{"url":"bwiki:2/22/9b9mpe1e8m5e94bw63y2jymp9pqv6lo.mp3","text":"早上好，博士。","alt":"voice/char_130_doberm/cn_042.mp3"}]}}