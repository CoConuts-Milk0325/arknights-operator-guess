{"中文":{"登录":[{"url":"bwiki:6/6c/4qcc8w4vfahpayy9bmk23i0z5tv9l16.mp3","text":"要是有敌人就大声喊，老子我会保护你。","alt":"voice_cn/char_155_tiger/cn_001.mp3"}],"交谈":[{"url":"bwiki:3/3f/pq7tyl4zurxowiotd6zmz2q0k71pxki.mp3","text":"那家伙跑哪去了？总是跟在主子身边，矮矮的又晒得很黑，名字叫“摩根”的家伙......啊！别跑！","alt":"voice_cn/char_155_tiger/cn_002.mp3"},{"url":"bwiki:a/a6/tsllgjzu896dzsgf0minm22q1xwscgo.mp3","text":"你帮我，我帮你，理所当然的吧。你要是尊重我，我就不会怠慢你。","alt":"voice_cn/char_155_tiger/cn_003.mp3"},{"url":"bwiki:b/b0/3r7ybsaznvvaxv4jvfhp9uuid331u37.mp3","text":"我家主子好像还挺喜欢你这里的。还真是稀奇事啊，我们很少在同个地方停留太久的。","alt":"voice_cn/char_155_tiger/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:7/7b/8xzatxvq1iku05pv8p2kf9492cptbwv.mp3","text":"不管做什么工作，都得拿出气势。","alt":"voice_cn/char_155_tiger/cn_005.mp3"},{"url":"bwiki:7/75/cx3jbpvuvcih2f08mt156gh91n5bvww.mp3","text":"哦~哦~不要着急慢慢吃吧~喂！给我再拿些肉吧！就这点，完全不够这孩子吃！","alt":"voice_cn/char_155_tiger/cn_006.mp3"}],"信赖":[{"url":"bwiki:4/41/hotqi1ogzaowuix15c3ifgkm892bqn0.mp3","text":"摩根那笨蛋，别看总是游手好闲的，她好歹算是给我们出谋划策的，该做的事还是会去做，虽然大多数时间都在给我捣乱。啧......！","alt":"voice_cn/char_155_tiger/cn_007.mp3"},{"url":"bwiki:f/fc/j7xjh8t21qfa7kfwbo62g2673z8x320.mp3","text":"单手拿锤威风凛凛的王，帅吧？但老子我，还是更期待她用剑的样子哪。","alt":"voice_cn/char_155_tiger/cn_008.mp3"},{"url":"bwiki:5/51/d1zk3n215xlbxb66imzpfy7dg21s4v3.mp3","text":"尽管开口！不用考虑那么多，就吩咐吧，你想解决谁？","alt":"voice_cn/char_155_tiger/cn_009.mp3"}],"闲置":[{"url":"bwiki:b/be/suosr609i3w300576g51s9y7k70xjto.mp3","text":"哼。放松警惕了吗？就算你被老虎吃掉，我也不管哦。","alt":"voice_cn/char_155_tiger/cn_010.mp3"}],"报到":[{"url":"bwiki:7/71/bm4lceq61ouu3pwo6d3f8j1sgejuc0o.mp3","text":"老子是因陀罗，没什么乱七八糟的能力，干架靠的就是这双拳头。那么，请多关照！","alt":"voice_cn/char_155_tiger/cn_011.mp3"}],"作战记录":[{"url":"bwiki:c/c1/l3vztjemfzcjokdqu3k4sbzysp7t8e4.mp3","text":"哦，这个不错，我喜欢。","alt":"voice_cn/char_155_tiger/cn_012.mp3"}],"精英化1":[{"url":"bwiki:4/44/duk8akqlql23p68szukv9ujs9wji3ww.mp3","text":"晋升固然好，打架也不赖！","alt":"voice_cn/char_155_tiger/cn_013.mp3"}],"精英化2":[{"url":"bwiki:6/6b/rnr00xqdyfyu07w9gb3u8qauds9bfee.mp3","text":"别怕，我能保护你。","alt":"voice_cn/char_155_tiger/cn_014.mp3"}],"编入":[{"url":"bwiki:1/1a/nyg9pl4ts3ab0b2n01coe8o5nytg1li.mp3","text":"战场在哪？","alt":"voice_cn/char_155_tiger/cn_017.mp3"}],"任命队长":[{"url":"bwiki:2/2c/73rtw9j6izgdcx0i3utf6hptxx7u5iv.mp3","text":"又是谁想要挨揍？","alt":"voice_cn/char_155_tiger/cn_018.mp3"}],"行动出发":[{"url":"bwiki:c/c0/0ynncn3jmy9g98bf3knwkwwooys294d.mp3","text":"你们干你们的活，没事别管我！","alt":"voice_cn/char_155_tiger/cn_019.mp3"}],"行动开始":[{"url":"bwiki:f/ff/lzlds21tjg80iqgten4ilylmk2v8kjc.mp3","text":"放马过来吧！","alt":"voice_cn/char_155_tiger/cn_020.mp3"}],"选中":[{"url":"bwiki:c/c7/526vig3c4ere2fqwrncbw00caqe210e.mp3","text":"嘿！","alt":"voice_cn/char_155_tiger/cn_021.mp3"},{"url":"bwiki:7/77/20t6rgcgxq94zotd3jw901m09ridbs9.mp3","text":"别拖拖拉拉的！","alt":"voice_cn/char_155_tiger/cn_022.mp3"}],"部署":[{"url":"bwiki:9/96/qk3ehuvbyx42dw3ryednpw1roxahp3u.mp3","text":"哈哈！","alt":"voice_cn/char_155_tiger/cn_023.mp3"},{"url":"bwiki:d/d2/r4s6928gwgzzxgojvj2vifya7vc2yht.mp3","text":"好，轮到我了！","alt":"voice_cn/char_155_tiger/cn_024.mp3"}],"技能":[{"url":"bwiki:f/f0/ssuayjubbz0kcfpcqs5oztgpzs00ryc.mp3","text":"你这个混球！","alt":"voice_cn/char_155_tiger/cn_025.mp3"},{"url":"bwiki:a/a6/azlrhkfakb5842ksw2c1x3vj06bl8ct.mp3","text":"有什么好怕的！","alt":"voice_cn/char_155_tiger/cn_026.mp3"},{"url":"bwiki:7/72/9ikrefyqvjh1yorowz24f6jp2y2mlwz.mp3","text":"你玩完了！","alt":"voice_cn/char_155_tiger/cn_027.mp3"},{"url":"bwiki:f/f3/huc17f53885z8k1wjzljryl3238wd3o.mp3","text":"没用！","alt":"voice_cn/char_155_tiger/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:5/5d/ly03w33jszbrhtrc9unw9nj1atsfnoj.mp3","text":"过瘾！太过瘾了！","alt":"voice_cn/char_155_tiger/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:d/dc/rnnfqcni0h1cp4ji51mdoi8i4m3tyr2.mp3","text":"不见红，不畅快！","alt":"voice_cn/char_155_tiger/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:0/0a/5hz559126pcn5fumltmthd3bfka5gpe.mp3","text":"嘁，有人逃跑了，扫兴。","alt":"voice_cn/char_155_tiger/cn_031.mp3"}],"失败":[{"url":"bwiki:2/25/bk6hxl3qozxucza1gsrgmcun5trnwee.mp3","text":"你，不错嘛，给我等着——！","alt":"voice_cn/char_155_tiger/cn_032.mp3"}],"进驻":[{"url":"bwiki:3/38/psqz0q0toexqwbk3g6v31vl9m5oefnb.mp3","text":"这房间怎么回事啊，比我过去待的要窄好多。","alt":"voice_cn/char_155_tiger/cn_033.mp3"}],"戳一下":[{"url":"bwiki:d/d9/c4hrdf1f9psls0yzos929at27gld7z0.mp3","text":"喂，敢动我，把你打飞哦！","alt":"voice_cn/char_155_tiger/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:b/b8/2pokv16t2k2iqgu90zyg9iji9m4olhk.mp3","text":"来吧！拥抱一下！对，就是拥抱的那个意思！","alt":"voice_cn/char_155_tiger/cn_036.mp3"}],"标题":[{"url":"bwiki:c/cb/gtpie8bquo0ch8bu8vdzif3c97x2p7k.mp3","text":"明日方舟。","alt":"voice_cn/char_155_tiger/cn_037.mp3"}],"新年":[{"url":"bwiki:f/f3/rq0vlm1ngluue6z2js9a71wffscjs8v.mp3","text":"喔！有年终奖金吗？哈哈，也该有我一份吧，都帮你打过那么多次架啦，再怎么说都是同伴了，对吧！走，我请你吃一顿！","alt":"voice_cn/char_155_tiger/cn_038.mp3"}],"问候":[{"url":"bwiki:d/d5/h9o9rjjrrxwjuyuv4309e48c9e5hgnq.mp3","text":"哟！博士。","alt":"voice_cn/char_155_tiger/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:1/1c/6ouvqyht48h18ssxq5og4fogh5kcwh8.mp3","text":"要是有敌人就大声喊，老子我会保护你。","alt":"voice/char_155_tiger/cn_001.mp3"}],"交谈":[{"url":"bwiki:f/fc/maa6adw601tmw7o5fe4qn8u32u1of4i.mp3","text":"那家伙跑哪去了？总是跟在主子身边，矮矮的又晒得很黑，名字叫“摩根”的家伙......啊！别跑！","alt":"voice/char_155_tiger/cn_002.mp3"},{"url":"bwiki:2/26/4q1vbjapmzj0lh3s4208ywrmhat3c2z.mp3","text":"你帮我，我帮你，理所当然的吧。你要是尊重我，我就不会怠慢你。","alt":"voice/char_155_tiger/cn_003.mp3"},{"url":"bwiki:6/68/lmhpez1foj87w8s609anqg7qzj8mo04.mp3","text":"我家主子好像还挺喜欢你这里的。还真是稀奇事啊，我们很少在同个地方停留太久的。","alt":"voice/char_155_tiger/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:2/2c/m9lhae653kffn22c5t30yjj89d35yqz.mp3","text":"不管做什么工作，都得拿出气势。","alt":"voice/char_155_tiger/cn_005.mp3"},{"url":"bwiki:b/b6/98reb6uevy1z050ewwwv1xk2r77mkn7.mp3","text":"哦~哦~不要着急慢慢吃吧~喂！给我再拿些肉吧！就这点，完全不够这孩子吃！","alt":"voice/char_155_tiger/cn_006.mp3"}],"信赖":[{"url":"bwiki:9/9d/fch0fluspney43248qt49yop3go32k6.mp3","text":"摩根那笨蛋，别看总是游手好闲的，她好歹算是给我们出谋划策的，该做的事还是会去做，虽然大多数时间都在给我捣乱。啧......！","alt":"voice/char_155_tiger/cn_007.mp3"},{"url":"bwiki:a/aa/trk8012mmzzutu3mfuwaafyrjvwi0n1.mp3","text":"单手拿锤威风凛凛的王，帅吧？但老子我，还是更期待她用剑的样子哪。","alt":"voice/char_155_tiger/cn_008.mp3"},{"url":"bwiki:8/80/he9r92qx424vju