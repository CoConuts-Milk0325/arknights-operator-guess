{"中文":{"登录":[{"url":"bwiki:9/9d/r38i16x3yf6btju31yk1rlwfsenyssb.mp3","text":"前辈，您借我的天灾研究笔记我都读完了，还有其他的吗？","alt":"voice_cn/char_180_amgoat/cn_001.mp3"}],"交谈":[{"url":"bwiki:c/c6/nyi92yew0xfrk4bywy4y4ptyl6xg2yf.mp3","text":"您说什么？为什么？为什么要叫您前辈？啊，因为您是天灾研究的专家呀，按照规矩一定要叫前辈的~","alt":"voice_cn/char_180_amgoat/cn_002.mp3"},{"url":"bwiki:0/0b/kvm0cqukfpuy2yfd5g4g7ds06pbribn.mp3","text":"那个，原——什么？啊，是问我听力恶化的原因？其实，是我以前在火山地带做考察的时候，不小心感染了矿石病的缘故......","alt":"voice_cn/char_180_amgoat/cn_003.mp3"},{"url":"bwiki:d/d7/d5la7rnvq4fqwmd95006ctwu5xjhgy7.mp3","text":"除了完成前辈您安排的工作，我还要抽空去凯尔希医生那里做检查。医生说，我的病症似乎是比较严重的那种......","alt":"voice_cn/char_180_amgoat/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:d/d7/642l61i4rzpp7atzwdghnz28jgjz5wy.mp3","text":"为了完成父母的研究，我还得更努力才行。如果我能证明他们的研究是有意义的，说不定，将会有一个影响世界的大发现呢。","alt":"voice_cn/char_180_amgoat/cn_005.mp3"},{"url":"bwiki:a/ae/0z1a390goibik9uss7ecbmwk87stwkk.mp3","text":"我的父母......已经去世了，他们在火山周边进行观测时遭遇了火山碎屑流......我必须继承父母的遗志，完成他们的学说，无论如何都要......","alt":"voice_cn/char_180_amgoat/cn_006.mp3"}],"信赖":[{"url":"bwiki:0/05/e221eeua997flr37xswg42dqgx70irm.mp3","text":"玩伴吗？我和慕斯她们关系很好，所以一点也不寂寞~如果可以的话，我想和大家一起办读书会！嗯，就在前辈您的办公室，可以吗？","alt":"voice_cn/char_180_amgoat/cn_007.mp3"},{"url":"bwiki:0/01/tiqvwovlryiqeu617xr5a2hwcvufl9p.mp3","text":"我从凯尔希医生那里听到了，不只是听力，我的视力也在慢慢丧失......矿石病，究竟会把我变成什么样子呢？","alt":"voice_cn/char_180_amgoat/cn_008.mp3"},{"url":"bwiki:7/75/bljmml5ut8ypitygmyz91hoesis9ggw.mp3","text":"为什么能察觉到前辈站在我身后？那是因为我感受到了前辈的温度~虽然我的视力听力都变差了，但其他感官还很敏锐哦~即使变成现在这个样子，我呀，可没那么容易被打倒的~","alt":"voice_cn/char_180_amgoat/cn_009.mp3"}],"闲置":[{"url":"bwiki:6/69/n8wtv3ycjoimkibh3g0arf2tbiphal8.mp3","text":"前辈，睡着了呀......","alt":"voice_cn/char_180_amgoat/cn_010.mp3"}],"报到":[{"url":"bwiki:d/d7/ea23by0im4rfs12459e9yjczboue380.mp3","text":"我是艾雅法拉，加入罗德岛前一直在研究火山地质。因为矿石病的影响，我的听力不太好，也许，以后要多多麻烦您了，前辈~","alt":"voice_cn/char_180_amgoat/cn_011.mp3"}],"作战记录":[{"url":"bwiki:c/c2/62ylx3fm07rdxulmqa9mwz0kv99wgx1.mp3","text":"请您给予我更多的指导，前辈~","alt":"voice_cn/char_180_amgoat/cn_012.mp3"}],"精英化1":[{"url":"bwiki:a/a4/mfeydaefvgkjkkmns7s3uh4g47pg7sz.mp3","text":"晋升？是真的吗？能被前辈夸奖，真的好高兴！","alt":"voice_cn/char_180_amgoat/cn_013.mp3"}],"精英化2":[{"url":"bwiki:d/dc/pem7i6zyc1i6vzrw7xp5qd7d4yju6kx.mp3","text":"这些小羊是妈妈留给我的，前辈也觉得它们很可爱吧？欸？热——很烫？啊请等等，不戴隔热手套的话会被它们烫伤的！","alt":"voice_cn/char_180_amgoat/cn_014.mp3"}],"编入":[{"url":"bwiki:7/7b/2wjgrs69x4vx0br4cohlww2sxu69eip.mp3","text":"我知道了，前辈。","alt":"voice_cn/char_180_amgoat/cn_017.mp3"}],"任命队长":[{"url":"bwiki:f/f7/aq9cvcd0l1d0l52x0csyxg0bdw3titr.mp3","text":"除了武器，您也别忘记准备防灾用具哦~","alt":"voice_cn/char_180_amgoat/cn_018.mp3"}],"行动出发":[{"url":"bwiki:a/ad/m84h592jhevddahujel62v4lu9iu682.mp3","text":"前辈，我们能照顾好自己，您专注指挥就好。","alt":"voice_cn/char_180_amgoat/cn_019.mp3"}],"行动开始":[{"url":"bwiki:d/d6/ie6yfhuzc81omqakostkfvavbu1pwu2.mp3","text":"请大家一定要注意安全。","alt":"voice_cn/char_180_amgoat/cn_020.mp3"}],"选中":[{"url":"bwiki:d/d6/lpp4nbqqee6rfc08rx3xhm4abqrk1b3.mp3","text":"前辈？","alt":"voice_cn/char_180_amgoat/cn_021.mp3"},{"url":"bwiki:0/09/5npe6wubehabcn811oeltord4ofoam3.mp3","text":"前辈，请您吩咐。","alt":"voice_cn/char_180_amgoat/cn_022.mp3"}],"部署":[{"url":"bwiki:9/92/hejz3lmgkxdyn3wtuvf3nmd3x24ufxc.mp3","text":"我会小心行动的。","alt":"voice_cn/char_180_amgoat/cn_023.mp3"},{"url":"bwiki:7/78/dy4v1bkr03fq72vd7c21mf9xwcmug8s.mp3","text":"加油！","alt":"voice_cn/char_180_amgoat/cn_024.mp3"}],"技能":[{"url":"bwiki:4/4a/hhqg1x9bch696bha3oio9m8z02ywmn2.mp3","text":"温度稳定。","alt":"voice_cn/char_180_amgoat/cn_025.mp3"},{"url":"bwiki:d/d1/1l25xt4k8m7todoslj3yfmxggzdspqv.mp3","text":"可能有点热哦？","alt":"voice_cn/char_180_amgoat/cn_026.mp3"},{"url":"bwiki:d/d8/t246emziwtc4zn0yxc42wdbzi0rg1jg.mp3","text":"请小心火灾。","alt":"voice_cn/char_180_amgoat/cn_027.mp3"},{"url":"bwiki:8/88/mu2uitdp85itqvkz4blanudsh1fkxdw.mp3","text":"这招怎么样！","alt":"voice_cn/char_180_amgoat/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:7/73/kvqgathgo4marqes0gwk200fchkd86b.mp3","text":"前辈平安无事吗？太好了......","alt":"voice_cn/char_180_amgoat/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:d/d7/nacthulpl7fugde9lad1g9zrqvph4dt.mp3","text":"为什么要这样彼此争斗不休呢......","alt":"voice_cn/char_180_amgoat/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:f/f8/pw6nn2zoi697b94v7ck642ssu8l3vvb.mp3","text":"大家都没事吧？有什么我能做的吗？","alt":"voice_cn/char_180_amgoat/cn_031.mp3"}],"失败":[{"url":"bwiki:f/f4/im9y3h4h8lfbvehqp2jv4sgfrujbbk6.mp3","text":"呜......没、没事的......","alt":"voice_cn/char_180_amgoat/cn_032.mp3"}],"进驻":[{"url":"bwiki:0/02/2z7j5n1ifhsrgpd03ccppct6zorxiif.mp3","text":"这个房间让我很安心~","alt":"voice_cn/char_180_amgoat/cn_033.mp3"}],"戳一下":[{"url":"bwiki:7/7c/c16yh69l93enxndmhrmsn63euc6zmya.mp3","text":"呀！别、别吓我，前辈！","alt":"voice_cn/char_180_amgoat/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:7/71/ij4bjghib4h2b29ijdvshvexk3bw3m9.mp3","text":"谢谢前辈不断地指引我的成长~","alt":"voice_cn/char_180_amgoat/cn_036.mp3"}],"标题":[{"url":"bwiki:f/f3/63sx0ybms4roj46tb0kiehaf9fmlb5o.mp3","text":"明日方舟。","alt":"voice_cn/char_180_amgoat/cn_037.mp3"}],"新年":[{"url":"bwiki:4/4a/ooaqksiu5sttx18ypmbh3y7fl0qm71k.mp3","text":"前辈，新年快乐！大家都高高兴兴地在准备礼物和装饰呢，还有好多干员来和我说话。虽然有时候听不太清，但是看每个人脸上的表情，肯定都是些温暖的话吧，前辈，您也要接受这份温暖呀。","alt":"voice_cn/char_180_amgoat/cn_038.mp3"}],"问候":[{"url":"bwiki:2/25/p27o0k03qc7oxwlkbcwk0eez5q4g9er.mp3","text":"前辈，早上好~","alt":"voice_cn/char_180_amgoat/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:b/b3/4qsw3so4y2lo822m32jszpefnrjg9oq.mp3","text":"前辈，您借我的天灾研究笔记我都读完了，还有其他的吗？","alt":"voice/char_180_amgoat/cn_001.mp3"}],"交谈":[{"url":"bwiki:b/b6/cdxy7bo7m0cpzg8efbo9p1djqimy7ke.mp3","text":"您说什么？为什么？为什么要叫您前辈？啊，因为您是天灾研究的专家呀，按照规矩一定要叫前辈的~","alt":"voice/char_180_amgoat/cn_002.mp3"},{"url":"bwiki:a/ab/mduptme4hag7pxg785g3f3cbu4qnbzv.mp3","text":"那个，原——什么？啊，是问我听力恶化的原因？其实，是我以前在火山地带做考察的时候，不小心感染了矿石病的缘故......","alt":"voice/char_180_amgoat/cn_003.mp3"},{"url":"bwiki:2/2c/shvx30uh64i25wv0ux841tfauml1wgs.mp3","text":"除了完成前辈您安排的工作，我还要抽空去凯尔希医生那里做检查。医生说，我的病症似乎是比较严重的那种......","alt":"voice/char_180_amgoat/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:2/23/4kuu9xb6h86z60zd5c091g1s4nqpit0.mp3","text":"为了完成父母的研究，我还得更努力才行。如果我能证明他们的研究是有意义的，说不定，将会有一个影响世界的大发现呢。","alt":"voice/char_180_amgoat/cn_005.mp3"},{"url":"bwiki:1/16/aw2t9gylrpixnvzg9fhqxjsknyitwfl.mp3","text":"我的父母......已经去世了，他们在火山周边进行观测时遭遇了火山碎屑流......我必须继承父母的遗志，完成他们的学说，无论如何都要......","alt":"voice/char_180_amgoat/cn_006.mp3"}],"信赖":[{"url":"bwiki:0/00/2htso3y6xx2dnz7jesobipw6pngv7a1.mp3","text":"玩伴吗？我和慕斯她们关系很好，所以一点也不寂寞~如果可以的话，我想和大家一起办读书会！嗯，就在前辈您的办公室，可以吗？","alt":"voice/char_180_amgoat/cn_007.mp3"},{"url":"bwiki:2/27/f2z7hzxpj5hrba57bptrkwxridhws9k.mp3","text":"我从凯尔希医生那里听到了，不只是听力，我的视力也在慢慢丧失......矿石病，究竟会把我变成什么样子呢？","alt":"voice/char_180_amgoat/cn_008.mp3"},{"url":"bwiki:b/b5/eeazvehha7zruqv2nz884kv9utm6asq.mp3","text":"为什么能察觉到前辈站在我身后？那是因为我感受到了前辈的温度~虽然我的视力听力都变差了，但其他感官还很敏锐哦~即使变成现在这个样子，我呀，可没那么容易被打倒的~","alt":"voice/char_180_amgoat/cn_009.mp3"}],"闲置":[{"url":"bwiki:f/fd/4goip8zk9259ruzlxrj3fo6ojrzxd0f.mp3","text":"前辈，睡着了呀......","alt":"voice/char_180_amgoat/cn_010.mp3"}],"报到":[{"url":"bwiki:3/3c/3c8z8r70hkul6d0omwfi6onlax9vwqj.mp3","text":"我是艾雅法拉，加入罗德岛前一直在研究火山地质。因为矿石病的影响，我的听力不太好，也许，以后要多多麻烦您了，前辈~","alt":"voice/char_180_amgoat/cn_011.mp3"}],"作战记录":[{"url":"bwiki:1/14/ixppnm68v66lkw3a6cf1qd9leqf10u4.mp3","text":"请您给予我更多的指导，前辈~","alt":"voice/char_180_amgoat/cn_012.mp3"}],"精英化1":[{"url":"bwiki:0/0e/qo998cbl9wp6zattdlm32m1d6a79rtr.mp3","text":"晋升？是真的吗？能被前辈夸奖，真的好高兴！","alt":"voice/char_180_amgoat/cn_013.mp3"}],"精英化2":[{"url":"bwiki:f/f7/sfinz6lk47ycmhktwb49zlriltj4b84.mp3","text":"这些小羊是妈妈留给我的，前辈也觉得它们很可爱吧？欸？热——很烫？啊请等等，不戴隔热手套的话会被它们烫伤的！","alt":"voice/char_180_amgoat/cn_014.mp3"}],"编入":[{"url":"bwiki:0/02/9s2z7nawmbthi87ggyycibm5g3zcfxn.mp3","text":"我知道了，前辈。","alt":"voice/char_180_amgoat/cn_017.mp3"}],"任命队长":[{"url":"bwiki:2/2d/j27jk9cv654sni53om7znmt93nezi78.mp3","text":"除了武器，您也别忘记准备防灾用具哦~","alt":"voice/char_180_amgoat/cn_018.mp3"}],"行动出发":[{"url":"bwiki:a/a7/8i79ovnst183302qnwyz1v0h42xxab7.mp3","text":"前辈，我们能照顾好自己，您专注指挥就好。","alt":"voice/char_180_amgoat/cn_019.mp3"}],"行动开始":[{"url":"bwiki:3/39/dlvtke252mybo6r0cm3ggw2onsqub5h.mp3","text":"请大家一定要注意安全。","alt":"voice/char_180_amgoat/cn_020.mp3"}],"选中":[{"url":"bwiki:8/83/rf0bnfqj20my1pk3hxyu8cgyk4dmjex.mp3","text":"前辈？","alt":"voice/char_180_amgoat/cn_021.mp3"},{"url":"bwiki:3/36/51lox06xx8qlmwcpjjecf17qfitls7r.mp3","text":"前辈，请您吩咐。","alt":"voice/char_180_amgoat/cn_022.mp3"}],"部署":[{"url":"bwiki:e/e8/8thsw8rx77rmi9uunn0b2l0pf9nxrau.mp3","text":"我会小心行动的。","alt":"voice/char_180_amgoat/cn_023.mp3"},{"url":"bwiki:d/dd/bh426ip2sn6rz987lmhy1lx6eusqpq0.mp3","text":"加油！","alt":"voice/char_180_amgoat/cn_024.mp3"}],"技能":[{"url":"bwiki:d/de/kgzx1mkdfs71p7n7fbky3emtnlgttzb.mp3","text":"温度稳定。","alt":"voice/char_180_amgoat/cn_025.mp3"},{"url":"bwiki:b/bd/rqvsyt4yb6gm1h7sdpeviqdjrfrfpks.mp3","text":"可能有点热哦？","alt":"voice/char_180_amgoat/cn_026.mp3"},{"url":"bwiki:2/2d/9i3a6rdggz9sxu2lup62nh7l8g2f3ag.mp3","text":"请小心火灾。","alt":"voice/char_180_amgoat/cn_027.mp3"},{"url":"bwiki:0/03/ni5eqtm040bk3o8vs3jtm58fux375z2.mp3","text":"这招怎么样！","alt":"voice/char_180_amgoat/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:f/f2/6gve0tgt0jg3272k9fbky4k7ewyndwi.mp3","text":"前辈平安无事吗？太好了......","alt":"voice/char_180_amgoat/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:d/d2/jfd8wcv5hbkxxgrap5bu7312at9c8r7.mp3","text":"为什么要这样彼此争斗不休呢......","alt":"voice/char_180_amgoat/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:f/ff/omdnt9mhi15kqjwvub038hffrc8n3er.mp3","text":"大家都没事吧？有什么我能做的吗？","alt":"voice/char_180_amgoat/cn_031.mp3"}],"失败":[{"url":"bwiki:2/2f/jmzk8n5dbo7xdanm5jn6rzq1dc3kgtq.mp3","text":"呜......没、没事的......","alt":"voice/char_180_amgoat/cn_032.mp3"}],"进驻":[{"url":"bwiki:2/2e/imkiv1799fkkiav45j7d18qoalhog6k.mp3","text":"这个房间让我很安心~","alt":"voice/char_180_amgoat/cn_033.mp3"}],"戳一下":[{"url":"bwiki:c/cd/9nrnztdl9nm5f3cyddxjkxkpagpxgvv.mp3","text":"呀！别、别吓我，前辈！","alt":"voice/char_180_amgoat/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:c/c1/o1y0a3asfx3c1xpfqroii2ijcavacy5.mp3","text":"谢谢前辈不断地指引我的成长~","alt":"voice/char_180_amgoat/cn_036.mp3"}],"标题":[{"url":"bwiki:3/38/796tq08dzxgvpajpmag19bb0lvt93tg.mp3","text":"明日方舟。","alt":"voice/char_180_amgoat/cn_037.mp3"}],"新年":[{"url":"bwiki:c/c6/ffck96obwvt02p7snta93jjjq1i91hk.mp3","text":"前辈，新年快乐！大家都高高兴兴地在准备礼物和装饰呢，还有好多干员来和我说话。虽然有时候听不太清，但是看每个人脸上的表情，肯定都是些温暖的话吧，前辈，您也要接受这份温暖呀。","alt":"voice/char_180_amgoat/cn_038.mp3"}],"问候":[{"url":"bwiki:7/74/rejz6wwt8r5v1pktn7vsv657kh11n85.mp3","text":"前辈，早上好~","alt":"voice/char_180_amgoat/cn_042.mp3"}]}}