{"中文":{"登录":[{"url":"bwiki:4/42/2ttv888u4lsh04ocnbh57psmhilyxyx.mp3","text":"博士，今天我来担当您的护卫！放心，不会让可疑的人接近您的！","alt":"voice_cn/char_122_beagle/cn_001.mp3"}],"交谈":[{"url":"bwiki:b/b1/lpdgbjigsftfr4e0bidpcnxrk8mbnvs.mp3","text":"我今天的训练成绩单......吗？呃，那个，您还是别看啦......","alt":"voice_cn/char_122_beagle/cn_002.mp3"},{"url":"bwiki:6/6a/jnwmn4etn3v4266v1pwjnuno6nfvjpj.mp3","text":"每次战斗前我总是紧张得不得了，害得芬队长也要为我捏一把汗......我该怎么办好呢？博士&gt;&lt;！","alt":"voice_cn/char_122_beagle/cn_003.mp3"},{"url":"bwiki:b/b1/rwhic7q63f0futcbpmfbadz87nidgro.mp3","text":"芙蓉和炎熔总是来找我抱怨对方，可她们都是我的好朋友，各自的说法也都很有道理......博士，我该怎么办才好啊......？","alt":"voice_cn/char_122_beagle/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:9/99/mrdzergt6pr36t1nbpejhnr08nog7fj.mp3","text":"杜宾老师总是教育我们——“就算新人期结束，实战中也要以保命为优先“——这样的话。呜~不甘心，什么时候才能变成她那样帅气又强大的人呢？","alt":"voice_cn/char_122_beagle/cn_005.mp3"}],"信赖":[{"url":"bwiki:e/ee/t764a0juj6vgfyt0mu74rzhezaobgy7.mp3","text":"作为干员我还是新人，不过我也正在努力不是吗？嘿嘿，如果您也觉得我有进步，希望您能多多夸奖我一下......","alt":"voice_cn/char_122_beagle/cn_007.mp3"},{"url":"bwiki:f/f8/70jmx4ukfwnyoq7rwder5hupjy1ze4d.mp3","text":"矿石病吗？已经不是很在意了，因为感觉和以前也没有多大的区别嘛~不过果然还是，希望和大家永远在一起，在病痊愈之前，一直在一起......呜......","alt":"voice_cn/char_122_beagle/cn_008.mp3"},{"url":"bwiki:1/17/3ucnoq2idb2pybeqkw6gze85lwurev3.mp3","text":"其实来这里之前，我对自己是没什么自信的......但是现在我能做到保护博士和大家了，真的很高兴！能保护所有人是我的梦想！所以，我也希望，如果这样的日子能一直持续下去就好了。","alt":"voice_cn/char_122_beagle/cn_009.mp3"}],"闲置":[{"url":"bwiki:4/47/japq9mjx5qko0x2b12kcghzxk9x4ud0.mp3","text":"......好想在睡着的博士脸上恶作剧啊。","alt":"voice_cn/char_122_beagle/cn_010.mp3"}],"报到":[{"url":"bwiki:3/36/tqvugctpy5knmb0bbf4eksapefqd0xp.mp3","text":"我是米格鲁！虽然，招募评定的成绩不太理想，但就算作为实习生我也会努力帮忙的！","alt":"voice_cn/char_122_beagle/cn_011.mp3"}],"作战记录":[{"url":"bwiki:2/2d/7wbi5cthcx7bm239zosbupdkkgern1g.mp3","text":"做到了！我变得更强啦！","alt":"voice_cn/char_122_beagle/cn_012.mp3"}],"精英化1":[{"url":"bwiki:3/32/lltuong68e0vmbexy56934xhfagczy0.mp3","text":"这样、这样的话！就不会被人喊“宇宙级新人！”啦！","alt":"voice_cn/char_122_beagle/cn_013.mp3"}],"编入":[{"url":"bwiki:4/41/e0c5cvmsn4y1axhsrq5gbxdn1xny5la.mp3","text":"我会加油的！","alt":"voice_cn/char_122_beagle/cn_017.mp3"}],"任命队长":[{"url":"bwiki:b/b6/jckgwdd8h7okcaswjgwa7jcjxzv2pf6.mp3","text":"欸，我是队长？不是芬做队长真的好吗？","alt":"voice_cn/char_122_beagle/cn_018.mp3"}],"行动出发":[{"url":"bwiki:a/a1/stug0u62uqnm4bfc1raw56i3g22o99w.mp3","text":"各位，出发了！","alt":"voice_cn/char_122_beagle/cn_019.mp3"}],"行动开始":[{"url":"bwiki:3/38/12jgzde1mfi5yiajgsptiat5lpzmchm.mp3","text":"各位，敌人来了哟！","alt":"voice_cn/char_122_beagle/cn_020.mp3"}],"选中":[{"url":"bwiki:5/54/rsu7qaxjvn190vgyr9eqixgssy9nt55.mp3","text":"请给我勇气！","alt":"voice_cn/char_122_beagle/cn_021.mp3"},{"url":"bwiki:e/ec/lni3b2c7dmd9o2xlwcn3e7fgj91ko00.mp3","text":"要我上吗？","alt":"voice_cn/char_122_beagle/cn_022.mp3"}],"部署":[{"url":"bwiki:7/7c/3gx582jm90nsd065msxtjdordnygjod.mp3","text":"抵达目标地点了！","alt":"voice_cn/char_122_beagle/cn_023.mp3"},{"url":"bwiki:f/f1/hxi9jzkh7ecda2br805i3nzv5ehjbo8.mp3","text":"就是这里！","alt":"voice_cn/char_122_beagle/cn_024.mp3"}],"技能":[{"url":"bwiki:5/5a/kv1t96qxdb9zwq2d76hdgs23u8dyjyk.mp3","text":"哈~！","alt":"voice_cn/char_122_beagle/cn_025.mp3"},{"url":"bwiki:c/ce/kt7ldosbzvdg8xbf9hvhbe8pa4daa78.mp3","text":"看我~的！","alt":"voice_cn/char_122_beagle/cn_026.mp3"}],"高难胜利":[{"url":"bwiki:9/9b/r2lysmrju3gtwf6p9b0xpzb7kuvkfnk.mp3","text":"保护大家是我的使命！不管有什么困难，这个信念都不会动摇！","alt":"voice_cn/char_122_beagle/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:a/a4/l1eabrqquc76oijy3x312gnskt8vti1.mp3","text":"敌人一个不漏的全都击溃了！罗德岛的各位是最棒的！","alt":"voice_cn/char_122_beagle/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:c/cf/fbndsbvcdablahb57y03fbgqxyyog4m.mp3","text":"赢了赢了！不过，还是稍稍放走了几个敌人，欸嘿嘿......","alt":"voice_cn/char_122_beagle/cn_031.mp3"}],"失败":[{"url":"bwiki:1/1f/4965ewu574cwh4cem6ig6da5kegjyqj.mp3","text":"对不起......对不起......","alt":"voice_cn/char_122_beagle/cn_032.mp3"}],"进驻":[{"url":"bwiki:e/e4/nmg1xz1rg46rxhnr4elxt601uigkwy6.mp3","text":"我能帮你什么忙吗？","alt":"voice_cn/char_122_beagle/cn_033.mp3"}],"戳一下":[{"url":"bwiki:3/30/gmt2wdh79pqvx02yo7oc9odia6zdyff.mp3","text":"博士！很、很痒的！","alt":"voice_cn/char_122_beagle/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:4/4f/8n9ldr7xw856uw59s92zr5ewz3gi2to.mp3","text":"博士，我可以每天都去您那里学习吗？","alt":"voice_cn/char_122_beagle/cn_036.mp3"}],"标题":[{"url":"bwiki:0/00/ol40lmvew81c1i38g5r4xzmxizeir28.mp3","text":"明日方舟。","alt":"voice_cn/char_122_beagle/cn_037.mp3"}],"新年":[{"url":"bwiki:3/3b/jkzgqg6ku90tnr6u2cqto9megrf30d1.mp3","text":"新年快乐！博士，今天是假期对吧！那应该，是可以不用训练的吧......可是我刚刚看到，杜宾教官还有好几个前辈都在训练场，我是不是也应该去呢......","alt":"voice_cn/char_122_beagle/cn_038.mp3"}],"问候":[{"url":"bwiki:b/b3/7kxza8e9lgljpwb8y6ruztn5d7c6xx9.mp3","text":"你好呀，博士。","alt":"voice_cn/char_122_beagle/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:0/0c/m11vgqrg1d3s8aavp9sts2rpy1j0zs6.mp3","text":"博士，今天我来担当您的护卫！放心，不会让可疑的人接近您的！","alt":"voice/char_122_beagle/cn_001.mp3"}],"交谈":[{"url":"bwiki:4/49/2ze86h252ecz88f1t0r84ss7gy2h4aa.mp3","text":"我今天的训练成绩单......吗？呃，那个，您还是别看啦......","alt":"voice/char_122_beagle/cn_002.mp3"},{"url":"bwiki:c/cf/h59i494dlr50xs4imlrv221w5gsx2oq.mp3","text":"每次战斗前我总是紧张得不得了，害得芬队长也要为我捏一把汗......我该怎么办好呢？博士&gt;&lt;！","alt":"voice/char_122_beagle/cn_003.mp3"},{"url":"bwiki:e/e5/5acsuxn0qn3kokz51nf7nmf6cx84pgi.mp3","text":"芙蓉和炎熔总是来找我抱怨对方，可她们都是我的好朋友，各自的说法也都很有道理......博士，我该怎么办才好啊......？","alt":"voice/char_122_beagle/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:5/58/7538ksmja0pl8jdtttsghjrzfskjtga.mp3","text":"杜宾老师总是教育我们——“就算新人期结束，实战中也要以保命为优先“——这样的话。呜~不甘心，什么时候才能变成她那样帅气又强大的人呢？","alt":"voice/char_122_beagle/cn_005.mp3"}],"信赖":[{"url":"bwiki:c/cc/ktijjjux7v3cgepxn6lu5x7ier4vnnx.mp3","text":"作为干员我还是新人，不过我也正在努力不是吗？嘿嘿，如果您也觉得我有进步，希望您能多多夸奖我一下......","alt":"voice/char_122_beagle/cn_007.mp3"},{"url":"bwiki:3/3f/cboi5006xrdb4npm4emndgz2ya5puxn.mp3","text":"矿石病吗？已经不是很在意了，因为感觉和以前也没有多大的区别嘛~不过果然还是，希望和大家永远在一起，在病痊愈之前，一直在一起......呜......","alt":"voice/char_122_beagle/cn_008.mp3"},{"url":"bwiki:e/e3/qlqidcqm590amuu3ap1mmbod0t76irl.mp3","text":"其实来这里之前，我对自己是没什么自信的......但是现在我能做到保护博士和大家了，真的很高兴！能保护所有人是我的梦想！所以，我也希望，如果这样的日子能一直持续下去就好了。","alt":"voice/char_122_beagle/cn_009.mp3"}],"闲置":[{"url":"bwiki:8/89/57g9o1qy2srrq1noxyx