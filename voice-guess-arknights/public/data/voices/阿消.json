{"中文":{"登录":[{"url":"bwiki:b/bd/gn63lf27uho3n3r5wshf3sqpvuhkkkf.mp3","text":"已经准备好为您服务了，长官！","alt":"voice_cn/char_277_sqrrel/cn_001.mp3"}],"交谈":[{"url":"bwiki:c/c7/1sgiepm895thheqhmkbx2x0nm4xha9j.mp3","text":"为了安全起见，正在为您确认逃生路线和消防设备，请稍等片刻！","alt":"voice_cn/char_277_sqrrel/cn_002.mp3"},{"url":"bwiki:e/e7/8lbgenrbfyqw2grfcvanqepmsu41ovf.mp3","text":"过道内严禁烟火，请各位干员不要在走道吸烟，谢谢配合！","alt":"voice_cn/char_277_sqrrel/cn_003.mp3"},{"url":"bwiki:6/6e/3cjrc0tsnusxe6a00vhyflc8cmwlav0.mp3","text":"为大家科普消防知识也是我职责的一部分就先从您开始吧长官！","alt":"voice_cn/char_277_sqrrel/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:c/c7/elpwkpwskgpwl1z3egia4s502i7rece.mp3","text":"别看我个子小，有些任务可是只有我才能完成的。","alt":"voice_cn/char_277_sqrrel/cn_005.mp3"},{"url":"bwiki:0/04/j9e7xlemjt5c1vw2xo0nfa6a0u85hli.mp3","text":"长官，我很紧张，其实......我不擅长说话......谢谢您......的关心！","alt":"voice_cn/char_277_sqrrel/cn_006.mp3"}],"信赖":[{"url":"bwiki:f/f4/5udt0b5j6uo167inh2beq59rehlxdx6.mp3","text":"有时候，我一张嘴说话就停不下来，长官我会被讨厌吗......呜......","alt":"voice_cn/char_277_sqrrel/cn_007.mp3"},{"url":"bwiki:3/3d/iyg2iqvfjlwnkkul2c19vibrlylx5d1.mp3","text":"长官，帮我，换下灯泡......我，够不着......啊，亮了。","alt":"voice_cn/char_277_sqrrel/cn_008.mp3"},{"url":"bwiki:9/91/le7ih8kfpjb2gela60ccnukot090svc.mp3","text":"长官，她她她们又开始在房间里烧烤了，您快帮忙制止一下哎呀呀呀！谁把我的灭火器换成伊芙利特的喷火背包了啊啊啊啊！长官您没事吧！","alt":"voice_cn/char_277_sqrrel/cn_009.mp3"}],"闲置":[{"url":"bwiki:d/de/0f84fs58a0xfzw7gqvg8dgph7iwpj5l.mp3","text":"还有几分钟休息时间就结束了，长官您稍微注意一下。","alt":"voice_cn/char_277_sqrrel/cn_010.mp3"}],"报到":[{"url":"bwiki:e/ee/axjxk1x2iwo0ncpm0vq8vgaypuglh2l.mp3","text":"博士长官您好，龙门消防署警员阿消向您报到！","alt":"voice_cn/char_277_sqrrel/cn_011.mp3"}],"作战记录":[{"url":"bwiki:1/1d/iys8qybcnaofs99ci0ljo5qlraia7d9.mp3","text":"演习录像也是训练的一部分吗？","alt":"voice_cn/char_277_sqrrel/cn_012.mp3"}],"精英化1":[{"url":"bwiki:d/d2/53lpuexyayf392mhoukgo156s32p892.mp3","text":"多谢您的提拔，长官！","alt":"voice_cn/char_277_sqrrel/cn_013.mp3"}],"精英化2":[{"url":"bwiki:1/1c/ix25yndgyy1ey35mst3x3j5p69lzpj7.mp3","text":"这是...勋章?嗯，我会......加油的，为了大家，也为了您。","alt":"voice_cn/char_277_sqrrel/cn_014.mp3"}],"编入":[{"url":"bwiki:5/50/0u19h03fgd15w2npcv14s72atbbomjt.mp3","text":"准备就绪。","alt":"voice_cn/char_277_sqrrel/cn_017.mp3"}],"任命队长":[{"url":"bwiki:e/eb/ish9v62tiq8b7v6ka5tnq7shsnefp4b.mp3","text":"听我指挥。","alt":"voice_cn/char_277_sqrrel/cn_018.mp3"}],"行动出发":[{"url":"bwiki:3/36/sz916poejaikv2ajm6evcivdto72ayg.mp3","text":"出勤！","alt":"voice_cn/char_277_sqrrel/cn_019.mp3"}],"行动开始":[{"url":"bwiki:6/6d/q361spbi7ue1p4scifwinfxz6rr7gdf.mp3","text":"火来了，大家快做准备！","alt":"voice_cn/char_277_sqrrel/cn_020.mp3"}],"选中":[{"url":"bwiki:6/63/9o5qrks226sg0bbrzdi4a9kuky69c3d.mp3","text":"在！","alt":"voice_cn/char_277_sqrrel/cn_021.mp3"},{"url":"bwiki:7/78/jrjk4ziifwv0oqhesc4bdgqskiez7qo.mp3","text":"了解！","alt":"voice_cn/char_277_sqrrel/cn_022.mp3"}],"部署":[{"url":"bwiki:a/af/dal8pkavgwp8ylmf9eqs660sqwt72fv.mp3","text":"唔唔。","alt":"voice_cn/char_277_sqrrel/cn_023.mp3"},{"url":"bwiki:a/a7/e418kgukx9rk1mbh31g3i2341zcf241.mp3","text":"哼。","alt":"voice_cn/char_277_sqrrel/cn_024.mp3"}],"技能":[{"url":"bwiki:f/f0/pkomh5tgtvzjm0vnrtwz5xu4j6s0dfi.mp3","text":"嘿呀！","alt":"voice_cn/char_277_sqrrel/cn_025.mp3"},{"url":"bwiki:c/cb/i7f0ot1suddd5uns9tkrrhpty81w1p4.mp3","text":"走开走开！","alt":"voice_cn/char_277_sqrrel/cn_026.mp3"},{"url":"bwiki:5/51/psomya3hdk6innf5rvif1t46wjt67gs.mp3","text":"灭火器喷射！","alt":"voice_cn/char_277_sqrrel/cn_027.mp3"},{"url":"bwiki:c/c1/b3oypx77f8bqfeb8okla0x0jz3v06lz.mp3","text":"根据消防守则，你这是违禁行为！","alt":"voice_cn/char_277_sqrrel/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:c/cf/ntl72uygf2v9ntqxxri5hxwyfuq7e1n.mp3","text":"这样规模的火灾，也只有靠长官和大家一起努力才能消灭的了。","alt":"voice_cn/char_277_sqrrel/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:c/c2/tijf3d78pbzohiv71796999vqtel2yl.mp3","text":"大火已经完全扑灭了，随时可以收队。","alt":"voice_cn/char_277_sqrrel/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:3/34/jt9d0apcmdqou8lwd5n4q1gbq71wkqd.mp3","text":"火情已经基本得到控制了！需要我进行善后处理吗。","alt":"voice_cn/char_277_sqrrel/cn_031.mp3"}],"失败":[{"url":"bwiki:e/ef/j39o9uh3331vpk7vn5yvkydaswo832p.mp3","text":"糟，糟糕......大火烧过来了！","alt":"v