{"中文":{"登录":[{"url":"bwiki:9/9a/2mhmsjyz29yf0rh692umiojqksxf3qe.mp3","text":"要我帮忙是没问题啦，之后可得好好回报我哦。","alt":"voice_cn/char_275_breeze/cn_001.mp3"}],"交谈":[{"url":"bwiki:8/84/29jzc1etlvrcf6dkjpzvjq3l88f37b2.mp3","text":"维娜......不，推进之王小姐她总给我一种说不出的感觉，是为什么呢......？","alt":"voice_cn/char_275_breeze/cn_002.mp3"},{"url":"bwiki:4/4f/9c526s5n263m2fw5qtwpw0m0op2hx3q.mp3","text":"我的老爹？哎呀，明知道我是离家出走来到这里的，却还要这么问吗？莫非博士你其实很不擅长聊天？","alt":"voice_cn/char_275_breeze/cn_003.mp3"},{"url":"bwiki:f/f4/sui34oqjcdabpwqffjwvd66sytcshma.mp3","text":"博士，请务必品尝一下我的料理......有草药的味道？哎、哎呀，我怎么会用博士您做实验呢？哈哈......","alt":"voice_cn/char_275_breeze/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:e/e2/gpjqimbetz780co0r1ky8vrdp1vfmda.mp3","text":"我曾觉得老爹他们麻木、迂腐，所以独自离开那里，寻找新的生活，走了很远，经历了很多，却反而理解了老爹他们。欸哈哈，搞什么嘛。","alt":"voice_cn/char_275_breeze/cn_005.mp3"},{"url":"bwiki:5/5b/ip74d7a11cxqdtk9yvhu5pfmk6av3cr.mp3","text":"博士，你看见那朵离散的云了吗？那是我家乡的方向。","alt":"voice_cn/char_275_breeze/cn_006.mp3"}],"信赖":[{"url":"bwiki:d/d6/kvg6n7p27jojpjw7db9e7d7fvyyu0is.mp3","text":"“信仰”是一个有趣的话题，我没有机会前往拉特兰，却没想到能从罗德岛干员口中听到拉特兰的种种事迹，不过是位过于......呃、活泼的姐姐呢，拉特兰原来是这样的地方吗？","alt":"voice_cn/char_275_breeze/cn_007.mp3"},{"url":"bwiki:f/f3/6rvvuyibxz6b7xn50yzyrwzx6ya27u3.mp3","text":"多伦郡的航船需要灯塔才能回到港湾，罗德岛将是我最后旅程的避风港。至于博士你嘛，勉强凑合着吧......所以请一定要做到，我没有做到的事。","alt":"voice_cn/char_275_breeze/cn_008.mp3"},{"url":"bwiki:6/65/bq3zv84ts9pinuvk49ukb7ohp4jmir7.mp3","text":"此时此地，便是格蕾丝·亚利桑那的信仰所在，博士博士，我将对您的希望虔诚，生死不渝。","alt":"voice_cn/char_275_breeze/cn_009.mp3"}],"闲置":[{"url":"bwiki:9/95/20mcqpbxxw8r4ehmienr0g5jupc0uhb.mp3","text":"......是在梦中彷徨的表情呢。感到不安吗，博士。","alt":"voice_cn/char_275_breeze/cn_010.mp3"}],"报到":[{"url":"bwiki:2/21/n3ddujne57vl7eo3xaenhjrfehz51gv.mp3","text":"微风，来自多伦郡的游学者，很荣幸见到您，博士。正式的礼仪太麻烦了，所以就免了吧。","alt":"voice_cn/char_275_breeze/cn_011.mp3"}],"作战记录":[{"url":"bwiki:2/2d/smb4uaucgebr0ueywu366ssli53jw8a.mp3","text":"......令人惊叹的医疗技艺，不愧是罗德岛。","alt":"voice_cn/char_275_breeze/cn_012.mp3"}],"精英化1":[{"url":"bwiki:6/6d/hfkq2q8dko1cvn919j5iwycep3voiom.mp3","text":"为您的恩赐献上由衷的祝福，博士。唔？真是失礼的反应，这可是正经的吻手礼，动作快点啦！","alt":"voice_cn/char_275_breeze/cn_013.mp3"}],"精英化2":[{"url":"bwiki:b/b2/gognewbh1tsfzuvx9ko0n8gb9m1erdy.mp3","text":"哎呀，这次可不会像上次那么正式咯，难道你在期待着吗？我会将我的一切奉献给罗德岛，这是超过形式的觉悟哦。","alt":"voice_cn/char_275_breeze/cn_014.mp3"}],"编入":[{"url":"bwiki:b/bc/4ykpnva2xbs13dqnm87te8p1f14yb0s.mp3","text":"医护工作就交给我吧。","alt":"voice_cn/char_275_breeze/cn_017.mp3"}],"任命队长":[{"url":"bwiki:5/5e/7tvs7ipszwzd38wnbo1r6dnm43w2uiw.mp3","text":"感谢您的信任，我会以干员们的安全为第一优先考虑。","alt":"voice_cn/char_275_breeze/cn_018.mp3"}],"行动出发":[{"url":"bwiki:b/b1/ahpb80wnefnlwm38zn3g7sld6k1s7g4.mp3","text":"起风了......","alt":"voice_cn/char_275_breeze/cn_019.mp3"}],"行动开始":[{"url":"bwiki:4/4e/asuslpergz48yn86zppls3vu5qld9a1.mp3","text":"伤害别人的恶党，没有祈求饶恕的权利。","alt":"voice_cn/char_275_breeze/cn_020.mp3"}],"选中":[{"url":"bwiki:d/de/e50fyglv7qgb3u83jctw60ny1xsg7o1.mp3","text":"在。","alt":"voice_cn/char_275_breeze/cn_021.mp3"},{"url":"bwiki:d/d4/ovtidwvb9dsk7vi9luwk8szey8hl69h.mp3","text":"请指示。","alt":"voice_cn/char_275_breeze/cn_022.mp3"}],"部署":[{"url":"bwiki:5/50/olcd2wesjupy4nl0ka2vh6123i4tdcn.mp3","text":"速战速决。","alt":"voice_cn/char_275_breeze/cn_023.mp3"},{"url":"bwiki:f/f7/0o4b3vzurkmo4odbgvhpcrx8d7d8cdd.mp3","text":"注意保护自己。","alt":"voice_cn/char_275_breeze/cn_024.mp3"}],"技能":[{"url":"bwiki:2/2e/b4cuecxq3ejau4ru7f4p2zdp6nroyxl.mp3","text":"悼词回响！","alt":"voice_cn/char_275_breeze/cn_025.mp3"},{"url":"bwiki:8/8e/g9d3uwkxca0b00ekbyyegb23cddsrpq.mp3","text":"风唱挽歌......","alt":"voice_cn/char_275_breeze/cn_026.mp3"},{"url":"bwiki:e/e1/14yrx5zwi33434180e7xpmu1je9gwr0.mp3","text":"意志！","alt":"voice_cn/char_275_breeze/cn_027.mp3"}],"高难胜利":[{"url":"bwiki:d/d0/qbr41cryh3igxfu04cr8stzynq5tbyp.mp3","text":"诸位，胜利属于我们。","alt":"voice_cn/char_275_breeze/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:0/0d/171m7ulugkdfq1z4rr6qqzp830ooh2i.mp3","text":"每一次胜利都将成为火种，生生不息。","alt":"voice_cn/char_275_breeze/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:8/86/9bfrgqy3rngovjm3hm1iu1rkwxa9qrl.mp3","text":"请不要麻痹大意，风向显露着不安。","alt":"voice_cn/char_275_breeze/cn_031.mp3"}],"失败":[{"url":"bwiki:f/fe/kgbtp3x8lbqboz4aaserhhpnbm1vntb.mp3","text":"为什么总是执着于伤害他人......","alt":"voice_cn/char_275_breeze/cn_032.mp3"}],"进驻":[{"url":"bwiki:e/e5/sjmzuq4qrf3bbqstczaw7pue9ocil4l.mp3","text":"真是别具一格的设施呢。","alt":"voice_cn/char_275_breeze/cn_033.mp3"}],"戳一下":[{"url":"bwiki:c/cd/94fqzry08iho1nmb0niww8ruy0pyxxn.mp3","text":"等，等下！","alt":"voice_cn/char_275_breeze/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:5/56/4w2p552ubna4g3oqd5qwx3ipd6ihpe5.mp3","text":"博士，想听听我家乡的故事吗？","alt":"voice_cn/char_275_breeze/cn_036.mp3"}],"标题":[{"url":"bwiki:2/20/o48urgyytthu6zkr0n059et88b2virr.mp3","text":"明日方舟。","alt":"voice_cn/char_275_breeze/cn_037.mp3"}],"新年":[{"url":"bwiki:3/3f/kfxlxihnl1zmovltkhyxswdnihwql2r.mp3","text":"新年快乐，博士。不知不觉又过去一年了，这是我离家的第几年了呢......等等，不要用那副表情摸我的头，我没有想家！","alt":"voice_cn/char_275_breeze/cn_038.mp3"}],"问候":[{"url":"bwiki:6/6f/g31dyi9osik6m5pkgg6381097a57gf0.mp3","text":"您好，博士。","alt":"voice_cn/char_275_breeze/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:b/b6/bcwa3y7dqvvsuxr6sfw099hov0o50d4.mp3","text":"要我帮忙是没问题啦，之后可得好好回报我哦。","alt":"voice/char_275_breeze/cn_001.mp3"}],"交谈":[{"url":"bwiki:b/b4/s2da4nng3isy7ltmkmt1syhmtnpsx41.mp3","text":"维娜......不，推进之王小姐她总给我一种说不出的感觉，是为什么呢......？","alt":"voice/char_275_breeze/cn_002.mp3"},{"url":"bwiki:2/22/36xg9pb78zv8lxiw9aze4ml8jh4gm4m.mp3","text":"我的老爹？哎呀，明知道我是离家出走来到这里的，却还要这么问吗？莫非博士你其实很不擅长聊天？","alt":"voice/char_275_breeze/cn_003.mp3"},{"url":"bwiki:4/4c/l7k83x252kg08v11zrr13uolr11kwqb.mp3","text":"博士，请务必品尝一下我的料理......有草药的味道？哎、哎呀，我怎么会用博士您做实验呢？哈哈......","alt":"voice/char_275_breeze/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:3/3f/fobg6eb8jjg1jjhyee47nglesl7kdu5.mp3","text":"我曾觉得老爹他们麻木、迂腐，所以独自离开那里，寻找新的生活，走了很远，经历了很多，却反而理解了老爹他们。欸哈哈，搞什么嘛。","alt":"voice/char_275_breeze/cn_005.mp3"},{"url":"bwiki:6/6a/7whkrypjjm4n9asekjfto03ahnqlfdk.mp3","text":"博士，你看见那朵离散的云了吗？那是我家乡的方向。","alt":"voice/char_275_breeze/cn_006.mp3"}],"信赖":[{"url":"bwiki:e/e9/e0o8cf4t2gzu2e6do10n82duyf5iytl.mp3","text":"“信仰”是一个有趣的话题，我没有机会前往拉特兰，却没想到能从罗德岛干员口中听到拉特兰的种种事迹，不过是位过于......呃、活泼的姐姐呢，拉特兰原来是这样的地方吗？","alt":"voice/char_275_breeze/cn_007.mp3"},{"url":"bwiki:e/e8/h93z7mqxql4mdzk1ewj5z2igno7abwf.mp3","text":"多伦郡的航船需要灯塔才能回到港湾，罗德岛将是我最后旅程的避风港。至于博士你嘛，勉强凑合着吧......所以请一定要做到，我没有做到的事。","alt":"voice/char_275_breeze/cn_008.mp3"},{"url":"bwiki:9/90/02s1an4yt131cy0obnjlvx23bxu251x.mp3","text":"此时此地，便是格蕾丝·亚利桑那的信仰所在，博士博士，我将对您的希望虔诚，生死不渝。","alt":"voice/char_275_breeze/cn_009.mp3"}],"闲置":[{"url":"bwiki:8/83/f0fwhmc2aujoxy0mbk53bivnxfwkwfs.mp3","text":"......是在梦中彷徨的表情呢。感到不安吗，博士。","alt":"voice/char_275_breeze/cn_010.mp3"}],"报到":[{"url":"bwiki:7/72/apua9j2z1mjdeq7nt8wn34oaztw7bpq.mp3","text":"微风，来自多伦郡的游学者，很荣幸见到您，博士。正式的礼仪太麻烦了，所以就免了吧。","alt":"voice/char_275_breeze/cn_011.mp3"}],"作战记录":[{"url":"bwiki:1/16/0219ogbm78rsrz0awfysy8cqo3g00cg.mp3","text":"......令人惊叹的医疗技艺，不愧是罗德岛。","alt":"voice/char_275_breeze/cn_012.mp3"}],"精英化1":[{"url":"bwiki:c/cf/j8pu4oqkp9wls6ia9rvs5u2882vq8ge.mp3","text":"为您的恩赐献上由衷的祝福，博士。唔？真是失礼的反应，这可是正经的吻手礼，动作快点啦！","alt":"voice/char_275_breeze/cn_013.mp3"}],"精英化2":[{"url":"bwiki:c/cd/5l9n6s2ra7e6i3bwvfxwwdfw46wjha1.mp3","text":"哎呀，这次可不会像上次那么正式咯，难道你在期待着吗？我会将我的一切奉献给罗德岛，这是超过形式的觉悟哦。","alt":"voice/char_275_breeze/cn_014.mp3"}],"编入":[{"url":"bwiki:7/76/e0iqlxswujthoi1s8gkcu6mz7z6dqrx.mp3","text":"医护工作就交给我吧。","alt":"voice/char_275_breeze/cn_017.mp3"}],"任命队长":[{"url":"bwiki:6/63/h3bnim6ggeurye2udwuw91pkej7zk40.mp3","text":"感谢您的信任，我会以干员们的安全为第一优先考虑。","alt":"voice/char_275_breeze/cn_018.mp3"}],"行动出发":[{"url":"bwiki:6/66/6s3421i7tfdfhunf0ayq6v22cg8vwkp.mp3","text":"起风了......","alt":"voice/char_275_breeze/cn_019.mp3"}],"行动开始":[{"url":"bwiki:d/d0/is7yz7bp82hircuc0jg6j2o286ki3hy.mp3","text":"伤害别人的恶党，没有祈求饶恕的权利。","alt":"voice/char_275_breeze/cn_020.mp3"}],"选中":[{"url":"bwiki:7/7a/etm9drbpq52qqqclioc9qg2rknwjty3.mp3","text":"在。","alt":"voice/char_275_breeze/cn_021.mp3"},{"url":"bwiki:0/0f/m6f3s49k15o23q4usemy5wbg8mmy6nl.mp3","text":"请指示。","alt":"voice/char_275_breeze/cn_022.mp3"}],"部署":[{"url":"bwiki:9/9b/2ihr4b63a87sdzuz39xnzbv2fejbmvh.mp3","t