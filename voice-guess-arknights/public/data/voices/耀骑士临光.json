u7ryent91iff45sx9.mp3","text":"先前的宿舍还为我留着吗？谢谢，麻烦你们了。","alt":"voice/char_1014_nearl2/cn_033.mp3"}],"戳一下":[{"url":"bwiki:b/b6/flbm96hvqelxrb1j9cvsilh0yz3j1c2.mp3","text":"哈......只是在玩闹吗，博士......","alt":"voice/char_1014_nearl2/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:d/d1/gbh2r0sgf5x3mxu32kiientkzyy1m2m.mp3","text":"能再一次触碰到您的藏书，真是奇妙的感觉。这一本，可以借给玛莉娅看看吗？","alt":"voice/char_1014_nearl2/cn_036.mp3"}],"标题":[{"url":"bwiki:0/07/qw38y1fl4xwdnrwjbk6snmxj0uvqmbg.mp3","text":"明日方舟。","alt":"voice/char_1014_nearl2/cn_037.mp3"}],"新年":[{"url":"bwiki:c/c8/qbuew3wzsb7zxrj7tcdsbv6xx29futm.mp3","text":"我出现在这里令您意外？是啊，文书事务总会堆积在案头。但在时针开启新的一年的这一刻，我还是希望像这样坐在罗德岛的甲板上，看看仍未被灯火照亮的荒原。新年快乐，博士。","alt":"voice/char_1014_nearl2/cn_038.mp3"}],"问候":[{"url":"bwiki:7/78/npo6io3xrk5xdy626hj1pbnf37w3v61.mp3","text":"最近过得还好吗，博士？","alt":"voice/char_1014_nearl2/cn_042.mp3"}]}}