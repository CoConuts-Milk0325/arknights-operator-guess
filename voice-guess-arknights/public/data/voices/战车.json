{"中文":{"登录":[{"url":"bwiki:7/7f/7fff7dgiiwbedl2d7p6zse8570e0vbe.mp3","text":"你这里并不需要战术人员......我知道了，你是请我来聊天的。","alt":"voice/char_459_tachak/cn_001.mp3"}],"交谈":[{"url":"bwiki:b/b8/2vp8hwkribcjd8m98ldpzkf49ikiaks.mp3","text":"我热爱我的国家，以及它所给我带来的一切——无论那是好是坏。","alt":"voice/char_459_tachak/cn_002.mp3"},{"url":"bwiki:c/c6/32mu6u79eoeh2snw8s4rzymlot5flhy.mp3","text":"你还没见过我妹妹吧，看，照片上穿白大褂的就是她，旁边是她家的孩子。","alt":"voice/char_459_tachak/cn_003.mp3"},{"url":"bwiki:e/ec/crobnijoe6kuynqhj5o9inorqjnoppg.mp3","text":"好好活着，这样你才能当大家的领袖，千万别让爱你的人只能去墓地见你一面，明白吗？","alt":"voice/char_459_tachak/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:0/03/38i40ytn29q1sboz54rflxk6eduexaj.mp3","text":"我不希望我的孩子追随我的脚步，成为军人要吃的苦不是他们能够接受的。","alt":"voice/char_459_tachak/cn_005.mp3"},{"url":"bwiki:0/02/b7jnyqmhhq39g407idfqnfocos1cd3z.mp3","text":"倾泻火力简单而又有效，我们国家的人就喜欢这种方法。","alt":"voice/char_459_tachak/cn_006.mp3"}],"信赖":[{"url":"bwiki:2/2d/tcdfzfvvl7zyuxbchf26ed2y3709csf.mp3","text":"我喜欢你的思考模式。","alt":"voice/char_459_tachak/cn_007.mp3"},{"url":"bwiki:c/c5/c5my7wiuqja6pi7qe8gcqs0hwgkhoop.mp3","text":"我个人比较喜欢敌人自己冲过来找死，你呢？","alt":"voice/char_459_tachak/cn_008.mp3"},{"url":"bwiki:5/50/cvl43sr3773d2e760vh7czsf855zhnn.mp3","text":"放松点亲爱的，等完事了我请你喝伏特加。","alt":"voice/char_459_tachak/cn_009.mp3"}],"闲置":[{"url":"bwiki:3/37/7oboh6ed9la4zvzk9vwjihobmagcfap.mp3","text":"你很无聊吗，为什么不保养你的武器？","alt":"voice/char_459_tachak/cn_010.mp3"}],"报到":[{"url":"bwiki:1/15/nsje4vgm3o7kjp174uwba1hvu3xuwu8.mp3","text":"彩虹小队成员，代号战车。我准备好了，你将把我派去何方？","alt":"voice/char_459_tachak/cn_011.mp3"}],"作战记录":[{"url":"bwiki:c/ce/kahp9oe5p47bkzfdvis8twfk27a6jfs.mp3","text":"我们先是从中学习，再来就可以智胜他们。","alt":"voice/char_459_tachak/cn_012.mp3"}],"精英化1":[{"url":"bwiki:f/f8/hscji8h3mjgqbywbo01i9uil12i2sn6.mp3","text":"很好。","alt":"voice/char_459_tachak/cn_013.mp3"}],"精英化2":[{"url":"bwiki:3/3c/1xxe595x22jjwj0vya3iudy3t2frpc4.mp3","text":"他们当时说我要死了，他们错了，我重生了。","alt":"voice/char_459_tachak/cn_014.mp3"}],"编入":[{"url":"bwiki:0/01/5xz0059ml6k7tezvwwuigsdzed71gb4.mp3","text":"对，对，我懂的。","alt":"voice/char_459_tachak/cn_017.mp3"}],"任命队长":[{"url":"bwiki:e/e6/cwgp8598l4bjmi6744b9lf0g4ob2hpr.mp3","text":"千万别逞英雄，不会有用的。","alt":"voice/char_459_tachak/cn_018.mp3"}],"行动出发":[{"url":"bwiki:6/65/181sxqg9dnmqo5fc1fmvid7f3gwlpnz.mp3","text":"跟着我就对了！","alt":"voice/char_459_tachak/cn_019.mp3"}],"行动开始":[{"url":"bwiki:f/f4/re9q1fi1d5vygnhbz9xmih0yimhi2iv.mp3","text":"发现敌方。","alt":"voice/char_459_tachak/cn_020.mp3"}],"选中":[{"url":"bwiki:3/38/3o07ht6xq8ob95udrj8a3hdl12zulvy.mp3","text":"太好了，宝贝。","alt":"voice/char_459_tachak/cn_021.mp3"},{"url":"bwiki:9/9e/jeaeobz9fo7bbha8wre50wx3d11er0l.mp3","text":"让我们直接开工吧。","alt":"voice/char_459_tachak/cn_022.mp3"}],"部署":[{"url":"bwiki:b/b0/9lchimapa2ag2l9pds9a8rsm62xnmyx.mp3","text":"各位，有我在你们真是太幸运了。","alt":"voice/char_459_tachak/cn_023.mp3"},{"url":"bwiki:8/84/11k1w4q3h3ob6thtizi29vvp5df80hl.mp3","text":"别担心！有战车在呢！","alt":"voice/char_459_tachak/cn_024.mp3"}],"技能":[{"url":"bwiki:c/c5/4ke71x3tgtafuf36gg746a2m3ul3q0g.mp3","text":"快来找战车吧，宝贝。","alt":"voice/char_459_tachak/cn_025.mp3"},{"url":"bwiki:a/a2/htoa4l7pheuh6absmzzhtyq2s00rivj.mp3","text":"可以大开杀戒了。","alt":"voice/char_459_tachak/cn_026.mp3"},{"url":"bwiki:8/8b/h4009azb8ygc8erwabfvd6dykfv0tpu.mp3","text":"部署好火力区域了。","alt":"voice/char_459_tachak/cn_027.mp3"},{"url":"bwiki:2/2c/o38t221dztcjwalv0uebcvxeizux6i6.mp3","text":"让他们自投罗网吧！","alt":"voice/char_459_tachak/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:a/a2/9mnhq9tj95snlx9pj01m8r4harucslu.mp3","text":"还真是没预料到。","alt":"voice/char_459_tachak/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:c/cf/jejmgyf5zo7oddo2zazgyafxpjmzn47.mp3","text":"我什么场面没见过。","alt":"voice/char_459_tachak/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:b/b7/s72q49xrjhkfnx8pyad1rocj3lipfil.mp3","text":"朋友，我们还没脱离险境呢。","alt":"voice/char_459_tachak/cn_031.mp3"}],"失败":[{"url":"bwiki:4/4c/et61tu8kl6cf2c07pod9qb1saa7j4e3.mp3","text":"保护博士！","alt":"voice/char_459_tachak/cn_032.mp3"}],"进驻":[{"url":"bwiki:c/ca/k9vb6pvl3zzh620w33tf89syrwu3pwo.mp3","text":"我没意见。","alt":"voice/char_459_tachak/cn_033.mp3"}],"戳一下":[{"url":"bwiki:f/f6/kpqib3v9hb4h2lr6ensrbq8ngst0tjf.mp3","text":"当心点，同志。","alt":"voice/char_459_tachak/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:2/2e/2a2tmfrvvakwqcl2dx4dlsq7lrxphbj.mp3","text":"如果你有需要，就叫我来帮忙。","alt":"voice/char_459_tachak/cn_036.mp3"}],"标题":[{"url":"bwiki:3/32/an11d3q3sikx3c8u6nn7sayj1khpq4e.mp3","text":"明日方舟。","alt":"voice/char_459_tachak/cn_037.mp3"}],"问候":[{"url":"bwiki:e/eb/hz8a53wmemrl6sbj9xrz98i0jlbb9h9.mp3","text":"有事？","alt":"voice/char_459_tachak/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:7/7f/7fff7dgiiwbedl2d7p6zse8570e0vbe.mp3","text":"你这里并不需要战术人员......我知道了，你是请我来聊天的。","alt":"voice/char_459_tachak/cn_001.mp3"}],"交谈":[{"url":"bwiki:b/b8/2vp8hwkribcjd8m98ldpzkf49ikiaks.mp3","text":"我热爱我的国家，以及它所给我带来的一切——无论那是好是坏。","alt":"voice/char_459_tachak/cn_002.mp3"},{"url":"bwiki:c/c6/32mu6u79eoeh2snw8s4rzymlot5flhy.mp3","text":"你还没见过我妹妹吧，看，照片上穿白大褂的就是她，旁边是她家的孩子。","alt":"voice/char_459_tachak/cn_003.mp3"},{"url":"bwiki:e/ec/crobnijoe6kuynqhj5o9inorqjnoppg.mp3","text":"好好活着，这样你才能当大家的领袖，千万别让爱你的人只能去墓地见你一面，明白吗？","alt":"voice/char_459_tachak/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:0/03/38i40ytn29q1sboz54rflxk6eduexaj.mp3","text":"我不希望我的孩子追随我的脚步，成为军人要吃的苦不是他们能够接受的。","alt":"voice/char_459_tachak/cn_005.mp3"},{"url":"bwiki:0/02/b7jnyqmhhq39g407idfqnfocos1cd3z.mp3","text":"倾泻火力简单而又有效，我们国家的人就喜欢这种方法。","alt":"voice/char_459_tachak/cn_006.mp3"}],"信赖":[{"url":"bwiki:2/2d/tcdfzfvvl7zyuxbchf26ed2y3709csf.mp3","text":"我喜欢你的思考模式。","alt":"voice/char_459_tachak/cn_007.mp3"},{"url":"bwiki:c/c5/c5my7wiuqja6pi7qe8gcqs0hwgkhoop.mp3","text":"我个人比较喜欢敌人自己冲过来找死，你呢？","alt":"voice/char_459_tachak/cn_008.mp3"},{"url":"bwiki:5/50/cvl43sr3773d2e760vh7czsf855zhnn.mp3","text":"放松点亲爱的，等完事了我请你喝伏特加。","alt":"voice/char_459_tachak/cn_009.mp3"}],"闲置":[{"url":"bwiki:3/37/7oboh6ed9la4zvzk9vwjihobmagcfap.mp3","text":"你很无聊吗，为什么不保养你的武器？","alt":"voice/char_459_tachak/cn_010.mp3"}],"报到":[{"url":"bwiki:1/15/nsje4vgm3o7kjp174uwba1hvu3xuwu8.mp3","text":"彩虹小队成员，代号战车。我准备好了，你将把我派去何方？","alt":"voice/char_459_tachak/cn