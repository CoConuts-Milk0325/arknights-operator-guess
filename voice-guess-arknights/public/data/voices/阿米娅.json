{"中文":{"登录":[{"url":"bwiki:f/f4/2gasd4u4qeqh6wqmjocnnmml15o36ck.mp3","text":"博士，您工作辛苦了。","alt":"voice_cn/char_002_amiya/cn_001.mp3"}],"交谈":[{"url":"bwiki:c/c8/jku4m3n5os8xzv8o7uwjy7bpjmj31uc.mp3","text":"凯尔希医生教导过我，工作的时候一定要保持全神贯注......嗯，全神贯注。","alt":"voice_cn/char_002_amiya/cn_002.mp3"},{"url":"bwiki:8/87/cf3m2xy7dihfhc5lmstepm8h5dexj4g.mp3","text":"罗德岛全舰正处于通常航行状态。博士，整理下航程信息吧？","alt":"voice_cn/char_002_amiya/cn_003.mp3"},{"url":"bwiki:6/6d/hjqzdcfi5kn6947qzamuhow735tz5km.mp3","text":"作为罗德岛的领导者我还有很多不成熟的地方，希望您能更多地为我指明前进的方向。","alt":"voice_cn/char_002_amiya/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:c/c2/4ztnxmb4e5c78mprsx8f5swz1cjh5jf.mp3","text":"虽然这可能是我一厢情愿的想法，但我希望罗德岛能成为大家的第二个故乡......","alt":"voice_cn/char_002_amiya/cn_005.mp3"},{"url":"bwiki:2/28/gpmm55mcet6gunklv9bijm22g8n2jz8.mp3","text":"我们失去了很多才走到今天。有时候我会问自己，这一切真的值得么....？","alt":"voice_cn/char_002_amiya/cn_006.mp3"}],"信赖":[{"url":"bwiki:c/ca/d25721q8474l8ov62tzwd1becotnv2g.mp3","text":"有时候，我会想起寒冷的家乡，那里就连空气中都弥漫着铜锈的味道。相比之下罗德岛是如此的温暖。所以，为了守护好这里，我必须更加努力才行。","alt":"voice_cn/char_002_amiya/cn_007.mp3"},{"url":"bwiki:5/5d/7mosc8qjvic4ahf2ewvsdjt92tw4x00.mp3","text":"嘿嘿，博士，悄悄告诉你一件事——我重新开始练小提琴了。","alt":"voice_cn/char_002_amiya/cn_008.mp3"},{"url":"bwiki:0/06/f75kqtq11hrixzber20ezy95c7k7o3j.mp3","text":"博士，我们的脚下，是一条漫长的道路......也许这是一次没有终点的旅行，但如果是和您一起，我觉得，非常幸福。","alt":"voice_cn/char_002_amiya/cn_009.mp3"}],"闲置":[{"url":"bwiki:a/a2/nr69e5ezlxusv7plbkhil95xmyuiryo.mp3","text":"博士，您还有许多事情需要处理。现在还不能休息哦。","alt":"voice_cn/char_002_amiya/cn_010.mp3"}],"报到":[{"url":"bwiki:c/c5/3dzsjahbcf1f4bazoui0o8o8ghwa93d.mp3","text":"博士，能再见到您......真是太好了。今后我们同行的路还很长，所以，请您多多关照！","alt":"voice_cn/char_002_amiya/cn_011.mp3"}],"作战记录":[{"url":"bwiki:8/83/9axpexebr17n3drnjxggs3jzi3k1obr.mp3","text":"原来是这样......博士，谢谢您！这些指导，真的很有帮助！","alt":"voice_cn/char_002_amiya/cn_012.mp3"}],"精英化1":[{"url":"bwiki:0/09/sxdzzvtq49g4hdq556gnt6k58z97008.mp3","text":"能再一次和您并肩作战真是太好了，博士！","alt":"voice_cn/char_002_amiya/cn_013.mp3"}],"精英化2":[{"url":"bwiki:4/43/so0rmxeekx9h608b30w5fo5ixge5hsn.mp3","text":"那一天所看到的光景，想要呐喊却无法发出声音的绝望......希望能把这些，永远藏在记忆的最深处......","alt":"voice_cn/char_002_amiya/cn_014.mp3"}],"编入":[{"url":"bwiki:3/31/qgqa6a0pq29ev301of1t9vjn70q3pqk.mp3","text":"嗯，我知道了。","alt":"voice_cn/char_002_amiya/cn_017.mp3"}],"任命队长":[{"url":"bwiki:7/7e/ognx0cm7ceq4y3zsaxk3omb5xz7meic.mp3","text":"我不会辜负大家的。","alt":"voice_cn/char_002_amiya/cn_018.mp3"}],"行动出发":[{"url":"bwiki:0/08/p7qe4ade6qqut648g92ostyh495ncyf.mp3","text":"行动开始！","alt":"voice_cn/char_002_amiya/cn_019.mp3"}],"行动开始":[{"url":"bwiki:5/5e/b0eglvyc33lkx1hswc32s4gmea68eys.mp3","text":"来了！大家，请做好战斗准备！","alt":"voice_cn/char_002_amiya/cn_020.mp3"}],"选中":[{"url":"bwiki:8/87/hdqprdfzo40voq0836nim0sxlz62b8h.mp3","text":"是。","alt":"voice_cn/char_002_amiya/cn_021.mp3"},{"url":"bwiki:d/d4/5bhav90qv85ev7nwjz0d5b1t356663v.mp3","text":"博士，我在这里。","alt":"voice_cn/char_002_amiya/cn_022.mp3"}],"部署":[{"url":"bwiki:9/96/ddt3tqz4ktn2k165zd18z5pe5qh1fh0.mp3","text":"我知道了！","alt":"voice_cn/char_002_amiya/cn_023.mp3"},{"url":"bwiki:3/32/p8xq540zmhm72vtneup5bqcx8ymudqm.mp3","text":"了解。","alt":"voice_cn/char_002_amiya/cn_024.mp3"}],"技能":[{"url":"bwiki:e/ed/gnj7gxvb648j4fzpa32ngamgxa5fkgc.mp3","text":"我知道你在想什么。","alt":"voice_cn/char_002_amiya/cn_025.mp3"},{"url":"bwiki:1/18/1oj2fqrucdxgvn0ftsevx7vt64g7qrh.mp3","text":"大家可都相信着我！","alt":"voice_cn/char_002_amiya/cn_026.mp3"},{"url":"bwiki:c/cd/pwii4wcxgt1778vh6i505iiw18ord34.mp3","text":"你们在害怕我？","alt":"voice_cn/char_002_amiya/cn_027.mp3"},{"url":"bwiki:2/22/qjyqdqjoezsygkuoy0d1393g4h1ka6j.mp3","text":"这个声音在......哭？","alt":"voice_cn/char_002_amiya/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:7/78/955a6ngwcahgya6phdodst6ynp7vhbe.mp3","text":"无论多么艰难的任务，只要有博士在，就一定能完成，我一直这样坚信着！","alt":"voice_cn/char_002_amiya/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:1/10/bjx77onvsqvq8xfvaagewujj0ied278.mp3","text":"即使是完美的胜利，大家也要保持警惕，不要太过放松哦！","alt":"voice_cn/char_002_amiya/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:7/71/r9ivwg5ckj4k35s0t4nz2i0u9rufe54.mp3","text":"博士，辛苦了！累了的话请休息一会儿吧。","alt":"voice_cn/char_002_amiya/cn_031.mp3"}],"失败":[{"url":"bwiki:c/c4/qn0c0d27d6dms92xvn4iyl0tep5hh2o.mp3","text":"我没事的......大家，请振作起来！","alt":"voice_cn/char_002_amiya/cn_032.mp3"}],"进驻":[{"url":"bwiki:9/97/hwpth29solmskvtwuw2033m99mf9fzy.mp3","text":"有什么想喝的吗，博士？","alt":"voice_cn/char_002_amiya/cn_033.mp3"}],"戳一下":[{"url":"bwiki:4/43/2x9iongwkhvomwcp023yn57f58yd738.mp3","text":"欸？博士？","alt":"voice_cn/char_002_amiya/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:3/3c/fdnn2xca012ep1vr9wyre3mo8pbv9wy.mp3","text":"欸嘿嘿......","alt":"voice_cn/char_002_amiya/cn_036.mp3"}],"标题":[{"url":"bwiki:d/db/c0n4leyxeqkng65p6ljdafrb9syupwi.mp3","text":"明日方舟。","alt":"voice_cn/char_002_amiya/cn_037.mp3"}],"新年":[{"url":"bwiki:b/be/ak4bmr4fhl68g26l8kt2l80ce72p5w3.mp3","text":"新年快乐，博士！今天请您休息一下......抱、抱歉，您已经工作半天了吗？我是不是来晚了一点？刚刚煌把我叫去量身高了......您是在开玩笑啊，太好了。","alt":"voice_cn/char_002_amiya/cn_038.mp3"}],"问候":[{"url":"bwiki:a/a8/36v8ntas3x6gdnlw81o7tjipuslq436.mp3","text":"欢迎回家，博士！","alt":"voice_cn/char_002_amiya/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:e/e6/k4k6n5z15ea87m9o9fzzyhien3rjwwg.mp3","text":"博士，您工作辛苦了。","alt":"voice/char_002_amiya/cn_001.mp3"}],"交谈":[{"url":"bwiki:c/c0/9um0j8ksku6xrgdam67atiyw9y37ngn.mp3","text":"凯尔希医生教导过我，工作的时候一定要保持全神贯注......嗯，全神贯注。","alt":"voice/char_002_amiya/cn_002.mp3"},{"url":"bwiki:9/9a/9gdm4de40hr53xm4zk9hvbx2cs5rc5h.mp3","text":"罗德岛全舰正处于通常航行状态。博士，整理下航程信息吧？","alt":"voice/char_002_amiya/cn_003.mp3"},{"url":"bwiki:2/20/728mvnl3koya0391zseuoe8f5mlbodq.mp3","text":"作为罗德岛的领导者我还有很多不成熟的地方，希望您能更多地为我指明前进的方向。","alt":"voice/char_002_amiya/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:c/c2/drdzrn7yoabjc2zjoylop0ije92ldxb.mp3","text":"虽然这可能是我一厢情愿的想法，但我希望罗德岛能成为大家的第二个故乡......","alt":"voice/char_002_amiya/cn_005.mp3"},{"url":"bwiki:a/a6/35jf7m36i1nl3cvfhui6epm6a7tocgr.mp3","text":"我们失去了很多才走到今天。有时候我会问自己，这一切真的值得么....？","alt":"voice/char_002_amiya/cn_006.mp3"}],"信赖":[{"url":"bwiki:c/cb/4wpbxg7itjcxtjns6wrzfeevf60xolj.mp3","text":"有时候，我会想起寒冷的家乡，那里就连空气中都弥漫着铜锈的味道。相比之下罗德岛是如此的温暖。所以，为了守护好这里，我必须更加努力才行。","alt":"voice/char_002_amiya/cn_007.mp3"},{"url":"bwiki:7/7f/fwpu1girjxnbkbj2ff8ai33ccr2zqky.mp3","text":"嘿嘿，博士，悄悄告诉你一件事——我重新开始练小提琴了。","alt":"voice/char_002_amiya/cn_008.mp3"},{"url":"bwiki:b/b4/nh1mmwjjsq9ffdrbfrjxdnok9wphrew.mp3","text":"博士，我们的脚下，是一条漫长的道路......也许这是一次没有终点的旅行，但如果是和您一起，我觉得，非常幸福。","alt":"voice/char_002_amiya/cn_009.mp3"}],"闲置":[{"url":"bwiki:7/73/2z9kc12ehe8vkmmj2zdpsvzua6y3iol.mp3","text":"博士，您还有许多事情需要处理。现在还不能休息哦。","alt":"voice/char_002_amiya/cn_010.mp3"}],"报到":[{"url":"bwiki:d/d0/swj1q02gdpauyxg17jfgsr31dlnnyg1.mp3","text":"博士，能再见到您......真是太好了。今后我们同行的路还很长，所以，请您多多关照！","alt":"voice/char_002_amiya/cn_011.mp3"}],"作战记录":[{"url":"bwiki:0/05/5s2hlshnei2yl0aw8eyf8xegcl6ldel.mp3","text":"原来是这样......博士，谢谢您！这些指导，真的很有帮助！","alt":"voice/char_002_amiya/cn_012.mp3"}],"精英化1":[{"url":"bwiki:d/df/s7wszqwbnhkm9fcrp380jsbkc0y5k3m.mp3","text":"能再一次和您并肩作战真是太好了，博士！","alt":"voice/char_002_amiya/cn_013.mp3"}],"精英化2":[{"url":"bwiki:d/d1/fjvfdvf9pg3npgaojq8kz1ci1pu3r4n.mp3","text":"那一天所看到的光景，想要呐喊却无法发出声音的绝望......希望能把这些，永远藏在记忆的最深处......","alt":"voice/char_002_amiya/cn_014.mp3"}],"编入":[{"url":"bwiki:8/8a/dlhsp76k3qe1ni1ejakmiygsv46qg5o.mp3","text":"嗯，我知道了。","alt":"voice/char_002_amiya/cn_017.mp3"}],"任命队长":[{"url":"bwiki:2/29/devym4i1pveogj7w545mghbiqahosws.mp3","text":"我不会辜负大家的。","alt":"voice/char_002_amiya/cn_018.mp3"}],"行动出发":[{"url":"bwiki:0/01/c6a0lvmwxzo8uzdbn5wcewbte9ek0qh.mp3","text":"行动开始！","alt":"voice/char_002_amiya/cn_019.mp3"}],"行动开始":[{"url":"bwiki:3/3b/0tr7jwb274hr172kjqxyejb6hh6kdyw.mp3","text":"来了！大家，请做好战斗准备！","alt":"voice/char_002_amiya/cn_020.mp3"}],"选中":[{"url":"bwiki:3/35/f759p4bui0f2tel2lrqe6zge6wiain4.mp3","text":"是。","alt":"voice/char_002_amiya/cn_021.mp3"},{"url":"bwiki:4/4b/j43p8qh3nmrj4ol3jf7va8hrddmo7cj.mp3","text":"博士，我在这里。","alt":"voice/char_002_amiya/cn_022.mp3"}],"部署":[{"url":"bwiki:e/e2/mi4l3ovmzvmvhpgd4rxbr8177x7dnis.mp3","text":"我知道了！","alt":"voice/char_002_amiya/cn_023.mp3"},{"url":"bwiki:2/24/idukz36jrup3a9ob0447yk1tnatg0ci.mp3","text":"了解。","alt":"voice/char_002_amiya/cn_024.mp3"}],"技能":[{"url":"bwiki:7/78/7ald3osmvi76ve60iw0pe8se1kcpi33.mp3","text":"我知道你在想什么。","alt":"voice/char_002_amiya/cn_025.mp3"},{"url":"bwiki:f/f5/sf8ezra36h9fyxnh64vdou2jlekp305.mp3","text":"大家可都相信着我！","alt":"voice/char_002_amiya/cn_026.mp3"},{"url":"bwiki:c/c9/2ss8opys04qr210677nh546k7vst2s6.mp3","text":"你们在害怕我？","alt":"voice/char_002_amiya/cn_027.mp3"},{"url":"bwiki:5/50/dez2chee9gajiz74428mcis2ffan47y.mp3","text":"这个声音在......哭？","alt":"voice/char_002_amiya/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:1/14/3l8pnq76dq3bfde5abip25bqm7zdjsv.mp3","text":"无论多么艰难的任务，只要有博士在，就一定能完成，我一直这样坚信着！","alt":"voice/char_002_amiya/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:c/c6/6l4ret8d7atcfqethlw75a07e9hd4kr.mp3","text":"即使是完美的胜利，大家也要保持警惕，不要太过放松哦！","alt":"voice/char_002_amiya/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:1/10/tfb8ofnp6r8tykc5s83jc4hb8s172le.mp3","text":"博士，辛苦了！累了的话请休息一会儿吧。","alt":"voice/char_002_amiya/cn_031.mp3"}],"失败":[{"url":"bwiki:2/26/3d9c2mxlbkla0bhub4p53nbs70q2w93.mp3","text":"我没事的......大家，请振作起来！","alt":"voice/char_002_amiya/cn_032.mp3"}],"进驻":[{"url":"bwiki:4/47/nd43ux8o4edqpg9s3l8p4pbzr7t1wsq.mp3","text":"有什么想喝的吗，博士？","alt":"voice/char_002_amiya/cn_033.mp3"}],"戳一下":[{"url":"bwiki:6/6c/atoijjffp0mz6f60lwjd5tsga4sb758.mp3","text":"欸？博士？","alt":"voice/char_002_amiya/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:6/6b/nyivpaujvjep5wa97jw4di5bmc3oe9e.mp3","text":"欸嘿嘿......","alt":"voice/char_002_amiya/cn_036.mp3"}],"标题":[{"url":"bwiki:d/dd/cf6rhieyix70ctvnrd4ayzx3szslyv8.mp3","text":"明日方舟。","alt":"voice/char_002_amiya/cn_037.mp3"}],"新年":[{"url":"bwiki:c/c2/jh6a63s5zmqbin6kcjf0ecn35wkjhgc.mp3","text":"新年快乐，博士！今天请您休息一下......抱、抱歉，您已经工作半天了吗？我是不是来晚了一点？刚刚煌把我叫去量身高了......您是在开玩笑啊，太好了。","alt":"voice/char_002_amiya/cn_038.mp3"}],"问候":[{"url":"bwiki:5/51/ayig2bsjdfnhwtcveaep0gzysp77nz9.mp3","text":"欢迎回家，博士！","alt":"voice/char_002_amiya/cn_042.mp3"}]}}