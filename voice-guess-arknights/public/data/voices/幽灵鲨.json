"bwiki:d/d8/3o9g4zmxkjing20phrklxnfwp40h3m6.mp3","text":"我来自深邃的海洋......","alt":"voice/char_143_ghost/cn_023.mp3"},{"url":"bwiki:a/a6/1vr7s63ba5bf5vh6tn7aiuyfbve435j.mp3","text":"是您唤醒了我。","alt":"voice/char_143_ghost/cn_024.mp3"}],"技能":[{"url":"bwiki:6/63/f4gk4hcq0cvts7qd2gr2blke1kf1dx0.mp3","text":"取悦我吧。","alt":"voice/char_143_ghost/cn_025.mp3"},{"url":"bwiki:4/41/nw6pukrletpxlr2mybv6t1bv3dnyziv.mp3","text":"回归深渊吧。","alt":"voice/char_143_ghost/cn_026.mp3"},{"url":"bwiki:b/bf/3eafzo6485dub52pelzv6l6b3sfno60.mp3","text":"没有价值的东西，我毫无兴趣。","alt":"voice/char_143_ghost/cn_027.mp3"},{"url":"bwiki:3/36/5dlp3jrqweo09wuzi21awl19d7ijneq.mp3","text":"不许逃走。","alt":"voice/char_143_ghost/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:3/3f/omdxlaopthi7ajzsz8ixze2zk1m5fss.mp3","text":"我战胜了您给予我的全部考验，您看到了吗？","alt":"voice/char_143_ghost/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:7/76/a3l9yout7u3dhd3d8hatd0ymgurrand.mp3","text":"请将迷失的灵魂们，引渡到安息之地吧。","alt":"voice/char_143_ghost/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:4/4f/cui1qx7j3uextkawznwi742imjtsl7h.mp3","text":"......谁都，别想逃走！","alt":"voice/char_143_ghost/cn_031.mp3"}],"失败":[{"url":"bwiki:e/eb/fex376bq4d1xyuurggee7jkj98dgsnp.mp3","text":"必须让他们偿还......必须......","alt":"voice/char_143_ghost/cn_032.mp3"}],"进驻":[{"url":"bwiki:b/bb/tlr5b6dyjt8r73don4ob07x7as8ez7s.mp3","text":"可以给我一个，看得见星星的房间吗？","alt":"voice/char_143_ghost/cn_033.mp3"}],"戳一下":[{"url":"bwiki:b/b8/ei8ypyqx6w8q5m1tcs2hk298k6t89cq.mp3","text":"呵呵......","alt":"voice/char_143_ghost/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:5/57/2nod7h2cfpmxqclkn4delc1qae6h2h5.mp3","text":"博士......你背后究竟是什么样的力量......使我这样欣喜若狂呢......","alt":"voice/char_143_ghost/cn_036.mp3"}],"标题":[{"url":"bwiki:2/20/ivkzyvraklt1d44vkq8po4xr89f5ch5.mp3","text":"明日方舟。","alt":"voice/char_143_ghost/cn_037.mp3"}],"新年":[{"url":"bwiki:6/6b/kocv5c94gnguz7e1gy2hedlqg56jtqs.mp3","text":"又一年过去了吗？啊，在海中度过的岁月太漫长了，我已经不记得上一次自己是怎么度过的了......不提这个，告诉我吧，博士，今天，您想和我一起在窗台旁，看星星吗？","alt":"voice/char_143_ghost/cn_038.mp3"}],"问候":[{"url":"bwiki:4/4b/dwed9owimtwszeczi10rir