{"中文":{"登录":[{"url":"bwiki:4/49/0vni621nhs6gkqr3yqje65ex6qudv3z.mp3","text":"博士，现在起由我担任你的护卫。","alt":"voice_cn/char_010_chen/cn_001.mp3"},{"url":"bwiki:5/52/pdy92eg34rzhzu72ncxdo5jxrchk6in.mp3","text":"博士，现在起由我担任你的护卫。","alt":"voice_custom/char_010_chen_cn_topolect/cn_001.mp3"}],"交谈":[{"url":"bwiki:f/f8/4wqqrb07ey28bqio9h9ce5d995icb6j.mp3","text":"我一直觉得你们罗德岛很可疑，现在也一样。","alt":"voice_cn/char_010_chen/cn_002.mp3"},{"url":"bwiki:a/a4/oqyciagnwdv036xurt5lusmqengjqbz.mp3","text":"你怎么还在盯着我看？你的工作呢？","alt":"voice_cn/char_010_chen/cn_003.mp3"},{"url":"bwiki:3/3e/f3s9zze3iigztt1xax819usux7z0o24.mp3","text":"哼。","alt":"voice_cn/char_010_chen/cn_004.mp3"},{"url":"bwiki:4/48/firzaprwaft3e2ay2ow99zyx8jn1obz.mp3","text":"我一直觉得你们罗德岛很可疑，现在也一样。","alt":"voice_custom/char_010_chen_cn_topolect/cn_002.mp3"},{"url":"bwiki:8/82/r59biqkk97cxlwtbeysm7dlghkxa6fw.mp3","text":"你怎么还在盯着我看？你的工作呢？","alt":"voice_custom/char_010_chen_cn_topolect/cn_003.mp3"},{"url":"bwiki:b/b7/9ffbyqhfsbwoae34ora6th9pi4f11g8.mp3","text":"哼。","alt":"voice_custom/char_010_chen_cn_topolect/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:9/93/a2uzr0meha1l2bdkv46r303aibpu84w.mp3","text":"龙门的大街小巷我都走过。码头、招牌、坡道，那些风景印在我的心上。我永远都不会忘记。","alt":"voice_cn/char_010_chen/cn_005.mp3"},{"url":"bwiki:f/fd/nhaw9rheifmuprpvm8hxwwy1csfv4kg.mp3","text":"周边地区的局势并不稳定，虽然我会时刻保持警戒，但你也不能疏忽大意。","alt":"voice_cn/char_010_chen/cn_006.mp3"},{"url":"bwiki:d/d8/919ynecp3r1mvlwbilq8n4q4mvyo0v9.mp3","text":"龙门的大街小巷我都走过。码头、招牌、坡道，那些风景印在我的心上。我永远都不会忘记。","alt":"voice_custom/char_010_chen_cn_topolect/cn_005.mp3"},{"url":"bwiki:5/5b/e265mbwthwg1rizes75ojx9cpoqkrjj.mp3","text":"周边地区的局势并不稳定，虽然我会时刻保持警戒，但你也不能疏忽大意。","alt":"voice_custom/char_010_chen_cn_topolect/cn_006.mp3"}],"信赖":[{"url":"bwiki:a/a5/1k3859sxf8f3p7coq7okfrzv0crof9i.mp3","text":"也许有一天我会得到那个人的认可，在那之前......","alt":"voice_cn/char_010_chen/cn_007.mp3"},{"url":"bwiki:2/2d/huczmrcz3x7gcns41qx79l1yjjeih11.mp3","text":"阿米娅深深信赖着你。看着你们两人站在一起，我偶尔也会觉得，如果我身边，也能有这样一个人......","alt":"voice_cn/char_010_chen/cn_008.mp3"},{"url":"bwiki:d/d8/n2av83ql3qpcuq87zlhkeyby60lr5u6.mp3","text":"我......我从没试过去毫无保留地相信一个人，即使是那个人也......","alt":"voice_cn/char_010_chen/cn_009.mp3"},{"url":"bwiki:1/1d/quiolluc0r33cir61hx36ovp82upczz.mp3","text":"也许有一天我会得到那个人的认可，在那之前......","alt":"voice_custom/char_010_chen_cn_topolect/cn_007.mp3"},{"url":"bwiki:9/90/pajc585vddu1n538xe2r3artx7l3k18.mp3","text":"阿米娅深深信赖着你。看着你们两人站在一起，我偶尔也会觉得，如果我身边，也能有这样一个人......","alt":"voice_custom/char_010_chen_cn_topolect/cn_008.mp3"},{"url":"bwiki:c/c6/hgat06d4sluzev4kk2698y96f6wjm3j.mp3","text":"我......我从没试过去毫无保留地相信一个人，即使是那个人也......","alt":"voice_custom/char_010_chen_cn_topolect/cn_009.mp3"}],"闲置":[{"url":"bwiki:2/29/f6008j6u86i32kyu2b22s0bpfqpyvhv.mp3","text":"博士？睡着了？哼，真没紧张感。","alt":"voice_cn/char_010_chen/cn_010.mp3"},{"url":"bwiki:9/97/pisuet2h9l3096rsrze2yivfb5l6p29.mp3","text":"博士？睡着了？哼，真没紧张感。","alt":"voice_custom/char_010_chen_cn_topolect/cn_010.mp3"}],"报到":[{"url":"bwiki:9/9d/rycj25oydl0f7e4g2vld5yr43vw2eey.mp3","text":"陈，龙门近卫局特别督察组组长。基于一些特殊原因，我要暂时留在这里一段时间。之前的合作中，我想我们已经彼此了解了，请马上带我去工作现场吧。","alt":"voice_cn/char_010_chen/cn_011.mp3"},{"url":"bwiki:0/0a/mkuqv52hjsb23uicw4vxnl1xo9exfkl.mp3","text":"陈，龙门近卫局特别督察组组长。基于一些特殊原因，我要暂时留在这里一段时间。之前的合作中，我想我们已经彼此了解了，请马上带我去工作现场吧。","alt":"voice_custom/char_010_chen_cn_topolect/cn_011.mp3"}],"作战记录":[{"url":"bwiki:4/4c/fff6ds3h71slgb13pn7ltjqehm3acau.mp3","text":"一切都是为了更好地执行任务。","alt":"voice_cn/char_010_chen/cn_012.mp3"},{"url":"bwiki:4/49/4cgr33gtr8vxfw96bxmkfq8qr2lziep.mp3","text":"一切都是为了更好地执行任务。","alt":"voice_custom/char_010_chen_cn_topolect/cn_012.mp3"}],"精英化1":[{"url":"bwiki:9/97/9wutg5k1w03e1d7261cqfmthvxlxeu5.mp3","text":"晋升？这种事对我来说并不陌生。","alt":"voice_cn/char_010_chen/cn_013.mp3"},{"url":"bwiki:6/64/alu5vp04mqxs1xx7z2vgcz7iokxwgu3.mp3","text":"晋升？这种事对我来说并不陌生。","alt":"voice_custom/char_010_chen_cn_topolect/cn_013.mp3"}],"精英化2":[{"url":"bwiki:6/6d/03aip992wrhcdjm3grpolglmx4ymq3s.mp3","text":"知道了。常规干员无法胜任的任务，全部交给我来处理。","alt":"voice_cn/char_010_chen/cn_014.mp3"},{"url":"bwiki:2/24/mbq313oqfmrhztg6wz18kmbybdx7hb4.mp3","text":"知道了。常规干员无法胜任的任务，全部交给我来处理。","alt":"voice_custom/char_010_chen_cn_topolect/cn_014.mp3"}],"编入":[{"url":"bwiki:2/20/sxm7sazxsofztvhrztfhwe4l3uli4po.mp3","text":"没问题。","alt":"voice_cn/char_010_chen/cn_017.mp3"},{"url":"bwiki:5/58/lbvqh5ib6ofti9bsue984hklhbedycm.mp3","text":"没问题。","alt":"voice_custom/char_010_chen_cn_topolect/cn_017.mp3"}],"任命队长":[{"url":"bwiki:a/a6/qa5qh578o775j4hix78qgyhb1uiw5qa.mp3","text":"各位，记住，只有相互配合，才能高效行动。","alt":"voice_cn/char_010_chen/cn_018.mp3"},{"url":"bwiki:d/d7/tq39vpapugb8aaznj72ou6ieuk0j6w9.mp3","text":"各位，记住，只有相互配合，才能高效行动。","alt":"voice_custom/char_010_chen_cn_topolect/cn_018.mp3"}],"行动出发":[{"url":"bwiki:9/90/5aatb8nduiorvf88yoa1scqrtnx0dqz.mp3","text":"全体人员，做好战斗准备。","alt":"voice_cn/char_010_chen/cn_019.mp3"},{"url":"bwiki:4/46/eu2u6dfr797mletzgffk639hympheq1.mp3","text":"全体人员，做好战斗准备。","alt":"voice_custom/char_010_chen_cn_topolect/cn_019.mp3"}],"行动开始":[{"url":"bwiki:d/d6/70miq38ome2s2dghf7ueqrbra7k0fa6.mp3","text":"准备好了吗？那么，一切按照计划进行。","alt":"voice_cn/char_010_chen/cn_020.mp3"},{"url":"bwiki:6/6c/h9xthebggmypbmt36107devf8rbyyjx.mp3","text":"准备好了吗？那么，一切按照计划进行。","alt":"voice_custom/char_010_chen_cn_topolect/cn_020.mp3"}],"选中":[{"url":"bwiki:2/20/qw2bg4lggtbdw7ucao1wbbd32sg5yol.mp3","text":"这里是陈。","alt":"voice_cn/char_010_chen/cn_021.mp3"},{"url":"bwiki:3/3a/cn28imfbyfq2lpsa28211q1ourg0km2.mp3","text":"我随时可以。","alt":"voice_cn/char_010_chen/cn_022.mp3"},{"url":"bwiki:e/ed/55ldig9dtutlxanl1go5j0vg1xpf308.mp3","text":"这里是陈。","alt":"voice_custom/char_010_chen_cn_topolect/cn_021.mp3"},{"url":"bwiki:5/50/mhuhag63zcttf5vb51mj5ii1z8mjb29.mp3","text":"我随时可以。","alt":"voice_custom/char_010_chen_cn_topolect/cn_022.mp3"}],"部署":[{"url":"bwiki:b/b2/7ts3bkm2ngfoulanjem0vpw01rzy2c0.mp3","text":"行动。","alt":"voice_cn/char_010_chen/cn_023.mp3"},{"url":"bwiki:0/08/cwqit0ebjjfhm10ri2a7upcq2zrvh8n.mp3","text":"快速解决他们。","alt":"voice_cn/char_010_chen/cn_024.mp3"},{"url":"bwiki:0/02/sc9ri0c2bxcmadol71f4mfw0mbakdki.mp3","text":"行动。","alt":"voice_custom/char_010_chen_cn_topolect/cn_023.mp3"},{"url":"bwiki:4/4c/7hca4lcmtznv6tsohgnu3k0nbcjcwui.mp3","text":"快速解决他们。","alt":"voice_custom/char_010_chen_cn_topolect/cn_024.mp3"}],"技能":[{"url":"bwiki:3/3f/qucd010hyovxrzxz3rgo2cuwxy00qvs.mp3","text":"斩！","alt":"voice_cn/char_010_chen/cn_025.mp3"},{"url":"bwiki:5/50/f4bha3dgn95pv0s1vy69hgbhyw9yand.mp3","text":"闪！","alt":"voice_cn/char_010_chen/cn_026.mp3"},{"url":"bwiki:d/d1/mc4e5pdycv9mawfvp7z268lzqvl84y7.mp3","text":"放下你的武器！","alt":"voice_cn/char_010_chen/cn_027.mp3"},{"url":"bwiki:f/fa/q3h1uobagywvu2sups5vpserw57r0cp.mp3","text":"不要逼我。","alt":"voice_cn/char_010_chen/cn_028.mp3"},{"url":"bwiki:4/42/ir9x40t2urhdalft5dxjeyvdksaqvj4.mp3","text":"斩！","alt":"voice_custom/char_010_chen_cn_topolect/cn_025.mp3"},{"url":"bwiki:3/3a/jtwp9808f8yokj16eosb161tfgqfdsr.mp3","text":"闪！","alt":"voice_custom/char_010_chen_cn_topolect/cn_026.mp3"},{"url":"bwiki:d/dd/3uwidr8f43nmeivwmex13zunxgtdxvz.mp3","text":"放下你的武器！","alt":"voice_custom/char_010_chen_cn_topolect/cn_027.mp3"},{"url":"bwiki:1/1c/4trq110mi8xv3lx9c2tia84c7evofpn.mp3","text":"不要逼我。","alt":"voice_custom/char_010_chen_cn_topolect/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:2/2e/3ec2tuof5wc27q7ylowf5453qh8z0g8.mp3","text":"罪恶绝不能被容忍，不管用什么办法我都要阻止你们。","alt":"voice_cn/char_010_chen/cn_029.mp3"},{"url":"bwiki:3/38/qs8pamwhxqlkk6pdzhlea0uc7tt9ni7.mp3","text":"罪恶绝不能被容忍，不管用什么办法我都要阻止你们。","alt":"voice_custom/char_010_chen_cn_topolect/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:4/40/igu3v5uxyx5izy27kvs6b3z8m4gpt5w.mp3","text":"是谁给了你们自信前来挑战我？","alt":"voice_cn/char_010_chen/cn_030.mp3"},{"url":"bwiki:e/ee/0ppiw0rs3bhomr7n71asoejnmrvrcwd.mp3","text":"是谁给了你们自信前来挑战我？","alt":"voice_custom/char_010_chen_cn_topolect/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:0/07/oii0xqoh98s4dtopuuyvqdqw7l7v0ix.mp3","text":"伤员请等待医疗队的救援。其他干员保持警戒。","alt":"voice_cn/char_010_chen/cn_031.mp3"},{"url":"bwiki:1/12/mznkyz8sj1eo2v4xq3gvatohhr2kfkd.mp3","text":"伤员请等待医疗队的救援。其他干员保持警戒。","alt":"voice_custom/char_010_chen_cn_topolect/cn_031.mp3"}],"失败":[{"url":"bwiki:f/fe/aygmamx9st6fh2a12igpymc4yxi0x65.mp3","text":"有序撤退，不要让队伍崩溃！","alt":"voice_cn/char_010_chen/cn_032.mp3"},{"url":"bwiki:b/b9/mzpbr0d9mh0rrprkh45n66ep8kyyz2j.mp3","text":"有序撤退，不要让队伍崩溃！","alt":"voice_custom/char_010_chen_cn_topolect/cn_032.mp3"}],"进驻":[{"url":"bwiki:c/ce/t0jeds2xh1504inz4q914ji87fmyaxe.mp3","text":"这就是罗德岛的内部设施？意外的宽敞嘛。","alt":"voice_cn/char_010_chen/cn_033.mp3"},{"url":"bwiki:f/f9/szh8w2wmmzuyvjqbwdbcc9nglos2de7.mp3","text":"这就是罗德岛的内部设施？意外的宽敞嘛。","alt":"voice_custom/char_010_chen_cn_topolect/cn_033.mp3"}],"戳一下":[{"url":"bwiki:7/79/hwdum7yleocu0q0dcsctrev4wr1pb2g.mp3","text":"喂！干什么呢！","alt":"voice_cn/char_010_chen/cn_034.mp3"},{"url":"bwiki:f/f1/44fac1c80d0mtd73hw4zaswyrwx195m.mp3","text":"喂！干什么呢！","alt":"voice_custom/char_010_chen_cn_topolect/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:6/61/t6wrf4102mrqhtqomkjfx4mewfyr9fa.mp3","text":"博士，你心情不错嘛，因为最近作战比较顺利？正巧，我也一样。","alt":"voice_cn/char_010_chen/cn_036.mp3"},{"url":"bwiki:e/e1/946gf84gt4c2sx7b76xisgryl3u7dqf.mp3","text":"博士，你心情不错嘛，因为最近作战比较顺利？正巧，我也一样。","alt":"voice_custom/char_010_chen_cn_topolect/cn_036.mp3"}],"标题":[{"url":"bwiki:8/82/f7ibtp8fxz4nuzgni1bfscpyg652er8.mp3","text":"明日方舟。","alt":"voice_cn/char_010_chen/cn_037.mp3"},{"url":"bwiki:c/ca/btxweozdf9glid28k0rfmrosu0e6k0f.mp3","text":"明日方舟。","alt":"voice_custom/char_010_chen_cn_topolect/cn_037.mp3"}],"新年":[{"url":"bwiki:7/7f/8yhf40tnrk9x5vgvstoqg71mquqwyg7.mp3","text":"博士，关于上次的报告——博士也还在工作吗？嗯，倒是在我的意料之外，毕竟外面已经闹成这样，我以为打开门就能看到一屋子正在庆祝的干员。新年快乐，好了，这是打印出的事件报告——","alt":"voice_cn/char_010_chen/cn_038.mp3"},{"url":"bwiki:0/0e/0f0xsmokzg2sixuxsn0cfbpismtm422.mp3","text":"博士，关于上次的报告——博士也还在工作吗？嗯，倒是在我的意料之外，毕竟外面已经闹成这样，我以为打开门就能看到一屋子正在庆祝的干员。新年快乐，好了，这是打印出的事件报告——","alt":"voice_custom/char_010_chen_cn_topolect/cn_038.mp3"}],"问候":[{"url":"bwiki:2/29/njiyuydp4a3y657j3z81soyp54io93p.mp3","text":"哦，是博士啊。","alt":"voice_cn/char_010_chen/cn_042.mp3"},{"url":"bwiki:c/ce/5jdcqmimo9u0mij8m5zg21fvtzm2f6o.mp3","text":"哦，是博士啊。","alt":"voice_custom/char_010_chen_cn_topolect/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:1/1f/aeq5l0ttw76sso2wbjidhnzx8vztifh.mp3","text":"博士，现在起由我担任你的护卫。","alt":"voice/char_010_chen/cn_001.mp3"}],"交谈":[{"url":"bwiki:3/38/b09g161a6ow15yulo1qzk31mbwxfam7.mp3","text":"我一直觉得你们罗德岛很可疑，现在也一样。","alt":"voice/char_010_chen/cn_002.mp3"},{"url":"bwiki:3/38/9ifmgdrjsuiybffbupkxw7kn9ubj7va.mp3","text":"你怎么还在盯着我看？你的工作呢？","alt":"voice/char_010_chen/cn_003.mp3"},{"url":"bwiki:f/fc/fmwf5z86tt0ool3ewrhfmep1r89t5ex.mp3","text":"哼。","alt":"voice/char_010_chen/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:f/fe/jbkk550g2xrw3s44mk8fdr8aodid7ux.mp3","text":"龙门的大街小巷我都走过。码头、招牌、坡道，那些风景印在我的心上。我永远都不会忘记。","alt":"voice/char_010_chen/cn_005.mp3"},{"url":"bwiki:e/e3/0jvtgzovbxeghyp0l4kolf02klz7ywl.mp3","text":"周边地区的局势并不稳定，虽然我会时刻保持警戒，但你也不能疏忽大意。","alt":"voice/char_010_chen/cn_006.mp3"}],"信赖":[{"url":"bwiki:f/f6/ivmxcg4a99c508jb1z88ou4gqayu4w4.mp3","text":"也许有一天我会得到那个人的认可，在那之前......","alt":"voice/char_010_chen/cn_007.mp3"},{"url":"bwiki:1/16/iy8ab52ryycilerf5qtrrcd6g1eqyfj.mp3","text":"阿米娅深深信赖着你。看着你们两人站在一起，我偶尔也会觉得，如果我身边，也能有这样一个人......","alt":"voice/char_010_chen/cn_008.mp3"},{"url":"bwiki:f/f8/f6n08q3jwoqnd5su4ghc8fuycgmaj3a.mp3","text":"我......我从没试过去毫无保留地相信一个人，即使是那个人也......","alt":"voice/char_010_chen/cn_009.mp3"}],"闲置":[{"url":"bwiki:5/53/5h3c7g0tu0y3fkht6hynmer4kiijv14.mp3","text":"博士？睡着了？哼，真没紧张感。","alt":"voice/char_010_chen/cn_010.mp3"}],"报到":[{"url":"bwiki:8/87/57810vsx7ve8egb2qufoolh0uipj07d.mp3","text":"陈，龙门近卫局特别督察组组长。基于一些特殊原因，我要暂时留在这里一段时间。之前的合作中，我想我们已经彼此了解了，请马上带我去工作现场吧。","alt":"voice/char_010_chen/cn_011.mp3"}],"作战记录":[{"url":"bwiki:b/b2/2xi076s5x02spb69hby72vj5nqhxqdp.mp3","text":"一切都是为了更好地执行任务。","alt":"voice/char_010_chen/cn_012.mp3"}],"精英化1":[{"url":"bwiki:a/a8/ip8d0gubb3hskvey9ru5y2rq8oepx52.mp3","text":"晋升？这种事对我来说并不陌生。","alt":"voice/char_010_chen/cn_013.mp3"}],"精英化2":[{"url":"bwiki:6/69/fif4s9bzhtntqejla5ulvdt9n9c73zi.mp3","text":"知道了。常规干员无法胜任的任务，全部交给我来处理。","alt":"voice/char_010_chen/cn_014.mp3"}],"编入":[{"url":"bwiki:a/ad/d47raefxy8z7u9n29ijxmgljglwcf22.mp3","text":"没问题。","alt":"voice/char_010_chen/cn_017.mp3"}],"任命队长":[{"url":"bwiki:4/43/nw9gaboavxeyy6kbg57pw1enbhrauub.mp3","text":"各位，记住，只有相互配合，才能高效行动。","alt":"voice/char_010_chen/cn_018.mp3"}],"行动出发":[{"url":"bwiki:2/22/mgemuxennatwf3fvfvxkc56mkn1qo1h.mp3","text":"全体人员，做好战斗准备。","alt":"voice/char_010_chen/cn_019.mp3"}],"行动开始":[{"url":"bwiki:3/3a/eyof91fsde8odb5yeijh88iggyu6ytv.mp3","text":"准备好了吗？那么，一切按照计划进行。","alt":"voice/char_010_chen/cn_020.mp3"}],"选中":[{"url":"bwiki:c/c2/9ln7v8v4pilxw1heixv1twbd4pled4j.mp3","text":"这里是陈。","alt":"voice/char_010_chen/cn_021.mp3"},{"url":"bwiki:9/9e/ihe5seoknnn1uxo0j7cko57ory69xh0.mp3","text":"我随时可以。","alt":"voice/char_010_chen/cn_022.mp3"}],"部署":[{"url":"bwiki:5/5d/ttik7cj0ichuykce0kh721dfrr8491i.mp3","text":"行动。","alt":"voice/char_010_chen/cn_023.mp3"},{"url":"bwiki:2/23/levrnwaet1430mc4upjump27z1qb837.mp3","text":"快速解决他们。","alt":"voice/char_010_chen/cn_024.mp3"}],"技能":[{"url":"bwiki:6/62/md5khkz5e4f8ecpip2lu1ys9iie6qnf.mp3","text":"斩！","alt":"voice/char_010_chen/cn_025.mp3"},{"url":"bwiki:2/26/ow7xcceam4dey1uel9opb8fre4cn7sy.mp3","text":"闪！","alt":"voice/char_010_chen/cn_026.mp3"},{"url":"bwiki:9/98/050k37sdhazkjnrkkxq60qzngfw581q.mp3","text":"放下你的武器！","alt":"voice/char_010_chen/cn_027.mp3"},{"url":"bwiki:2/27/cyljdwplgtdswkn7x1f2z24f5nwitg0.mp3","text":"不要逼我。","alt":"voice/char_010_chen/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:1/14/izovtc20bnlvchdgwpexir36dm5lo0c.mp3","text":"罪恶绝不能被容忍，不管用什么办法我都要阻止你们。","alt":"voice/char_010_chen/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:2/25/ovnoa4dk60yds9690vwweqfw0lkh8hu.mp3","text":"是谁给了你们自信前来挑战我？","alt":"voice/char_010_chen/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:2/29/mqgd69ia7wxim167m65l4xcycm6picr.mp3","text":"伤员请等待医疗队的救援。其他干员保持警戒。","alt":"voice/char_010_chen/cn_031.mp3"}],"失败":[{"url":"bwiki:0/0f/rix7c7yy75xcqgexto3sj5z98ow1tnt.mp3","text":"有序撤退，不要让队伍崩溃！","alt":"voice/char_010_chen/cn_032.mp3"}],"进驻":[{"url":"bwiki:7/70/ouc00oi9mkp4n91wl9b46wecd7471p0.mp3","text":"这就是罗德岛的内部设施？意外的宽敞嘛。","alt":"voice/char_010_chen/cn_033.mp3"}],"戳一下":[{"url":"bwiki:7/7e/cd5ranvhn5g8m6harozw76qtivupvto.mp3","text":"喂！干什么呢！","alt":"voice/char_010_chen/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:8/86/laanhzk83nna2jtwf1qelft1066gmu3.mp3","text":"博士，你心情不错嘛，因为最近作战比较顺利？正巧，我也一样。","alt":"voice/char_010_chen/cn_036.mp3"}],"标题":[{"url":"bwiki:5/57/6h6adguclje0b2igizw0lv56nlx8ype.mp3","text":"明日方舟。","alt":"voice/char_010_chen/cn_037.mp3"}],"新年":[{"url":"bwiki:3/3e/3p3cd6nivq2sik98w7zfza79z6wmo6r.mp3","text":"博士，关于上次的报告——博士也还在工作吗？嗯，倒是在我的意料之外，毕竟外面已经闹成这样，我以为打开门就能看到一屋子正在庆祝的干员。新年快乐，好了，这是打印出的事件报告——","alt":"voice/char_010_chen/cn_038.mp3"}],"问候":[{"url":"bwiki:0/0d/r5xftgq7fndwdkukls4h8dbljholkl6.mp3","text":"哦，是博士啊。","alt":"voice/char_010_chen/cn_042.mp3"}]}}