{"中文":{"登录":[{"url":"bwiki:3/3c/rtl1vrcdp2n7inmib3sxagce5ifnhcb.mp3","text":"护卫？......啧，我知道了。","alt":"voice_cn/char_356_broca/cn_001.mp3"}],"交谈":[{"url":"bwiki:8/86/f1rjs29rbls2xjcky74lwfqqmnjf0z1.mp3","text":"那个叫阿米娅的小女孩也是这里的领导者？罗德岛到底是什么黑心公司。","alt":"voice_cn/char_356_broca/cn_002.mp3"},{"url":"bwiki:9/9f/p50z409xpj0rzsgs8ur1skc85j3qnd8.mp3","text":"我不喜欢吃白食，有什么体力活需要我，可以找我。","alt":"voice_cn/char_356_broca/cn_003.mp3"},{"url":"bwiki:a/a6/n257rarkj3hv9ztpv908po4vvv2prp2.mp3","text":"我不讨厌被命令，但我讨厌不知道自己在为什么战斗的感觉。","alt":"voice_cn/char_356_broca/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:3/30/3musjuwfqafuqtecb0p594f0vyzhj4b.mp3","text":"兴趣？为什么我要告诉你？......啧，别用那种眼神看我，告诉你行了吧，我喜欢自己做各种改造。","alt":"voice_cn/char_356_broca/cn_005.mp3"},{"url":"bwiki:f/fa/ke9z2cmbhnwxhq2fb0069ohpi7eyje9.mp3","text":"如果没有贾维和奥斯塔，我已经死在那天那条小巷子里了。所以，我这条命是他们的，无论他们想做什么，我都会帮他们。","alt":"voice_cn/char_356_broca/cn_006.mp3"}],"信赖":[{"url":"bwiki:e/e2/py1qptrr0zaybp0lrunrncki5zwkkth.mp3","text":"我不讨厌你，但我......无法完全信任你。","alt":"voice_cn/char_356_broca/cn_007.mp3"},{"url":"bwiki:e/e7/2iwzzxxfnmzu5esv0dnqx2y2lqf56o6.mp3","text":"好好做事，好好赚钱，好好生活，曾经，我的想法就这么简单......不过，奥斯塔说得对，在叙拉古这个地方，这样的想法，应该叫梦想。","alt":"voice_cn/char_356_broca/cn_008.mp3"},{"url":"bwiki:4/4f/p2wo20jrp2iejk9bhcpp3li36k39uwr.mp3","text":"我承认，你这家伙作为领导者来说还可以......但是，奥斯塔说过，一个组织的腐化，有时候就是从掉以轻心的时候开始的，我会盯紧你。","alt":"voice_cn/char_356_broca/cn_009.mp3"}],"闲置":[{"url":"bwiki:e/e0/qkzq63vzkrtdvdoarg7d52oiugcezs5.mp3","text":"睡着了吗，真是悠哉的家伙。啧，毯子放哪儿去了......","alt":"voice_cn/char_356_broca/cn_010.mp3"}],"报到":[{"url":"bwiki:6/6f/8mwzbh5qhdm8hm2z0nfe2854d4c4741.mp3","text":"既然贾维决定加入你们，我也没什么好说的。你可以叫我布洛卡，我会听你的命令，但别指望我做多余的事，我对你们这样的大组织可没有好感。","alt":"voice_cn/char_356_broca/cn_011.mp3"}],"作战记录":[{"url":"bwiki:d/d5/g5c0zepvlu2dgnq9dh9qzqpu6kxfdfj.mp3","text":"......谢谢。","alt":"voice_cn/char_356_broca/cn_012.mp3"}],"精英化1":[{"url":"bwiki:3/3a/pzuokuscfjcy3s52k6wr682n53qv259.mp3","text":"加薪？......我不是很需要。","alt":"voice_cn/char_356_broca/cn_013.mp3"}],"精英化2":[{"url":"bwiki:f/f8/s43ghgbjs07y8lj5gycb1vnotvudlni.mp3","text":"或许奥斯塔是对的，罗德岛可以信任。这样的话，那我......","alt":"voice_cn/char_356_broca/cn_014.mp3"}],"编入":[{"url":"bwiki:7/74/7oujiy6nu31vek0a2xx6rn9nueyl5y5.mp3","text":"好。","alt":"voice_cn/char_356_broca/cn_017.mp3"}],"任命队长":[{"url":"bwiki:5/52/66riveknw1o6gsjln64rbkecbp9arrs.mp3","text":"......我不擅长带队。","alt":"voice_cn/char_356_broca/cn_018.mp3"}],"行动出发":[{"url":"bwiki:f/f7/f8t3bcudv1fen7sszjf8x4xe1vc9nz4.mp3","text":"走吧。","alt":"voice_cn/char_356_broca/cn_019.mp3"}],"行动开始":[{"url":"bwiki:7/74/k9n721icj86kw3ffu05h4e98zp6z47f.mp3","text":"该打架了。","alt":"voice_cn/char_356_broca/cn_020.mp3"}],"选中":[{"url":"bwiki:a/a8/ssoy2lvqlw6i6nham1n2x2qyk32kau7.mp3","text":"别对我指手画脚。","alt":"voice_cn/char_356_broca/cn_021.mp3"},{"url":"bwiki:6/6f/lawe1255i9zmo1yvbsbss9ny5wzco3z.mp3","text":"啧，我知道了。","alt":"voice_cn/char_356_broca/cn_022.mp3"}],"部署":[{"url":"bwiki:5/5a/ek9niooxnnraxelhcvae5gmkpd748zq.mp3","text":"那些就是敌人？","alt":"voice_cn/char_356_broca/cn_023.mp3"},{"url":"bwiki:2/2c/9xembcts81gw6vz10s612xy7fhhm0z1.mp3","text":"我能应付。","alt":"voice_cn/char_356_broca/cn_024.mp3"}],"技能":[{"url":"bwiki:1/12/74k1cb9tc1h3ruf60o92879wl64rtd5.mp3","text":"不会很疼。","alt":"voice_cn/char_356_broca/cn_025.mp3"},{"url":"bwiki:b/b0/gw1crsc5utsrgujr5m8dosdor2172g6.mp3","text":"快点结束吧。","alt":"voice_cn/char_356_broca/cn_026.mp3"},{"url":"bwiki:b/bb/316olaoo2pth6oopl3rubsg50jzepph.mp3","text":"去死。","alt":"voice_cn/char_356_broca/cn_027.mp3"},{"url":"bwiki:a/a9/10ji1a37o79f8xt33rtlrbl978ln6z7.mp3","text":"闭嘴。","alt":"voice_cn/char_356_broca/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:b/bd/3m9bx07s4z64gmj6ttl9bf4qvnq733x.mp3","text":"......你这家伙，还挺厉害。","alt":"voice_cn/char_356_broca/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:a/a3/pa9au7zol0sj1zovp6ckabde2vc6iqu.mp3","text":"都搞定了。","alt":"voice_cn/char_356_broca/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:2/22/fq0x7u8qfowpft75iuvansvlzuhsly7.mp3","text":"我去追？","alt":"voice_cn/char_356_broca/cn_031.mp3"}],"失败":[{"url":"bwiki:2/24/f8ukhrdj71lmpe65hd0k5f8049ts2yn.mp3","text":"别慌，你努力了，奥斯塔也会有失手的时候。","alt":"voice_cn/char_356_broca/cn_032.mp3"}],"进驻":[{"url":"bwiki:9/98/arwwwljs6dxppkq15ddu4anytyp9dm4.mp3","text":"我随便走走。","alt":"voice_cn/char_356_broca/cn_033.mp3"}],"戳一下":[{"url":"bwiki:9/99/riru2xlktmhg29rrjg0qvbew44cdo55.mp3","text":"你......！","alt":"voice_cn/char_356_broca/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:9/90/jvskv6iax2d1fiinobmsdlwv82r66pn.mp3","text":"博士，你很烦。","alt":"voice_cn/char_356_broca/cn_036.mp3"}],"标题":[{"url":"bwiki:e/e4/qoflzxdl20wtko2pnsnvzuseebeed9w.mp3","text":"明日方舟。","alt":"voice_cn/char_356_broca/cn_037.mp3"}],"新年":[{"url":"bwiki:e/e0/agy0ufh3ditii1kzy2199y1tdboe3n0.mp3","text":"新年快乐，博士......干什么，寄人篱下，这点礼数我还是懂的。而且，和之前在叙拉古相比，这种场面，我想都不敢想，罗德岛挺好的。","alt":"voice_cn/char_356_broca/cn_038.mp3"}],"问候":[{"url":"bwiki:0/0d/e3o3kbnde46mgbjl3du57wddcskz5dd.mp3","text":"早。","alt":"voice_cn/char_356_broca/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:4/40/0u9swdqa5peauo3l67ktadqqam4j006.mp3","text":"护卫？......啧，我知道了。","alt":"voice/char_356_broca/cn_001.mp3"}],"交谈":[{"url":"bwiki:4/4f/hwtgvl4p9w7m1mb7sd8g1n6wk7zgv8m.mp3","text":"那个叫阿米娅的小女孩也是这里的领导者？罗德岛到底是什么黑心公司。","alt":"voice/char_356_broca/cn_002.mp3"},{"url":"bwiki:5/5b/sx1vv9sgpdrq5omcflaxx5aqfejayzk.mp3","text":"我不喜欢吃白食，有什么体力活需要我，可以找我。","alt":"voice/char_356_broca/cn_003.mp3"},{"url":"bwiki:2/25/3ufzvp0xsanxruifkk0pbfvrzdp0fbx.mp3","text":"我不讨厌被命令，但我讨厌不知道自己在为什么战斗的感觉。","alt":"voice/char_356_broca/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:8/81/ejhmctg1ycxqmizuidiijyi6pw7m5si.mp3","text":"兴趣？为什么我要告诉你？......啧，别用那种眼神看我，告诉你行了吧，我喜欢自己做各种改造。","alt":"voice/char_356_broca/cn_005.mp3"},{"url":"bwiki:3/3d/q3axonx2yk1ub3g8qxzcb3witow2te1.mp3","text":"如果没有贾维和奥斯塔，我已经死在那天那条小巷子里了。所以，我这条命是他们的，无论他们想做什么，我都会帮他们。","alt":"voice/char_356_broca/cn_006.mp3"}],"信赖":[{"url":"bwiki:3/3c/my9hyxoxk5jy26mu18msli6k8cdjbdx.mp3","text":"我不讨厌你，但我......无法完全信任你。","alt":"voice/char_356_broca/cn_007.mp3"},{"url":"bwiki:0/0e/kzb7ygu3w0riyb5besy7nsekgq0ha46.mp3","text":"好好做事，好好赚钱，好好生活，曾经，我的想法就这么简单......不过，奥斯塔说得对，在叙拉古这个地方，这样的想法，应该叫梦想。","alt":"voice/char_356_broca/cn_008.mp3"},{"url":"bwiki:e/e3/m3ywpd49jurm7p2247nha9jdia5g7zg.mp3","text":"我承认，你这家伙作为领导者来说还可以......但是，奥斯塔说过，一个组织的腐化，有时候就是从掉以轻心的时候开始的，我会盯紧你。","alt":"voice/char_356_broca/cn_009.mp3"}],"闲置":[{"url":"bwiki:0/09/0sslqgkpfb9zgwy2mt2dbqnrxjiha27.mp3","text":"睡着了吗，真是悠哉的家伙。啧，毯子放哪儿去了......","alt":"voice/char_356_broca/cn_010.mp3"}],"报到":[{"url":"bwiki:2/22/o7hoj360j294x21189pnb3rz5jdtklc.mp3","text":"既然贾维决定加入你们，我也没什么好说的。你可以叫我布洛卡，我会听你的命令，但别指望我做多余的事，我对你们这样的大组织可没有好感。","alt":"voice/char_356_broca/cn_011.mp3"}],"作战记录":[{"url":"bwiki:6/60/jlqwn1jbo7i87yx7vga1n2b036v3ey0.mp3","text":"......谢谢。","alt":"voice/char_356_broca/cn_012.mp3"}],"精英化1":[{"url":"bwiki:3/31/nu6hfx7gtml8ygxb10rvk6i0ln7u5p3.mp3","text":"加薪？......我不是很需要。","alt":"voice/char_356_broca/cn_013.mp3"}],"精英化2":[{"url":"bwiki:1/1b/bea4s6ga4g21z1kn73m5yngxq6kaeki.mp3","text":"或许奥斯塔是对的，罗德岛可以信任。这样的话，那我......","alt":"voice/char_356_broca/cn_014.mp3"}],"编入":[{"url":"bwiki:e/ec/sjh7ktkyq5n4es9cuugbu9wt6k4y7po.mp3","text":"好。","alt":"voice/char_356_broca/cn_017.mp3"}],"任命队长":[{"url":"bwiki:1/1b/ce98lepk3ibqtezjyjiqfawhk7tpzku.mp3","text":"......我不擅长带队。","alt":"voice/char_356_broca/cn_018.mp3"}],"行动出发":[{"url":"bwiki:2/26/r1ymhg4z6s9linz5uz35ony72fm5wpb.mp3","text":"走吧。","alt":"voice/char_356_broca/cn_019.mp3"}],"行动开始":[{"url":"bwiki:6/63/nnvjxnxzhb8ky4s2bdkut39gu4lonjm.mp3","text":"该打架了。","alt":"voice/char_356_broca/cn_020.mp3"}],"选中":[{"url":"bwiki:6/65/jmk9gm1mxbz6ck3ybqpqpobm300x9gl.mp3","text":"别对我指手画脚。","alt":"voice/char_356_broca/cn_021.mp3"},{"url":"bwiki:a/aa/h3cfa1n2j5pozbf0i6ynw8hp5ig17ws.mp3","text":"啧，我知道了。","alt":"voice/char_356_broca/cn_022.mp3"}],"部署":[{"url":"bwiki:0/0f/en4xedd39o8j5csgqiyb34mbm2f1bn8.mp3","text":"那些就是敌人？","alt":"voice/char_356_broca/cn_023.mp3"},{"url":"bwiki:e/e7/sxwv9hziz1kq3i082l2k9s36vsc04l9.mp3","text":"我能应付。","alt":"voice/char_356_broca/cn_024.mp3"}],"技能":[{"url":"bwiki:c/cb/am95zirblsgp25ykfgg3qi3zdnstaeb.mp3","text":"不会很疼。","alt":"voice/char_356_br