{"中文":{"登录":[{"url":"bwiki:3/3f/l0i47j9a3ig76gwxhu32hqxk2nnug49.mp3","text":"博士是不是饿了？我做的饭团可好吃了，拿一两个去吧！","alt":"voice_cn/char_289_gyuki/cn_001.mp3"}],"交谈":[{"url":"bwiki:c/c5/nfxv50qeh9mr48pqv15fonjwqzfbvek.mp3","text":"我喜欢这样几件事：比试武技，还有啊，踢足球！对啦还有插花。把我当作仅仅是痴迷战斗的古典武者——有这种想法的人，真是太天真了！","alt":"voice_cn/char_289_gyuki/cn_002.mp3"},{"url":"bwiki:a/ad/27n204i6c0ox9n5l9ldyz6jv5i6bb46.mp3","text":"我的种族以其他种族为食？这谣言，你是从谁那听来的？嘁，那种只敢躲在角落里中伤别人的懦夫，要是被我抓到，可得好好教训教训他！","alt":"voice_cn/char_289_gyuki/cn_003.mp3"},{"url":"bwiki:0/03/j2jlluwbmdnaxhywk39iyi3qafq1289.mp3","text":"我的身体天生就有自愈的能力。就算是因为战斗受了伤，也很快就能愈合。","alt":"voice_cn/char_289_gyuki/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:e/e4/7f4aa2t1367enfxrhszhu0ib0en8mvx.mp3","text":"博士，罗德岛要举办足球赛了！走吧，你可一定要和我一起报名！放心放心，只要我缠丸在场，对手就只有认输的份！博士你只要考虑获奖时摆什么POSE就行啦！","alt":"voice_cn/char_289_gyuki/cn_005.mp3"},{"url":"bwiki:3/3d/dlj1sg6s1oh18txg26o5crcpxsqus3h.mp3","text":"战斗中的我看起来像另一个人？以冷酷的姿态击败所有敌人，眼神中不带丝毫感情？哦豁~那不是非常帅气的吗？真想好好见识一下啊，战斗时的我！","alt":"voice_cn/char_289_gyuki/cn_006.mp3"}],"信赖":[{"url":"bwiki:6/64/l9mhm2nlgw0pnxf19yzp5wzfux7h608.mp3","text":"缠丸我啊，总是一不小心就弄坏周围的东西，所以我就向花道老师学了插花，试着控制自己的力量。而且，有那么多漂亮的花围着自己，本来就挺让人开心的！","alt":"voice_cn/char_289_gyuki/cn_007.mp3"},{"url":"bwiki:0/04/d4dwv0xfl2jf401ip60g0od5z99qdnr.mp3","text":"说到战斗策略......是的，我完全不擅长呢，所以才总是会陷入危险的战斗吧！不过，博士你的命令每次都能让我及时清醒，有你站在我背后，真好。","alt":"voice_cn/char_289_gyuki/cn_008.mp3"},{"url":"bwiki:5/5e/roj8mf0cp26qdwzgaa7ei3j754mvw8v.mp3","text":"其实，我是个太容易轻信他人的笨蛋，好几次都被骗的很惨，甚至差点就死掉了。但缠丸我啊，是绝对信任博士的，因为博士你绝对不会背叛我。","alt":"voice_cn/char_289_gyuki/cn_009.mp3"}],"闲置":[{"url":"bwiki:a/a4/lq2thubfe623bqv8s9had0f53n940de.mp3","text":"......博士，别睡啊？不行不行，没人和我说话我会无聊死的！","alt":"voice_cn/char_289_gyuki/cn_010.mp3"}],"报到":[{"url":"bwiki:8/8f/2b8uuil6dsz99wmwc2pvhlhefibqncl.mp3","text":"缠丸，现在正式加入罗德岛！我来负责战斗，指挥就交给博士你了！","alt":"voice_cn/char_289_gyuki/cn_011.mp3"}],"作战记录":[{"url":"bwiki:1/1b/age46bu17e0px53g8pxoryauwbia1lt.mp3","text":"这样就又可以学到很多战斗技巧了吧。","alt":"voice_cn/char_289_gyuki/cn_012.mp3"}],"精英化1":[{"url":"bwiki:8/8f/f286zwgw580z149eiy44r1slgvzsmnu.mp3","text":"博士，善用我的力量，就是尊重我。","alt":"voice_cn/char_289_gyuki/cn_013.mp3"}],"精英化2":[{"url":"bwiki:8/8d/qviryewg8w1j4diwlovgsyuvr0sntya.mp3","text":"博士，请退后。如果全力挥舞的话，我的武器可能会伤到你。但缠丸我，想要为你取得胜利。","alt":"voice_cn/char_289_gyuki/cn_014.mp3"}],"编入":[{"url":"bwiki:5/5f/5ae2tsmz75rg6gry9hi1f5wfejtv33u.mp3","text":"哈~各位看起来都挺强的，不如我们先来热身一下？","alt":"voice_cn/char_289_gyuki/cn_017.mp3"}],"任命队长":[{"url":"bwiki:0/07/ihifhgx7sv4mfl5kkwh937fc9wqiqru.mp3","text":"呃，要让我当队长？那不就意味着我没法放手一搏了嘛？","alt":"voice_cn/char_289_gyuki/cn_018.mp3"}],"行动出发":[{"url":"bwiki:a/a3/akqe2u0f5xc0o4tz6ugv2kqvb8xdr25.mp3","text":"各位都准备好大干一场了吧？那还等什么呢！","alt":"voice_cn/char_289_gyuki/cn_019.mp3"}],"行动开始":[{"url":"bwiki:e/e7/cwco8rfrbirc2ux0fg0a5kcxr8axv5c.mp3","text":"久等了，我的敌人们啊。","alt":"voice_cn/char_289_gyuki/cn_020.mp3"}],"选中":[{"url":"bwiki:4/4c/j5x6p4avaup9zco28wgoej2l0qh98fy.mp3","text":"我在这里呢。","alt":"voice_cn/char_289_gyuki/cn_021.mp3"},{"url":"bwiki:0/08/ib61yptm9om5c4cg4vf0c434raza6yx.mp3","text":"还要等多久哦？","alt":"voice_cn/char_289_gyuki/cn_022.mp3"}],"部署":[{"url":"bwiki:d/da/jmny8bzin5bypw313s5nzuxhpahe9pu.mp3","text":"有战场的气息。","alt":"voice_cn/char_289_gyuki/cn_023.mp3"},{"url":"bwiki:8/86/d8q1pv8uqunumzr856zxkqzzifj45y6.mp3","text":"让他们颤抖吧。","alt":"voice_cn/char_289_gyuki/cn_024.mp3"}],"技能":[{"url":"bwiki:c/cf/kmrdu68xu8nn9q0oj8ngq9b8ropf0ew.mp3","text":"敢站到我面前，有胆量！","alt":"voice_cn/char_289_gyuki/cn_025.mp3"},{"url":"bwiki:2/24/pnvhoj6jh66bm8f5e924xe306e3pvmc.mp3","text":"做好觉悟了吗？","alt":"voice_cn/char_289_gyuki/cn_026.mp3"},{"url":"bwiki:f/f6/nrsmuhok1gv6op43ng4hd8ejscykypp.mp3","text":"就把你连武器一起切碎！","alt":"voice_cn/char_289_gyuki/cn_027.mp3"},{"url":"bwiki:4/4c/mhh0pz175fec6ftt40v6zkcrp0n2c8q.mp3","text":"倒下吧！","alt":"voice_cn/char_289_gyuki/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:e/e4/e0oyv4p1dc17gurspvdcfl9pwow9sta.mp3","text":"火海深渊，刀山剑林，太令人满足了！我中意的战场就是这个样子！","alt":"voice_cn/char_289_gyuki/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:1/13/c0l2mdbmx1a1ylal7xhjdv1szfxdtrl.mp3","text":"博士，我全都解决了！唔......四周一片狼藉，难道都是我搞的？","alt":"voice_cn/char_289_gyuki/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:4/49/hll8ia6tcw3zcu5xyha63qqx5iq8r5i.mp3","text":"我去追逃兵咯？不然这场战斗，根本不能算是结束了啊。","alt":"voice_cn/char_289_gyuki/cn_031.mp3"}],"失败":[{"url":"bwiki:b/bf/stjr6x3hj16hxlfxanap8xtfwu77oxp.mp3","text":"撤退！我来垫后，小心，别受伤！","alt":"voice_cn/char_289_gyuki/cn_032.mp3"}],"进驻":[{"url":"bwiki:d/d0/g5bqosdlmby08okjvcbbk4o71pz6eph.mp3","text":"唔呃，撞、撞到角了！","alt":"voice_cn/char_289_gyuki/cn_033.mp3"}],"戳一下":[{"url":"bwiki:a/a9/jjgimmkcs727ifbzacivy5ewvj38law.mp3","text":"哈？","alt":"voice_cn/char_289_gyuki/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:1/18/3ls6mshaoi4fwh4027306tpmhihwp09.mp3","text":"有什么高兴的事？一定要和缠丸我分享哦！","alt":"voice_cn/char_289_gyuki/cn_036.mp3"}],"标题":[{"url":"bwiki:b/b4/1m0heywgho2hx9n3sh6lnp8fx9zg97o.mp3","text":"明日方舟。","alt":"voice_cn/char_289_gyuki/cn_037.mp3"}],"新年":[{"url":"bwiki:9/9c/dhyu10k40sg05n6rg0m1hqvs7khdsek.mp3","text":"新年的话，你们的庆祝方式是什么样的？随便怎样都可以？好，那我要找角峰他们办场足球对抗赛！你可一定要来看啊！","alt":"voice_cn/char_289_gyuki/cn_038.mp3"}],"问候":[{"url":"bwiki:3/35/ml98xmabawmgskz9x0fdeee9ruij3r1.mp3","text":"嗯嗯，我在听呢。","alt":"voice_cn/char_289_gyuki/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:7/7f/hibl3xoc87m5s80sptbxrzpt2hg2vu6.mp3","text":"博士是不是饿了？我做的饭团可好吃了，拿一两个去吧！","alt":"voice/char_289_gyuki/cn_001.mp3"}],"交谈":[{"url":"bwiki:a/a0/lagzrgw79nri4oq8tk9ybochl4mmfgf.mp3","text":"我喜欢这样几件事：比试武技，还有啊，踢足球！对啦还有插花。把我当作仅仅是痴迷战斗的古典武者——有这种想法的人，真是太天真了！","alt":"voice/char_289_gyuki/cn_002.mp3"},{"url":"bwiki:b/bd/26v941kyaegq5zrssz5coc4d65va5ad.mp3","text":"我的种族以其他种族为食？这谣言，你是从谁那听来的？嘁，那种只敢躲在角落里中伤别人的懦夫，要是被我抓到，可得好好教训教训他！","alt":"voice/char_289_gyuki/cn_003.mp3"},{"url":"bwiki:1/1f/c7g5jfrxeypyt6p87oo5hg71a36bmxq.mp3","text":"我的身体天生就有自愈的能力。就算是因为战斗受了伤，也很快就能愈合。","alt":"voice/char_289_gyuki/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:6/66/b1x9sc7ifqb240yxzydw7ene4aa1s8o.mp3","text":"博士，罗德岛要举办足球赛了！走吧，你可一定要和我一起报名！放心放心，只要我缠丸在场，对手就只有认输的份！博士你只要考虑获奖时摆什么POSE就行啦！","alt":"voice/char_289_gyuki/cn_005.mp3"},{"url":"bwiki:5/5e/dbwajeww8v2azwvjxpiqrbyqvlpxknr.mp3","text":"战斗中的我看起来像另一个人？以冷酷的姿态击败所有敌人，眼神中不带丝毫感情？哦豁~那不是非常帅气的吗？真想好好见识一下啊，战斗时的我！","alt":"voice/char_289_gyuki/cn_006.mp3"}],"信赖":[{"url":"bwiki:0/0f/mz2w3f9961qv8f5sbim6gls2z8h8h98.mp3","text":"缠丸我啊，总是一不小心就弄坏周围的东西，所以我就向花道老师学了插花，试着控制自己的力量。而且，有那么多漂亮的花围着自己，本来就挺让人开心的！","alt":"voice/char_289_gyuki/cn_007.mp3"},{"url":"bwiki:c/c1/gu6hhgqznpjlfg0ojvmogwdh8zn1crc.mp3","text":"说到战斗策略......是的，我完全不擅长呢，所以才总是会陷入危险的战斗吧！不过，博士你的命令每次都能让我及时清醒，有你站在我背后，真好。","alt":"voice/char_289_gyuki/cn_008.mp3"},{"url":"bwiki:1/19/5b4ju5uwisgzwtybetk0i0z0fqw0v42.mp3","text":"其实，我是个太容易轻信他人的笨蛋，好几次都被骗的很惨，甚至差点就死掉了。但缠丸我啊，是绝对信任博士的，因为博士你绝对不会背叛我。","alt":"voice/char_289_gyuki/cn_009.mp3"}],"闲置":[{"url":"bwiki:f/f1/1495r2xkxm6qpkbw6yw84ewzicn4na9.mp3","text":"......博士，别睡啊？不行不行，没人和我说话我会无聊死的！","alt":"voice/char_289_gyuki/cn_010.mp3"}],"报到":[{"url":"bwiki:5/5e/m76xih036dl415q2fbenjvi4tg7w9hi.mp3","text":"缠丸，现在正式加入罗德岛！我来负责战斗，指挥就交给博士你了！","alt":"voice/char_289_gyuki/cn_011.mp3"}],"作战记录":[{"url":"bwiki:1/17/3ayxnuvhf2oghwzqbn069rv5lor4k8s.mp3","text":"这样就又可以学到很多战斗技巧了吧。","alt":"voice/char_289_gyuki/cn_012.mp3"}],"精英化1":[{"url":"bwiki:8/87/izmh2nrrnt2swuiyw9o6posis8olzib.mp3","text":"博士，善用我的力量，就是尊重我。","alt":"voice/char_289_gyuki/cn_013.mp3"}],"精英化2":[{"url":"bwiki:8/84/a512aagmgjz3o5j96wjxgcvs4xqup3u.mp3","text":"博士，请退后。如果全力挥舞的话，我的武器可能会伤到你。但缠丸我，想要为你取得胜利。","alt":"voice/char_289_gyuki/cn_014.mp3"}],"编入":[{"url":"bwiki:7/76/e85tv7tpmhzsm5ef231ku8m5gogz2zj.mp3","text":"哈~各位看起来都挺强的，不如我们先来热身一下？","alt":"voice/char_289_gyuki/cn_017.mp3"}],"任命队长":[{"url":"bwiki:7/75/5f7c1qlqllcu8p2mrd7alutvygcjnds.mp3","text":"呃，要让我当队长？那不就意味着我没法放手一搏了嘛？","alt":"voice/char_289_gyuki/cn_018.mp3"}],"行动出发":[{"url":"bwiki:d/d2/njvi3qumw8tucf9h03knn1xw00eh434.mp3","text":"各位都准备好大干一场了吧？那还等什么呢！","alt":"voice/char_289_gyuki/cn_019.mp3"}],"行动开始":[{"url":"bwiki:1/1f/gnbjziqepy6i3ip1ronaexv65qij278.mp3","text":"久等了，我的敌人们啊。","alt":"voice/char_289_gyuki/cn_020.mp3"}],"选中":[{"url":"bwiki:a/ac/56ofc344f380ry9yqcnkxj0kjvuntcp.mp3","text":"我在这里呢。","alt":"voice/char_289_gyuki/cn_021.mp3"},{"url":"bwiki:4/40/dzolp2scp5uqx54weu1idp4ls6cw33w.mp3","text":"还要等多久哦？","alt":"voice/char_289_gyuki/cn_022.mp3"}],"部署":[{"url":"bwiki:b/ba/feovstvr4wsj1p6cgnwbt17wfj14h90.mp3","text":"有战场的气息。","alt":"voice/char_289_gyuki/cn_023.mp3"},{"url":"bwiki:7/71/kwikwsice28o6pe6mp9vf336no0pwh9.mp3","text":"让他们颤抖吧。","alt":"voice/char_289_gyuki/cn_024.mp3"}],"技能":[{"url":"bwiki:a/a7/cwactfxpqvzxnvwklgwqzgl6r78ui8z.mp3","text":"敢站到我面前，有胆量！","alt":"voice/char_289_gyuki/cn_025.mp3"},{"url":"bwiki:f/f5/ey7xnvxk5q99psrwgd4ihi32iklm12u.mp3","text":"做好觉悟了吗？","alt":"voice/char_289_gyuki/cn_026.mp3"},{"url":"bwiki:3/30/lvp7n1g1pw81lnncf9yzfvwtb6m45br.mp3","text":"就把你连武器一起切碎！","alt":"voice/char_289_gyuki/cn_027.mp3"},{"url":"bwiki:8/8d/b0zsx2ckou5r926jm4oahly2iurkgel.mp3","text":"倒下吧！","alt":"voice/char_289_gyuki/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:5/5e/fb7yolyvvlwa0zdsfq0gl0quboxxksq.mp3","text":"火海深渊，刀山剑林，太令人满足了！我中意的战场就是这个样子！","alt":"voice/char_289_gyuki/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:0/01/8aqsbiab8cboxh3ng5sceh6tuxtur0y.mp3","text":"博士，我全都解决了！唔......四周一片狼藉，难道都是我搞的？","alt":"voice/char_289_gyuki/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:6/6e/gwy7nxev9ap8zcka3vrlqlt8gre0jqh.mp3","text":"我去追逃兵咯？不然这场战斗，根本不能算是结束了啊。","alt":"voice/char_289_gyuki/cn_031.mp3"}],"失败":[{"url":"bwiki:3/38/jgmzld3jfsza6lh5y09ku1ejnpiu741.mp3","text":"撤退！我来垫后，小心，别受伤！","alt":"voice/char_289_gyuki/cn_032.mp3"}],"进驻":[{"url":"bwiki:f/fa/efu0zv8acbgn7lo3j1ka5esjy6a3wnc.mp3","text":"唔呃，撞、撞到角了！","alt":"voice/char_289_gyuki/cn_033.mp3"}],"戳一下":[{"url":"bwiki:0/02/immbut98xaznvkblrlnqfd6sq4bv73t.mp3","text":"哈？","alt":"voice/char_289_gyuki/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:f/f4/0mw3ditvt83tdnszjizmbs3divrlu9z.mp3","text":"有什么高兴的事？一定要和缠丸我分享哦！","alt":"voice/char_289_gyuki/cn_036.mp3"}],"标题":[{"url":"bwiki:6/63/97hycbf4nt9ukribw1aip2avm5mn6f3.mp3","text":"明日方舟。","alt":"voice/char_289_gyuki/cn_037.mp3"}],"新年":[{"url":"bwiki:0/0b/rb7av5ubaxz8934d1s69bqpf00tvxp5.mp3","text":"新年的话，你们的庆祝方式是什么样的？随便怎样都可以？好，那我要找角峰他们办场足球对抗赛！你可一定要来看啊！","alt":"voice/char_289_gyuki/cn_038.mp3"}],"问候":[{"url":"bwiki:d/d9/j2jo3nazqm1arbneh1ontvs00vtfn4n.mp3","text":"嗯嗯，我在听呢。","alt":"voice/char_289_gyuki/cn_042.mp3"}]}}