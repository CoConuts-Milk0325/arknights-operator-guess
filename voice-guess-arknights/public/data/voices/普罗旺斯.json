{"中文":{"登录":[{"url":"bwiki:6/68/r32nkkbl6pugo6diiuykwp7s2tntjla.mp3","text":"博士，如果房间卫生需要打扫的话，记得叫我~","alt":"voice_cn/char_145_prove/cn_001.mp3"}],"交谈":[{"url":"bwiki:3/34/tecl08e6rdotkr6685p7v6scralrk18.mp3","text":"我的尾巴您很在意吗？毛茸茸的，很可爱？那——要摸摸看吗？其他人身上，可没有这样的尾巴哦~","alt":"voice_cn/char_145_prove/cn_002.mp3"},{"url":"bwiki:8/85/b7286py0l9g3n0stlz9len2yibrf744.mp3","text":"荒野里水是珍贵资源呢，虽然罗德岛并不那么缺水，但还是希望博士你要节约使用哦。","alt":"voice_cn/char_145_prove/cn_003.mp3"},{"url":"bwiki:3/39/2lujz4pby78xxvygjig067udlp6u4yi.mp3","text":"搜救遭遇天灾的人也是我的职责，虽然大多数情况下都会空手而归......","alt":"voice_cn/char_145_prove/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:2/20/sl3f4n42m4cd5fub62gpdhqfyjssc2k.mp3","text":"信标回收、矿床勘探、然后是可利用资源回收，这样任务就完成咯~","alt":"voice_cn/char_145_prove/cn_005.mp3"},{"url":"bwiki:2/2c/1ryxpnbkdiur3h80m3em28bvq9d3lki.mp3","text":"葡萄先生是我的搭档。它什么都能做，非常可靠哦。它的来历？唔......对哦，我是怎么和它认识的呢......？","alt":"voice_cn/char_145_prove/cn_006.mp3"}],"信赖":[{"url":"bwiki:a/a0/k3u36zpiaxq48s8jl0jc4uwcl9gwq58.mp3","text":"那、那个红色的孩子是怎么回事......我......颤抖，止不住呢......那个，博士的手臂能稍稍借下吗......？这样的话，我会安心很多的......","alt":"voice_cn/char_145_prove/cn_007.mp3"},{"url":"bwiki:c/cf/f7hmhh5boll8rspaes2vlqxvcugn74c.mp3","text":"一般来说，野外的天灾工作者都会产生这样各种各样的异变。我有什么变化？知道得越多，就离危险越近哦，博士。","alt":"voice_cn/char_145_prove/cn_008.mp3"},{"url":"bwiki:1/13/ar5y845palxflygzlomjmlehffkf2hq.mp3","text":"荒野中的天灾工作者......一般都无法善终。不用担心我哦，能在罗德岛稍事休息，我已经感到......很幸福了。","alt":"voice_cn/char_145_prove/cn_009.mp3"}],"闲置":[{"url":"bwiki:d/d2/kx2ojgj9an9rssqmwxzj2jnceycsuzv.mp3","text":"怎么又睡在这种地方，真是的......总是一副毫无防备的样子。","alt":"voice_cn/char_145_prove/cn_010.mp3"}],"报到":[{"url":"bwiki:e/e8/65qt7rs8cy0jxeegcv4gmkjbm03oc83.mp3","text":"我是普罗旺斯，是个普通的天灾工作者~您这样盯着我看，是在意我的尾巴吗~？","alt":"voice_cn/char_145_prove/cn_011.mp3"}],"作战记录":[{"url":"bwiki:1/1c/qh517jghzif76017euq4e7n30izpi7x.mp3","text":"这样的话，就更接近您心目中我应有的样子了吗？","alt":"voice_cn/char_145_prove/cn_012.mp3"}],"精英化1":[{"url":"bwiki:a/a0/nz0unr9ejz34950pvc82hdb6e9felr9.mp3","text":"和博士一起工作，很愉快啊~","alt":"voice_cn/char_145_prove/cn_013.mp3"}],"精英化2":[{"url":"bwiki:6/6c/lpoc9hzvkmm2x5cj24dtd7fc5wjq1i0.mp3","text":"罗德岛附近出现了风暴的征兆——不用担心，组织避难就交给我吧！我可是这方面的专家！","alt":"voice_cn/char_145_prove/cn_014.mp3"}],"编入":[{"url":"bwiki:1/1e/g50tocwlq3ezzk4tyvh31iwammr09u5.mp3","text":"这次和谁组队呢？","alt":"voice_cn/char_145_prove/cn_017.mp3"}],"任命队长":[{"url":"bwiki:7/73/izvwrccbfin28wt6166rukshvpdxs8d.mp3","text":"不会有任何问题的。","alt":"voice_cn/char_145_prove/cn_018.mp3"}],"行动出发":[{"url":"bwiki:f/fb/ad9gbp2uw2ieca0xmdtg5jb8soehtq5.mp3","text":"我的工作是把大家平安带回来。","alt":"voice_cn/char_145_prove/cn_019.mp3"}],"行动开始":[{"url":"bwiki:5/55/8gwxux86naen1nb0euc2q2gxfvbs0zb.mp3","text":"无论天灾还是敌人，都是我痛恨的对手！","alt":"voice_cn/char_145_prove/cn_020.mp3"}],"选中":[{"url":"bwiki:3/36/tv05zi34v9ixmmnr6y2t4jeexbj5vfu.mp3","text":"该我出场了吗？","alt":"voice_cn/char_145_prove/cn_021.mp3"},{"url":"bwiki:e/e7/tjelg4dqxhho1a15d83p9ktowu00ttj.mp3","text":"状态绝佳！","alt":"voice_cn/char_145_prove/cn_022.mp3"}],"部署":[{"url":"bwiki:f/f1/8etow3mu22upduoo8lag2f73qv1jw5w.mp3","text":"先从警告射击开始~","alt":"voice_cn/char_145_prove/cn_023.mp3"},{"url":"bwiki:f/fd/a1tj3loi4qmqi3n658vnkbtp8vh9q4n.mp3","text":"弩箭装填完毕！随时都可以！","alt":"voice_cn/char_145_prove/cn_024.mp3"}],"技能":[{"url":"bwiki:8/87/a9zu5mgy5z4ntxvomxcfm46jb8jef68.mp3","text":"已经警告过了哦！灾害处理，现在开始！","alt":"voice_cn/char_145_prove/cn_025.mp3"},{"url":"bwiki:f/fe/i2vkpqnuvayf4z9zp8e1zk9ngdk8txi.mp3","text":"弱点洞察！","alt":"voice_cn/char_145_prove/cn_026.mp3"},{"url":"bwiki:2/2d/mqwhfye2nqtqmym7j3tnzo5f35mdczd.mp3","text":"我来分散敌人的注意力。","alt":"voice_cn/char_145_prove/cn_027.mp3"},{"url":"bwiki:5/59/jpjtl3jlzl9k1shjjuggii80mnoow26.mp3","text":"荒野有它自己的准则！","alt":"voice_cn/char_145_prove/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:5/57/b2d8pgb636dna8674tt58gdptma3u17.mp3","text":"与天灾的破坏相比，敌人还真是脆弱呢。","alt":"voice_cn/char_145_prove/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:8/8d/tlysd015r47u5pe9rhausrksty07nue.mp3","text":"灾害评估报告，损伤是零~","alt":"voice_cn/char_145_prove/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:8/87/6ddeeue6qt332ztnem8bviul7vlvt38.mp3","text":"大家都辛苦了，即便稍有损害也不能气馁哦。","alt":"voice_cn/char_145_prove/cn_031.mp3"}],"失败":[{"url":"bwiki:b/b5/hbopdlrysfbhtsgbxg1hmc0d9w4jvoi.mp3","text":"呃......评估失误了，真是我职业生涯的污点......！","alt":"voice_cn/char_145_prove/cn_032.mp3"}],"进驻":[{"url":"bwiki:8/86/bvz1wzqbco3pchgzrnuxlnztq7vb05z.mp3","text":"如果是能好好休息的房间就好了~","alt":"voice_cn/char_145_prove/cn_033.mp3"}],"戳一下":[{"url":"bwiki:9/9f/2ypq8hwj1lm3eeyr4km6y48202rntd1.mp3","text":"啊啊，博士？","alt":"voice_cn/char_145_prove/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:d/d4/djir1xa332nmbt19lxm2p175er44qy5.mp3","text":"我的大尾巴毛绒绒~毛绒绒~♪","alt":"voice_cn/char_145_prove/cn_036.mp3"}],"标题":[{"url":"bwiki:a/a8/7poerdxjalw8kbrzjkq8n4f6b87l51i.mp3","text":"明日方舟。","alt":"voice_cn/char_145_prove/cn_037.mp3"}],"新年":[{"url":"bwiki:d/dc/2hpar5pmiwjo0cumuc8z8c47lsf5dw4.mp3","text":"新年快乐博士~我正准备量一下我的尾巴~它好像又长长了一点，博士，帮我一下，捏住尾巴尖尖，再把尺子比在这里......唔唔，数值是......","alt":"voice_cn/char_145_prove/cn_038.mp3"}],"问候":[{"url":"bwiki:a/a3/2pfgo2z8u4hlgsuy29gkd5dxb9aevic.mp3","text":"啊，博士早上好~","alt":"voice_cn/char_145_prove/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:b/b1/16dc966ibv9actgjx99wehckpy11jx3.mp3","text":"博士，如果房间卫生需要打扫的话，记得叫我~","alt":"voice/char_145_prove/cn_001.mp3"}],"交谈":[{"url":"bwiki:9/98/1anjz2km6n67m3x6xtu43auwk91djod.mp3","text":"我的尾巴您很在意吗？毛茸茸的，很可爱？那——要摸摸看吗？其他人身上，可没有这样的尾巴哦~","alt":"voice/char_145_prove/cn_002.mp3"},{"url":"bwiki:8/8d/6bdebd6lmlr4psmixz0ggjcpjdd9897.mp3","text":"荒野里水是珍贵资源呢，虽然罗德岛并不那么缺水，但还是希望博士你要节约使用哦。","alt":"voice/char_145_prove/cn_003.mp3"},{"url":"bwiki:f/f7/tajcv92umwvspqiofc8fh16tffb8d08.mp3","text":"搜救遭遇天灾的人也是我的职责，虽然大多数情况下都会空手而归......","alt":"voice/char_145_prove/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:8/87/51apov1yb89hlv0pcrbj7yfqnt4edpb.mp3","text":"信标回收、矿床勘探、然后是可利用资源回收，这样任务就完成咯~","alt":"voice/char_145_prove/cn_005.mp3"},{"url":"bwiki:9/9b/744kcepsjw7hm2naln83skurzls1n5m.mp3","text":"葡萄先生是我的搭档。它什么都能做，非常可靠哦。它的来历？唔......对哦，我是怎么和它认识的呢......？","alt":"voice/char_145_prove/cn_006.mp3"}],"信赖":[{"url":"bwiki:5/5e/89wt10bpgdqpqv78owj5lzia93ypvsa