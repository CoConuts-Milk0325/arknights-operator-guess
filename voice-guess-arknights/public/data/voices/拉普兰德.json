{"中文":{"登录":[{"url":"bwiki:3/38/4hcly0hsmiyni8h81g25wu8l2u78b8z.mp3","text":"哟，博士。就算我把武器带进这里，你也会原谅我的对吧。那我就坐在这里了。","alt":"voice_cn/char_140_whitew/cn_001.mp3"}],"交谈":[{"url":"bwiki:5/57/ajax6u4yah46iu4xvd17njvow9h4ikc.mp3","text":"有人想伤害你？好好想想你过去的所作所为，是不是在哪结下过什么仇怨啊。","alt":"voice_cn/char_140_whitew/cn_002.mp3"},{"url":"bwiki:e/e4/5quqn1svgiopz78a2eikq9qh10af9gx.mp3","text":"如果有人借复仇的名义来杀你，不要犹豫，干掉那个人。一旦你决定拿起武器，杀人就不需要什么理由。","alt":"voice_cn/char_140_whitew/cn_003.mp3"},{"url":"bwiki:6/60/ew9xv6zr31p47ybgmdhi3wit5ypomvt.mp3","text":"这么久没见，德克萨斯身边多了不少人嘛！哈哈，这很好！也让我和他们认识一下！","alt":"voice_cn/char_140_whitew/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:8/85/etuzwhzbgquxfa9uuwmycmms9rorxeu.mp3","text":"你觉得我是杀手？好啊，你当然可以随意解读我。我可以成为任何人，也能做任何工作，在任何时间都能干掉我想干掉的人，只要我想！","alt":"voice_cn/char_140_whitew/cn_005.mp3"},{"url":"bwiki:5/53/rrft912bu29wemzdhje8a2bzwo8lyb0.mp3","text":"我喜欢力量，博士，尤其是你还向我提供了可以尽情宣泄力量的职位......如果说这个疯狂的世界还剩下什么乐趣，就只剩下用我的力量征服一切这件事了吧！","alt":"voice_cn/char_140_whitew/cn_006.mp3"}],"信赖":[{"url":"bwiki:d/da/eyrpp1n77a0cect17nsgmwi87o947yi.mp3","text":"德克萨斯？呵呵，虽然她在害怕我，不过我没打算对她做些什么。我只是想让她变回以前那个德克萨斯，而不是像现在这样怯懦......","alt":"voice_cn/char_140_whitew/cn_007.mp3"},{"url":"bwiki:c/cd/t366k9kokquojdtl4smkzudeo8jsalf.mp3","text":"......那个红色的......没错吧......！博士，我啊，是绝对不能靠近她的！但是，但是——这感觉，这感觉......！如果战斗的话一定会死，但是，还是想和那家伙打上一场啊......！","alt":"voice_cn/char_140_whitew/cn_008.mp3"},{"url":"bwiki:e/ec/k1phxzhjfuyt44epehuxl4rrvdi6cpe.mp3","text":"想了解我和德克萨斯过去的事？哈哈，还真是挑起了一个不得了的话题啊你！总有一天你会知道的，但，绝不会是我来告诉你......","alt":"voice_cn/char_140_whitew/cn_009.mp3"}],"闲置":[{"url":"bwiki:0/05/3elumrw8gzazi5jjmhzetly2bltpfc2.mp3","text":"睡吧，至少现在，你还能做个美梦......","alt":"voice_cn/char_140_whitew/cn_010.mp3"}],"报到":[{"url":"bwiki:8/8b/j7nqpm4urgy51lgty440flpglpupb3j.mp3","text":"暴虐的恶人阻断正义的道路，我的主人啊，以复仇与恶意为名，引领弱小的人吧。","alt":"voice_cn/char_140_whitew/cn_011.mp3"}],"作战记录":[{"url":"bwiki:b/b9/mgzie21h3eyd3b81lzmf0hj90x1ft73.mp3","text":"你爱我不断提升的力量，对吧！","alt":"voice_cn/char_140_whitew/cn_012.mp3"}],"精英化1":[{"url":"bwiki:2/2f/5ofchhyn488t66rspnlnoedwk4bqw88.mp3","text":"哈哈哈，好，我喜欢你对我的信任。德克萨斯做得到吗？","alt":"voice_cn/char_140_whitew/cn_013.mp3"}],"精英化2":[{"url":"bwiki:1/15/jkm3ry9c3hlax9ewdzcordpicmxb7b6.mp3","text":"对对，就是这样，解放更多的力量吧，你该这样做！","alt":"voice_cn/char_140_whitew/cn_014.mp3"}],"编入":[{"url":"bwiki:e/eb/efzjf0r8dlmfkd1gl9knayc92zpkv3a.mp3","text":"让德克萨斯来担任队长！","alt":"voice_cn/char_140_whitew/cn_017.mp3"}],"任命队长":[{"url":"bwiki:c/cd/16maw3hnyjihamfi79641jt2hd1jpy9.mp3","text":"把德克萨斯放到我的小队来！","alt":"voice_cn/char_140_whitew/cn_018.mp3"}],"行动出发":[{"url":"bwiki:3/39/00x9ggws0nabb7g7co6b0ia3ysgtxru.mp3","text":"哈哈，诸位，反正我记不住你们的脸......算了，出发吧？","alt":"voice_cn/char_140_whitew/cn_019.mp3"}],"行动开始":[{"url":"bwiki:1/1a/pr72nrc8suevpjb7vjeme63z6q4iifr.mp3","text":"你们就是敌人？那就拜托你们进攻用点力了，别让我太无聊！","alt":"voice_cn/char_140_whitew/cn_020.mp3"}],"选中":[{"url":"bwiki:f/fc/ja1xn5cif2ix64o9mms7o48niwn8kp2.mp3","text":"让我见识见识你的能耐。","alt":"voice_cn/char_140_whitew/cn_021.mp3"},{"url":"bwiki:4/41/fhakaxfi5emz1bdhic4bfjwwwm45nbj.mp3","text":"你准备怎么安排？","alt":"voice_cn/char_140_whitew/cn_022.mp3"}],"部署":[{"url":"bwiki:3/35/9zn2ws77q4x54t6d8gwzx1k19n9w51c.mp3","text":"不错的位置啊。","alt":"voice_cn/char_140_whitew/cn_023.mp3"},{"url":"bwiki:4/48/49wbhvkap68r3yqokmikmba7jc6v6zk.mp3","text":"哈哈！","alt":"voice_cn/char_140_whitew/cn_024.mp3"}],"技能":[{"url":"bwiki:6/6d/2mzeu6a1qdn4c95qyqdx45fwg3ccxmk.mp3","text":"加油！还差一点。你就能干掉我了！","alt":"voice_cn/char_140_whitew/cn_025.mp3"},{"url":"bwiki:f/fe/mmysrsbtm0u70jxipa2r8ffdp22alih.mp3","text":"你能做到吗？","alt":"voice_cn/char_140_whitew/cn_026.mp3"},{"url":"bwiki:2/28/1jh9vh79dkcoqx347okktmfppuakccy.mp3","text":"试着抵抗我吧！","alt":"voice_cn/char_140_whitew/cn_027.mp3"},{"url":"bwiki:f/fb/m41c7wzqp4kfal0c5wwrx39bgpqslzx.mp3","text":"再加把劲！","alt":"voice_cn/char_140_whitew/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:6/67/il68qccl4dgn42zw11ykk1kexpafmlr.mp3","text":"这样就结束了？真无聊。","alt":"voice_cn/char_140_whitew/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:3/33/j3dnqpz9q7nov0tat8lrfu5gklnrzx0.mp3","text":"呵呵，喜欢我做的千层酥吗？","alt":"voice_cn/char_140_whitew/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:4/47/gvjoyt49dqx4d5nzbuz3lk2vufvwugm.mp3","text":"马马虎虎吧，让那几个人逃走，我也有责任。","alt":"voice_cn/char_140_whitew/cn_031.mp3"}],"失败":[{"url":"bwiki:a/ac/cizf8tiw6be44deweu9bh1v0blsja1c.mp3","text":"棒极了，这下，我践踏他们的欲望变得更强了！哈哈哈！","alt":"voice_cn/char_140_whitew/cn_032.mp3"}],"进驻":[{"url":"bwiki:1/16/gxh17jevm02ugr2170q9yhjhnfez6ke.mp3","text":"咦？刚才一瞬间，好像看到了一个红色的影子。","alt":"voice_cn/char_140_whitew/cn_033.mp3"}],"戳一下":[{"url":"bwiki:7/79/gpmxwwpjgzj34k2zliqd7k6lgsg3gcn.mp3","text":"呵呵。","alt":"voice_cn/char_140_whitew/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:4/4c/pqzrk34o3ye4jb7mgj0x456onbx3y6l.mp3","text":"越了解你，也就越了解德克萨斯。太棒了。","alt":"voice_cn/char_140_whitew/cn_036.mp3"}],"标题":[{"url":"bwiki:f/f1/9vvoyxyu2zyxi58uqouqjmaz440fpg1.mp3","text":"明日方舟。","alt":"voice_cn/char_140_whitew/cn_037.mp3"}],"新年":[{"url":"bwiki:f/ff/9xxv7v4ad48wwnat5ju7g64lkw21z2d.mp3","text":"德克萨斯在哪？马上就是倒计时了，这种日子难道她没在罗德岛？呵呵，连这种节日都没看到她人，她那群朋友都在哪？我要去找她了，博士，一起去？","alt":"voice_cn/char_140_whitew/cn_038.mp3"}],"问候":[{"url":"bwiki:7/7c/p0fod364jfuenvtxehl35yga1ece642.mp3","text":"呵，你好，博士。","alt":"voice_cn/char_140_whitew/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:9/90/jp0sbzd6kdp7zu4jpedwpy4rrl51unj.mp3","text":"哟，博士。就算我把武器带进这里，你也会原谅我的对吧。那我就坐在这里了。","alt":"voice/char_140_whitew/cn_001.mp3"}],"交谈":[{"url":"bwiki:a/a3/1mkdbuz3ue440sbtc1cs6vb0nrt4uhn.mp3","text":"有人想伤害你？好好想想你过去的所作所为，是不是在哪结下过什么仇怨啊。","alt":"voice/char_140_whitew/cn_002.mp3"},{"url":"bwiki:2/2f/kkglnojpf0sowvrbwr4daqkxbee12s7.mp3","text":"如果有人借复仇的名义来杀你，不要犹豫，干掉那个人。一旦你决定拿起武器，杀人就不需要什么理由。","alt":"voice/char_140_whitew/cn_003.mp3"},{"url":"bwiki:d/d2/my9j4mi3t1mcgnzp3g0v08niru2bv5o.mp3","text":"这么久没见，德克萨斯身边多了不少人嘛！哈哈，这很好！也让我和他们认识一下！","alt":"voice/char_140_whitew/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:2/26/1fuchtroc6tjqj7g7kn51umm1rfltho.mp3","text":"你觉得我是杀手？好啊，你当然可以随意解读我。我可以成为任何人，也能做任何工作，在任何时间都能干掉我想干掉的人，只要我想！","alt":"voice/char_140_whitew/cn_005.mp3"},{"url":"bwiki:6/68/0soxxnwykqb6p0m2qost9vbv47dwq3n.mp3","text":"我喜欢力量，博士，尤其是你还向我提供了可以尽情宣泄力量的职位......如果说这个疯狂的世界还剩下什么乐趣，就只剩下用我的力量征服一切这件事了吧！","alt":"voice/char_140_whitew/cn_006.mp3"}],"信赖":[{"url":"bwiki:5/52/bcg0728cbtu9reaejhernw02lyjhayz.mp3","text":"德克萨斯？呵呵，虽然她在害怕我，不过我没打算对她做些什么。我只是想让她变回以前那个德克萨斯，而不是像现在这样怯懦......","alt":"voice/char_140_whitew/cn_007.mp3"},{"url":"bwiki:a/a4/bkmmxe8z7kmq6qcarfhjft71moixmx5.mp3","text":"......那个红色的......没错吧......！博士，我啊，是绝对不能靠近她的！但是，但是——这感觉，这感觉......！如果战斗的话一定会死，但是，还是想和那家伙打上一场啊......！","alt":"voice/char_140_whitew/cn_008.mp3"},{"url":"bwiki:4/4b/rsduypwg6qffxq4onv69wuoi6kut66r.mp3","text":"想了解我和德克萨斯过去的事？哈哈，还真是挑起了一个不得了的话题啊你！总有一天你会知道的，但，绝不会是我来告诉你......","alt":"voice/char_140_whitew/cn_009.mp3"}],"闲置":[{"url":"bwiki:5/5d/11jdd09psr305tlb220bol0ozq2hg95.mp3","text":"睡吧，至少现在，你还能做个美梦......","alt":"voice/char_140_whitew/cn_010.mp3"}],"报到":[{"url":"bwiki:d/d3/krk60puhu08k2c7xfe57hj4zekt0n9x.mp3","text":"暴虐的恶人阻断正义的道路，我的主人啊，以复仇与恶意为名，引领弱小的人吧。","alt":"voice/char_140_whitew/cn_011.mp3"}],"作战记录":[{"url":"bwiki:a/ab/m11pxbebvrq5jyse8yb4at6wvsdmuop.mp3","text":"你爱我不断提升的力量，对吧！","alt":"voice/char_140_whitew/cn_012.mp3"}],"精英化1":[{"url":"bwiki:4/48/n78npj7lvqp4vsnns5v6zl8lfxt8pnl.mp3","text":"哈哈哈，好，我喜欢你对我的信任。德克萨斯做得到吗？","alt":"voice/char_140_whitew/cn_013.mp3"}],"精英化2":[{"url":"bwiki:0/06/jxuveim3w6p3cn989aqy7mo4cbfc3w1.mp3","text":"对对，就是这样，解放更多的力量吧，你该这样做！","alt":"voice/char_140_whitew/cn_014.mp3"}],"编入":[{"url":"bwiki:a/a6/9if7t0dzbppzoyvbxwt5s457nbssebn.mp3","text":"让德克萨斯来担任队长！","alt":"voice/char_140_whitew/cn_017.mp3"}],"任命队长":[{"url":"bwiki:1/13/kap7x0b9lvb9wkqlglrhls197pvh6oe.mp3","text":"把德克萨斯放到我的小队来！","alt":"voice/char_140_whitew/cn_018.mp3"}],"行动出发":[{"url":"bwiki:0/08/ncpg6f3tb8c0uwmvmduovh4wtgsi7il.mp3","text":"哈哈，诸位，反正我记不住你们的脸......算了，出发吧？","alt":"voice/char_140_whitew/cn_019.mp3"}],"行动开始":[{"url":"bwiki:4/49/jfjl821ncfi5kexc1m892nb2iqlo851.mp3","text":"你们就是敌人？那就拜托你们进攻用点力了，别让我太无聊！","alt":"voice/char_140_whitew/cn_020.mp3"}],"选中":[{"url":"bwiki:d/d2/8mc4e3c3q0vbhirppdmt718rxco5rzk.mp3","text":"让我见识见识你的能耐。","alt":"voice/char_140_whitew/cn_021.mp3"},{"url":"bwiki:a/a7/t5ffbmw65l1uv1rqobzhpcdzjv05u8q.mp3","text":"你准备怎么安排？","alt":"voice/char_140_whitew/cn_022.mp3"}],"部署":[{"url":"bwiki:c/c2/9qjw2hmzzrm9gao261cd1sud30l6y62.mp3","text":"不错的位置啊。","alt":"voice/char_140_whitew/cn_023.mp3"},{"url":"bwiki:5/51/hhxv11lnyeikmwuyo5c273se2x35i2w.mp3","text":"哈哈！","alt":"voice/char_140_whitew/cn_024.mp3"}],"技能":[{"url":"bwiki:e/e4/psyugce00rmu0zhjp4pjjbberehcxsf.mp3","text":"加油！还差一点。你就能干掉我了！","alt":"voice/char_140_whitew/cn_025.mp3"},{"url":"bwiki:4/47/dfnidrvq935rgj4gzs6tkkwwqop2a3n.mp3","text":"你能做到吗？","alt":"voice/char_140_whitew/cn_026.mp3"},{"url":"bwiki:1/1c/sojw8wf4zpznvfn1mle49d5lkyaogiz.mp3","text":"试着抵抗我吧！","alt":"voice/char_140_whitew/cn_027.mp3"},{"url":"bwiki:d/d0/e0hdzn58phtpuwik0t5ylkwecfy3y42.mp3","text":"再加把劲！","alt":"voice/char_140_whitew/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:b/b3/2amameuwdo0z3beyobv806ka5gosh6h.mp3","text":"这样就结束了？真无聊。","alt":"voice/char_140_whitew/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:2/29/5nju0jrv5ugz4n7huskeivad7daucdh.mp3","text":"呵呵，喜欢我做的千层酥吗？","alt":"voice/char_140_whitew/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:7/7c/7wm7y2tq3bfm5r73a4ent66n4sztdxh.mp3","text":"马马虎虎吧，让那几个人逃走，我也有责任。","alt":"voice/char_140_whitew/cn_031.mp3"}],"失败":[{"url":"bwiki:a/a4/laj4fstgcyyrkq6yazrv2ntrqec3piw.mp3","text":"棒极了，这下，我践踏他们的欲望变得更强了！哈哈哈！","alt":"voice/char_140_whitew/cn_032.mp3"}],"进驻":[{"url":"bwiki:f/f4/rmc5ifljx0tf0wo1w4tfmpl499ch49f.mp3","text":"咦？刚才一瞬间，好像看到了一个红色的影子。","alt":"voice/char_140_whitew/cn_033.mp3"}],"戳一下":[{"url":"bwiki:4/48/gfz8rddhdp4iefbzq6hgnw2xyzbdtsb.mp3","text":"呵呵。","alt":"voice/char_140_whitew/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:8/80/67ysj901flcfn8602ymz6cg7bddfhjc.mp3","text":"越了解你，也就越了解德克萨斯。太棒了。","alt":"voice/char_140_whitew/cn_036.mp3"}],"标题":[{"url":"bwiki:a/af/it6cjbrfk4h2ovbziy89ahigp086wfy.mp3","text":"明日方舟。","alt":"voice/char_140_whitew/cn_037.mp3"}],"新年":[{"url":"bwiki:d/de/1p1wjw6vahzxyzu7bavbx7vcoaexe6b.mp3","text":"德克萨斯在哪？马上就是倒计时了，这种日子难道她没在罗德岛？呵呵，连这种节日都没看到她人，她那群朋友都在哪？我要去找她了，博士，一起去？","alt":"voice/char_140_whitew/cn_038.mp3"}],"问候":[{"url":"bwiki:6/6e/o2hnc7may7587j0iqmnexup67eby655.mp3","text":"呵，你好，博士。","alt":"voice/char_140_whitew/cn_042.mp3"}]}}