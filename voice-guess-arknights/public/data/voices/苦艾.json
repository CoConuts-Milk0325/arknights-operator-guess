voice/char_405_absin/cn_037.mp3"}],"新年":[{"url":"bwiki:6/6d/3drnrm1z37sz5s3oqsss0hk1jncxiei.mp3","text":"以前的今天，爸爸通常都在加班，很晚才回来，我和妈妈就一直在家里等他。如果太困了我会去窗户旁看雪，等雪盖满对面的招牌，爸爸就回来了......博士，谢谢你，我一个人待着没问题的。","alt":"voice/char_405_absin/cn_038.mp3"}],"问候":[{"url":"bwiki:6/68/9mmfomfdca2rdxkxcryudb78ey1oxr5.mp3","text":"怎么了，要不要来点什么醒醒神。","alt":"voice/char_405_absin/cn_042.mp3"}]}}