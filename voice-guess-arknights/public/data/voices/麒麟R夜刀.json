/cn_036.mp3"}],"标题":[{"url":"bwiki:e/ea/6yehbvahedax7of1g0b3h1bo0g2bsyx.mp3","text":"明日方舟。","alt":"voice/char_1029_yato2/cn_037.mp3"}],"新年":[{"url":"bwiki:d/d4/jc6zg0j9ualsfxzukem5pn57t7pcnzt.mp3","text":"又是一个新年，新年快乐。欢乐的节日往往是敌人放松警惕的时刻，如果您有任何行动计划，请务必交给我执行。","alt":"voice/char_1029_yato2/cn_038.mp3"}],"问候":[{"url":"bwiki:9/94/q3drwa2m8c6f1dxkm8tt9x6skul6p7l.mp3","text":"您好，博士，您还是和从前一样，我有做得更好吗？","alt":"voice/char_1029_yato2/cn_042.mp3"}]}}