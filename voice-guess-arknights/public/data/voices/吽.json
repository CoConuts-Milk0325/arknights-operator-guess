oice_cn/char_226_hmau/cn_038.mp3"},{"url":"bwiki:b/b1/1a45nc4je93snivhde3ofobmkvzig6j.mp3","text":"老板，新年好啊！我心情很好？哈哈，那当然，大家聚在一起高高兴兴的，这么喜庆的事，哪能不高兴？这么说来，老板您是不是也能好好歇上一天了？今天我下厨，晚饭可以过来和我们一起吃啊！","alt":"voice_custom/char_226_hmau_cn_topolect/cn_038.mp3"}],"问候":[{"url":"bwiki:b/b8/5wla02ouhvgrs34bu5efxum7jwqzh24.mp3","text":"老板，早啊。","alt":"voice_cn/char_226_hmau/cn_042.mp3"},{"url":"bwiki:6/6b/o76c5e64rnliw76vrnqi3ohu70r0s17.mp3","text":"老板，早啊。","alt":"voice_custom/char_226_hmau_cn_topolect/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:c/cc/fpclpoggm7kesfbflukz9yg7zp4572h.mp3","text":"嗨，老板，吃过没，我这有些饼干你要吗？","alt":"voice/char_226_hmau/cn_001.mp3"}],"交谈":[{"url":"bwiki:c/cb/9gyzv1u1cer5vpc8tckznmj8t58eq24.mp3","text":"老板，阿要是来骚扰您，还麻烦您多担待担待，这小子虽然爱耍人，不过没什么恶意的，您要是真受不了，喊我来收拾他也行。","alt":"voice/char_226_hmau/cn_002.mp3"},{"url":"bwiki:d/d7/mqh7drro1bnzcesm27u1pmhe004am2g.mp3","text":"老板，您要是饿了就说一声，我去给您炒几个菜。别看我这样，其实我还是从老鲤那里学了几手的。","alt":"voice/char_226_hmau/cn_003.mp3"},{"url":"bwiki:5/5f/t59dazyvzy4hcnfc23b8d3do244g17m.mp3","text":"老板，罗德岛有没有开设机械班的？我对机械很有兴趣，想要进修一下。","alt":"voice/char_226_hmau/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:5/5a/gxmclo0g0xdomvmh8qi73v1hz708f7l.mp3","text":"哈哈，老板，不瞒你说，其实很长一段时间里，我都以为每个侦探都会做老鲤那些事，比如去黑帮火并现场喝茶看戏什么的。","alt":"voice/char_226_hmau/cn_005.mp3"},{"url":"bwiki:6/64/eg2ue0jvt5c36uudax0uo9obdnfeha7.mp3","text":"老板，您也知道，以阿那小子的头脑和能力，将来一定会有大出息的。但对我来说，我只希望，他永远不要变回以前的样子。","alt":"voice/char_226_hmau/cn_006.mp3"}],"信赖":[{"url":"bwiki:6/63/qabuaszxss4lovxjy1fpqb0cxfiihix.mp3","text":"我和老鲤的关系啊，怎么说呢，最早我还是比较怕他的，因为我特别不会应付那种一看城府就很深的人......现在肯定不怕了，也认识这么多年了嘛。","alt":"voice/char_226_hmau/cn_007.mp3"},{"url":"bwiki:8/85/tg3me9boheamjt4faiksqxhf03zkz9h.mp3","text":"老板，您要是有什么想知道的事，我可以帮您联络老鲤，只要是龙门里发生的事情，我还没见过他不知道的。","alt":"voice/char_226_hmau/cn_008.mp3"},{"url":"bwiki:5/50/l5ef0sbp5p1ee3498x1kra1gom9a42c.mp3","text":"打打杀杀的事情，老实说我不是很擅长，大家坐下和和气气的该有多好。不过很多时候就是没办法，我也有不想失去的东西。以前，那是侦探所，现在，也包括罗德岛了。","alt":"voice/char_226_hmau/cn_009.mp3"}],"闲置":[{"url":"bwiki:6/62/lxi82h7qqu8wj3gk2sd4sobz5kkjkef.mp3","text":"老......呼，好险，差点就把老板吵醒了，那我也眯一会儿好了。","alt":"voice/char_226_hmau/cn_010.mp3"}],"报到":[{"url":"bwiki:d/d0/p0hpu9ni329y8ykk55sxmikmx9l9mmv.mp3","text":"您就是老鲤说的博士了吧，您好，我是吽，擅长的是安保工作和机械修理，您要是出门缺个保镖，或者电视冰箱坏了，都可以叫我。","alt":"voice/char_226_hmau/cn_011.mp3"}],"作战记录":[{"url":"bwiki:b/b1/kbrjo5oarstb2bertqwxl7vxaa3vkrl.mp3","text":"人外有人，天外有天呐，我也要加把劲才行。","alt":"voice/char_226_hmau/cn_012.mp3"}],"精英化1":[{"url":"bwiki:e/ec/ep90m4ssyzd7g8gupbg5hxaqpfjh0o5.mp3","text":"谢谢老板，我会更加努力的。","alt":"voice/char_226_hmau/cn_013.mp3"}],"精英化2":[{"url":"bwiki:4/44/1cjn4bnfwe0yebtf2oatexz1fspa1g2.mp3","text":"老板，别客气，尽管差遣我就好。别的事情我没什么自信，但是在皮糙肉厚这一点上，我自认还是有点实力的！","alt":"voice/char_226_hmau/cn_014.mp3"}],"编入":[{"url":"bwiki:8/82/7tkr55f9ym8nmnb11akx0pjrh2oveo9.mp3","text":"任务？没问题。","alt":"voice/char_226_hmau/cn_017.mp3"}],"任命队长":[{"url":"bwiki:9/91/7gfhdr9uiun772j7bk3zx8beuxllmyw.mp3","text":"我保证让大家平安回来。","alt":"voice/char_226_hmau/cn_018.mp3"}],"行动出发":[{"url":"bwiki:a/a5/o1z4fulpy171yktxu1wht1x1zkz8hb3.mp3","text":"大家跟紧我，可别走丢了。","alt":"voice/char_226_hmau/cn_019.mp3"}],"行动开始":[{"url":"bwiki:2/2b/ephva6zwvy3c8x73eoww609ta7o8mye.mp3","text":"有我在，别怕。","alt":"voice/char_226_hmau/cn_020.mp3"}],"选中":[{"url":"bwiki:6/68/6mxygl4m1y7m0dcznrqwvuccc3jic61.mp3","text":"包在我身上！","alt":"voice/char_226_hmau/cn_021.mp3"},{"url":"bwiki:f/fd/bl7tb9a2qzft44k68umnuibrkyvq9cm.mp3","text":"哪里需要我？","alt":"voice/char_226_hmau/cn_022.mp3"}],"部署":[{"url":"bwiki:0/04/79ag33o4nfd72yleu953d37s77oq8ek.mp3","text":"都来我的身后！","alt":"voice/char_226_hmau/cn_023.mp3"},{"url":"bwiki:6/67/hyxli35y5ah42vswbnmsv2k3p0b5e4g.mp3","text":"我来掩护各位！","alt":"voice/char_226_hmau/cn_024.mp3"}],"技能":[{"url":"bwiki:e/ee/itm8v0nnjzobx6e787h7wye6yum414q.mp3","text":"别想前进一步！","alt":"voice/char_226_hmau/cn_025.mp3"},{"url":"bwiki:f/f8/9ytwqykypu0cat75sp4ayi6mpkj9c68.mp3","text":"有谁需要治疗？","alt":"voice/char_226_hmau/cn_026.mp3"},{"url":"bwiki:e/e2/pqc296qlac6dpmrvxzvbmv9r9qdd3lw.mp3","text":"别想伤害我的同伴！","alt":"voice/char_226_hmau/cn_027.mp3"},{"url"