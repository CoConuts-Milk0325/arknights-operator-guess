{"中文":{"登录":[{"url":"bwiki:4/4f/glka9f9wt3yveu9kjozroaqe9nzf0z2.mp3","text":"耶！博士，现在轮到我陪您值班了！","alt":"voice_cn/char_209_ardign/cn_001.mp3"}],"交谈":[{"url":"bwiki:6/6a/jcyen585vgpcse2z4lxfrz5kxg1gj51.mp3","text":"“卡缇”作为代号的含义是什么？啊哈~其实这是大家对我们种族的称呼，把它当做代号也是我家里的习惯啦。","alt":"voice_cn/char_209_ardign/cn_002.mp3"},{"url":"bwiki:0/0f/8omjrn3w61ifc6pna75neh1bv1q47ba.mp3","text":"啊，另一个小组里也有和我同族的孩子耶~下次我去约她玩！","alt":"voice_cn/char_209_ardign/cn_003.mp3"},{"url":"bwiki:e/ea/iab7m44c1k67t2u50umrxxpjrq60fjf.mp3","text":"我出生在莱塔尼亚的北方，那里到处都是雪和森林。对了，下次我来教您滑雪吧！","alt":"voice_cn/char_209_ardign/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:c/c7/ql0qrur485hb86whfqy0wzv0wb8oj0l.mp3","text":"大家经常抱着“重装干员的话，职责就是巩固好自己的防线”这样老旧的印象，这样的想法早就落伍啦！现在可是机动战的时代，速度才是最重要的！","alt":"voice_cn/char_209_ardign/cn_005.mp3"}],"信赖":[{"url":"bwiki:1/1e/1dwvi425e9jbj5ewqhi4zve8u02185u.mp3","text":"哼哼，这股香气，一定是玫兰莎！欸博士我和你说，我好想和她再亲近一点......那样的话，我们的团队协作一定会变得更加默契！","alt":"voice_cn/char_209_ardign/cn_007.mp3"},{"url":"bwiki:b/b2/4lvffonml9jqwo7sdljl5mawt74pkaa.mp3","text":"嘿嘿，我超喜欢和孩子们一起玩的。在老家的时候，我每年都要拉着弟弟妹妹们坐着雪橇去旅行呢，好怀念啊~啊，说到雪橇——不知道安德切尔愿不愿意帮我做一个呢？","alt":"voice_cn/char_209_ardign/cn_008.mp3"},{"url":"bwiki:5/5c/6zdwq5adkiaer8fprgv23h5lqg3zi3z.mp3","text":"我也有很多不喜欢的东西，比如说矿石病啊什么的......但是，反正为这些烦恼也没有用，还不如快快乐乐地度过每一天！而且，还有博士您在我身边呢！","alt":"voice_cn/char_209_ardign/cn_009.mp3"}],"闲置":[{"url":"bwiki:e/e7/9c13maenmje29eptu3qr41futy65icy.mp3","text":"汪！","alt":"voice_cn/char_209_ardign/cn_010.mp3"}],"报到":[{"url":"bwiki:8/8b/de6rc5axxgpj6aq29ejihms33khswrl.mp3","text":"你——好！我第一次来到这么大的移动设施里面，现在超兴奋的！我是卡缇族的梅莉，您就是博士吗？","alt":"voice_cn/char_209_ardign/cn_011.mp3"}],"作战记录":[{"url":"bwiki:3/3c/qe725vel1qft43s0tqer6db6jnud745.mp3","text":"欸嘿嘿，谢谢！","alt":"voice_cn/char_209_ardign/cn_012.mp3"}],"精英化1":[{"url":"bwiki:c/c7/idyvhecrfaunln7aiycqybl6qf8v6ck.mp3","text":"耶！我会努力争取下次晋升的！毕竟有一就有二嘛~","alt":"voice_cn/char_209_ardign/cn_013.mp3"}],"编入":[{"url":"bwiki:e/eb/hz4xngtif4ppvwoff3euwwtm4rofnhe.mp3","text":"好耶！终于等到机会了！","alt":"voice_cn/char_209_ardign/cn_017.mp3"}],"任命队长":[{"url":"bwiki:c/c1/ffjpuah3qiu8fgvfgwets8w865rrnh1.mp3","text":"啊，安赛尔！哎呀，不会的不会的，我才不会带大家乱跑啦......","alt":"voice_cn/char_209_ardign/cn_018.mp3"}],"行动出发":[{"url":"bwiki:a/a8/diejijdqwiziltmy82wzpljlg6h1ed8.mp3","text":"排队出发！向目标战场，前进！","alt":"voice_cn/char_209_ardign/cn_019.mp3"}],"行动开始":[{"url":"bwiki:4/4d/o785dosft4kvl5ygj15w4j83p2ks7n9.mp3","text":"走了！......史都华德，接下来我该怎么做来着？","alt":"voice_cn/char_209_ardign/cn_020.mp3"}],"选中":[{"url":"bwiki:f/f0/4c2p0lcm4rdg3qdbwzbdgfkn5bfmlew.mp3","text":"在战场上，可不能犹豫！","alt":"voice_cn/char_209_ardign/cn_021.mp3"},{"url":"bwiki:d/d9/bwfon45sztnu9v0vf17dzrhp452j7a4.mp3","text":"好！","alt":"voice_cn/char_209_ardign/cn_022.mp3"}],"部署":[{"url":"bwiki:b/b5/n7wgkib4c5do7p8s5rsixmhb12wt54h.mp3","text":"了解！","alt":"voice_cn/char_209_ardign/cn_023.mp3"},{"url":"bwiki:2/22/9zfzsq0j0dtyr1khhsdaxu3dgj1gl8b.mp3","text":"我会保护大家的！","alt":"voice_cn/char_209_ardign/cn_024.mp3"}],"技能":[{"url":"bwiki:7/77/c4nupk57ygbjbf0y0k140frlcut34f0.mp3","text":"啊哈！","alt":"voice_cn/char_209_ardign/cn_025.mp3"},{"url":"bwiki:0/0a/g2zldcdrcfruhdawmymxcck74kinngp.mp3","text":"你们的攻击毫无意义！","alt":"voice_cn/char_209_ardign/cn_026.mp3"}],"高难胜利":[{"url":"bwiki:b/b7/gl2o7elq7z0wl8y8h30lkuf7wtmokbu.mp3","text":"我相信大家一定能做到，对吧安德切尔？","alt":"voice_cn/char_209_ardign/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:6/6f/476qcceov8l6p3pbv8k6fcov3qyznw1.mp3","text":"耶——！大获全胜！","alt":"voice_cn/char_209_ardign/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:a/a8/91mgopl10jufgdq7txnp3yqioof8ipc.mp3","text":"谢谢医疗组！你们都是我的救命恩人......","alt":"voice_cn/char_209_ardign/cn_031.mp3"}],"失败":[{"url":"bwiki:9/91/inm5cpqjwwjrii5fzndes2j9it7q8ki.mp3","text":"呜......对不起......安赛尔......","alt":"voice_cn/char_209_ardign/cn_032.mp3"}],"进驻":[{"url":"bwiki:e/ef/gxwj86tv6uyig279aacig7qcp7fo0h3.mp3","text":"史都华德，接下来我该做点什么好？","alt":"voice_cn/char_209_ardign/cn_033.mp3"}],"戳一下":[{"url":"bwiki:1/11/03itnffm05ko02u08ypskyocnvvdjf4.mp3","text":"哇！过山车——！","alt":"voice_cn/char_209_ardign/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:0/00/830bb6iayvilfokgcgnalmbfmfiaa4s.mp3","text":"玫兰莎？哎，怎么是博士......","alt":"voice_cn/char_209_ardign/cn_036.mp3"}],"标题":[{"url":"bwiki:2/29/7f6w6e81mu9nvv4u00n9p8vpbc43cvb.mp3","text":"明日方舟。","alt":"voice_cn/char_209_ardign/cn_037.mp3"}],"新年":[{"url":"bwiki:c/c3/aadbsm296hahesc2s3nlb87ahqg7r3c.mp3","text":"博士，新年快乐！外面怎么还是没有下雪啊，好可惜，我的雪橇都准备了好久了，什么时候才能像小时候那样，快快乐乐地从山坡上滑下去，然后一头栽倒在雪堆里呢？","alt":"voice_cn/char_209_ardign/cn_038.mp3"}],"问候":[{"url":"bwiki:c/c9/ht06v18l4x8o91af4wlldffusfgirwg.mp3","text":"我在这里哦，博士！","alt":"voice_cn/char_209_ardign/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:7/75/86enuszicf0ydil9zh1mhtlec0fgbv8.mp3","text":"耶！博士，现在轮到我陪您值班了！","alt":"voice/char_209_ardign/cn_001.mp3"}],"交谈":[{"url":"bwiki:e/e2/az6iqhnzjvnol71ayslchdwgx6o06d0.mp3","text":"“卡缇”作为代号的含义是什么？啊哈~其实这是大家对我们种族的称呼，把它当做代号也是我家里的习惯啦。","alt":"voice/char_209_ardign/cn_002.mp3"},{"url":"bwiki:4/41/sduchrxkiwpxq0bwy9eq56wujayp99s.mp3","text":"啊，另一个小组里也有和我同族的孩子耶~下次我去约她玩！","alt":"voice/char_209_ardign/cn_003.mp3"},{"url":"bwiki:d/dc/il8e4bshyzb5v98vtmtfihap40sod5y.mp3","text":"我出生在莱塔尼亚的北方，那里到处都是雪和森林。对了，下次我来教您滑雪吧！","alt":"voice/char_209_ardign/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:e/e3/2mbhl8mjhj0s2qrty3y31lt7xt85o5f.mp3","text":"大家经常抱着“重装干员的话，职责就是巩固好自己的防线”这样老旧的印象，这样的想法早就落伍啦！现在可是机动战的时代，速度才是最重要的！","alt":"voice/char_209_ardign/cn_005.mp3"}],"信赖":[{"url":"bwiki:b/b0/5r1hu032rqkybt0ft42rvc5ie16nghm.mp3","text":"哼哼，这股香气，一定是玫兰莎！欸博士我和你说，我好想和她再亲近一点......那样的话，我们的团队协作一定会变得更加默契！","alt":"voice/char_209_ardign/cn_007.mp3"},{"url":"bwiki:c/c1/gafjpyus1nzl4b7fwx60ih9ucc9syeo.mp3","text":"嘿嘿，我超喜欢和孩子们一起玩的。在老家的时候，我每年都要拉着弟弟妹妹们坐着雪橇去旅行呢，好怀念啊~啊，说到雪橇——不知道安德切尔愿不愿意帮我做一个呢？","alt":"voice/char_209_ardign/cn_008.mp3"},{"url":"bwiki:e/e5/9555q282fha3hml9nd5m5hucx4mk6cl.mp3","text":"我也有很多不喜欢的东西，比如说矿石病啊什么的......但是，反正为这些烦恼也没有用，还不如快快乐乐地度过每一天！而且，还有博士您在我身边呢！","alt":"voice/char_209_ardign/cn_009.mp3"}],"闲置":[{"url":"bwiki:4/47/rcnaxki1mxrfswl4iur8cx58m9ewh56.mp3","text":"汪！","alt":"voice/char_209_ardign/cn_010.mp3"}],"报到":[{"url":"bwiki:a/ae/