{"中文":{"登录":[{"url":"bwiki:3/33/20uh9ph50ls3ek2km7fj1rxj4ze1dr4.mp3","text":"非常抱歉，明明我的工作是照看您，但我的身体没法很好地活动......","alt":"voice_cn/char_179_cgbird/cn_001.mp3"}],"交谈":[{"url":"bwiki:c/cc/e3okr8jmku99l822dbtqtc9ymbdc7r5.mp3","text":"因为我吸入过某种源石毒素，所以记忆和下肢神经系统都受到了损害——凯尔希医生是这样告诉我的......过去的我，到底经历过什么呢？","alt":"voice_cn/char_179_cgbird/cn_002.mp3"},{"url":"bwiki:1/16/cwwpar2nsvsmiumc063cjb5rkdxhy1k.mp3","text":"这只蓝色的小鸟，时常飞来和我聊天......有时候，我会梦见自己变成这孩子的模样，在天空和大地上自由自在地飞翔......","alt":"voice_cn/char_179_cgbird/cn_003.mp3"},{"url":"bwiki:7/7c/khqikrvde9r7wdc48qx3apx1drq9xmi.mp3","text":"曾经，有人把我紧闭在空房间中。只有在治疗别人时，我才能见到其他人......","alt":"voice_cn/char_179_cgbird/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:1/14/t1rjtcs4337f7ez7t8p9ixs5pp5ejg2.mp3","text":"只要握住这把法杖，我就能随心所欲地治愈伤痛......这，难道也是我原本就具备的能力吗？","alt":"voice_cn/char_179_cgbird/cn_005.mp3"},{"url":"bwiki:1/11/8e2ikywkpfoyqs3cbnxvlr9znnclym1.mp3","text":"闪灵小姐告诉我，我们所背负着的，魔族挑起战争的罪恶，终有一天要被偿还。那些囚禁我的人也说过同样的话......可是......","alt":"voice_cn/char_179_cgbird/cn_006.mp3"}],"信赖":[{"url":"bwiki:6/67/02m4vem8zvza5zerseno3k5ussq6gvc.mp3","text":"阿米娅小姐......每次看到她，我都会产生一种怀念的感觉......我曾在哪里，见过她？","alt":"voice_cn/char_179_cgbird/cn_007.mp3"},{"url":"bwiki:5/5b/hsmwj23snbm80tqf0lxjbzqnca1kj9v.mp3","text":"对我来说，记忆只是一些零散的碎片而已......同胞、源石、使命、反抗、战争......为什么，其中一枚碎片里，有您的身影呢？","alt":"voice_cn/char_179_cgbird/cn_008.mp3"},{"url":"bwiki:6/64/fe8xhwpry41fiasd5mjax2uhn7kdgqq.mp3","text":"为什么我会是如今这副身姿呢？为什么我要去承受这迷乱的一切呢？博士，答案，是否就在您的手中呢？","alt":"voice_cn/char_179_cgbird/cn_009.mp3"}],"闲置":[{"url":"bwiki:d/dd/0jb9nd86vv3lx6pwjpt0i26b6y0qt9h.mp3","text":"......于睡梦中，您是否，也会成为一只自由的飞鸟呢？","alt":"voice_cn/char_179_cgbird/cn_010.mp3"}],"报到":[{"url":"bwiki:8/87/6sltypgv0e3g7rwtd99afpx3rxtm772.mp3","text":"丽兹，这是我真正的名字。除此之外的事情，我都不记得了......","alt":"voice_cn/char_179_cgbird/cn_011.mp3"}],"作战记录":[{"url":"bwiki:0/06/ozrtxxnch6ocurwjejly302cxzmubul.mp3","text":"为什么，要壮大我的力量呢。","alt":"voice_cn/char_179_cgbird/cn_012.mp3"}],"精英化1":[{"url":"bwiki:b/bb/lqdzo3j016ypoikxst17mnb2a4xhzbn.mp3","text":"晋升吗？我知道了，这一定是值得高兴的事吧。只是......非常抱歉，我完全没法体会，这种喜悦的感情......","alt":"voice_cn/char_179_cgbird/cn_013.mp3"}],"精英化2":[{"url":"bwiki:2/27/hl5qyyhld3a2xrgbkuyqz4r39ai8c4w.mp3","text":"谢谢博士亲自通知我晋升的事，只是......对于现在的我来说最重要的，是这只小鸟所诉说的外面的故事......","alt":"voice_cn/char_179_cgbird/cn_014.mp3"}],"编入":[{"url":"bwiki:3/3f/303poj15ndp6viwk8atp4666snfnj8w.mp3","text":"这里就是集合地点吗？","alt":"voice_cn/char_179_cgbird/cn_017.mp3"}],"任命队长":[{"url":"bwiki:0/08/05245efmfnofe01vhr7y2vwoz4hxozr.mp3","text":"如果这是您的命令，那么我一定会服从。","alt":"voice_cn/char_179_cgbird/cn_018.mp3"}],"行动出发":[{"url":"bwiki:f/f1/tu4gp5690xqfs795gvhq4gygsmn77c7.mp3","text":"按照说明手册操作就可以了吧？","alt":"voice_cn/char_179_cgbird/cn_019.mp3"}],"行动开始":[{"url":"bwiki:c/ca/85togac5oummta2qlx8mhwqlzsmyxx2.mp3","text":"战场是......夺走生命的地方......","alt":"voice_cn/char_179_cgbird/cn_020.mp3"}],"选中":[{"url":"bwiki:b/bc/i0guju4p72xrdhrfcnonfyvm7u9h7ho.mp3","text":"博士。","alt":"voice_cn/char_179_cgbird/cn_021.mp3"},{"url":"bwiki:8/8c/pkjggfuzb543vlobaakdomf19gbrl4a.mp3","text":"您要选择谁呢？","alt":"voice_cn/char_179_cgbird/cn_022.mp3"}],"部署":[{"url":"bwiki:d/d2/a3jyosm2gi1lutd8x1njzmel8fu6r04.mp3","text":"这就是......战场......","alt":"voice_cn/char_179_cgbird/cn_023.mp3"},{"url":"bwiki:f/f5/gcw412jh1b1kh5a7nn1ujueaj0fjvdr.mp3","text":"掠夺性命，非我之愿。","alt":"voice_cn/char_179_cgbird/cn_024.mp3"}],"技能":[{"url":"bwiki:a/a9/35ij8ol1zahxmlywfrr035l9p93ije8.mp3","text":"请将我的力量，尽数收下。","alt":"voice_cn/char_179_cgbird/cn_025.mp3"},{"url":"bwiki:8/8a/me7lndros1zopxdmzdqf0a46bscuilu.mp3","text":"飞翔吧。","alt":"voice_cn/char_179_cgbird/cn_026.mp3"},{"url":"bwiki:8/8f/ck0injz1awbqwapj4qfkja2s7brgvjn.mp3","text":"你不会受伤。","alt":"voice_cn/char_179_cgbird/cn_027.mp3"},{"url":"bwiki:3/30/h03pcqf2074yxm4vol92rhoobwon5f9.mp3","text":"我将保护你。","alt":"voice_cn/char_179_cgbird/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:7/73/q1e71oxememko030x49x09hsyjsym27.mp3","text":"无论是怎样的战斗，我都......","alt":"voice_cn/char_179_cgbird/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:4/46/j34uvr0aqwzmkjflx5xwllaed9qom25.mp3","text":"战斗，直至生命的尽头......这就是我们的宿命。","alt":"voice_cn/char_179_cgbird/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:c/c0/lcndgj88zso6cz1oh45aby0cgd1imvf.mp3","text":"或许，他们已经逃离了命运的牢笼......","alt":"voice_cn/char_179_cgbird/cn_031.mp3"}],"失败":[{"url":"bwiki:5/5c/4hw3ja5fmm47p961yq9ja49oklkkvsl.mp3","text":"这就是......绝望吗......","alt":"voice_cn/char_179_cgbird/cn_032.mp3"}],"进驻":[{"url":"bwiki:5/53/2k0g7dbwf0zpsxhzhtsperea266axeu.mp3","text":"房间......也是一种牢笼。","alt":"voice_cn/char_179_cgbird/cn_033.mp3"}],"戳一下":[{"url":"bwiki:d/d2/q8zanj025ilwlacnhmbkj77rlu8koik.mp3","text":"嗯，怎么了。","alt":"voice_cn/char_179_cgbird/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:2/2a/3iq05lu19ba0gzq25iravvutbh07hhy.mp3","text":"博士，您现在在做的，就是所谓的亲密接触吗？","alt":"voice_cn/char_179_cgbird/cn_036.mp3"}],"标题":[{"url":"bwiki:8/8d/lp442p87096sjlpadkr5whlx5noff94.mp3","text":"明日方舟。","alt":"voice_cn/char_179_cgbird/cn_037.mp3"}],"新年":[{"url":"bwiki:3/37/dtpkgiqjfnjlbyjew51wt5pzahd7235.mp3","text":"新年......快乐？对不起，我好像忘记了这个节日的涵义——您是说，只要许一个愿望就可以了？我希望，新的一年里，玛嘉烈和闪灵都可以平安健康......当然，还有博士您。","alt":"voice_cn/char_179_cgbird/cn_038.mp3"}],"问候":[{"url":"bwiki:1/18/7hh13ovikuxzatt6vfzk4a3iwngj5dg.mp3","text":"您好，博士。","alt":"voice_cn/char_179_cgbird/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:0/05/k2bxqlwkznrmk65naktgs0fsp78dvqg.mp3","text":"非常抱歉，明明我的工作是照看您，但我的身体没法很好地活动......","alt":"voice/char_179_cgbird/cn_001.mp3"}],"交谈":[{"url":"bwiki:2/20/2fzv8jqqlu70xkbp48rgc7ophrfn0sz.mp3","text":"因为我吸入过某种源石毒素，所以记忆和下肢神经系统都受到了损害——凯尔希医生是这样告诉我的......过去的我，到底经历过什么呢？","alt":"voice/char_179_cgbird/cn_002.mp3"},{"url":"bwiki:b/bf/fp7f1635mf8noboxn452u0sd4i8k0cs.mp3","text":"这只蓝色的小鸟，时常飞来和我聊天......有时候，我会梦见自己变成这孩子的模样，在天空和大地上自由自在地飞翔......","alt":"voice/char_179_cgbird/cn_003.mp3"},{"url":"bwiki:a/a9/79zn93ria850bzmdoq1b7sw75fqjgup.mp3","text":"曾经，有人把我紧闭在空房间中。只有在治疗别人时，我才能见到其他人......","alt":"voice/char_179_cgbird/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:0/05/ruoh6l0ol2ceqt440jy05rad9bzt4p8.mp3","text":"只要握住这把法杖，我就能随心所欲地治愈伤痛......这，难道也是我原本就具备的能力吗？","alt":"voice/char_179_cgbird/cn_005.mp3"},{"url":"bwiki:a/ae/pljymx6k7g2u8l6nuwkaz2eyh174ahj.mp3","text":"闪灵小姐告诉我，我们所背负着的，魔族挑起战争的罪恶，终有一天要被偿还。那些囚禁我的人也说过同样的话......可是......","alt":"voice/char_179_cgbird/cn_006.mp3"}],"信赖":[{"url":"bwiki:6/64/bes8nke830pi86ii4rkanvfr2b6nw89.mp3","text":"阿米娅小姐......每次看到她，我都会产生一种怀念的感觉......我曾在哪里，见过她？","alt":"voice/char_179_cgbird/cn_007.mp3"},{"url":"bwiki:c/cc/1gfhafqcm4rqzgs711lyz1smpc1oc3p.mp3","text":"对我来说，记忆只是一些零散的碎片而已......同胞、源石、使命、反抗、战争......为什么，其中一枚碎片里，有您的身影呢？","alt":"voice/char_179_cgbird/cn_008.mp3"},{"url":"bwiki:9/9e/g4fwtl8s0sf7ra9jhm4akss34dfmie0.mp3","text":"为什么我会是如今这副身姿呢？为什么我要去承受这迷乱的一切呢？博士，答案，是否就在您的手中呢？","alt":"voice/char_179_cgbird/cn_009.mp3"}],"闲置":[{"url":"bwiki:1/1c/mykruiyidwoe2ijdls06o2ng8wd6ncx.mp3","text":"......于睡梦中，您是否，也会成为一只自由的飞鸟呢？","alt":"voice/char_179_cgbird/cn_010.mp3"}],"报到":[{"url":"bwiki:f/f8/i9vrecb6uouyzia40drmqvj00f9klu8.mp3","text":"丽兹，这是我真正的名字。除此之外的事情，我都不记得了......","alt":"voice/char_179_cgbird/cn_011.mp3"}],"作战记录":[{"url":"bwiki:6/6b/q3v64n7szb1bogojle17dqpfj9voma7.mp3","text":"为什么，要壮大我的力量呢。","alt":"voice/char_179_cgbird/cn_012.mp3"}],"精英化1":[{"url":"bwiki:1/1f/dwcfykg3vsd4dvq3muxkj4bq2grdi0e.mp3","text":"晋升吗？我知道了，这一定是值得高兴的事吧。只是......非常抱歉，我完全没法体会，这种喜悦的感情......","alt":"voice/char_179_cgbird/cn_013.mp3"}],"精英化2":[{"url":"bwiki:2/28/249n9wv9bffr8429uu9bf63aczsssbb.mp3","text":"谢谢博士亲自通知我晋升的事，只是......对于现在的我来说最重要的，是这只小鸟所诉说的外面的故事......","alt":"voice/char_179_cgbird/cn_014.mp3"}],"编入":[{"url":"bwiki:9/96/lhfmobw4zfs51l61wd2a1zn7ruw5mrq.mp3","text":"这里就是集合地点吗？","alt":"voice/char_179_cgbird/cn_017.mp3"}],"任命队长":[{"url":"bwiki:0/02/khn6feexijompg76zmu0f7z67gi9mx8.mp3","text":"如果这是您的命令，那么我一定会服从。","alt":"voice/char_179_cgbird/cn_018.mp3"}],"行动出发":[{"url":"bwiki:4/4a/774vweq7mg9oprodu995r3b3xvbwmhx.mp3","text":"按照说明手册操作就可以了吧？","alt":"voice/char_179_cgbird/cn_019.mp3"}],"行动开始":[{"url":"bwiki:b/b6/g1957pjl6tz35rr53mkw8n2d6jthbgs.mp3","text":"战场是......夺走生命的地方......","alt":"voice/char_179_cgbird/cn_020.mp3"}],"选中":[{"url":"bwiki:5/5e/7hqbb3mks538kxyuw