p3"}],"精英化2":[{"url":"bwiki:d/dd/m5r78u4q32nzvq2qafhzv7wey5b8mg3.mp3","text":"资深工程干员吗？这样我是不是就可以领到更多的工资了？可以多寄回去一点给爸爸妈妈，也要写一封信告诉爷爷。嗯，果然，我接下来的都是好日子啦！","alt":"voice/char_488_buildr/cn_014.mp3"}],"编入":[{"url":"bwiki:5/53/2qbrklqyq4gj7jxs0xmbijieffwpf8u.mp3","text":"我去查看一下周边环境。","alt":"voice/char_488_buildr/cn_017.mp3"}],"任命队长":[{"url":"bwiki:0/0f/ma64f6umztefac5rlydzpy3hyp17mla.mp3","text":"之前学校里的老顽固教授们通常都做什么来着......先开个动员会？噗，会被大家讨厌吧......","alt":"voice/char_488_buildr/cn_018.mp3"}],"行动出发":[{"url":"bwiki:c/c3/dx1f5tusytt9z76aw9tvoocvwatu20w.mp3","text":"大家拿好结构图，小心事故多发区域。","alt":"voice/char_488_buildr/cn_019.mp3"}],"行动开始":[{"url":"bwiki:9/96/i62oruelc1z5i9rgas9p6qnx57vj7ba.mp3","text":"已抵达最佳作战位置，随时可以行动。","alt":"voice/char_488_buildr/cn_020.mp3"}],"选中":[{"url":"bwiki:f/f6/67zxwr50crsouf51oavlhu0h6ovfzob.mp3","text":"以上需求均已收到。","alt":"voice/char_488_buildr/cn_021.mp3"},{"url":"bwiki:3/35/i51xvhund1t3z1k16o3854wibwpx9c0.mp3","text":"我会提出最佳方案。","alt":"voice/char_488_buildr/cn_022.mp3"}],"部署":[{"url":"bwiki:3/31/gpv26p2m80k4iwpj3zd5vklcbjthd77.mp3","text":"如果您需要，我会毫不犹豫地破坏这里。","alt":"voice/char_488_buildr/cn_023.mp3"},{"url":"bwiki:8/8f/18mfu0aetaqxg35bwdybvq1qa19z25u.mp3","text":"我的锤子没那么脆弱！","alt":"voice/char_488_buildr/cn_024.mp3"}],"技能":[{"url":"bwiki:3/3b/5kp93i9cz2l3aku2zz2s7s8mx7s1jnf.mp3","text":"极限承载强度计算完成！","alt":"voice/char_488_buildr/cn_025.mp3"},{"url":"bwiki:4/45/spdqadu6bzsnw64ueetbnzgzl29avjo.mp3","text":"应力集中区域测算完毕！","alt":"voice/char_488_buildr/cn_026.mp3"},{"url":"bwiki:4/48/odvlsw38ibnyuro96vznmxp1zs50zjc.mp3","text":"敌方掩体已击毁。","alt":"voice/char_488_buildr/cn_027.mp3"},{"url":"bwiki:f/f4/2ilco7zft8oyltm3ayk8r9n19xpntlz.mp3","text":"结构稳定，大家放心！","alt":"voice/char_488_buildr/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:5/53/f56esxbcxd282807w2p2xn68318hbm3.mp3","text":"如同一座永远不会被摧毁的建筑物。","alt":"voice/char_488_buildr/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:a/a7/nqnjw2jty2i6ska96pfj50l732pzn5d.mp3","text":"这次就不是我倒霉啦，是他们运气不好！","alt":"voice/char_488_buildr/cn_030.mp3"}],"非3星胜利":[{"