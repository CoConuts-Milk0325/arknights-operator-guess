r_208_melan/cn_031.mp3"}],"失败":[{"url":"bwiki:2/26/7i29pksvh07wpmemoq4c9gqu426yaug.mp3","text":"失败了......竟然，会变成这样......","alt":"voice/char_208_melan/cn_032.mp3"}],"进驻":[{"url":"bwiki:2/22/0nwburtusny6n89s68ktvbwir5f6akh.mp3","text":"这里......这里还有其他人在的吗......？","alt":"voice/char_208_melan/cn_033.mp3"}],"戳一下":[{"url":"bwiki:1/1c/03ckxoq3pw0rol8cvdrink4fkx4avml.mp3","text":"是、是谁——博士！","alt":"voice/char_208_melan/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:4/48/3zhzvyotsh62efxf5uejfw9yr8cmvyf.mp3","text":"博士，感谢您一直这样关心我......那个，其实......我希望自己，今后也能更多地去战斗。","alt":"voice/char_208_melan/cn_036.mp3"}],"标题":[{"url":"bwiki:9/91/920i9vnnt0q21i3idm0rns8nfkcpct7.mp3","text":"明日方舟。","alt":"voice/char_208_melan/cn_037.mp3"}],"新年":[{"url":"bwiki:2/2e/gaxn21etzhbrkehuwxhf45vcaigjido.mp3","text":"新年......快乐，博士，我的父母也给我寄来了信件和礼物，我的感知能力在今天似乎也有所好转，今天......是很开心的一天，希望您也有这样的好心情。","alt":"voice/char_208_melan/cn_038.mp3"}],"问候":[{"url":"bwiki:8/86/kfx4e1wdo6oawdy9nz9s2vm1uefzimo.mp3","text":"博士。","alt":"voice/char_208_melan/cn_042.mp3"}]}}