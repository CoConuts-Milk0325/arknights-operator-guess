{"中文":{"登录":[{"url":"bwiki:6/62/hyed61q6u28d4ih15dx0hgsa0jqm205.mp3","text":"那个，我、我该站在哪里才好？坐，坐下？......那，那我该坐在哪里？","alt":"voice_cn/char_127_estell/cn_001.mp3"}],"交谈":[{"url":"bwiki:3/3f/ef706b2mp0unghyt6vljn6fqiq5ufob.mp3","text":"我的伙伴，就是那只小鸟，最近它总是失踪，那个，不会是不喜欢再和我待在一起了吧......","alt":"voice_cn/char_127_estell/cn_002.mp3"},{"url":"bwiki:1/1c/dici9md7pmkme049shuqa1fkiukca6z.mp3","text":"我这样子，看起来根本不像是干员吧......有我这样的干员，您也不会高兴的。请放心，我不会说自己属于罗德岛的......","alt":"voice_cn/char_127_estell/cn_003.mp3"},{"url":"bwiki:f/fb/ljxol06203oc9wtr0npsfj3wpid04w4.mp3","text":"如您所见，我的头发没法编一些常见的发型，所以就只能像这样把头发放下来......果然我这样，还是不太好吧......","alt":"voice_cn/char_127_estell/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:b/b0/k4yg1nombzq1mboz74k0tif7kks245d.mp3","text":"我这对变异的角很显眼吧，本来我以为，自己已经习惯被人观看了......果然......还是会觉得不好意思啊......","alt":"voice_cn/char_127_estell/cn_005.mp3"},{"url":"bwiki:3/3c/gadjcr97dk2gh3uo4ajvbl5hoq19ahe.mp3","text":"我生活在荒野时认识的朋友们，也渐渐聚集在罗德岛了呢......这样，多多少少，我也不会那么孤单了......我会努力战斗保护大家的。","alt":"voice_cn/char_127_estell/cn_006.mp3"}],"信赖":[{"url":"bwiki:5/52/k38yyftay2tt0ax1va4ris12hmifnia.mp3","text":"其实从小我就一直......一直、梦想成为一个公主......那个，您想笑就笑吧，我、没关系的......","alt":"voice_cn/char_127_estell/cn_007.mp3"},{"url":"bwiki:b/bc/49r8f7ijzmkmqleiq61ivru71yxg8cy.mp3","text":"我一直被敌人“怪胎、怪胎“地叫......但......是啊，我是怪胎，是想要保护博士，想要保护所有人的怪胎。","alt":"voice_cn/char_127_estell/cn_008.mp3"},{"url":"bwiki:4/45/j3jsrfdkp6a3t2xyfyks9tm6c76btcf.mp3","text":"那个，总是很活泼的医生，好像和我是同族人吧......虽然我挺想和她说说话的，但是......还是有点害怕她......","alt":"voice_cn/char_127_estell/cn_009.mp3"}],"闲置":[{"url":"bwiki:2/24/0r9qks0j6evdb8dfn1exa0uianhx4c8.mp3","text":"这下没有人盯着我看了吧......？呼——终于......","alt":"voice_cn/char_127_estell/cn_010.mp3"}],"报到":[{"url":"bwiki:1/1d/969sfiqajj3xjwhlxmdu323a5f7e71d.mp3","text":"您、您好......那个，呃，对不起......我的角不小心把您办公室的门捅穿......了......","alt":"voice_cn/char_127_estell/cn_011.mp3"}],"作战记录":[{"url":"bwiki:5/53/ktr9wonrqwuf11riwb2ftosxfwenkbd.mp3","text":"比现在更强的力量，我真能控制得了吗......？","alt":"voice_cn/char_127_estell/cn_012.mp3"}],"精英化1":[{"url":"bwiki:3/33/kpyn3n3iqace5y5hys4zbddoxe6byhb.mp3","text":"晋升是什么......？虽然还不太明白，但我确实帮上您的忙了，是吗？","alt":"voice_cn/char_127_estell/cn_013.mp3"}],"精英化2":[{"url":"bwiki:e/e1/kb7pbt67crxv7w1uqn06mcit7zkewee.mp3","text":"多亏博士您，让我有了一点自信......我究竟该做什么，是为了谁拥有这样的力量，现在，我现在好像稍微明白了。","alt":"voice_cn/char_127_estell/cn_014.mp3"}],"编入":[{"url":"bwiki:7/79/lmu846eyjheemeff7cub0cdj141qxle.mp3","text":"请大家别太注意我......","alt":"voice_cn/char_127_estell/cn_017.mp3"}],"任命队长":[{"url":"bwiki:1/17/chs1sr2v4p58grhi0iatsz7yfjzct7f.mp3","text":"哇、我......！？真、真的没问题吗......？","alt":"voice_cn/char_127_estell/cn_018.mp3"}],"行动出发":[{"url":"bwiki:4/4d/c3arthrr1oyzy41b2nbbw1qf6hdlrwj.mp3","text":"那个，各、各位，要出击了......！下、下令，就是这样的感觉吧？","alt":"voice_cn/char_127_estell/cn_019.mp3"}],"行动开始":[{"url":"bwiki:b/b1/4ye7imvni6tawiya39ukgi8n98u3tri.mp3","text":"不、不会让那些恶徒，得逞的！","alt":"voice_cn/char_127_estell/cn_020.mp3"}],"选中":[{"url":"bwiki:4/4a/07h8zru572chb30fwhn882vrtp0przt.mp3","text":"啊，我吗......？","alt":"voice_cn/char_127_estell/cn_021.mp3"},{"url":"bwiki:3/33/k0sn4ixdaki42yt7jaq1yx5u0eu2rcf.mp3","text":"让我来！","alt":"voice_cn/char_127_estell/cn_022.mp3"}],"部署":[{"url":"bwiki:2/2f/3rafb7q4vy2rzf3jrvgyr1we302vh7a.mp3","text":"我来防守这里的话，应该能吸引到很多敌人......","alt":"voice_cn/char_127_estell/cn_023.mp3"},{"url":"bwiki:8/83/jj7nt41lewr391889he53puya50c1u5.mp3","text":"让敌人感到恐惧，我能做到吧......？","alt":"voice_cn/char_127_estell/cn_024.mp3"}],"技能":[{"url":"bwiki:d/d5/tslbcjhch87clj72te5s2adbmkb21s3.mp3","text":"哈啊！","alt":"voice_cn/char_127_estell/cn_025.mp3"},{"url":"bwiki:4/4d/p2bxoyzh9n92eqx4iz51evxq0cbb0wb.mp3","text":"这里，不让过！","alt":"voice_cn/char_127_estell/cn_026.mp3"},{"url":"bwiki:2/2c/ts9otjlyxurrb7dqztwxn3qrvrzai90.mp3","text":"我不会放你们离开的！","alt":"voice_cn/char_127_estell/cn_027.mp3"},{"url":"bwiki:6/67/efh2g2z012p9uqv1ax8fhsmvunchpgx.mp3","text":"请你害怕我吧！","alt":"voice_cn/char_127_estell/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:c/c3/du3q1p6akz9cy5j9mt4w4fkhi6mukb4.mp3","text":"再加把劲......嗯，再加把劲！","alt":"voice_cn/char_127_estell/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:a/aa/06k7hagd4y24n6jl23rjg3zvwas8ygn.mp3","text":"您会为我们的战果感到骄傲吗，博士？","alt":"voice_cn/char_127_estell/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:7/75/35id1w6ygabm12r0zrxravjbeiipffu.mp3","text":"太好了......我们赢了！博士！","alt":"voice_cn/char_127_estell/cn_031.mp3"}],"失败":[{"url":"bwiki:a/aa/9leb7cp6npcdtlboifernh3gavriaow.mp3","text":"果然......我什么都没做到......","alt":"voice_cn/char_127_estell/cn_032.mp3"}],"进驻":[{"url":"bwiki:e/ec/fdh7cqkwmc5u3kkn9ca4zf4xv1fshj4.mp3","text":"哇啊......这里，好宽阔！太好了......","alt":"voice_cn/char_127_estell/cn_033.mp3"}],"戳一下":[{"url":"bwiki:7/73/hqlendewllib14one5y2czrlf9c7dv9.mp3","text":"那个......？","alt":"voice_cn/char_127_estell/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:a/ab/gwmuapi1bnyeqdq5tnho8n1c304q43b.mp3","text":"博士总是这么关心我，我非常、非常高兴......","alt":"voice_cn/char_127_estell/cn_036.mp3"}],"标题":[{"url":"bwiki:9/9a/oad4oabzvss8wspep6a5srcrsuvabih.mp3","text":"明日方舟。","alt":"voice_cn/char_127_estell/cn_037.mp3"}],"新年":[{"url":"bwiki:4/4b/nb4k26nw76cpfo54eylm2yi2ej9g2sc.mp3","text":"新年快乐，博士......我有一个愿望，那个，就是以后能和大家更顺畅地交流，我能做到吗？还有，还有交到更多的朋友，这是可以的吗？拥有朋友这件事......","alt":"voice_cn/char_127_estell/cn_038.mp3"}],"问候":[{"url":"bwiki:9/92/1pc193z8y8dxwlr6z280mqqf4lm34ns.mp3","text":"博，博士...","alt":"voice_cn/char_127_estell/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:3/3f/9y3qgxzr9kipewd1haqucbhmn64m1zy.mp3","text":"那个，我、我该站在哪里才好？坐，坐下？......那，那我该坐在哪里？","alt":"voice/char_127_estell/cn_001.mp3"}],"交谈":[{"url":"bwiki:5/5e/rubgqpdkap4a9lyy9fqdyvsb6qs9gr2.mp3","text":"我的伙伴，就是那只小鸟，最近它总是失踪，那个，不会是不喜欢再和我待在一起了吧......","alt":"voice/char_127_estell/cn_002.mp3"},{"url":"bwiki:2/26/cw4f0bo6ltmyd1m4ao0fun82qs2333u.mp3","text":"我这样子，看起来根本不像是干员吧......有我这样的干员，您也不会高兴的。请放心，我不会说自己属于罗德岛的......","alt":"voice/char_127_estell/cn_003.mp3"},{"url":"bwiki:0/06/h7uxcb95rirq35efzcg4elgg3b71pyl.mp3","text":"如您所见，我的头发没法编一些常见的发型，所以就只能像这样把头发放下来......果然我这样，还是不太好吧......","alt":"voice/char_127_estell/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:a/a4/k4ngqk1ble5jlfuwflpmc2ei6nhp259.mp3","t