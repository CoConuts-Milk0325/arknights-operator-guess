:7/73/j49dp3tyg6wpgmepua6t5bluyjoi4zg.mp3","text":"不、不会让那些恶徒，得逞的！","alt":"voice/char_127_estell/cn_020.mp3"}],"选中":[{"url":"bwiki:0/05/1aqr1zl53xk24p96t2m9eu798w1l5mr.mp3","text":"啊，我吗......？","alt":"voice/char_127_estell/cn_021.mp3"},{"url":"bwiki:a/af/efli7ctg1zqrrrmm2ut64v69hykm6ia.mp3","text":"让我来！","alt":"voice/char_127_estell/cn_022.mp3"}],"部署":[{"url":"bwiki:2/2d/55tj73oym99nzzr6a0d2u9cm9diimdr.mp3","text":"我来防守这里的话，应该能吸引到很多敌人......","alt":"voice/char_127_estell/cn_023.mp3"},{"url":"bwiki:8/81/32bebemxheim6w9t6b89itw822hoh75.mp3","text":"让敌人感到恐惧，我能做到吧......？","alt":"voice/char_127_estell/cn_024.mp3"}],"技能":[{"url":"bwiki:2/26/jw3jsxnwrftoczvekuxwr6ztj4898h5.mp3","text":"哈啊！","alt":"voice/char_127_estell/cn_025.mp3"},{"url":"bwiki:3/3c/5nzfzacoqd3ta2xpq2nw1e6nj9oy1sw.mp3","text":"这里，不让过！","alt":"voice/char_127_estell/cn_026.mp3"},{"url":"bwiki:4/4d/8b34de75m6qmy714c2w5oavsm1gu5kb.mp3","text":"我不会放你们离开的！","alt":"voice/char_127_estell/cn_027.mp3"},{"url":"bwiki:b/be/6xlsi4qrsyrxiuq6e3wj42gxxfljhfd.mp3","text":"请你害怕我吧！","alt":"voice/char_127_estell/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:7/7a/cpfvde45uxdhe9eccbfjk4czdgpt3qz.mp3","text":"再加把劲......嗯，再加把劲！","alt":"voice/char_127_estell/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:d/db/aa06jz4d2ryfdpi3e94ho6acthv031d.mp3","text":"您会为我们的战果感到骄傲吗，博士？","alt":"voice/char_127_estell/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:0/0e/8l1lcvefshnzabds6h8saztqa5lgohj.mp3","text":"太好了......我们赢了！博士！","alt":"voice/char_127_estell/cn_031.mp3"}],"失败":[{"url":"bwiki:6/6b/6aec066bfo7t1phrw7pspi9powp7j9r.mp3","text":"果然......我什么都没做到......","alt":"voice/char_127_estell/cn_032.mp3"}],"进驻":[{"url":"bwiki:b/b9/2zk1v4uhu4id21evffxs7j8amyj8jr8.mp3","text":"哇啊......这里，好宽阔！太好了......","alt":"voice/char_127_estell/cn_033.mp3"}],"戳一下":[{"url":"bwiki:5/58/b4bygk8nsz7sdalgn02qctpkd2k5h1x.mp3","text":"那个......？","alt":"voice/char_127_estell/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:c/cf/k8yivvuzsg3bb67gc47m9066p9zogw3.mp3","text":"博士总是这么关心我，我非常、非常高兴......","alt":"voice/char_127_estell/cn_036.mp3"}],"标题":[{"url":"bwiki:a/ab/junqum6e67yd1d76j7447vg7zmq9i8z.mp3","text":"明日方舟。","alt":"voice/char_127_estell/cn_037.mp3"}],"新年":[{"url":"bwiki:d/dd/e8b4ga5mfqoff41w7g94o1dz7ypvgyv.mp3","text":"新年快乐，博士......我有一个愿望，那个，就是以后能和大家更顺畅地交流，我能做到吗？还有，还有交到更多的朋友，这是可以的吗？拥有朋友这件事......","alt":"voice/char_127_estell/cn_038.mp3"}],"问候":[{"url":"bwiki:e/ed/0c4inzpzuwgtstcdv5prunuwkuno5o5.mp3","text":"博，博士...","alt":"voice/char_127_estell/cn_042.mp3"}]}}