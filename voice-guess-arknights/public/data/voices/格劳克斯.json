{"中文":{"登录":[{"url":"bwiki:e/ea/d54b1io561su5ec2pdjy4dmopi7s2m5.mp3","text":"我会在一边安安静静地调整倾诉者的......保证不会打扰你。","alt":"voice_cn/char_326_glacus/cn_001.mp3"}],"交谈":[{"url":"bwiki:1/11/2sqpiwurjcjds56gkx8ioz82itg0qxe.mp3","text":"为什么大家总是对蓝毒小姐敬而远之呢？是我不太一样？......好吧。","alt":"voice_cn/char_326_glacus/cn_002.mp3"},{"url":"bwiki:b/b0/2vl7v37wmm2w3lwqy57kohsjaw4sxgk.mp3","text":"博士有什么想说的话吗？没什么？总之......我就在这里。","alt":"voice_cn/char_326_glacus/cn_003.mp3"},{"url":"bwiki:e/e9/rv5k4picifel4a0htt9gwj41uazzfbp.mp3","text":"宿舍很热的话会让人没有食欲......啊。这是家族遗传，真的不是在抱怨。","alt":"voice_cn/char_326_glacus/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:8/89/8mrlwjxop4nj4njv6oryo9ouk4tu71f.mp3","text":"我之所以来到这里......奔跑都做不到的话，会有谁愿意主动离开故土呢？","alt":"voice_cn/char_326_glacus/cn_005.mp3"},{"url":"bwiki:f/f8/hrhk9fnppcar0x19x5zmq9s0ukxeesi.mp3","text":"虽然火神小姐和我一样不喜欢“旧的东西”，但我觉得，我们的想法从根本上还是有差别的。","alt":"voice_cn/char_326_glacus/cn_006.mp3"}],"信赖":[{"url":"bwiki:1/10/f11l0wu8hjhmrlognq4ylb3xcj2iphm.mp3","text":"博士，那个，蓝毒小姐说我总是像藏着什么想法似的，我会给人这种感觉吗？偶尔？不会吧......","alt":"voice_cn/char_326_glacus/cn_007.mp3"},{"url":"bwiki:2/2a/gxyorjym8y2kelfh5capqwzt43axyvo.mp3","text":"并不是我不太愿意说话，只是以前的日子里，我其实很少有什么开口的权利——所以只是习惯而已！希望博士不要误会了！","alt":"voice_cn/char_326_glacus/cn_008.mp3"},{"url":"bwiki:2/21/ltxu7rj3morhd08swjekajcgkwrfcfg.mp3","text":"对我而言，有两段记忆如奇迹般耀眼。其中之一，是当我第一次借助这孩子奔跑起来的时候，景色万般旖旎，视野是那么的开阔......另一次，唔，就是身在罗德岛的此时此刻吧。","alt":"voice_cn/char_326_glacus/cn_009.mp3"}],"闲置":[{"url":"bwiki:e/e6/dat4seg5eam4llf8zqclukzwwabyu35.mp3","text":"嗯？唔，博士什么时候睡着的......","alt":"voice_cn/char_326_glacus/cn_010.mp3"}],"报到":[{"url":"bwiki:b/bf/2gfz20w7kdlbtzthsj4rv39rnqrkq28.mp3","text":"干员格劳克斯，今日报到。请问我可以回房间了吗？","alt":"voice_cn/char_326_glacus/cn_011.mp3"}],"作战记录":[{"url":"bwiki:0/04/d2tu1ytv780v4r7111ziq6noou5akee.mp3","text":"嗯？啊，好的，原来如此，我明白了。","alt":"voice_cn/char_326_glacus/cn_012.mp3"}],"精英化1":[{"url":"bwiki:c/c2/6a4bqnkblh2xo837l4nfu3eb0f1flm0.mp3","text":"其实这把武器的名字是我自己取的，也许这才是我心里的想法......欸？刚才宣布的晋升干员原来是我吗？","alt":"voice_cn/char_326_glacus/cn_013.mp3"}],"精英化2":[{"url":"bwiki:5/53/rj26lfr5cqnyje0205jmwtl6qjqz6t6.mp3","text":"信任吗.....那个，我不知道该怎么表达，但我会继续努力的。","alt":"voice_cn/char_326_glacus/cn_014.mp3"}],"编入":[{"url":"bwiki:d/d5/1qdbbioqqmcfwxxc8uvjvvq18affkno.mp3","text":"队员们有做好接地措施吗？","alt":"voice_cn/char_326_glacus/cn_017.mp3"}],"任命队长":[{"url":"bwiki:8/81/212ryqh9vonq85jz45vqxm2kk38esr9.mp3","text":"欸？我是队长？难道刚才不小心就答应下来了......","alt":"voice_cn/char_326_glacus/cn_018.mp3"}],"行动出发":[{"url":"bwiki:7/7b/q5dip9r1tlathlect7va8veah5ss1s1.mp3","text":"这次能捡到什么有趣的东西呢？","alt":"voice_cn/char_326_glacus/cn_019.mp3"}],"行动开始":[{"url":"bwiki:8/81/40i78sat6ztv6cx28nthfute3whub8s.mp3","text":"电磁脉冲立场准备就绪。","alt":"voice_cn/char_326_glacus/cn_020.mp3"}],"选中":[{"url":"bwiki:5/54/95amnso9j9na0w8lac9zjv2ubdtv5sd.mp3","text":"嗯？喊我吗？","alt":"voice_cn/char_326_glacus/cn_021.mp3"},{"url":"bwiki:3/3a/96gcjtfmbb5sdl75kvci4rob6vp7kd3.mp3","text":"电量充足，随时准备。","alt":"voice_cn/char_326_glacus/cn_022.mp3"}],"部署":[{"url":"bwiki:d/d6/gfpcrpyo9tekpxt1gai83xhqfj0crnn.mp3","text":"地面的触感......","alt":"voice_cn/char_326_glacus/cn_023.mp3"},{"url":"bwiki:5/5e/3789n9o78o7ihm6lkvmgmbz2p7y9sfm.mp3","text":"别担心，顺利登陆。","alt":"voice_cn/char_326_glacus/cn_024.mp3"}],"技能":[{"url":"bwiki:c/c9/0ogq2qbd5x1jo75qupdjqkqgabbrur5.mp3","text":"满功率输出！","alt":"voice_cn/char_326_glacus/cn_025.mp3"},{"url":"bwiki:b/b0/eogo5agqztj68y3t3bi269vzdd2296c.mp3","text":"顾不上误伤了......！","alt":"voice_cn/char_326_glacus/cn_026.mp3"},{"url":"bwiki:1/1b/00ebbajptwnukq3o0jx9pa8ngy6bobw.mp3","text":"微波频率增幅！","alt":"voice_cn/char_326_glacus/cn_027.mp3"},{"url":"bwiki:3/3b/n8tuad6pnbn0455d5ml7or6oqu87p2h.mp3","text":"坠落吧！","alt":"voice_cn/char_326_glacus/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:e/e5/gmsk828ulq6z7a8la8izjqk4u6b9adf.mp3","text":"敌方反应沉默，请各自检查一下损害情况......","alt":"voice_cn/char_326_glacus/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:a/ae/52zkcflek7ba1t45z5o9bcolpi9r6wc.mp3","text":"全单位沉默，脉冲立场解除，辛苦大家了。","alt":"voice_cn/char_326_glacus/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:0/0e/56yj3umm05sgc1vsfkmlfk4lttkqj05.mp3","text":"唔，刚才是不是有敌人逃走了？不追吗？","alt":"voice_cn/char_326_glacus/cn_031.mp3"}],"失败":[{"url":"bwiki:9/96/qfyrthj3t1uxiv7a6c18z2974t37ebd.mp3","text":"脉冲立场已经解除，快联络救援！","alt":"voice_cn/char_326_glacus/cn_032.mp3"}],"进驻":[{"url":"bwiki:e/e6/21qhlf0ux4ee5lviy3r6fgbqej3gne3.mp3","text":"没问题，但先等我找到那颗螺丝钉......","alt":"voice_cn/char_326_glacus/cn_033.mp3"}],"戳一下":[{"url":"bwiki:e/e7/cmwooyjx9um89kn4n7btcrqm4nbykib.mp3","text":"啊，走神了。","alt":"voice_cn/char_326_glacus/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:e/ee/ggcx8o13xcjbi3by6tx8fbk81jugs44.mp3","text":"博士，能和我出去散散步吗？","alt":"voice_cn/char_326_glacus/cn_036.mp3"}],"标题":[{"url":"bwiki:0/03/0vawgleoc8dedds8xd3e0xm01k3zo92.mp3","text":"明日方舟。","alt":"voice_cn/char_326_glacus/cn_037.mp3"}],"新年":[{"url":"bwiki:9/94/sb4n4r6zv13ukmo3x7dt2t9bum0edrz.mp3","text":"博士，新年快乐。礼物？我没想过......不，其实我一直希望能有一些合理的战损补贴......只是我没敢和凯尔希医生提......","alt":"voice_cn/char_326_glacus/cn_038.mp3"}],"问候":[{"url":"bwiki:c/c6/7f16gjcwn5as174onpdt9jfv4d9kvnq.mp3","text":"早上好，博士。","alt":"voice_cn/char_326_glacus/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:a/a8/oe3twtzhxc4t8b1zns1fa727zi212lk.mp3","text":"我会在一边安安静静地调整倾诉者的......保证不会打扰你。","alt":"voice/char_326_glacus/cn_001.mp3"}],"交谈":[{"url":"bwiki:d/d3/igvsg0eq8pewqyls9ejt9njl1qiqz5k.mp3","text":"为什么大家总是对蓝毒小姐敬而远之呢？是我不太一样？......好吧。","alt":"voice/char_326_glacus/cn_002.mp3"},{"url":"bwiki:3/3b/mp4kom9qt6vo9bena6e5dir7ajv0d4k.mp3","text":"博士有什么想说的话吗？没什么？总之......我就在这里。","alt":"voice/char_326_glacus/cn_003.mp3"},{"url":"bwiki:f/fc/ebxyze5b2h958uqz5ypnhj7u04619ju.mp3","text":"宿舍很热的话会让人没有食欲......啊。这是家族遗传，真的不是在抱怨。","alt":"voice/char_326_glacus/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:6/65/0jjy4qa7846bm68ufyzi815dfw0r2ld.mp3","text":"我之所以来到这里......奔跑都做不到的话，会有谁愿意主动离开故土呢？","alt":"voice/char_326_glacus/cn_005.mp3"},{"url":"bwiki:a/a4/j51pa6ubu0tul5vegfh76b0t3vbb9jv.mp3","text":"虽然火神小姐和我一样不喜欢“旧的东西”，但我觉得，我们的想法从根本上还是有差别的。","alt":"voice/char_326_glacus/cn_006.mp3"}],"信赖":[{"url":"bwiki:3/33/k1xpn8n9m5a7ethxu1luq3ooj8ezin3.m