25de7jscgzx1sjx2sjzvy69pomhx4.mp3","text":"感谢您的信任，博士。我原以为罗德岛对我而言只是一个美好得有些不真实的中转站，现在看来，我可能要在这里多耽搁一段时间了。","alt":"voice/char_4006_melnte/cn_014.mp3"}],"编入":[{"url":"bwiki:f/ff/bgpaxavd1nu87qhnqbmwp9uqwpdxo56.mp3","text":"我会为各位提供火力支援。","alt":"voice/char_4006_melnte/cn_017.mp3"}],"任命队长":[{"url":"bwiki:9/9e/drbdvd1wtfar04ff751ga1i2976g2xl.mp3","text":"任命我为队长？看来这是一场攻坚战了。","alt":"voice/char_4006_melnte/cn_018.mp3"}],"行动出发":[{"url":"bwiki:8/84/bs3v36ny3xdtlw8gihbdycbtpzjtdcw.mp3","text":"请各位再次检查自己的武器状况，以免在战场上遭遇不测。","alt":"voice/char_4006_melnte/cn_019.mp3"}],"行动开始":[{"url":"bwiki:9/98/qysfnuhuhg4jgqub9jwse48u9v5sxsu.mp3","text":"保持安全距离，尽量避免正面交锋。","alt":"voice/char_4006_melnte/cn_020.mp3"}],"选中":[{"url":"bwiki:d/d1/qh4vqrxdsc12bpdt0vsca8rk22uruwo.mp3","text":"我在。","alt":"voice/char_4006_melnte/cn_021.mp3"},{"url":"bwiki:9/95/5cv1ogocmw6vu2zi7q6wopgmc1nxe93.mp3","text":"请指示。","alt":"voice/char_4006_melnte/cn_022.mp3"}],"部署":[{"url":"bwiki:2/22/rsk9avnlm5bcftmrwf34e1lvyz3tqas.mp3","text":"正在校正射击诸元......完毕。","alt":"voice/char_4006_melnte/cn_023.mp3"},{"url":"bwiki:0/0a/qt4ivx7ly2yppxlz00hxaqdtzeqnan1.mp3","text":"武器状态良好，可以开始收集数据。","alt":"voice/char_4006_melnte/cn_024.mp3"}],"技能":[{"url":"bwiki:c/cc/9ml4voxz6dw1d3aawajlg6p1u9nphqs.mp3","text":"嘘，听见了吗，死神从天而降的声音？","alt":"voice/char_4006_melnte/cn_025.mp3"},{"url":"bwiki:e/e4/8q6dclzantn142ixmjzjrw6wi6ylvuy.mp3","text":"火力覆盖。","alt":"voice/char_4006_melnte/cn_026.mp3"},{"url":"bwiki:f/f3/k0k94s8xrn3n5kojcr9iokx503fntqd.mp3","text":"输出功率已达安全上限。","alt":"voice/char_4006_melnte/cn_027.mp3"},{"url":"bwiki:1/12/hjlthediqhgdeumd32w0ttpuelac2u6.mp3","text":"别扎堆，影响我判断爆炸范围。","alt":"voice/char_4006_melnte/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:c/c0/1djte8wx2o6bmcj94e3qt14l8jdhggk.mp3","text":"我......突然有些惶恐。如果我站在您的对面，在您的指挥面前，我引以为傲的火力究竟能发挥出多少力量？","alt":"voice/char_4006_melnte/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:9/9d/jv976rt5pow6ez7d3bt8hw1j8gyb37l.mp3","text":"完美的表现，我甚至想主动写一篇性能报告了。","alt":"voice/char_4006_melnte/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki