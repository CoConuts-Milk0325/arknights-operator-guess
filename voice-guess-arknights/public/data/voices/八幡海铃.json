{"中文":{"登录":[{"url":"bwiki:f/fc/lqn24ntjrjyw7jtqr64bwn8c7hsebng.mp3","text":"这部分的工作应该已经处理好了，博士，有什么问题吗？","alt":"voice/char_4186_tmoris/cn_001.mp3"}],"交谈":[{"url":"bwiki:b/b0/o1lt5m75y6171y1iimqil2brvc01l86.mp3","text":"罗德岛的干员们看起来都十分强大且个性十足，但是干员之间却少有冲突，都能彼此真诚相待，真是让人意想不到。","alt":"voice/char_4186_tmoris/cn_002.mp3"},{"url":"bwiki:b/bd/5j8ogxn5ujxfzi0wweanm9057v6du50.mp3","text":"红豆的吉他也弹得不错啊，她还邀请我去参观她的乐队表演。嗯，我很有兴趣。","alt":"voice/char_4186_tmoris/cn_003.mp3"},{"url":"bwiki:0/06/sby7sxlbr7po1rf6ctqau9368xwu22h.mp3","text":"博士请放心，我不会因为忙于工作而让自己的身体状态变差。我的休息时间和锻炼时间都已经规划好了，我也给工作留好了足够的缓冲时间。","alt":"voice/char_4186_tmoris/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:9/9d/o3crr6zw90jpjfytrw41b7n3hldofwz.mp3","text":"我只是做了我理所应当做的事情，既然暂居罗德岛，帮助罗德岛上的大家也无可厚非。","alt":"voice/char_4186_tmoris/cn_005.mp3"},{"url":"bwiki:0/00/k4ylcu8thbzbsen2s377t7jrdp67zx4.mp3","text":"不愧是罗德岛，一定是阿米娅和博士的真诚感染了大家。我现在相信这里的大家都是真的把彼此当作家人看待了，能为这里出一份力是我的荣幸。","alt":"voice/char_4186_tmoris/cn_006.mp3"}],"信赖":[{"url":"bwiki:e/e7/7kspdqxz5s3ht44q26w40a0p2guv87v.mp3","text":"小刻喜欢吃的蜜饼果然很好吃，吃多少都没问题。","alt":"voice/char_4186_tmoris/cn_007.mp3"},{"url":"bwiki:1/18/e5z57cy3ofovnaxsk9k4rmoipl6eh78.mp3","text":"明明罗德岛上的大家也都有自己的困扰，但还是会毫无保留地帮助彼此，我们因此受了很多人的照顾，尤其是博士你，十分感谢。","alt":"voice/char_4186_tmoris/cn_008.mp3"},{"url":"bwiki:3/3e/tn66oloihif98leg57pu2x1rg0nx8kd.mp3","text":"不知不觉好像又有十多个小队需要我去帮忙。不过，我很珍惜在罗德岛的这每一份工作。","alt":"voice/char_4186_tmoris/cn_009.mp3"}],"闲置":[{"url":"bwiki:8/8d/4n15rkego6mud2nz7s73cxmn277fm4q.mp3","text":"嗯......博士还在忙吗，这盒巧克力奶冻就给博士吧。","alt":"voice/char_4186_tmoris/cn_010.mp3"}],"报到":[{"url":"bwiki:5/5b/3h0hznxrrtnca3f9hgjmf4zt2xd8ojh.mp3","text":"我是八幡海铃，有什么需要我做的吗？","alt":"voice/char_4186_tmoris/cn_011.mp3"}],"作战记录":[{"url":"bwiki:8/82/n7f3ncounqpkaaghnccdd50cczm2n06.mp3","text":"嗯，果然是高效的手法，我会学习的。","alt":"voice/char_4186_tmoris/cn_012.mp3"}],"精英化1":[{"url":"bwiki:6/6a/fywu0qupzvfpvd2be4z7m8cluch9bqy.mp3","text":"我只是做了分内的事而已。","alt":"voice/char_4186_tmoris/cn_013.mp3"}],"精英化2":[{"url":"bwiki:7/7a/2xvhu9goaia4llct84ztpae1gyn42f9.mp3","text":"罗德岛的大家愿意接纳和信任我，真是件高兴的事。那么，大家也能回应我的期望吧？","alt":"voice/char_4186_tmoris/cn_014.mp3"}],"编入":[{"url":"bwiki:5/5f/n3p4n7ea5ihgi45d30rr07we93opx4g.mp3","text":"嗯，我知道了。","alt":"voice/char_4186_tmoris/cn_017.mp3"}],"任命队长":[{"url":"bwiki:2/2a/s4d1jbfi9ksvu7e8u7nwiuf1wyvsgj3.mp3","text":"要我来做指挥吗？行吧。","alt":"voice/char_4186_tmoris/cn_018.mp3"}],"行动出发":[{"url":"bwiki:8/80/ca6deu70k9lt788jbejtsiyewwdjode.mp3","text":"我们出发。","alt":"voice/char_4186_tmoris/cn_019.mp3"}],"行动开始":[{"url":"bwiki:3/36/1ayyqtnuil9mmzpizm12sv7dlfzeazz.mp3","text":"跟预想的一样，我们上吧。","alt":"voice/char_4186_tmoris/cn_020.mp3"}],"选中":[{"url":"bwiki:d/dd/4tszzmqf1g4e94jexn1fr18oj24c8rl.mp3","text":"是。","alt":"voice/char_4186_tmoris/cn_021.mp3"},{"url":"bwiki:0/0f/mwvbwvzzoca5dvl1wcm8vqrr6r0gf1t.mp3","text":"叫我吗？","alt":"voice/char_4186_tmoris/cn_022.mp3"}],"部署":[{"url":"bwiki:d/d7/ml87vq17qzeuywv7frs55okaon0l1sk.mp3","text":"就位。","alt":"voice/char_4186_tmoris/cn_023.mp3"},{"url":"bwiki:8/82/oy5auzdugkw6hcf1pwzr04esugtzyeq.mp3","text":"没有任何偏差。","alt":"voice/char_4186_tmoris/cn_024.mp3"}],"技能":[{"url":"bwiki:d/d7/h6qrsvk4mdjisif72hut699rf3mjypi.mp3","text":"交给我吧！","alt":"voice/char_4186_tmoris/cn_025.mp3"},{"url":"bwiki:c/c8/g186mh1jg5cfintk6fsdfn1hmeoyyr4.mp3","text":"并不是什么难事。","alt":"voice/char_4186_tmoris/cn_026.mp3"},{"url":"bwiki:0/07/fn5mn4bxh84croxrj8zoerrwvpoh6t9.mp3","text":"哼！","alt":"voice/char_4186_tmoris/cn_027.mp3"},{"url":"bwiki:7/79/hr1sfmbv12k9a6llymp133oonchc6cs.mp3","text":"打扰了。","alt":"voice/char_4186_tmoris/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:c/cd/d7uxml12ql1y00uvlk4ckiosqldvknm.mp3","text":"任务完成，多亏了大家。","alt":"voice/char_4186_tmoris/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:9/90/9bp2ypj54sp83kje9ngu8h7btvu1pln.mp3","text":"博士的指挥真是厉害。","alt":"voice/char_4186_tmoris/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:b/b2/l4jg55ws4oybgzx42ncf3w4aafymxdd.mp3","text":"勉勉强强，练习量还不够啊。","alt":"voice/char_4186_tmoris/cn_031.mp3"}],"失败":[{"url":"bwiki:2/2a/qtfk9p6ypp1zc3bpjuzsxlep7cpba6i.mp3","text":"快走吧，我们不能放弃任何一个人。","alt":"voice/char_4186_tmoris/cn_032.mp3"}],"进驻":[{"url":"bwiki:a/a2/aisw5s0z2wwsxo9a25ppdn21ae5mvc5.mp3","text":"哦，这里就是自由活动的房间吗，请问训练室在哪里？","alt":"voice/char_4186_tmoris/cn_033.mp3"}],"戳一下":[{"url":"bwiki:5/59/modjwspenluq0sfivt52irq7giulogm.mp3","text":"嗯？","alt":"voice/char_4186_tmoris/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:9/9c/3ih4xx1smgfvnhhdnxggok9qfr6t4jj.mp3","text":"嗯，我在。","alt":"voice/char_4186_tmoris/cn_036.mp3"}],"标题":[{"url":"bwiki:3/3b/msbf6ragukjqiqpy9qw823cx6f3ig4h.mp3","text":"明日方舟。","alt":"voice/char_4186_tmoris/cn_037.mp3"}],"新年":[{"url":"bwiki:2/25/23le0h38hcwcz2a9tnlhteftsf3mgdb.mp3","text":"你好博士，新年快乐，今后也请你多多关照。","alt":"voice/char_4186_tmoris/cn_038.mp3"}],"问候":[{"url":"bwiki:b/b6/2zd8syzmle37e3nn63go0j6y1ca74qo.mp3","text":"你好，博士，要一起去练习吗？","alt":"voice/char_4186_tmoris/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:f/fc/lqn24ntjrjyw7jtqr64bwn8c7hsebng.mp3","text":"这部分的工作应该已经处理好了，博士，有什么问题吗？","alt":"voice/char_4186_tmoris/cn_001.mp3"}],"交谈":[{"url":"bwiki:b/b0/o1lt5m75y6171y1iimqil2brvc01l86.mp3","text":"罗德岛的干员们看起来都十分强大且个性十足，但是干员之间却少有冲突，都能彼此真诚相待，真是让人意想不到。","alt":"voice/char_4186_tmoris/cn_002.mp3"},{"url":"bwiki:b/bd/5j8ogxn5ujxfzi0wweanm9057v6du50.mp3","text":"红豆的吉他也弹得不错啊，她还邀请我去参观她的乐队表演。嗯，我很有兴趣。","alt":"voice/char_4186_tmoris/cn_003.mp3"},{"url":"bwiki:0/06/sby7sxlbr7po1rf6ctqau9368xwu22h.mp3","text":"博士请放心，我不会因为忙于工作而让自己的身体状态变差。我的休息时间和锻炼时间都已经规划好了，我也给工作留好了足够的缓冲时间。","alt":"voice/char_4186_tmoris/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:9/9d/o3crr6zw90jpjfytrw41b7n3hldofwz.mp3","text":"我只是做了我理所应当做的事情，既然暂居罗德岛，帮助罗德岛上的大家也无可厚非。","alt":"voice/char_4186_tmoris/cn_005.mp3"},{"url":"bwiki:0/00/k4ylcu8thbzbsen2s377t7jrdp67zx4.mp3","text":"不愧是罗德岛，一定是阿米娅和博士的真诚感染了大家。我现在相信这里的大家都是真的把彼此当作家人看待了，能为这里出一份力是我的荣幸。","alt":"voice/char_4186_tmoris/cn_006.mp3"}],"信赖":[{"url":"bwiki:e/e7/7kspdqxz5s3ht44q26w40a0p2guv87v.mp3","text":"小刻喜欢吃的蜜饼果然很好吃，吃多少都没问题。","alt":"voice/char_4186_tmoris/cn_007.mp3"},{"url":"bwiki:1/18/e5z57cy3ofovnaxsk9k4rmoipl6eh78.mp3","text":"明明罗德岛上的大家也都有自己的困扰，但还是会毫无保留地帮助彼此，我们因此受了很多人的照顾，尤其是博士你，十分感谢。","alt":"voice/char_4186_tmoris/cn_008.mp3"},{"url":"bwiki:3/3e/tn66oloihif98leg57pu2x1rg0nx8kd.mp3","text":"不知不觉好像又有十多个小队需要我去帮忙。不过，我很珍惜在罗德岛的这每一份工作。","alt":"voice/char_4186_tmoris/cn_009.mp3"}],"闲置":[{"url":"bwiki:8/8d/4n15rkego6mud2nz7s73cxmn277fm4q.mp3","text":"嗯......博士还在忙吗，这盒巧克力奶冻就给博士吧。","alt":"voice/char_4186_tmoris/cn_010.mp3"}],"报到":[{"url":"bwiki:5/5b/3h0hznxrrtnca3f9hgjmf4zt2xd8ojh.mp3","text":"我是八幡海铃，有什么需要我做的吗？","alt":"voice/char_4186_tmoris/cn_011.mp3"}],"作战记录":[{"url":"bwiki:8/82/n7f3ncounqpkaaghnccdd50cczm2n06.mp3","text":"嗯，果然是高效的手法，我会学习的。","alt":"voice/char_4186_tmoris/cn_012.mp3"}],"精英化1":[{"url":"bwiki:6/6a/fywu0qupzvfpvd2be4z7m8cluch9bqy.mp3","text":"我只是做了分内的事而已。","alt":"voice/char_4186_tmoris/cn_013.mp3"}],"精英化2":[{"url":"bwiki:7/7a/2xvhu9goaia4llct84ztpae1gyn42f9.mp3","text":"罗德岛的大家愿意接纳和信任我，真是件高兴的事。那么，大家也能回应我的期望吧？","alt":"voice/char_4186_tmoris/cn_014.mp3"}],"编入":[{"url":"bwiki:5/5f/n3p4n7ea5ihgi45d30rr07we93opx4g.mp3","text":"嗯，我知道了。","alt":"voice/char_4186_tmoris/cn_017.mp3"}],"任命队长":[{"url":"bwiki:2/2a/s4d1jbfi9ksvu7e8u7nwiuf1wyvsgj3.mp3","text":"要我来做指挥吗？行吧。","alt":"voice/char_4186_tmoris/cn_018.mp3"}],"行动出发":[{"url":"bwiki:8/80/ca6deu70k9lt788jbejtsiyewwdjode.mp3","text":"我们出发。","alt":"voice/char_4186_tmoris/cn_019.mp3"}],"行动开始":[{"url":"bwiki:3/36/1ayyqtnuil9mmzpizm12sv7dlfzeazz.mp3","text":"跟预想的一样，我们上吧。","alt":"voice/char_4186_tmoris/cn_020.mp3"}],"选中":[{"url":"bwiki:d/dd/4tszzmqf1g4e94jexn1fr18oj24c8rl.mp3","text":"是。","alt":"voice/char_4186_tmoris/cn_021.mp3"},{"url":"bwiki:0/0f/mwvbwvzzoca5dvl1wcm8vqrr6r0gf1t.mp3","text":"叫我吗？","alt":"voice/char_4186_tmoris/cn_022.mp3"}],"部署":[{"url":"bwiki:d/d7/ml87vq17qzeuywv7frs55okaon0l1sk.mp3","text":"就位。","alt":"voice/char_4186_tmoris/cn_023.mp3"},{"url":"bwiki:8/82/oy5auzdugkw6hcf1pwzr04esugtzyeq.mp3","text":"没有任何偏差。","alt":"voice/char_4186_tmoris/cn_024.mp3"}],"技能":[{"url":"bwiki:d/d7/h6qrsvk4mdjisif72hut699rf3mjypi.mp3","text":"交给我吧！","alt":"voice/char_4186_tmoris/cn_025.mp3"},{"url":"bwiki:c/c8/g186mh1jg5cfintk6fsdfn1hmeoyyr4.mp3","text":"并不是什么难事。","alt":"voice/char_4186_tmoris/cn_026.mp3"},{"url":"bwiki:0/07/fn5mn4bxh84croxrj8zoerrwvpoh6t9.mp3","text":"哼！","alt":"voice/char_4186_tmoris/cn_027.mp3"},{"url":"bwiki:7/79/hr1sfmbv12k9a6llymp133oonchc6cs.mp3","text":"打扰了。","alt":"voice/char_4186_tmoris/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:c/cd/d7uxml12ql1y00uvlk4ckiosqldvknm.mp3","text":"任务完成，多亏了大家。","alt":"voice/char_4186_tmoris/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:9/90/9bp2ypj54sp83kje9ngu8h7btvu1pln.mp3","text":"博士的指挥真是厉害。","alt":"voice/char_4186_tmoris/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:b/b2/l4jg55ws4oybgzx42ncf3w4aafymxdd.mp3","text":"勉勉强强，练习量还不够啊。","alt":"voice/char_4186_tmoris/cn_031.mp3"}],"失败":[{"url":"bwiki:2/2a/qtfk9p6ypp1zc3bpjuzsxlep7cpba6i.mp3","text":"快走吧，我们不能放弃任何一个人。","alt":"voice/char_4186_tmoris/cn_032.mp3"}],"进驻":[{"url":"bwiki:a/a2/aisw5s0z2wwsxo9a25ppdn21ae5mvc5.mp3","text":"哦，这里就是自由活动的房间吗，请问训练室在哪里？","alt":"voice/char_4186_tmoris/cn_033.mp3"}],"戳一下":[{"url":"bwiki:5/59/modjwspenluq0sfivt52irq7giulogm.mp3","text":"嗯？","alt":"voice/char_4186_tmoris/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:9/9c/3ih4xx1smgfvnhhdnxggok9qfr6t4jj.mp3","text":"嗯，我在。","alt":"voice/char_4186_tmoris/cn_036.mp3"}],"标题":[{"url":"bwiki:3/3b/msbf6ragukjqiqpy9qw823cx6f3ig4h.mp3","text":"明日方舟。","alt":"voice/char_4186_tmoris/cn_037.mp3"}],"新年":[{"url":"bwiki:2/25/23le0h38hcwcz2a9tnlhteftsf3mgdb.mp3","text":"你好博士，新年快乐，今后也请你多多关照。","alt":"voice/char_4186_tmoris/cn_038.mp3"}],"问候":[{"url":"bwiki:b/b6/2zd8syzmle37e3nn63go0j6y1ca74qo.mp3","text":"你好，博士，要一起去练习吗？","alt":"voice/char_4186_tmoris/cn_042.mp3"}]}}