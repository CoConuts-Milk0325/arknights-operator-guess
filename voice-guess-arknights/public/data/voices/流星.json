{"中文":{"登录":[{"url":"bwiki:4/47/igb6e1co29kwn2mfsf7hu3s2r5537az.mp3","text":"好怀念的气息啊。这里是......？","alt":"voice_cn/char_126_shotst/cn_001.mp3"}],"交谈":[{"url":"bwiki:7/7d/hoppdkpok5zopp4p1ebrk7xsv4zxr0r.mp3","text":"来自卡西米尔的风，您感受到了吗？","alt":"voice_cn/char_126_shotst/cn_002.mp3"},{"url":"bwiki:a/ad/b77qwd96cuzpn7fzr2bzbni5afel1wj.mp3","text":"罗德岛和我待过的地方不一样，这里没有可以点起篝火的地方，真遗憾。不知道在甲板上能不能行，我想给大家创造一个近距离说话聊天的场所。","alt":"voice_cn/char_126_shotst/cn_003.mp3"},{"url":"bwiki:8/8f/r2x3wakji4uigrgzobaivgfal1luuo9.mp3","text":"这个任务登记系统......？呃，要怎么操作呢？我对电子设备真的不怎么在行......","alt":"voice_cn/char_126_shotst/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:1/1a/jvianw37qgngysnw0q2kx1e1vx6312b.mp3","text":"最近罗德岛增加了许多新面孔啊。为了让他们更顺利地融入罗德岛，必要的时候我会去帮助他们的。","alt":"voice_cn/char_126_shotst/cn_005.mp3"},{"url":"bwiki:8/8b/cuk5hbdyv914sff6616lccz58q0epod.mp3","text":"那位卡西米尔骑士......嗯，我没认错，我以前就认识她，那时候她还是个喜欢读书的内向女孩呢。变化可真大啊。","alt":"voice_cn/char_126_shotst/cn_006.mp3"}],"信赖":[{"url":"bwiki:4/4b/7bblvzq9f8uirocyni9ybnffy7fjfvd.mp3","text":"嘘——看，我发现了什么，这儿有一位落单的博士，我们可以尝试捕捉他！吓到您了吗？呵呵~","alt":"voice_cn/char_126_shotst/cn_007.mp3"},{"url":"bwiki:a/a6/7qxhee8jmhvx1h09r8nglagtzzih8e8.mp3","text":"偶尔的，我会想起在森林中的故乡时度过的日子。每年都有各种各样的竞赛可以参加，真怀念啊。不知道，我的故乡现在又变成什么样了呢。","alt":"voice_cn/char_126_shotst/cn_008.mp3"},{"url":"bwiki:2/24/mqfnsk2j1msqa3o56vrbuo5ezisvyqj.mp3","text":"博士的背后，无论什么时候都可以放心地交给我。","alt":"voice_cn/char_126_shotst/cn_009.mp3"}],"闲置":[{"url":"bwiki:1/15/on3h7a9ol60edx0mntowsbq73l0jjzn.mp3","text":"博士也会这样毫无防备地睡着啊，呵呵。","alt":"voice_cn/char_126_shotst/cn_010.mp3"}],"报到":[{"url":"bwiki:9/92/n22722dqqj0hzqn34h0v900tzi9p58s.mp3","text":"你好，我是流星，来自森林的弓箭手。您需要擅长远程援护的干员吗？","alt":"voice_cn/char_126_shotst/cn_011.mp3"}],"作战记录":[{"url":"bwiki:f/f5/14myrm3s07fsiq5la98989im1dc9v07.mp3","text":"弓术的练习，哪怕一天也不能松懈呀。","alt":"voice_cn/char_126_shotst/cn_012.mp3"}],"精英化1":[{"url":"bwiki:0/08/m129a5448ylwgkg222a7zwxh30c8a2r.mp3","text":"我很荣幸获得这次晋升机会。","alt":"voice_cn/char_126_shotst/cn_013.mp3"}],"精英化2":[{"url":"bwiki:1/15/g5maky1n7icxwstqa03iufdip35ry4i.mp3","text":"谢谢博士的认可。今后就让我继续为博士贡献自己的力量吧。","alt":"voice_cn/char_126_shotst/cn_014.mp3"}],"编入":[{"url":"bwiki:4/43/kuu7xw1cnl4fe8p41unrepwkk3c8pmh.mp3","text":"远程援护就交给我吧。","alt":"voice_cn/char_126_shotst/cn_017.mp3"}],"任命队长":[{"url":"bwiki:a/ab/rhoc95d4dccpv0lm04xz6jcc7jr1msp.mp3","text":"我会照顾好大家的。","alt":"voice_cn/char_126_shotst/cn_018.mp3"}],"行动出发":[{"url":"bwiki:c/c9/lotibg45id8qtlcr7imhx23lo5ppm9j.mp3","text":"伙伴们，出发。","alt":"voice_cn/char_126_shotst/cn_019.mp3"}],"行动开始":[{"url":"bwiki:1/10/gby14dqle0mv0ekz6qvq0htpkunla3a.mp3","text":"展示我们力量的时候到了。","alt":"voice_cn/char_126_shotst/cn_020.mp3"}],"选中":[{"url":"bwiki:1/13/ecfsol3foqtexk4qali9ic6y0gqjuj7.mp3","text":"请您下令。","alt":"voice_cn/char_126_shotst/cn_021.mp3"},{"url":"bwiki:e/e9/1zcneqcaaeemieqopgjirv6o3i2mxrt.mp3","text":"我已等候多时。","alt":"voice_cn/char_126_shotst/cn_022.mp3"}],"部署":[{"url":"bwiki:e/e8/adw4o5i684idqjwf3yj5gszk7htazb4.mp3","text":"风吹向了正确的地方。","alt":"voice_cn/char_126_shotst/cn_023.mp3"},{"url":"bwiki:0/05/l8vb89lyq8cjq3net1kew0szj837l6u.mp3","text":"我会保持警戒。","alt":"voice_cn/char_126_shotst/cn_024.mp3"}],"技能":[{"url":"bwiki:3/30/pixajby853858mtxh6ouf3go9exof37.mp3","text":"有破绽！","alt":"voice_cn/char_126_shotst/cn_025.mp3"},{"url":"bwiki:a/aa/4gmhqvzm7pak7af1zjqxtzikwb8e9pu.mp3","text":"风！","alt":"voice_cn/char_126_shotst/cn_026.mp3"},{"url":"bwiki:c/c1/cps7e1xnay6tobgsihed4ziz59b1c5l.mp3","text":"就是这一箭！","alt":"voice_cn/char_126_shotst/cn_027.mp3"},{"url":"bwiki:0/04/5qensl3e9fkykqaubf07vqdzv2fiap3.mp3","text":"致命一击。","alt":"voice_cn/char_126_shotst/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:0/0f/kv1tlfrdxct725t65eh8d0eqbyd2tbi.mp3","text":"不管是什么样的难关，只要我们齐心协力，就一定能克服过去。","alt":"voice_cn/char_126_shotst/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:9/97/tosios2g8io2ax6vjrdundfdtoomgl7.mp3","text":"干的漂亮，大家都是最棒的。","alt":"voice_cn/char_126_shotst/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:f/ff/a96dz35zdeshycfwa00jmhavxnicx67.mp3","text":"请伤者留在原地，别乱动，我马上就去帮你。","alt":"voice_cn/char_126_shotst/cn_031.mp3"}],"失败":[{"url":"bwiki:4/4b/sd202k9pcvfshdcpo05piedrvzho5at.mp3","text":"抱歉，不应该是这样的......","alt":"voice_cn/char_126_shotst/cn_032.mp3"}],"进驻":[{"url":"bwiki:8/84/2kauruuss8og87znkw495iw0q5o3lg1.mp3","text":"我还是不太习惯这么狭小的房间啊。","alt":"voice_cn/char_126_shotst/cn_033.mp3"}],"戳一下":[{"url":"bwiki:f/f4/94e5wb3dzh7q7b7avmsb08gcgoxzdzb.mp3","text":"哎呀？有什么事吗？","alt":"voice_cn/char_126_shotst/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:1/10/ogaxc18nuy9ip8lls36azivcid0us23.mp3","text":"和博士在一起的时光，就像沐浴在春天的阳光里一样温暖，很舒服。","alt":"voice_cn/char_126_shotst/cn_036.mp3"}],"标题":[{"url":"bwiki:f/ff/j7jcet0idbgmuz2jwk5ynniw3e9osgb.mp3","text":"明日方舟。","alt":"voice_cn/char_126_shotst/cn_037.mp3"}],"新年":[{"url":"bwiki:3/32/msaqu1s3jdghi4urdgi4p0zaf7pkac4.mp3","text":"又是一年了，森林是不是还和我当初离去时一样呢？虽然我仍旧有些不习惯现代生活，人们对矿石病的恐惧也似乎并没有减少，但是，新年的到来让这片大地重新焕发生机，万事都还是有希望的吧。","alt":"voice_cn/char_126_shotst/cn_038.mp3"}],"问候":[{"url":"bwiki:c/cf/3h5qe9bbsznp1b6qrvykz4e2yw0uxxe.mp3","text":"博士，您好。","alt":"voice_cn/char_126_shotst/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:c/c6/a5x1my54uv28jnsntwopxcuh03xbopq.mp3","text":"好怀念的气息啊。这里是......？","alt":"voice/char_126_shotst/cn_001.mp3"}],"交谈":[{"url":"bwiki:1/18/bvcm9l97vperlynrlo4z85i8ypnjgdp.mp3","text":"来自卡西米尔的风，您感受到了吗？","alt":"voice/char_126_shotst/cn_002.mp3"},{"url":"bwiki:c/c8/n66e11y156kjhsu9jf5kq1w104tmbph.mp3","text":"罗德岛和我待过的地方不一样，这里没有可以点起篝火的地方，真遗憾。不知道在甲板上能不能行，我想给大家创造一个近距离说话聊天的场所。","alt":"voice/char_126_shotst/cn_003.mp3"},{"url":"bwiki:1/1b/48phq5pkauli9lpxdmtmtkvvvsh3e8w.mp3","text":"这个任务登记系统......？呃，要怎么操作呢？我对电子设备真的不怎么在行......","alt":"voice/char_126_shotst/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:d/de/pp8lh1ok9hug0t22v6jz5mfthgh48fh.mp3","text":"最近罗德岛增加了许多新面孔啊。为了让他们更顺利地融入罗德岛，必要的时候我会去帮助他们的。","alt":"voice/char_126_shotst/cn_005.mp3"},{"url":"bwiki:6/64/qvsq8t51n9m3jyhdgrmebdcdlsbnohd.mp3","text":"那位卡西米尔骑士......嗯，我没认错，我以前就认识她，那时候她还是个喜欢读书的内向女孩呢。变化可真大啊。","alt":"voice/char_126_shotst/cn_006.mp3"}],"信赖":[{"url":"bwiki:0/04/i9nwp97kqvk52of1y1ce55vxlmti5r7.mp3","text":"嘘——看，我发现了什么，这儿有一位落单的博士，我们可以尝试捕捉他！吓到您了吗？呵呵~","alt":"voice/char_126_shotst/cn_007.mp3"},{"url":"bwiki:f/ff/3jc9k8i0mt8yc9uhrp5c05uxkn3l44s.mp3","text":"偶尔的，我会想起在森林中的故乡时度过的日子。每年都有各种各样的竞赛可以参加，真怀念啊。不知道，我的故乡现在又变成什么样了呢。","alt":"voice/char_126_shotst/cn_008.mp3"},{"url":"bwiki:6/62/pfrdl95s4im9dbcntj9r4b0t23x14m3.mp3","text":"博士的背后，无论什么时候都可以放心地交给我。","alt":"voice/char_126_shotst/cn_009.mp3"}],"闲置":[{"url":"bwiki:d/d7/go3edrnsozn757xokyzz88ujbwtc4vx.mp3","text":"博士也会这样毫无防备地睡着啊，呵呵。","alt":"voice/char_126_shotst/cn_010.mp3"}],"报到":[{"url":"bwiki:8/8b/3e6t30ibs191frir3o2ol3hmgb6k17q.mp3","text":"你好，我是流星，来自森林的弓箭手。您需要擅长远程援护的干员吗？","alt":"voice/char_126_shotst/cn_011.mp3"}],"作战记录":[{"url":"bwiki:e/e3/slh8yyolizxgrzyk9j2pon0msr262y6.mp3","text":"弓术的练习，哪怕一天也不能松懈呀。","alt":"voice/char_126_shotst/cn_012.mp3"}],"精英化1":[{"url":"bwiki:f/f7/hh5gcto8jjg0tpswjm9dk6btne2e7i8.mp3","text":"我很荣幸获得这次晋升机会。","alt":"voice/char_126_shotst/cn_013.mp3"}],"精英化2":[{"url":"bwiki:e/e2/187ys9c4legc7sb11ebdtn27zsc2g83.mp3","text":"谢谢博士的认可。今后就让我继续为博士贡献自己的力量吧。","alt":"voice/char_126_shotst/cn_014.mp3"}],"编入":[{"url":"bwiki:f/f6/phn3pn72amvxb9t2cywjssd94jumnpe.mp3","text":"远程援护就交给我吧。","alt":"voice/char_126_shotst/cn_017.mp3"}],"任命队长":[{"url":"bwiki:c/cb/563q7r075em0k2hlb5exhq5l6buw8as.mp3","text":"我会照顾好大家的。","alt":"voice/char_126_shotst/cn_018.mp3"}],"行动出发":[{"url":"bwiki:7/7f/ewy3lohhobfqua1xvu6xqt3pjlha8ta.mp3","text":"伙伴们，出发。","alt":"voice/char_126_shotst/cn_019.mp3"}],"行动开始":[{"url":"bwiki:4/4d/5v5uyftq0dg1mpkntd8e9qonutgy2fy.mp3","text":"展示我们力量的时候到了。","alt":"voice/char_126_shotst/cn_020.mp3"}],"选中":[{"url":"bwiki:e/e3/1d2hs7bdhu17lr56ws0ql1zp811x56p.mp3","text":"请您下令。","alt":"voice/char_126_shotst/cn_021.mp3"},{"url":"bwiki:6/63/3xub5xxr6bztfjrmja04jbrli32m2lh.mp3","text":"我已等候多时。","alt":"voice/char_126_shotst/cn_022.mp3"}],"部署":[{"url":"bwiki:d/d3/esf63s9l44k3a3otrxbhlzvhxf64bn4.mp3","text":"风吹向了正确的地方。","alt":"voice/char_126_shotst/cn_023.mp3"},{"url":"bwiki:b/be/4cnb82cxpitfh79e66cctsry18bgnj1.mp3","text":"我会保持警戒。","alt":"voice/char_126_shotst/cn_024.mp3"}],"技能":[{"url":"bwiki:2/2f/mnxs7uq5df8mmsdbt321e99zhjzpp1u.mp3","text":"有破绽！","alt":"voice/char_126_shotst/cn_025.mp3"},{"url":"bwiki:a/a4/honis6650547fq7kbaaz65yzqweu5i6.mp3","text":"风！","alt":"voice/char_126_shotst/cn_026.mp3"},{"url":"bwiki:8/8e/g7l9jevfukwac90itoql2t7cxcpiprr.mp3","text":"就是这一箭！","alt":"voice/char_126_shotst/cn_027.mp3"},{"url":"bwiki:b/b9/mcd8e3tlg1hecuugczuor3v1f14y121.mp3","text":"致命一击。","alt":"voice/char_126_shotst/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:8/8b/hypdy16s9c1khj7qoy57lg84j5la7ov.mp3","text":"不管是什么样的难关，只要我们齐心协力，就一定能克服过去。","alt":"voice/char_126_shotst/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:c/cc/0ks4hh873osq3kgzj0r77ynupbzbnwa.mp3","text":"干的漂亮，大家都是最棒的。","alt":"voice/char_126_shotst/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:8/8d/mixyth982ehrevr6p2lco8mhmw1oge8.mp3","text":"请伤者留在原地，别乱动，我马上就去帮你。","alt":"voice/char_126_shotst/cn_031.mp3"}],"失败":[{"url":"bwiki:3/30/bek9r2yeblpq0arxxomqdkx5vd1xzig.mp3","text":"抱歉，不应该是这样的......","alt":"voice/char_126_shotst/cn_032.mp3"}],"进驻":[{"url":"bwiki:4/49/bzihgqrh1obo92wwmycrwegpwd51vki.mp3","text":"我还是不太习惯这么狭小的房间啊。","alt":"voice/char_126_shotst/cn_033.mp3"}],"戳一下":[{"url":"bwiki:b/b8/829rk02eenah8sqt27tk4ffccesdj1u.mp3","text":"哎呀？有什么事吗？","alt":"voice/char_126_shotst/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:9/95/8eid5k451zdt60z8qbau53ct4fwkrb6.mp3","text":"和博士在一起的时光，就像沐浴在春天的阳光里一样温暖，很舒服。","alt":"voice/char_126_shotst/cn_036.mp3"}],"标题":[{"url":"bwiki:3/32/1h6it1n1hcbcs46rjcf7930jnscs1h4.mp3","text":"明日方舟。","alt":"voice/char_126_shotst/cn_037.mp3"}],"新年":[{"url":"bwiki:d/de/88vq1av1iuy4m4tvxmar0i53ej7drap.mp3","text":"又是一年了，森林是不是还和我当初离去时一样呢？虽然我仍旧有些不习惯现代生活，人们对矿石病的恐惧也似乎并没有减少，但是，新年的到来让这片大地重新焕发生机，万事都还是有希望的吧。","alt":"voice/char_126_shotst/cn_038.mp3"}],"问候":[{"url":"bwiki:e/ec/pp1azq704wqr5xxiknr9kfxc9mvy5yn.mp3","text":"博士，您好。","alt":"voice/char_126_shotst/cn_042.mp3"}]}}