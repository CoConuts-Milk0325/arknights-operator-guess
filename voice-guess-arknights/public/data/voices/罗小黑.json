{"中文":{"登录":[{"url":"bwiki:c/c5/py40wcnryx5ur52hwumj4eg2df1sehl.mp3","text":"这桌子好高啊，还是变成原形跳上去比较方便。","alt":"voice/char_4067_lolxh/cn_001.mp3"}],"交谈":[{"url":"bwiki:d/d5/c25p4ygtjdoq3ltxzwbfzwlw2r6qc80.mp3","text":"你怎么也在这里？那些医疗干员天天追在我屁股后面说要研究我！我得躲一下！不过你又是为什么藏在这里啊？博士，你不会是在偷懒吧？","alt":"voice/char_4067_lolxh/cn_002.mp3"},{"url":"bwiki:a/a3/2vv1mdp54tvcpjyqqb0gotzzmu1825c.mp3","text":"我的能力是控制金属，像你桌上那个金属块，我能把它变成尖的、圆的或者扁的，更复杂的样子也可以。","alt":"voice/char_4067_lolxh/cn_003.mp3"},{"url":"bwiki:9/91/n0p0zapl58p0irrr75g34uqhc35yr23.mp3","text":"这里的人模样长得都像是我们世界里的妖精，那这个世界的妖精，难道就是长博士你这样？","alt":"voice/char_4067_lolxh/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:3/36/dr7jb0n8vyufjyk6slx03prq4w6m67r.mp3","text":"我觉得这里和会馆很像，那些没有地方去的感染者都能留在这里。不过......感染者和妖精却很不一样，他们连远远躲开其他人都不行。","alt":"voice/char_4067_lolxh/cn_005.mp3"},{"url":"bwiki:1/1e/raaku6apllfg5phtggvlbztn54ywd2l.mp3","text":"这里这么多天灾......所以你们的城市只能不停地四处流浪吗？","alt":"voice/char_4067_lolxh/cn_006.mp3"}],"信赖":[{"url":"bwiki:e/e5/gprlukb34z1degtlt3m45xfl7qp4jye.mp3","text":"我知道了！干员是不是就是执行者？执行者是给会馆打杂的，干员就是帮罗德岛打杂的！嗯？不是这样吗？","alt":"voice/char_4067_lolxh/cn_007.mp3"},{"url":"bwiki:f/f9/8tjfii8ooawsh2p3sjkogk8afcrs1oy.mp3","text":"我以后会当上执行者的，像师父那样。师父可厉害了！嗯......你也很厉害，这艘舰船上所有人都会听你的话，你应该是个了不起的家伙。","alt":"voice/char_4067_lolxh/cn_008.mp3"},{"url":"bwiki:f/f6/o127pgc56fryple6w2npeqj119tyujz.mp3","text":"博士，我们算是朋友了吗？那以后有机会，你也到我们那边去玩吧！","alt":"voice/char_4067_lolxh/cn_009.mp3"}],"闲置":[{"url":"bwiki:c/c9/67g4418ev13ob9ga6j3nxs9uwctxy17.mp3","text":"博士，你是不是在偷偷吃好吃的？","alt":"voice/char_4067_lolxh/cn_010.mp3"}],"报到":[{"url":"bwiki:8/89/c1gwi9eysh8amaqhrh6e3tuo79tbq4v.mp3","text":"博士你好，我叫小黑，是个妖精。","alt":"voice/char_4067_lolxh/cn_011.mp3"}],"作战记录":[{"url":"bwiki:8/84/lxkx3798ebuf0x8zkdd03swgv2jv8a6.mp3","text":"博士......如果我看不懂这些录像的话，能来找你吗？","alt":"voice/char_4067_lolxh/cn_012.mp3"}],"精英化1":[{"url":"bwiki:7/71/i85cfu538x1xoxiw7c254maurgx8yd6.mp3","text":"晋升？这是什么意思？","alt":"voice/char_4067_lolxh/cn_013.mp3"}],"精英化2":[{"url":"bwiki:9/96/8zpaoqb68znmrx3thh78dmad7wpbjx8.mp3","text":"虽然还是不太明白，但是谢谢博士。","alt":"voice/char_4067_lolxh/cn_014.mp3"}],"编入":[{"url":"bwiki:2/2c/pd13xm47v6gqqt3txf1693vd8ztm609.mp3","text":"博士，我来了，嗯？我嘴巴上面有东西吗？啊，刚刚吃完东西，哈哈。","alt":"voice/char_4067_lolxh/cn_017.mp3"}],"任命队长":[{"url":"bwiki:0/01/3fl2yq4qvbg8zn56d5uz4m5ufes429g.mp3","text":"担任队长？我可以吗......？","alt":"voice/char_4067_lolxh/cn_018.mp3"}],"行动出发":[{"url":"bwiki:8/8f/3wyjfz1ko57ojyecrbpt9gdqkw2483t.mp3","text":"博士，抓紧我，我要用能力传送过去，这样快一点。","alt":"voice/char_4067_lolxh/cn_019.mp3"}],"行动开始":[{"url":"bwiki:c/cd/abnxomtiupr1hst33r9r8nb43lo8nku.mp3","text":"他们......全都是坏人吗？","alt":"voice/char_4067_lolxh/cn_020.mp3"}],"选中":[{"url":"bwiki:3/39/n4p13j4zyhm82rtio0j6sfa8pcu18up.mp3","text":"黑咻，我们得帮帮博士。","alt":"voice/char_4067_lolxh/cn_021.mp3"},{"url":"bwiki:a/ab/i8meby5rv62fy8j4rzo126f39iwcx1m.mp3","text":"嗯，博士，我在，不用担心。","alt":"voice/char_4067_lolxh/cn_022.mp3"}],"部署":[{"url":"bwiki:5/56/9wtbluen2gg3csqlm3qmmc2oqglwk8d.mp3","text":"我还挺擅长暗杀的。","alt":"voice/char_4067_lolxh/cn_023.mp3"},{"url":"bwiki:9/98/qyan22b7jlz9c2xcsieiuyf4gx5robr.mp3","text":"不准伤害他们！","alt":"voice/char_4067_lolxh/cn_024.mp3"}],"技能":[{"url":"bwiki:b/b7/eq5jif2580vb0wr81gadgcvzy9q5qcv.mp3","text":"不要靠近。","alt":"voice/char_4067_lolxh/cn_025.mp3"},{"url":"bwiki:e/ec/0rcu239q27wbjopczuhbl6ic7ojj0ji.mp3","text":"再过来，我不客气了！","alt":"voice/char_4067_lolxh/cn_026.mp3"},{"url":"bwiki:5/5e/sqrestlzxqb7cypa5zesy1j1t7yq808.mp3","text":"我很强的！看我的厉害！","alt":"voice/char_4067_lolxh/cn_027.mp3"},{"url":"bwiki:f/fa/60kmfomy7bt34zph3ki2w034uedjxl0.mp3","text":"嘶哈！","alt":"voice/char_4067_lolxh/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:a/a5/asd768i7q0hvux2l6rae04n6n8ivx82.mp3","text":"大家都没事吗？真是太好了！","alt":"voice/char_4067_lolxh/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:3/3c/bv56f7l2ipu5sfrj4yel6q0gr7vzik6.mp3","text":"厉害的人真的好多啊。","alt":"voice/char_4067_lolxh/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:0/0b/bbytvfj4m8s4mjnmwhydcgimsdwfuvb.mp3","text":"呼——幸好，你没受伤吧？","alt":"voice/char_4067_lolxh/cn_031.mp3"}],"失败":[{"url":"bwiki:a/ad/2znoyj1qr6l4rdg2tz44zptu9o9jqbu.mp3","text":"博士，都怪我不够强......","alt":"voice/char_4067_lolxh/cn_032.mp3"}],"进驻":[{"url":"bwiki:6/6a/c4a3mzz0csl0u8s1lgy5gxud3h7qf9e.mp3","text":"我可不能忘记博士给的任务。可是这个垫子好舒服呀，阳光也好暖和，我好像有点困......","alt":"voice/char_4067_lolxh/cn_033.mp3"}],"戳一下":[{"url":"bwiki:4/41/1sqg1r91pwv6rxjgli78pk4ghs1cf4f.mp3","text":"博士，不要动我耳朵！","alt":"voice/char_4067_lolxh/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:e/e0/bwj3ictzsw228b4ik77naj8jjfhbwd3.mp3","text":"博士，你怎么还在忙，快到饭点啦！","alt":"voice/char_4067_lolxh/cn_036.mp3"}],"标题":[{"url":"bwiki:0/0e/pck2jt9v9a12khqngx2evvydnfbh7v6.mp3","text":"明日方舟。","alt":"voice/char_4067_lolxh/cn_037.mp3"}],"新年":[{"url":"bwiki:2/23/203firqqt9e7v16prl7gx06ssjovdbh.mp3","text":"新年好，博士，这个给你，是阿根让我给你们带的卤味，来谢谢大家去年对我们的照顾。","alt":"voice/char_4067_lolxh/cn_038.mp3"}],"问候":[{"url":"bwiki:a/ad/p9v0i4ppf9fb1zugl4tu3k5y735diif.mp3","text":"博士，你好！","alt":"voice/char_4067_lolxh/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:4/40/lsbcp9l1a81vea9xten27ir0jer36lg.mp3","text":"这桌子好高啊，还是变成原形跳上去比较方便。","alt":"voice/char_4067_lolxh/cn_001.mp3"}],"交谈":[{"url":"bwiki:5/55/pkibfplubzoqpv5wkfz5l4i7f02b8xz.mp3","text":"你怎么也在这里？那些医疗干员天天追在我屁股后面说要研究我！我得躲一下！不过你又是为什么藏在这里啊？博士，你不会是在偷懒吧？","alt":"voice/char_4067_lolxh/cn_002.mp3"},{"url":"bwiki:2/23/3we8epctj8xuwy5vurncui477ifz7v6.mp3","text":"我的能力是控制金属，像你桌上那个金属块，我能把它变成尖的、圆的或者扁的，更复杂的样子也可以。","alt":"voice/char_4067_lolxh/cn_003.mp3"},{"url":"bwiki:6/61/qce7wvrrhlu1ibgs5ebm8js0dpzxfjv.mp3","text":"这里的人模样长得都像是我们世界里的妖精，那这个世界的妖精，难道就是长博士你这样？","alt":"voice/char_4067_lolxh/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:e/e1/hg1hj7wpawy0l5ihuz1xe6iyfx86v3n.mp3","text":"我觉得这里和会馆很像，那些没有地方去的感染者都能留在这里。不过......感染者和妖精却很不一样，他们连远远躲开其他人都不行。","alt":"voice/char_4067_lolxh/cn_005.mp3"},{"url":"bwiki:e/ea/6k2jbii05adnibjtv7ivcc51o5fqnwd.mp3","text":"这里这么多天灾......所以你们的城市只能不停地四处流浪吗？","alt":"voice/char_4067_lolxh/cn_006.mp3"}],"信赖":[{"url":"bwiki:b/b8/01781ktp0eig6fy0ut937bu2ufokjlu.mp3","text":"我知道了！干员是不是就是执行者？执行者是给会馆打杂的，干员就是帮罗德岛打杂的！嗯？不是这样吗？","alt":"voice/char_4067_lolxh/cn_007.mp3"},{"url":"bwiki:1/1c/pjy9kh0a03dw8b0iagmb13w4hc1vrkx.mp3","text":"我以后会当上执行者的，像师父那样。师父可厉害了！嗯......你也很厉害，这艘舰船上所有人都会听你的话，你应该是个了不起的家伙。","alt":"voice/char_4067_lolxh/cn_008.mp3"},{"url":"bwiki:2/28/3koepkpf6yvjeu0vuokddl01gvj431w.mp3","text":"博士，我们算是朋友了吗？那以后有机会，你也到我们那边去玩吧！","alt":"voice/char_4067_lolxh/cn_009.mp3"}],"闲置":[{"url":"bwiki:e/e4/3frpw2yfxtant2lkk1w4dmswje9yx1o.mp3","text":"博士，你是不是在偷偷吃好吃的？","alt":"voice/char_4067_lolxh/cn_010.mp3"}],"报到":[{"url":"bwiki:5/5c/cmqh0r9iqbuqd280wobvxqm730fit82.mp3","text":"博士你好，我叫小黑，是个妖精。","alt":"voice/char_4067_lolxh/cn_011.mp3"}],"作战记录":[{"url":"bwiki:3/32/5lt6x7ttns8ke0jak365ulsincii1uu.mp3","text":"博士......如果我看不懂这些录像的话，能来找你吗？","alt":"voice/char_4067_lolxh/cn_012.mp3"}],"精英化1":[{"url":"bwiki:b/b1/5dbyf7is5p6ek0qcbtx6ttoinrqj3ve.mp3","text":"晋升？这是什么意思？","alt":"voice/char_4067_lolxh/cn_013.mp3"}],"精英化2":[{"url":"bwiki:1/1f/jj9j5k2cpoxhn72wo4uv3ecf69kqudz.mp3","text":"虽然还是不太明白，但是谢谢博士。","alt":"voice/char_4067_lolxh/cn_014.mp3"}],"编入":[{"url":"bwiki:1/14/0lhxel271qcu51mwni9skgoup1z318f.mp3","text":"博士，我来了，嗯？我嘴巴上面有东西吗？啊，刚刚吃完东西，哈哈。","alt":"voice/char_4067_lolxh/cn_017.mp3"}],"任命队长":[{"url":"bwiki:1/1f/lp3j43219o0sd4xfhl3dys1ecjuh5xm.mp3","text":"担任队长？我可以吗......？","alt":"voice/char_4067_lolxh/cn_018.mp3"}],"行动出发":[{"url":"bwiki:4/4d/m1wjdks71dxsjx4mke7yeorqklg66pq.mp3","text":"博士，抓紧我，我要用能力传送过去，这样快一点。","alt":"voice/char_4067_lolxh/cn_019.mp3"}],"行动开始":[{"url":"voice/char_4067_lolxh/cn_020.mp3","text":"他们......全都是坏人吗？"}],"选中":[{"url":"voice/char_4067_lolxh/cn_021.mp3","text":"黑咻，我们得帮帮博士。"},{"url":"voice/char_4067_lolxh/cn_022.mp3","text":"嗯，博士，我在，不用担心。"}],"部署":[{"url":"voice/char_4067_lolxh/cn_023.mp3","text":"我还挺擅长暗杀的。"},{"url":"voice/char_4067_lolxh/cn_024.mp3","text":"不准伤害他们！"}],"技能":[{"url":"voice/char_4067_lolxh/cn_025.mp3","text":"不要靠近。"},{"url":"voice/char_4067_lolxh/cn_026.mp3","text":"再过来，我不客气了！"},{"url":"voice/char_4067_lolxh/cn_027.mp3","text":"我很强的！看我的厉害！"},{"url":"voice/char_4067_lolxh/cn_028.mp3","text":"嘶哈！"}],"高难胜利":[{"url":"bwiki:4/46/rqojt1kh4nbmcykrc1pyniotleh0fmz.mp3","text":"大家都没事吗？真是太好了！","alt":"voice/char_4067_lolxh/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:0/0e/a1qbmteoqu36dvra84lzz2mbw7eibn2.mp3","text":"厉害的人真的好多啊。","alt":"voice/char_4067_lolxh/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:7/79/js5npgonxqbjyepetiaiueatd1boe2h.mp3","text":"呼——幸好，你没受伤吧？","alt":"voice/char_4067_lolxh/cn_031.mp3"}],"失败":[{"url":"bwiki:a/a1/ei6udo3vsnmwiina1kbapa98l1m60p0.mp3","text":"博士，都怪我不够强......","alt":"voice/char_4067_lolxh/cn_032.mp3"}],"进驻":[{"url":"bwiki:1/14/s0vpgpyv2gsxzr2uoa3bnxoy9ak40rv.mp3","text":"我可不能忘记博士给的任务。可是这个垫子好舒服呀，阳光也好暖和，我好像有点困......","alt":"voice/char_4067_lolxh/cn_033.mp3"}],"戳一下":[{"url":"voice/char_4067_lolxh/cn_034.mp3","text":"博士，不要动我耳朵！"}],"信赖触摸":[{"url":"voice/char_4067_lolxh/cn_036.mp3","text":"博士，你怎么还在忙，快到饭点啦！"}],"标题":[{"url":"bwiki:1/18/pq5hbnrdngjo2yyjs6rt0lq12v8w6qw.mp3","text":"明日方舟。","alt":"voice/char_4067_lolxh/cn_037.mp3"}],"新年":[{"url":"bwiki:f/ff/e20aquf6uxkjtsp88263cw9zxtbo4ll.mp3","text":"新年好，博士，这个给你，是阿根让我给你们带的卤味，来谢谢大家去年对我们的照顾。","alt":"voice/char_4067_lolxh/cn_038.mp3"}],"问候":[{"url":"bwiki:1/14/tgwiixda7usd01e4dft8s1ocdcxwdhc.mp3","text":"博士，你好！","alt":"voice/char_4067_lolxh/cn_042.mp3"}]}}