{"中文":{"登录":[{"url":"bwiki:d/d3/1aln2e84mpu27tsghialwt95d4529v3.mp3","text":"博士，您好......那个，有需求的话，就请呼唤我......嗯，我的代号，您，还记得住吗......？","alt":"voice_cn/char_253_greyy/cn_001.mp3"}],"交谈":[{"url":"bwiki:7/77/jjsuyaegy9tmpclkd01g1w5674nk03j.mp3","text":"博、博士，您好......嗯，我刚刚为医疗组检查过电源线路，顺便帮大家送些文件......没、我没有被使唤！毕竟，医生们肯为我治病，这是恩情，要报答......","alt":"voice_cn/char_253_greyy/cn_002.mp3"},{"url":"bwiki:f/fe/8itd9b6lfb3kvtutq6fc900ujhity7p.mp3","text":"最初，我学习电能类法术，仅仅是为了让贫民区的伙伴有光照，让夜晚不再那样难熬......黑夜，真的很可怕，生活在黑夜中的人，也是......","alt":"voice_cn/char_253_greyy/cn_003.mp3"},{"url":"bwiki:9/99/4lsw6jdcvb3p8kjmincr8h5x8vfih8z.mp3","text":"我真的很羡慕，罗德岛有这样的源石发电设备......您知道吗，我生活的地方，哪怕只有一台这样的机器，大家也不会变得习惯黑暗，将没有光亮的生活视为常事了。","alt":"voice_cn/char_253_greyy/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:d/da/gjn9hi7by5hy9c3a3nnpwhx6x6p9yai.mp3","text":"教授我基础源石技艺的是妈妈，她说，我像年轻时的她一样懂得怎么使用法术，可也像她一样多病......如果她还在的话，我真希望她能和我一起来罗德岛......","alt":"voice_cn/char_253_greyy/cn_005.mp3"},{"url":"bwiki:7/7f/ksw6b7j93dgjioj36w7cjbor5r5tvhe.mp3","text":"在得到您的指导之前，我的法术只能照亮一个房间而已。不过，即使是那么小的一片火花，现在，也变成了能为大家带来帮助的能力了呢......！博士，真的很感谢您！","alt":"voice_cn/char_253_greyy/cn_006.mp3"}],"信赖":[{"url":"bwiki:d/d3/ieyd3jggbsacxf0y9xj9491yacmxs5w.mp3","text":"咦？梅尔小姐的库房电量异常？又、又是她，怎么办......您说，凯尔希医生的实验室要新增电缆？还有伊芙利特的房间又断电了？呜、呜啊啊啊......博士，帮帮我......","alt":"voice_cn/char_253_greyy/cn_007.mp3"},{"url":"bwiki:b/b6/kew6cpf0rjpwmrafm5nwlauivs7kphi.mp3","text":"呼——咦？博士......？啊对不起博士我没有在偷睡！我、我只是......咦，这里是医务室？","alt":"voice_cn/char_253_greyy/cn_008.mp3"},{"url":"bwiki:a/a2/1vi5x5kull5h8ouno97tph80fooi6h7.mp3","text":"博士，又要出门了吗？......嗯，我知道了。我会好好待在这里的......那个，博士，要早点回来哦......","alt":"voice_cn/char_253_greyy/cn_009.mp3"}],"闲置":[{"url":"bwiki:f/fb/obcyuj844d6eswl38l4xics3k68e3ix.mp3","text":"咿......！唔啊啊，静电好麻烦......","alt":"voice_cn/char_253_greyy/cn_010.mp3"}],"报到":[{"url":"bwiki:3/36/98b16nibzrlg37qzdaeruz7j5pyvx5x.mp3","text":"您、您好，我是格雷伊，电能相关的工作，还算擅长......那个，谢、谢谢您愿意收留我......！","alt":"voice_cn/char_253_greyy/cn_011.mp3"}],"作战记录":[{"url":"bwiki:6/64/i4urbu4e88l1brv7ekqtda4xwejknee.mp3","text":"这、这里的画面，暂停一下，可以吗？我、我记一下笔记......","alt":"voice_cn/char_253_greyy/cn_012.mp3"}],"精英化1":[{"url":"bwiki:c/c5/2ilkg7rjdel0wbj5reusu00a4eorxkb.mp3","text":"晋升吗？知道了，我这就去通知大家——欸？是、是安排我晋升......？咦？","alt":"voice_cn/char_253_greyy/cn_013.mp3"}],"精英化2":[{"url":"bwiki:9/94/80pjndbwzphrkzwp49iej59qv9v2jy9.mp3","text":"欸嘿嘿，博士，就让我为您照亮前进的道路吧！唔，好、好像说了些大话......？就算是大话，也是很认真的在说哦......！","alt":"voice_cn/char_253_greyy/cn_014.mp3"}],"编入":[{"url":"bwiki:3/3c/dfc1d8ulca9jhk6vp13sljhrc8ovhhe.mp3","text":"格雷伊，来给大家帮忙了......","alt":"voice_cn/char_253_greyy/cn_017.mp3"}],"任命队长":[{"url":"bwiki:f/f0/ajfnbsxkmrrpuslbbiwhd3mghqvyuau.mp3","text":"队、队长......？嗯、嗯，我听您的安排......！","alt":"voice_cn/char_253_greyy/cn_018.mp3"}],"行动出发":[{"url":"bwiki:f/f4/gx59frs81mu3humzgi8yiw6fao9tfua.mp3","text":"我去为后勤部队帮忙......！","alt":"voice_cn/char_253_greyy/cn_019.mp3"}],"行动开始":[{"url":"bwiki:e/e3/or107ewjg380nepmw8q11wo054mwyde.mp3","text":"博士，敌人开始集结了......","alt":"voice_cn/char_253_greyy/cn_020.mp3"}],"选中":[{"url":"bwiki:7/7a/b5n71ehy1p1pwftdo2s38w01j7l6rju.mp3","text":"我会尽、尽力......","alt":"voice_cn/char_253_greyy/cn_021.mp3"},{"url":"bwiki:7/7a/qlhxez5i7s7496rhd7edl2hup8lsyg3.mp3","text":"我、我应该能行......！","alt":"voice_cn/char_253_greyy/cn_022.mp3"}],"部署":[{"url":"bwiki:0/0d/6brygk0l09w0m1fs8v1fe86zukior1t.mp3","text":"我得慢慢来......","alt":"voice_cn/char_253_greyy/cn_023.mp3"},{"url":"bwiki:c/ca/qm1wmq7qy5es3ma11w1w7h1sg6mt83s.mp3","text":"可、可不能在这里扭伤了脚。","alt":"voice_cn/char_253_greyy/cn_024.mp3"}],"技能":[{"url":"bwiki:1/1d/kizk9d2dcv2cludw9g0o7p1x4kdwena.mp3","text":"别再作恶了！","alt":"voice_cn/char_253_greyy/cn_025.mp3"},{"url":"bwiki:7/7f/ciwrcdd7b621oztn32igympt947zzik.mp3","text":"不要伤害大家......！","alt":"voice_cn/char_253_greyy/cn_026.mp3"},{"url":"bwiki:7/72/i52l659n6kz5mbylm0jlvxag68uozth.mp3","text":"看这、这招！","alt":"voice_cn/char_253_greyy/cn_027.mp3"},{"url":"bwiki:1/1e/87syvkza3zjhwogdb0r4zq3a832onx2.mp3","text":"被电到的话，后果很、很可怕的......！","alt":"voice_cn/char_253_greyy/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:d/da/18ehaxwkyx5rvf0rh27le0oqxcfdsho.mp3","text":"博、博士，您辛苦了......！我们，一起回家吧......？","alt":"voice_cn/char_253_greyy/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:5/5c/66n5kuqtxax4c2y00cyr5zv9ulia411.mp3","text":"是、是我们胜利了......！博士！","alt":"voice_cn/char_253_greyy/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:7/70/499i5hkpkbdf06mudpzoakujd93uf25.mp3","text":"博士，那些逃走的人，不会......再回来了吧？","alt":"voice_cn/char_253_greyy/cn_031.mp3"}],"失败":[{"url":"bwiki:a/a1/thog2fhuzsx4ljk8aq74z5dmk2vsn1a.mp3","text":"呜......博士......","alt":"voice_cn/char_253_greyy/cn_032.mp3"}],"进驻":[{"url":"bwiki:a/a0/2q0hpotfyoe03wup3lcv370kcj188iq.mp3","text":"今天要做什么呢？","alt":"voice_cn/char_253_greyy/cn_033.mp3"}],"戳一下":[{"url":"bwiki:1/1f/d7gdw764j1tced7u7l99xozyuywevrj.mp3","text":"呜啊......","alt":"voice_cn/char_253_greyy/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:c/c8/9apu0jm9o7ofh2frgoy7gvoatj9weh7.mp3","text":"博士，个子真高......我、我什么时候才能追上博士......呢？","alt":"voice_cn/char_253_greyy/cn_036.mp3"}],"标题":[{"url":"bwiki:3/3b/1wucswq5579c6mv6ux4xiizyguz4yvj.mp3","text":"明日方舟。","alt":"voice_cn/char_253_greyy/cn_037.mp3"}],"新年":[{"url":"bwiki:1/14/5z05wua8x88o3ewmkyj2ixyv48on81j.mp3","text":"新年快乐，博士。那个，就是......待、待会儿有烟花大会，我想陪您一起看......嗯，我喜欢烟花，又明亮，又灿烂，小小一颗，就能照亮整片大地......","alt":"voice_cn/char_253_greyy/cn_038.mp3"}],"问候":[{"url":"bwiki:1/15/p7ifk96lyawkhv3n98afrm2r9eehae1.mp3","text":"博士，您回来了！","alt":"voice_cn/char_253_greyy/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:1/10/5ecu30mlak64odcnexn0e6oa4ffo867.mp3","text":"博士，您好......那个，有需求的话，就请呼唤我......嗯，我的代号，您，还记得住吗......？","alt":"voice/char_253_greyy/cn_001.mp3"}],"交谈":[{"url":"bwiki:6/64/jlamr5kxgjeb45giju7gd565ugk0ebc.mp3","text":"博、博士，您好......嗯，我刚刚为医疗组检查过电源线路，顺便帮大家送些文件......没、我没有被使唤！毕竟，医生们肯为我治病，这是恩情，要报答......","alt":"voice/char_253_greyy/cn_002.mp3"},{"url":"bwiki:6/67/96cz5ao9gf2ul3vgeafbzvklfq01pf9.mp3","text":"最初，我学习电能类法术，仅仅是为了让贫民区的伙伴有光照，让夜晚不再那样难熬......黑夜，真的很可怕，生活在黑夜中的人，也是......","alt":"voice/char_253_greyy/cn_003.mp3"},{"url":"bwiki:9/9e/relbhn9znaghs6qz90ujs4ozz56562m.mp3","text":"我真的很羡慕，罗德岛有这样的源石发电设备......您知道吗，我生活的地方，哪怕只有一台这样的机器，大家也不会变得习惯黑暗，将没有光亮的生活视为常事了。","alt":"voice/char_253_greyy/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:1/17/0gp1yhchde963ii1ya51syjl5yhtty4.mp3","text":"教授我基础源石技艺的是妈妈，她说，我像年轻时的她一样懂得怎么使用法术，可也像她一样多病......如果她还在的话，我真希望她能和我一起来罗德岛......","alt":"voice/char_253_greyy/cn_005.mp3"},{"url":"bwiki:3/3a/3ie2l5rfj0nmdvchg6a3cin48jzb8up.mp3","text":"在得到您的指导之前，我的法术只能照亮一个房间而已。不过，即使是那么小的一片火花，现在，也变成了能为大家带来帮助的能力了呢......！博士，真的很感谢您！","alt":"voice/char_253_greyy/cn_006.mp3"}],"信赖":[{"url":"bwiki:0/00/grbahxzckhop47t86lq33uew569hvlv.mp3","text":"咦？梅尔小姐的库房电量异常？又、又是她，怎么办......您说，凯尔希医生的实验室要新增电缆？还有伊芙利特的房间又断电了？呜、呜啊啊啊......博士，帮帮我......","alt":"voice/char_253_greyy/cn_007.mp3"},{"url":"bwiki:d/d1/bgp74gjakvw46085g5ihji2ghppi99z.mp3","text":"呼——咦？博士......？啊对不起博士我没有在偷睡！我、我只是......咦，这里是医务室？","alt":"voice/char_253_greyy/cn_008.mp3"},{"url":"bwiki:d/d7/lsoan3kpm8llg4yhftuu4ulhogdbial.mp3","text":"博士，又要出门了吗？......嗯，我知道了。我会好好待在这里的......那个，博士，要早点回来哦......","alt":"voice/char_253_greyy/cn_009.mp3"}],"闲置":[{"url":"bwiki:6/6c/nutpzg5wun40b3y8iw28fqgmwe7sc6z.mp3","text":"咿......！唔啊啊，静电好麻烦......","alt":"voice/char_253_greyy/cn_010.mp3"}],"报到":[{"url":"bwiki:e/e7/hd6t7bd68i7utf4ov4biv13qq5832e1.mp3","text":"您、您好，我是格雷伊，电能相关的工作，还算擅长......那个，谢、谢谢您愿意收留我......！","alt":"voice/char_253_greyy/cn_011.mp3"}],"作战记录":[{"url":"bwiki:0/0b/t4vze6osogw905jew4ivz5d32wssy7u.mp3","text":"这、这里的画面，暂停一下，可以吗？我、我记一下笔记......","alt":"voice/char_253_greyy/cn_012.mp3"}],"精英化1":[{"url":"bwiki:7/72/1oj44nd5isfuh8mk3gatxxncv5ijjah.mp3","text":"晋升吗？知道了，我这就去通知大家——欸？是、是安排我晋升......？咦？","alt":"voice/char_253_greyy/cn_013.mp3"}],"精英化2":[{"url":"bwiki:2/2b/q2ickjovpq00h1pdd4o7wlbybo0d7dm.mp3","text":"欸嘿嘿，博士，就让我为您照亮前进的道路吧！唔，好、好像说了些大话......？就算是大话，也是很认真的在说哦......！","alt":"voice/char_253_greyy/cn_014.mp3"}],"编入":[{"url":"bwiki:7/77/dotegq5zokeq9k7pe6eaauw0lg2c9mj.mp3","text":"格雷伊，来给大家帮忙了......","alt":"voice/char_253_greyy/cn_017.mp3"}],"任命队长":[{"url":"bwiki:3/38/qy61pe5bwyk5e7s1re2dry5h01v2a4e.mp3","text":"队、队长......？嗯、嗯，我听您的安排......！","alt":"voice/char_253_greyy/cn_018.mp3"}],"行动出发":[{"url":"bwiki:9/97/doft1e3i9jffqj8tfnopeeqezh78zcd.mp3","text":"我去为后勤部队帮忙......！","alt":"voice/char_253_greyy/cn_019.mp3"}],"行动开始":[{"url":"bwiki:5/51/32uritspxphngo30wm3prquwmyu2hjz.mp3","text":"博士，敌人开始集结了......","alt":"voice/char_253_greyy/cn_020.mp3"}],"选中":[{"url":"bwiki:0/05/lw3locyauhnqctio56kpa0iixiywd6j.mp3","text":"我会尽、尽力......","alt":"voice/char_253_greyy/cn_021.mp3"},{"url":"bwiki:0/02/fcov4ys7cgofe44zkrie7awahpdzvlc.mp3","text":"我、我应该能行......！","alt":"voice/char_253_greyy/cn_022.mp3"}],"部署":[{"url":"bwiki:3/34/70r3xljdmnlfx4pi1r67p8mwdq38s7h.mp3","text":"我得慢慢来......","alt":"voice/char_253_greyy/cn_023.mp3"},{"url":"bwiki:d/dc/tczyrjmmssmdslnxk0gtt2j2b76g1ip.mp3","text":"可、可不能在这里扭伤了脚。","alt":"voice/char_253_greyy/cn_024.mp3"}],"技能":[{"url":"bwiki:1/12/02f8kc3zadwjt1eq9c9ev4g13j7tcmr.mp3","text":"别再作恶了！","alt":"voice/char_253_greyy/cn_025.mp3"},{"url":"bwiki:7/70/2wr5vtjgzzf6ws6jgy5454zmkn09i94.mp3","text":"不要伤害大家......！","alt":"voice/char_253_greyy/cn_026.mp3"},{"url":"bwiki:5/5b/sozjpfgds9rzpkhz3ilgzdw0yqc5rt7.mp3","text":"看这、这招！","alt":"voice/char_253_greyy/cn_027.mp3"},{"url":"bwiki:3/35/jtkvxv6gxelhqw2rz09zch892emrlaw.mp3","text":"被电到的话，后果很、很可怕的......！","alt":"voice/char_253_greyy/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:a/a3/o07lmvud7aht775vlluj472n7i1ff5m.mp3","text":"博、博士，您辛苦了......！我们，一起回家吧......？","alt":"voice/char_253_greyy/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:b/b6/15y2c1u328bki50ig4qen8kdurck5bt.mp3","text":"是、是我们胜利了......！博士！","alt":"voice/char_253_greyy/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:a/a6/j3pg6bgxgw51nvlk8q8nmlovqhtuta7.mp3","text":"博士，那些逃走的人，不会......再回来了吧？","alt":"voice/char_253_greyy/cn_031.mp3"}],"失败":[{"url":"bwiki:f/fd/8zj8iuuqkswdowbyzxisinvsxzks3uj.mp3","text":"呜......博士......","alt":"voice/char_253_greyy/cn_032.mp3"}],"进驻":[{"url":"bwiki:1/14/clq6sx081d1dqk5zbnuuuu6s6673nty.mp3","text":"今天要做什么呢？","alt":"voice/char_253_greyy/cn_033.mp3"}],"戳一下":[{"url":"bwiki:7/7