{"中文":{"登录":[{"url":"bwiki:5/50/d9u6gm1jydeyuiqpjvzb4cx4w7d7qeo.mp3","text":"您的货物我已经搬过去了。举手之劳，别客气。","alt":"voice_cn/char_199_yak/cn_001.mp3"}],"交谈":[{"url":"bwiki:f/f4/lcxtuselqhkxetmhbcu38jmikde3qf9.mp3","text":"盾牌，就是守护。","alt":"voice_cn/char_199_yak/cn_002.mp3"},{"url":"bwiki:0/0a/fotelmx6kh7nz5k5h6l0kjuip7b4rnz.mp3","text":"我从银灰少爷......不，老爷。我从老爷少年时就开始负责保护他。","alt":"voice_cn/char_199_yak/cn_003.mp3"},{"url":"bwiki:8/87/5km9lhn73ckhdnhpebzmzbb96yzujao.mp3","text":"谈论这个是不礼貌的，但恩雅小姐的遭遇......确实令人感到忧伤。她理应有更好的生活。","alt":"voice_cn/char_199_yak/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:1/12/5d0n79dvlbjxfeskvw9op8wob07q389.mp3","text":"万一，这面盾有什么损坏的话，就去找那位叫火神的工匠修理，没错吧？","alt":"voice_cn/char_199_yak/cn_005.mp3"},{"url":"bwiki:f/f1/9gzy4fvpoqma1un4c3vxeqdw9iutugm.mp3","text":"意外，真是意外。那位铁匠的手艺真的不错。我得好好谢谢她才行。","alt":"voice_cn/char_199_yak/cn_006.mp3"}],"信赖":[{"url":"bwiki:7/72/78f3hiqzwugqngvjjykh5je7wifz769.mp3","text":"罗德岛的生活十分有趣，相比之下，在雪境度过的日子都比较平淡。","alt":"voice_cn/char_199_yak/cn_007.mp3"},{"url":"bwiki:b/bf/4wpw9y4ep3c6hysd3iti598jyu4pqf3.mp3","text":"虽然老爷派我来保护二小姐，老实说，我不认为二小姐是会坐在那里乖乖等人来保护她的类型。","alt":"voice_cn/char_199_yak/cn_008.mp3"},{"url":"bwiki:9/95/0rzfsu0hnqogaxjc4a3qencj28nlzfe.mp3","text":"银灰老爷对你如此器重的原因，我多少也有点明白了。以后请把我也当作你的盾。","alt":"voice_cn/char_199_yak/cn_009.mp3"}],"闲置":[{"url":"bwiki:1/15/eggetyzkc9jryy6vevvkx806w8grufg.mp3","text":"有时候也会忽然想念起雪境的生活。","alt":"voice_cn/char_199_yak/cn_010.mp3"}],"报到":[{"url":"bwiki:8/83/2ta8gziggssyethn2el15tyaw1q8f0s.mp3","text":"同盟者，在此对您致以雪境之礼。我是银灰老爷此次派驻的护卫之一，代号为角峰。","alt":"voice_cn/char_199_yak/cn_011.mp3"}],"作战记录":[{"url":"bwiki:5/50/no2emfhjepnmhg3ie5ok4e8h2c16ss5.mp3","text":"感谢。","alt":"voice_cn/char_199_yak/cn_012.mp3"}],"精英化1":[{"url":"bwiki:a/a3/84a9l3xtnlrue6r8debunrq63zvy3l2.mp3","text":"承蒙您的另眼相待，实在愧不敢当。","alt":"voice_cn/char_199_yak/cn_013.mp3"}],"精英化2":[{"url":"bwiki:b/b0/dr1lcwq70f6k0be1fekltzat38ouypq.mp3","text":"即使这盾下一刻粉碎，我也绝不会退后半步。此举无关忠义，只是信念使然。","alt":"voice_cn/char_199_yak/cn_014.mp3"}],"编入":[{"url":"bwiki:2/20/qic1g2vk0ydei8928wgi8m4d86lqpf8.mp3","text":"听从吩咐。","alt":"voice_cn/char_199_yak/cn_017.mp3"}],"任命队长":[{"url":"bwiki:a/ac/4xjoymfin505fzv78shbxzl27ovk5ys.mp3","text":"不敢当。","alt":"voice_cn/char_199_yak/cn_018.mp3"}],"行动出发":[{"url":"bwiki:0/03/890q5ozvlvwy8sxdurwbxyosm5ncdvg.mp3","text":"各位，由我护卫。","alt":"voice_cn/char_199_yak/cn_019.mp3"}],"行动开始":[{"url":"bwiki:7/7b/ei5sczmtcgjmkuusxlc5h3pg8ue4vy1.mp3","text":"这是有准备的开始。","alt":"voice_cn/char_199_yak/cn_020.mp3"}],"选中":[{"url":"bwiki:c/ca/nm706rvrlt67krctsbgagllqq8ijgas.mp3","text":"我可以担当先锋。","alt":"voice_cn/char_199_yak/cn_021.mp3"},{"url":"bwiki:2/25/k0ee116fvpcf81tzjrvjrwbfygu0vj8.mp3","text":"我的盾准备好了。","alt":"voice_cn/char_199_yak/cn_022.mp3"}],"部署":[{"url":"bwiki:a/a7/fxgurecgnvke8upfrl7oufjq5v5abq5.mp3","text":"哼。","alt":"voice_cn/char_199_yak/cn_023.mp3"},{"url":"bwiki:4/48/lvbp3hfbuob2rbs5aasj45bwuyf9nnb.mp3","text":"喝！","alt":"voice_cn/char_199_yak/cn_024.mp3"}],"技能":[{"url":"bwiki:b/b7/futxzlbtyg4rfhspggw0snxbpuzvv2s.mp3","text":"自讨苦吃。","alt":"voice_cn/char_199_yak/cn_025.mp3"},{"url":"bwiki:5/54/8814rdt4bokjfklr48wvfdtqwfkuid9.mp3","text":"这不止是力量而已。","alt":"voice_cn/char_199_yak/cn_026.mp3"},{"url":"bwiki:4/4c/sc72rb787ei2fd3y5jy76c88y4b5kpp.mp3","text":"有此信念，便能化身鬼神！","alt":"voice_cn/char_199_yak/cn_027.mp3"},{"url":"bwiki:a/ad/1t3cvpwjcgvq0ft2y8ko9t1fwzgke76.mp3","text":"你的觉悟根本不够！","alt":"voice_cn/char_199_yak/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:4/46/kzb4y37onr64usl1sthx5oj6hk02a32.mp3","text":"还没有发挥出百分之百的力量！","alt":"voice_cn/char_199_yak/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:6/6e/ddjaqgod5jnwcd9epzwbrdldc88zev4.mp3","text":"真是不痛不痒的进攻。","alt":"voice_cn/char_199_yak/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:3/3c/ri0g6bvz2d1doixg7b1xz9k6uz8fied.mp3","text":"下次一定会为您献上完美的胜利。","alt":"voice_cn/char_199_yak/cn_031.mp3"}],"失败":[{"url":"bwiki:e/e8/4ex7256dhzxe1gf6fzc9bd6yduq1ci3.mp3","text":"不该如此轻视敌人的，这是代价。","alt":"voice_cn/char_199_yak/cn_032.mp3"}],"进驻":[{"url":"bwiki:c/c5/rsqfnd8du2lem0ypynytpw61qzwrn19.mp3","text":"真是不错的房间，装修讲究，气氛祥和。","alt":"voice_cn/char_199_yak/cn_033.mp3"}],"戳一下":[{"url":"bwiki:9/9f/c1134avhpzvv11rwx327vzp94w4gcei.mp3","text":"嗯。","alt":"voice_cn/char_199_yak/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:a/ad/mk8u7iofo0outs2e48927s4el33shgt.mp3","text":"这是我的拿手菜，味道怎么样。","alt":"voice_cn/char_199_yak/cn_036.mp3"}],"标题":[{"url":"bwiki:3/3b/etyy1rpsb9h7oroavorshds5u2rry5x.mp3","text":"明日方舟。","alt":"voice_cn/char_199_yak/cn_037.mp3"}],"新年":[{"url":"bwiki:4/4d/79gjg3djnx6iaa3feochrbkhhbobpr0.mp3","text":"身为护卫，新年这一天就更不能懈怠，危险不会因为节日而消失，相反，可能会在人们懈怠的时候出现。博士，罗德岛还算安全，但也不要掉以轻心。新年快乐。","alt":"voice_cn/char_199_yak/cn_038.mp3"}],"问候":[{"url":"bwiki:0/03/8nplprqftoqp78r9omeuyslqpis58au.mp3","text":"您好，博士。","alt":"voice_cn/char_199_yak/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:a/a9/ipdes8essdvr45mcq8zdb24yn1qm1cr.mp3","text":"您的货物我已经搬过去了。举手之劳，别客气。","alt":"voice/char_199_yak/cn_001.mp3"}],"交谈":[{"url":"bwiki:9/92/0ezrpb0iri8sxrw7b0swum6cb0wuf78.mp3","text":"盾牌，就是守护。","alt":"voice/char_199_yak/cn_002.mp3"},{"url":"bwiki:6/66/dvpgsns5xo8md46q86z0zkfra5guzg0.mp3","text":"我从银灰少爷......不，老爷。我从老爷少年时就开始负责保护他。","alt":"voice/char_199_yak/cn_003.mp3"},{"url":"bwiki:e/eb/rzk34k0ycz8yjt7uf9f5co74h2wcmhb.mp3","text":"谈论这个是不礼貌的，但恩雅小姐的遭遇......确实令人感到忧伤。她理应有更好的生活。","alt":"voice/char_199_yak/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:7/72/tujo5iqcwonad2aaoskioc813mq2rd9.mp3","text":"万一，这面盾有什么损坏的话，就去找那位叫火神的工匠修理，没错吧？","alt":"voice/char_199_yak/cn_005.mp3"},{"url":"bwiki:5/5e/4irtpqxwm57dgarxh1r1ekjckd3x6q8.mp3","text":"意外，真是意外。那位铁匠的手艺真的不错。我得好好谢谢她才行。","alt":"voice/char_199_yak/cn_006.mp3"}],"信赖":[{"url":"bwiki:6/6b/mdxx2y5dxtqgvxlru94wom3v0erm1sk.mp3","text":"罗德岛的生活十分有趣，相比之下，在雪境度过的日子都比较平淡。","alt":"voice/char_199_yak/cn_007.mp3"},{"url":"bwiki:c/c4/th2jzu68bwvtfni6dp62uil0qydgduu.mp3","text":"虽然老爷派我来保护二小姐，老实说，我不认为二小姐是会坐在那里乖乖等人来保护她的类型。","alt":"voice/char_199_yak/cn_008.mp3"},{"url":"bwiki:5/53/n6j24h9871j18j4cch5urwqie4mjqm1.mp3","text":"银灰老爷对你如此器重的原因，我多少也有点明白了。以后请把我也当作你的盾。","alt":"voice/char_199_yak/cn_009.mp3"}],"闲置":[{"ur