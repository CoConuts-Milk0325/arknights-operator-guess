{"中文":{"登录":[{"url":"bwiki:9/93/irs88gtvtfwq2ssoi2h8gbktgc5t0ak.mp3","text":"这是你需要的文件，这是给你带的咖啡，不用谢。","alt":"voice/char_4125_rdoc/cn_001.mp3"}],"交谈":[{"url":"bwiki:9/93/jqe46smhkz6ve40ix6mb1ux6sfivnzd.mp3","text":"有什么事情吗......哦！抱歉，博士，我还以为刚刚那位干员是喊我来着。","alt":"voice/char_4125_rdoc/cn_002.mp3"},{"url":"bwiki:7/77/q5bsnk9z08fote5grl7k8dk59xd0i2p.mp3","text":"能拿得起柳叶刀就能端得起枪，永远别怀疑一个医生的手有多稳。","alt":"voice/char_4125_rdoc/cn_003.mp3"},{"url":"bwiki:9/97/a532zdhfbw3i09udt0f90fee5dbf7n5.mp3","text":"我会竭尽全力拯救目标，不论是伤病还是敌人，都不能将他们从我手中夺走。","alt":"voice/char_4125_rdoc/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:6/68/t9kdw7dy10ssrnk7i9nvu8yw71e8773.mp3","text":"人步入战场，与死亡同行，便会明白生命的宝贵。","alt":"voice/char_4125_rdoc/cn_005.mp3"},{"url":"bwiki:9/9d/ryw9pdobkjhmuu5qxt50d9n0n8d9yrs.mp3","text":"过去的经验告诉我，想要救死扶伤就该亲临现场，而不是坐在办公室里。而有时候，拯救生命的唯一手段，是夺走另外一个生命。","alt":"voice/char_4125_rdoc/cn_006.mp3"}],"信赖":[{"url":"bwiki:e/e6/jkmcfnosnv5ffueglyni11bxqyjuiye.mp3","text":"我的工作是保护你的人身安全，我不介意你给我来点挑战。","alt":"voice/char_4125_rdoc/cn_007.mp3"},{"url":"bwiki:6/65/i246dafhuwhi3t26nd867hp3in1dgrv.mp3","text":"发生什么了？我可不喜欢看人们愁眉不展的样子。","alt":"voice/char_4125_rdoc/cn_008.mp3"},{"url":"bwiki:f/f5/3h0um8jc8tu7svpxwf2wjd5pportu0b.mp3","text":"博士，我很庆幸我们找到了你。","alt":"voice/char_4125_rdoc/cn_009.mp3"}],"闲置":[{"url":"bwiki:6/64/5n3oym5h07xvxo0a9m2w8gzjd4qxii0.mp3","text":"快停下手头的工作吧，你上次休息是什么时候？","alt":"voice/char_4125_rdoc/cn_010.mp3"}],"报到":[{"url":"bwiki:f/fa/ne3zmnptao8pcz4y1x134m38zz4d9vt.mp3","text":"彩虹小队成员，代号医生。放心，我会保护你的安全。","alt":"voice/char_4125_rdoc/cn_011.mp3"}],"作战记录":[{"url":"bwiki:7/76/448bjn6jz9hriguffhz754jj7th4kac.mp3","text":"这样一来，事情就轻松多了。","alt":"voice/char_4125_rdoc/cn_012.mp3"}],"精英化1":[{"url":"bwiki:5/5e/h98q95gcqy1fm6sjsfipy1abpotnahg.mp3","text":"如果我们必须这样做，那就这样做。","alt":"voice/char_4125_rdoc/cn_013.mp3"}],"精英化2":[{"url":"bwiki:c/ca/ge7ush1trlm75iglu5zak56qmfxzg2k.mp3","text":"谢谢你，我正好需要更高的权限来阅读关于矿石病的机密文献。","alt":"voice/char_4125_rdoc/cn_014.mp3"}],"编入":[{"url":"bwiki:a/a2/kzey9od92f0feq8ufqnkbcrn4pbxllg.mp3","text":"需要帮忙就叫我。","alt":"voice/char_4125_rdoc/cn_017.mp3"}],"任命队长":[{"url":"bwiki:6/68/qhbms870z3c2jutrtzqdeoeczbe6yc5.mp3","text":"任务中注意安全。","alt":"voice/char_4125_rdoc/cn_018.mp3"}],"行动出发":[{"url":"bwiki:7/7a/2siak3ddxovz3bwffc7o7m2b29nbmui.mp3","text":"至少我们准备充分。","alt":"voice/char_4125_rdoc/cn_019.mp3"}],"行动开始":[{"url":"bwiki:4/43/t44aqi7uvqg2k6iowfbpgx3by8a947b.mp3","text":"本区域内尚有活动的敌人。","alt":"voice/char_4125_rdoc/cn_020.mp3"}],"选中":[{"url":"bwiki:f/ff/tm25de0fe2yfiacjm59alfm55akc70k.mp3","text":"准备就绪。","alt":"voice/char_4125_rdoc/cn_021.mp3"},{"url":"bwiki:d/d7/o08qlgdcpi3ycrjf7brxgzsznl74gxl.mp3","text":"我会保护你们。","alt":"voice/char_4125_rdoc/cn_022.mp3"}],"部署":[{"url":"bwiki:0/07/1s7sc8s0rguantzhhsd7yhvgy7puh3c.mp3","text":"赶紧动起来。","alt":"voice/char_4125_rdoc/cn_023.mp3"},{"url":"bwiki:b/bf/kaw430eppeinbs6uycpz2cf6eptc4u6.mp3","text":"尽量别让自己受伤。","alt":"voice/char_4125_rdoc/cn_024.mp3"}],"技能":[{"url":"bwiki:8/89/31lfoapt1w1v1vpaicp00ipkcx0g36z.mp3","text":"目标已定位。","alt":"voice/char_4125_rdoc/cn_025.mp3"},{"url":"bwiki:1/1c/a6frjsupjg94hgqe9f5v2wv20h0h250.mp3","text":"发现目标。","alt":"voice/char_4125_rdoc/cn_026.mp3"},{"url":"bwiki:e/ec/tradgn083qby4jopib421cgp9q0x6ig.mp3","text":"跟紧我。","alt":"voice/char_4125_rdoc/cn_027.mp3"},{"url":"bwiki:b/bf/fx3bxoswqgxq1nobal77jz1g6bpsw92.mp3","text":"正在换弹！","alt":"voice/char_4125_rdoc/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:2/2d/cm9ludcsoay0j2lm238n0715kv4haq8.mp3","text":"你还好吗？有没有觉得呼吸困难？","alt":"voice/char_4125_rdoc/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:3/38/mbn412jaq18mb9bxpbkekzbub0dhttb.mp3","text":"即将抵达撤离点，我们马上就可以休息了。","alt":"voice/char_4125_rdoc/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:7/7f/hql29f1ya8hcxzhqhu0jesoyo8yd2yh.mp3","text":"我们会让你好起来的，好吗？","alt":"voice/char_4125_rdoc/cn_031.mp3"}],"失败":[{"url":"bwiki:1/12/jij1o8taigfiiqm58kn3ri1z0fqtkja.mp3","text":"我们在浪费时间。","alt":"voice/char_4125_rdoc/cn_032.mp3"}],"进驻":[{"url":"bwiki:5/55/n3pd0pmmtk3tob4bcvqz47nxjakk5pp.mp3","text":"乐意之至。","alt":"voice/char_4125_rdoc/cn_033.mp3"}],