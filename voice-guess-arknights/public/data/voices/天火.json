{"中文":{"登录":[{"url":"bwiki:0/09/1o60jbqw4elj99tl4xy8f8r0ib61lol.mp3","text":"火灾警报器在响？失礼了，只是因为我经过了你的办公室而已。我的体温可能又过高了。","alt":"voice_cn/char_166_skfire/cn_001.mp3"}],"交谈":[{"url":"bwiki:1/1e/jmbvopl9177dikhwls9z25uo1z409yg.mp3","text":"没有无法学会的语言，没有无法理解的法术，这是理所应当的吧？......嗯？只有我是特别的？","alt":"voice_cn/char_166_skfire/cn_002.mp3"},{"url":"bwiki:d/de/2sa8k8xpe6qxrhdlk8vvk5suw79vnx5.mp3","text":"人生？那种东西——哼，直到上次袭击为止都还算符合预期。但在整合运动谋害菲尔之后，“消灭他们”已经是我日程表里最优先的事项了。","alt":"voice_cn/char_166_skfire/cn_003.mp3"},{"url":"bwiki:4/45/80lj1djydcmrmnvbbfdrbr3xu42bha8.mp3","text":"就凭罗德岛现在的软弱手段，只会拖我们“王者之杖”的后腿。","alt":"voice_cn/char_166_skfire/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:a/a4/du1s1h5yaxrg0ync1m9ls5st4i77jnm.mp3","text":"你能劝一劝阿米娅吗？她那样还挺可怜的。善良只会蒙蔽她，对我来说......适合恶徒的只有毁灭一种结局。","alt":"voice_cn/char_166_skfire/cn_005.mp3"},{"url":"bwiki:c/c5/dexyzkvil7oxe6v0sxrfiyvtoi79m7u.mp3","text":"你现在的实力，根本达不到我们【王者之杖】的平均水平。呵，没错，我是很强，而我们五人汇聚起的力量，更是连语言都没法衡量。","alt":"voice_cn/char_166_skfire/cn_006.mp3"}],"信赖":[{"url":"bwiki:6/6e/rufnuh74w3fdc4y9o0wvxjlh87vensh.mp3","text":"七曜的那把刀，是白送给她的，据说它的前任主人是一位能一刀斩下东国所有的樱花的剑豪。然而即使是这样的人，还是被白击败，输掉了这把刀哦。","alt":"voice_cn/char_166_skfire/cn_007.mp3"},{"url":"bwiki:8/86/n919jurbwqiacko91y6nrujarzrh7xu.mp3","text":"你那件衣服是怎么回事？咦？是我烧破的？但......不可能啊，我对自己身体的控制是很完美的......大概吧？我......抱歉，我很抱歉。","alt":"voice_cn/char_166_skfire/cn_008.mp3"},{"url":"bwiki:b/b0/84r5akwhmhsklghwsw8dqfs42rfsz3n.mp3","text":"即便你我的想法截然不同，但罗德岛那拼命努力、不断奔驰的样子......很不错。对，我是在夸奖你们。这很美妙。","alt":"voice_cn/char_166_skfire/cn_009.mp3"}],"闲置":[{"url":"bwiki:f/f1/fa1jeeqzlb14lqj9fehf3rsskp66b6j.mp3","text":"如此怠惰。你就打算这样偷懒贪睡，荒废时间吗？","alt":"voice_cn/char_166_skfire/cn_010.mp3"}],"报到":[{"url":"bwiki:e/e6/q8vvkl0f3homcprcvwyhd3mgtm8l0ec.mp3","text":"“王者之杖”所属，天火。在达成目的之前，我会暂时在罗德岛停留。目的？当然是将整合运动焚烧殆尽。","alt":"voice_cn/char_166_skfire/cn_011.mp3"}],"作战记录":[{"url":"bwiki:8/8b/0c0v32zkd076p4d7s91r6okczvkjmzz.mp3","text":"仅凭如此，可无法引出我真正的力量。","alt":"voice_cn/char_166_skfire/cn_012.mp3"}],"精英化1":[{"url":"bwiki:a/a6/7pwhd0jjclwmby7i939ny7lg1zh3zl6.mp3","text":"理所应当。","alt":"voice_cn/char_166_skfire/cn_013.mp3"}],"精英化2":[{"url":"bwiki:7/71/d3eff9lsle8r8uo6m4p2ckhusg9lfz0.mp3","text":"哼，偶尔享受些符合身份的待遇，也算是种休息。","alt":"voice_cn/char_166_skfire/cn_014.mp3"}],"编入":[{"url":"bwiki:3/36/6zi77v8efxdl82sysrdmp1axw6fma0v.mp3","text":"战场的温度太低了。","alt":"voice_cn/char_166_skfire/cn_017.mp3"}],"任命队长":[{"url":"bwiki:2/2e/olhe91jmknch4cx3fma1svyr2t1pxc3.mp3","text":"太阳的光辉，庇护着我。","alt":"voice_cn/char_166_skfire/cn_018.mp3"}],"行动出发":[{"url":"bwiki:7/76/noprjgw4r7lgheu4n7escqp33x220u4.mp3","text":"出击。","alt":"voice_cn/char_166_skfire/cn_019.mp3"}],"行动开始":[{"url":"bwiki:4/4c/ejexeweojfory2o26h6588f0m83mfx0.mp3","text":"在这天火的威光前拜伏吧。","alt":"voice_cn/char_166_skfire/cn_020.mp3"}],"选中":[{"url":"bwiki:2/22/2bwlsg53cueyfpnmj78tz7oy31jqqxa.mp3","text":"来吧。","alt":"voice_cn/char_166_skfire/cn_021.mp3"},{"url":"bwiki:3/36/n6tltl3qs8mypgtz89twfq7oofcwoek.mp3","text":"你打算怎么做？","alt":"voice_cn/char_166_skfire/cn_022.mp3"}],"部署":[{"url":"bwiki:8/83/si7xjvo9i520vkcgpsvntfh0rteqaxa.mp3","text":"噩运只等待弱者坠落。","alt":"voice_cn/char_166_skfire/cn_023.mp3"},{"url":"bwiki:6/66/38tybtlpentumrvt3gpssoi0jg2j1ip.mp3","text":"智者先攻。","alt":"voice_cn/char_166_skfire/cn_024.mp3"}],"技能":[{"url":"bwiki:b/b5/dacdragdaw3knlm0jriil7ffbb27rh8.mp3","text":"去吧。","alt":"voice_cn/char_166_skfire/cn_025.mp3"},{"url":"bwiki:9/9c/ss8ry7v90zfrfgq5b6trpnsextjfyk6.mp3","text":"火，炎，焱。","alt":"voice_cn/char_166_skfire/cn_026.mp3"},{"url":"bwiki:b/bb/be6czr79cf8uinr33h1x7ktjj80marw.mp3","text":"日炎将你焚尽！","alt":"voice_cn/char_166_skfire/cn_027.mp3"},{"url":"bwiki:c/c8/ko2lkvv8fg7h2b0jxzxo0jma55bxvar.mp3","text":"天空将你点燃！","alt":"voice_cn/char_166_skfire/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:0/07/8lhzej56ax24ejp9qsu9nqw55tcuqhr.mp3","text":"没有日炎烧不尽的灵魂。","alt":"voice_cn/char_166_skfire/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:7/71/616ofsby8sf04mesz6rb0y2sjv8osye.mp3","text":"你们啊，都被烧干净了，难道还想留下些什么吗？","alt":"voice_cn/char_166_skfire/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:f/f8/6fh0z0fkgtglhm251r5tolz8aqt6vmw.mp3","text":"就只有这种程度......吗。","alt":"voice_cn/char_166_skfire/cn_031.mp3"}],"失败":[{"url":"bwiki:8/86/i3ecy6pkbdhwm2n9cu4yexo1b1oy89b.mp3","text":"不可能......我这样的......怎么会......","alt":"voice_cn/char_166_skfire/cn_032.mp3"}],"进驻":[{"url":"bwiki:b/bb/2nw4untidx8trsc0u8j8ueqmvyhe5yp.mp3","text":"就不能为我准备一间更凉快点的房间吗？","alt":"voice_cn/char_166_skfire/cn_033.mp3"}],"戳一下":[{"url":"bwiki:3/37/day34dqb9c0qc12zsbj0l9mproe6mox.mp3","text":"你的手想被烧焦吗？","alt":"voice_cn/char_166_skfire/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:b/bc/33mwujrhsr2xq7x3ebwtn6k69x1o84e.mp3","text":"博士，可以为我说明一下这种理论吗？只要占用你十二分钟就够了。","alt":"voice_cn/char_166_skfire/cn_036.mp3"}],"标题":[{"url":"bwiki:5/55/55jwu8xvwtc3e0ipbae6cj7tsbfvwcl.mp3","text":"明日方舟。","alt":"voice_cn/char_166_skfire/cn_037.mp3"}],"新年":[{"url":"bwiki:4/4f/jp9xpuopfajgxgvazbyquwtkeaabw73.mp3","text":"哼，他们不让我靠近烟花，说我控制不好会把这些都炸掉，还专门让后勤部干员在这里守着，我哪里就——啊！灭火器灭火器！......生气导致体温上升是正常生理现象，我、我离远点就是了！","alt":"voice_cn/char_166_skfire/cn_038.mp3"}],"问候":[{"url":"bwiki:3/3d/fv6givppejb96ljq2nmkkg6f9kowb8x.mp3","text":"心情如何？","alt":"voice_cn/char_166_skfire/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:f/f0/0pompjybzam5sb24ck7m1b249x7vkae.mp3","text":"火灾警报器在响？失礼了，只是因为我经过了你的办公室而已。我的体温可能又过高了。","alt":"voice/char_166_skfire/cn_001.mp3"}],"交谈":[{"url":"bwiki:f/f4/hy85rtw9p3d0u07tb54a4u6ib1jgf7n.mp3","text":"没有无法学会的语言，没有无法理解的法术，这是理所应当的吧？......嗯？只有我是特别的？","alt":"voice/char_166_skfire/cn_002.mp3"},{"url":"bwiki:e/ef/pb09v3ly73h1hm41f2ay4t3aw1dmuca.mp3","text":"人生？那种东西——哼，直到上次袭击为止都还算符合预期。但在整合运动谋害菲尔之后，“消灭他们”已经是我日程表里最优先的事项了。","alt":"voice/char_166_skfire/cn_003.mp3"},{"url":"bwiki:5/53/rlypt3lmet458j9q524e5w0t199ajgh.mp3","text":"就凭罗德岛现在的软弱手段，只会拖我们“王者之杖”的后腿。","alt":"voice/char_166_skfire/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:b/b7/oqzryuealkdwy8dr4435cf04ylx99zf.mp3","text":"你能劝一劝阿米娅吗？她那样还挺可怜的。善良只会蒙蔽她，对我来说......适合恶徒的只有毁灭一种结局。","alt":"voice/char_166_skfire/cn_005.mp3"},{"url":"bwiki:3/31/i47tys56cfzwv2my61p7ny9c8xw9b2z.mp3","text":"你现在的实力，根本达不到我们【王者之杖】的平均水平。呵，没错，我是很强，而我们五人汇聚起的力量，更是连语言都没法衡量。","alt":"voice/char_166_skfire/cn_006.mp3"}],"信赖":[{"url":"bwiki:8/84/aca7q80c2hqzqtro6uu3t6hapzzc8x3.mp3","text":"七曜的那把刀，是白送给她的，据说它的前任主人是一位能一刀斩下东国所有的樱花的剑豪。然而即使是这样的人，还是被白击败，输掉了这把刀哦。","alt":"voice/char_166_skfire/cn_007.mp3"},{"url":"bwiki:2/2c/c078ug5h8xppstoboilzik9jk6pyhj1.mp3","text":"你那件衣服是怎么回事？咦？是我烧破的？但......不可能啊，我对自己身体的控制是很完美的......大概吧？我......抱歉，我很抱歉。","alt":"voice/char_166_skfire/cn_008.mp3"},{"url":"bwiki:6/6d/tnnytazixs8ra9w6zffh52zh1xzid26.mp3","text":"即便你我的想法截然不同，但罗德岛那拼命努力、不断奔驰的样子......很不错。对，我是在夸奖你们。这很美妙。","alt":"voice/char_166_skfire/cn_009.mp3"}],"闲置":[{"url":"bwiki:e/e1/lbpz78ymzt4n28d1hxl6woozagmd4de.mp3","text":"如此怠惰。你就打算这样偷懒贪睡，荒废时间吗？","alt":"voice/char_166_skfire/cn_010.mp3"}],"报到":[{"url":"bwiki:8/8c/3m06ulh4qkn1zih7srtdwkkaefv6rnd.mp3","text":"“王者之杖”所属，天火。在达成目的之前，我会暂时在罗德岛停留。目的？当然是将整合运动焚烧殆尽。","alt":"voice/char_166_skfire/cn_011.mp3"}],"作战记录":[{"url":"bwiki:2/22/18xwllwfi4ilux5o9l5017t4je78tvk.mp3","text":"仅凭如此，可无法引出我真正的力量。","alt":"voice/char_166_skfire/cn_012.mp3"}],"精英化1":[{"url":"bwiki:6/66/bmxhpxnpn485ucecmk88zzrklfesmc8.mp3","text":"理所应当。","alt":"voice/char_166_skfire/cn_013.mp3"}],"精英化2":[{"url":"bwiki:7/7c/1v5foqbkd7rq5rab7wmkktg9hho5bia.mp3","text":"哼，偶尔享受些符合身份的待遇，也算是种休息。","alt":"voice/char_166_skfire/cn_014.mp3"}],"编入":[{"url":"bwiki:0/0f/a9wjq7sohu2t7plvw3p6kbxk6zc88xv.mp3","text":"战场的温度太低了。","alt":"voice/char_166_skfire/cn_017.mp3"}],"任命队长":[{"url":"bwiki:6/6d/qyh248pom58nzsw3252118lbzrscygb.mp3","text":"太阳的光辉，庇护着我。","alt":"voice/char_166_skfire/cn_018.mp3"}],"行动出发":[{"url":"bwiki:2/2a/apdbjmrpok3xwysewg76a9k19tz6xpq.mp3","text":"出击。","alt":"voice/char_166_skfire/cn_019.mp3"}],"行动开始":[{"url":"bwiki:5/59/n3usc5cgwk6voyhw5t7z1h0kk803ovh.mp3","text":"在这天火的威光前拜伏吧。","alt":"voice/char_166_skfire/cn_020.mp3"}],"选中":[{"url":"bwiki:c/cb/2tsiks82r615wm00lvk3ibqc3vss2wm.mp3","text":"来吧。","alt":"voice/char_166_skfire/cn_021.mp3"},{"url":"bwiki:e/e8/12u5h8mlvgrfietjodba6mcp9e4cmhm.mp3","text":"你打算怎么做？","alt":"voice/char_166_skfire/cn_022.mp3"}],"部署":[{"url":"bwiki:5/5c/c6yjqej1z4ga261p6xdgmyw7jl6o6fw.mp3","text":"噩运只等待弱者坠落。","alt":"voice/char_166_skfire/cn_023.mp3"},{"url":"bwiki:f/f8/9g25sp0x1457wfdrqavpk4waj0g33la.mp3","text":"智者先攻。","alt":"voice/char_166_skfire/cn_024.mp3"}],"技能":[{"url":"bwiki:5/54/48h8pxw3dux3ly3s8c1bzccjyyi9djx.mp3","text":"去吧。","alt":"voice/char_166_skfire/cn_025.mp3"},{"url":"bwiki:3/31/67cv6n0phwib0gb0vfhdal3lyde7p73.mp3","text":"火，炎，焱。","alt":"voice/char_166_skfire/cn_026.mp3"},{"url":"bwiki:d/d8/ryfk7yfd5db4u43zxi5xaxdhtojjmko.mp3","text":"日炎将你焚尽！","alt":"voice/char_166_skfire/cn_027.mp3"},{"url":"bwiki:5/5f/oxd5axssknn29kdlcn456qj7kikrk4b.mp3","text":"天空将你点燃！","alt":"voice/char_166_skfire/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:e/e2/ep4ql6cnz9ahbwte8aouvdn75f4rlpy.mp3","text":"没有日炎烧不尽的灵魂。","alt":"voice/char_166_skfire/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:4/4d/r6olpeoq1sd431fgcdi40xrp4xdlh0i.mp3","text":"你们啊，都被烧干净了，难道还想留下些什么吗？","alt":"voice/char_166_skfire/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:5/56/pjlcfmwvjlkloi12aa435lr368n6y2n.mp3","text":"就只有这种程度......吗。","alt":"voice/char_166_skfire/cn_031.mp3"}],"失败":[{"url":"bwiki:9/97/99xydcdwsdjqpbehe6qd0l3e4zbumsz.mp3","text":"不可能......我这样的......怎么会......","alt":"voice/char_166_skfire/cn_032.mp3"}],"进驻":[{"url":"bwiki:1/14/fhentut6d21qoqhhlsz0crbt0597y3v.mp3","text":"就不能为我准备一间更凉快点的房间吗？","alt":"voice/char_166_skfire/cn_033.mp3"}],"戳一下":[{"url":"bwiki:7/76/hcrhza2taa423cbje7zg2n4i0smwkht.mp3","text":"你的手想被烧焦吗？","alt":"voice/char_166_skfire/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:2/2b/1aeuccoenfei68g5nqed3zfz352t4r3.mp3","text":"博士，可以为我说明一下这种理论吗？只要占用你十二分钟就够了。","alt":"voice/char_166_skfire/cn_036.mp3"}],"标题":[{"url":"bwiki:9/91/7f9j87jsprgjxaeolmzlz5cfiw7ttnb.mp3","text":"明日方舟。","alt":"voice/char_166_skfire/cn_037.mp3"}],"新年":[{"url":"bwiki:3/33/6mkgqjm3sfpsgr1temdf5nqy38i2nqf.mp3","text":"哼，他们不让我靠近烟花，说我控制不好会把这些都炸掉，还专门让后勤部干员在这里守着，我哪里就——啊！灭火器灭火器！......生气导致体温上升是正常生理现象，我、我离远点就是了！","alt":"voice/char_166_skfire/cn_038.mp3"}],"问候":[{"