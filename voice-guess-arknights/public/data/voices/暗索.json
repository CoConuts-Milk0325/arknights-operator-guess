{"中文":{"登录":[{"url":"bwiki:9/98/isce3lcj4m7sjyacegzkufmbwobv7ez.mp3","text":"博士，你没忘记带什么东西吧~","alt":"voice_cn/char_236_rope/cn_001.mp3"}],"交谈":[{"url":"bwiki:9/99/j1lghf8ml1hmv9krho0z5opkbkec6js.mp3","text":"从别人口袋里拿东西来填饱肚子？有什么办法，我就是这样长大的，不然我早就饿死了。","alt":"voice_cn/char_236_rope/cn_002.mp3"},{"url":"bwiki:0/05/aikad9844keupk6pheojaftd1djjlrd.mp3","text":"钩索想要耐用，绳子才是关键。嗯？你问我为什么喜欢用钩索？你去徒手爬爬楼不就知道了？","alt":"voice_cn/char_236_rope/cn_003.mp3"},{"url":"bwiki:d/d6/tnaszg9w6cz4z0t2hugh87dszc2pz8z.mp3","text":"是的是的，我会好好听从博士教导的，我能回宿舍了吗，一会还有事呢。好啦好啦！别说了！救命！","alt":"voice_cn/char_236_rope/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:2/2e/ery7pxen8ymtzy4ep9i16csn3ezvilh.mp3","text":"如果不是你们罗德岛，我可能还在蹲号子。你们是怎么知道我的？唔？从哪里听说了我的身手吗？","alt":"voice_cn/char_236_rope/cn_005.mp3"},{"url":"bwiki:6/6b/lnv3whfkqx4or8py7udtiw20evh2erw.mp3","text":"其实在贫民窟活下来有很多方式，只不过——活不下来的更多。说实在的，我可没得选，希望你能明白这点。","alt":"voice_cn/char_236_rope/cn_006.mp3"}],"信赖":[{"url":"bwiki:1/18/fuom24r1tvtm0jty9f6572mgoh5e5oy.mp3","text":"父母把我赶出家门，让我流落街头自生自灭。比起那样的地方，当然是在罗德岛更加快活些。","alt":"voice_cn/char_236_rope/cn_007.mp3"},{"url":"bwiki:b/b4/9gdp0knxqz63o4tj28fwdqa8irq5566.mp3","text":"有许多人生了这种病，我也觉得自己要没救了，还好你们找到我......说实在的，博士，你会帮我治好的吧？不能？嘛，也没差。","alt":"voice_cn/char_236_rope/cn_008.mp3"},{"url":"bwiki:2/2f/mhv3x5ypwl4h3zj1mp5b8xee3ei6ai9.mp3","text":"以前吃饭上顿不接下顿，现在能天天吃到舒服，不得不说，罗德岛还是不错的。哼......你想听我谢谢你吗？算了吧。哎呀你已经听过了！","alt":"voice_cn/char_236_rope/cn_009.mp3"}],"闲置":[{"url":"bwiki:a/a4/dup9glqt4zm1dr1aec47lddzb8v067b.mp3","text":"啊这椅子，可恶！有，有点舒服！","alt":"voice_cn/char_236_rope/cn_010.mp3"}],"报到":[{"url":"bwiki:d/dd/kvnw9p8ijugx1hj910rykcfxeweux95.mp3","text":"我叫暗索，很高兴认识你。啊对了，你的饭卡还在这里，别忘记拿了。唔？为什么在我这儿？这是秘·密·哦。","alt":"voice_cn/char_236_rope/cn_011.mp3"}],"作战记录":[{"url":"bwiki:e/e7/71dsrk4bpmyofkbf3yehdtmhvyo3g5k.mp3","text":"看这东西真的管用么？","alt":"voice_cn/char_236_rope/cn_012.mp3"}],"精英化1":[{"url":"bwiki:7/79/n3c68qjmd25kjcbi4xjn2ml44kzjo14.mp3","text":"工钱啦，工钱。比起这个，还是工钱更实在。","alt":"voice_cn/char_236_rope/cn_013.mp3"}],"精英化2":[{"url":"bwiki:a/aa/jpshdverrmjx750fzb959gkylp2vdoj.mp3","text":"好啦，收了你那么多钱，我也该认真干活咯！","alt":"voice_cn/char_236_rope/cn_014.mp3"}],"编入":[{"url":"bwiki:6/6f/qfj1wnz83vn607m96528bx6k2sz0ihb.mp3","text":"好、好，来了~","alt":"voice_cn/char_236_rope/cn_017.mp3"}],"任命队长":[{"url":"bwiki:d/de/m9d34m3sea1rhn0avcujec2blevtijb.mp3","text":"当队长？以前可是要拿额外工钱的，看在你的面子上就不强求啦。","alt":"voice_cn/char_236_rope/cn_018.mp3"}],"行动出发":[{"url":"bwiki:d/d4/b1n7jxf0cuuxqzch60cjv2oqrj7bufg.mp3","text":"要提前勘察好地图和路线哦，这可是经验之谈。","alt":"voice_cn/char_236_rope/cn_019.mp3"}],"行动开始":[{"url":"bwiki:2/21/tvlkeml9yp72ak12sjaa8g7bqtcki4j.mp3","text":"那么，敌人身上会有什么好东西呢？","alt":"voice_cn/char_236_rope/cn_020.mp3"}],"选中":[{"url":"bwiki:e/ef/j51x6igiygef7wav2w5s5iahg46i87h.mp3","text":"正面对决可不适合我啊。","alt":"voice_cn/char_236_rope/cn_021.mp3"},{"url":"bwiki:2/23/ov0egtcqeo6c7btuljm4bpvg4zkpvrq.mp3","text":"运用好我的长处，拜托了~","alt":"voice_cn/char_236_rope/cn_022.mp3"}],"部署":[{"url":"bwiki:1/18/1ok6twhnqujhooix7q73n1iuplfoj9z.mp3","text":"偷偷摸摸~","alt":"voice_cn/char_236_rope/cn_023.mp3"},{"url":"bwiki:a/a5/myagig7fqnjcxpnqttstrxoz6ssyuhm.mp3","text":"这是个好位置吗？","alt":"voice_cn/char_236_rope/cn_024.mp3"}],"技能":[{"url":"bwiki:b/b6/icg28pt67lifkr63q4z5sht74p4bbe2.mp3","text":"啊哈！","alt":"voice_cn/char_236_rope/cn_025.mp3"},{"url":"bwiki:3/30/qiy9d3njsvr9m7ydm22ral67msne6lk.mp3","text":"来来来~","alt":"voice_cn/char_236_rope/cn_026.mp3"},{"url":"bwiki:2/26/r6nm3nzat098zma4ofm0ph046aucv5g.mp3","text":"嘿——！","alt":"voice_cn/char_236_rope/cn_027.mp3"},{"url":"bwiki:f/f9/4qo8izmo7jd3orsv70ktgb1hg02zqvc.mp3","text":"被这钩子勾中可就跑不了了！","alt":"voice_cn/char_236_rope/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:6/68/rj9bs2xcxhbqm5dhyheoyweifo38a9r.mp3","text":"这一场可比平时刺激多了，当然，收入也......哼哼~","alt":"voice_cn/char_236_rope/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:9/97/h9os4jzan1xqqror9z9eumblrm10grt.mp3","text":"有些好东西，留在敌人身上也是种浪费~你说呢？","alt":"voice_cn/char_236_rope/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:8/8e/r457gf46up9b3rrx0hwj70or5mt8kll.mp3","text":"跑了几个人？那就别追了吧，说不定能改过自新呢？","alt":"voice_cn/char_236_rope/cn_031.mp3"}],"失败":[{"url":"bwiki:0/02/lf20gyez6og877f4ex6xmidxklbwsav.mp3","text":"......喂喂，还是和我一起先溜吧？保命要紧啊！","alt":"voice_cn/char_236_rope/cn_032.mp3"}],"进驻":[{"url":"bwiki:3/3c/i0626yru0muovel3p9p532v5ir1be15.mp3","text":"这个房间有没有通风管道？没什么，就问下。","alt":"voice_cn/char_236_rope/cn_033.mp3"}],"戳一下":[{"url":"bwiki:b/b3/4cpj9h99zv78mf1qub33o6kcllr5y6i.mp3","text":"呃，有谁来抓我了吗！","alt":"voice_cn/char_236_rope/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:9/97/n1jukfjfgzucbh9uycfrqvbujhf3ylt.mp3","text":"其实我也想学一学如何做个普通的女孩子的。可是吧，唉，那样是不是不太适合我呢？","alt":"voice_cn/char_236_rope/cn_036.mp3"}],"标题":[{"url":"bwiki:c/cc/h8xll6emzjdjfzo6l0tw1cdhn824ie5.mp3","text":"明日方舟。","alt":"voice_cn/char_236_rope/cn_037.mp3"}],"新年":[{"url":"bwiki:f/fb/j4xiag84pn5nvf8dq1b7ufns5zgi6vb.mp3","text":"热腾腾的食物，开怀的笑容，好多好多礼物......这种景象，我之前只在窗外偷看过。谢谢你，博士......可不是开玩笑，我是真心的！新年快乐哦。","alt":"voice_cn/char_236_rope/cn_038.mp3"}],"问候":[{"url":"bwiki:d/d8/gtsumauk1nhjbaspxg55vl8viqsw1vo.mp3","text":"嗨，博士。","alt":"voice_cn/char_236_rope/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:a/a2/4d8dxsyq0jtjfmxhqamof3z6bvif3tl.mp3","text":"博士，你没忘记带什么东西吧~","alt":"voice/char_236_rope/cn_001.mp3"}],"交谈":[{"url":"bwiki:f/f3/1skiav65q9vxlszi0zv8ht74vjgcx5i.mp3","text":"从别人口袋里拿东西来填饱肚子？有什么办法，我就是这样长大的，不然我早就饿死了。","alt":"voice/char_236_rope/cn_002.mp3"},{"url":"bwiki:0/0f/s007wyw0x7cjk8ldfjccumzeaj85v0l.mp3","text":"钩索想要耐用，绳子才是关键。嗯？你问我为什么喜欢用钩索？你去徒手爬爬楼不就知道了？","alt":"voice/char_236_rope/cn_003.mp3"},{"url":"bwiki:c/c1/6jvouhxm2gejyknnv8du03xw2l1lcud.mp3","text":"是的是的，我会好好听从博士教导的，我能回宿舍了吗，一会还有事呢。好啦好啦！别说了！救命！","alt":"voice/char_236_rope/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:c/cd/l7uxsli9j3ezpjt2mq0bi48fn56gk43.mp3","text":"如果不是你们罗德岛，我可能还在蹲号子。你们是怎么知道我的？唔？从哪里听说了我的身手吗？","alt":"voice/char_236_rope/cn_005.mp3"},{"url":"bwiki:6/60/i6emkzq76o5l1vp25h5u96gze1eldxu.mp3","text":"其实在贫民窟活下来有很多方式，只不过——活不下来的更多。说实在的，我可没得选，希望你能明白这点。","alt":"voice/char_236_rope/cn_006.mp3"}],"信赖":[{"url":"bwiki:4/4a/6brexx2rup286tamwm599wkodr42z90.mp3","text":"父母把我赶出家门，让我流落街头自生自灭。比起那样的地方，当然是在罗德岛更加快活些。","alt":"voice/char_236_rope/cn_007.mp3"},{"url":"bwiki:9/9a/hl4kuiqoaqq2o1q7jnncrd4fk0buztt.mp3","text":"有许多人生了这种病，我也觉得自己要没救了，还好你们找到我......说实在的，博士，你会帮我治好的吧？不能？嘛，也没差。","alt":"voice/char_236_rope/cn_008.mp3"},{"url":"bwiki:e/eb/6qps3drp35mjrnddd0fvkr8r67mqc3p.mp3","text":"以前吃饭上顿不接下顿，现在能天天吃到舒服，不得不说，罗德岛还是不错的。哼......你想听我谢谢你吗？算了吧。哎呀你已经听过了！","alt":"voice/char_236_rope/cn_009.mp3"}],"闲置":[{"url":"bwiki:2/2f/1klz0iojcbi67pbrcrfctiednv2lec7.mp3","text":"啊这椅子，可恶！有，有点舒服！","alt":"voice/char_236_rope/cn_010.mp3"}],"报到":[{"url":"bwiki:c/c3/qm2raauej8jghjmv6ckol26uukqydk1.mp3","text":"我叫暗索，很高兴认识你。啊对了，你的饭卡还在这里，别忘记拿了。唔？为什么在我这儿？这是秘·密·哦。","alt":"voice/char_236_rope/cn_011.mp3"}],"作战记录":[{"url":"bwiki:5/56/k3ncylm5jyuaf54fj5vys3c6379nsu5.mp3","text":"看这东西真的管用么？","alt":"voice/char_236_rope/cn_012.mp3"}],"精英化1":[{"url":"bwiki:8/8a/5aqxmm9w6scvq3z45mukpqg4k8jgtmm.mp3","text":"工钱啦，工钱。比起这个，还是工钱更实在。","alt":"voice/char_236_rope/cn_013.mp3"}],"精英化2":[{"url":"bwiki:f/fc/9wbktfhjv9u3ynkupog91658u1st6yr.mp3","text":"好啦，收了你那么多钱，我也该认真干活咯！","alt":"voice/char_236_rope/cn_014.mp3"}],"编入":[{"url":"bwiki:6/62/dubbp4hjoaa5jb31d1shd2sy142vdo0.mp3","text":"好、好，来了~","alt":"voice/char_236_rope/cn_017.mp3"}],"任命队长":[{"url":"bwiki:2/2a/e1v8eb16vym661omhms243qottrn2xg.mp3","text":"当队长？以前可是要拿额外工钱的，看在你的面子上就不强求啦。","alt":"voice/char_236_rope/cn_018.mp3"}],"行动出发":[{"url":"bwiki:d/da/el84et5e4intx2plctqa7etndjebezx.mp3","text":"要提前勘察好地图和路线哦，这可是经验之谈。","alt":"voice/char_236_rope/cn_019.mp3"}],"行动开始":[{"url":"bwiki:6/6b/q5xbs0kt4y5u9hfzzjmv4y3pak51kom.mp3","text":"那么，敌人身上会有什么好东西呢？","alt":"voice/char_236_rope/cn_020.mp3"}],"选中":[{"url":"bwiki:9/9e/0pbdxz62hn6apnxsk9d7ymzmi545ywx.mp3","text":"正面对决可不适合我啊。","alt":"voice/char_236_rope/cn_021.mp3"},{"url":"bwiki:6/64/lus98kersygyfustcpq5n8exharss22.mp3","text":"运用好我的长处，拜托了~","alt":"voice/char_236_rope/cn_022.mp3"}],"部署":[{"url":"bwiki:c/c4/n927m541f313quogxozujpjrphc8tbj.mp3","text":"偷偷摸摸~","alt":"voice/char_236_rope/cn_023.mp3"},{"url":"bwiki:d