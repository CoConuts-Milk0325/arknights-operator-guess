{"中文":{"登录":[{"url":"bwiki:a/a3/dqwyxj0ltuvnioal3jytm1vi3jkynwv.mp3","text":"我正在警戒四周，没有问题。","alt":"voice_cn/char_158_milu/cn_001.mp3"}],"交谈":[{"url":"bwiki:e/e6/gr84r61847nzify15xm59ev2xc7opu8.mp3","text":"一些注视着你的视线是饱含恶意的。即使在罗德岛，您也并不安全。","alt":"voice_cn/char_158_milu/cn_002.mp3"},{"url":"bwiki:1/11/rs782c9hnjwskg4w3h1f26vglaufapm.mp3","text":"没必要害怕那些阴影中的敌人，这些罪人无论用什么方法躲藏，都欺骗不了我的眼睛。","alt":"voice_cn/char_158_milu/cn_003.mp3"},{"url":"bwiki:f/f9/m4bm0upmhcukx16f986xxv48h18rdxo.mp3","text":"即使牺牲我的生命，也一定要完成这次复仇。","alt":"voice_cn/char_158_milu/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:2/25/85k9ofijtt6amty5hpfepm9v0ofs78q.mp3","text":"我的族人和朋友，都葬身在故乡的森林里。只有落叶能掩埋他们。","alt":"voice_cn/char_158_milu/cn_005.mp3"},{"url":"bwiki:7/73/j7svj3rax0pps9ymw4x81tphyvnqvu4.mp3","text":"这把弩是为了审判罪人制造的。终有一天，我要用它降下最后的裁决。","alt":"voice_cn/char_158_milu/cn_006.mp3"}],"信赖":[{"url":"bwiki:0/01/25hpdi1zuvn1n3j4msxcbq1yxriwqrr.mp3","text":"陨星。她曾经是我的朋友。我的故乡被摧毁的那天，只有我们几个人设法逃了出来。","alt":"voice_cn/char_158_milu/cn_007.mp3"},{"url":"bwiki:b/b5/cexhi8my2242217d3ymwhgf5a9op2pp.mp3","text":"我一直在找那个告密者，把叛军引向故乡的罪人......会是陨星吗？不，我、我不认为是她——","alt":"voice_cn/char_158_milu/cn_008.mp3"},{"url":"bwiki:d/d1/99qgreqeisoyiec9wnee93c1jv1ja5x.mp3","text":"——我睡着了？抱、抱歉，最近巡逻的时间增加了......不，即使您说没关系也......谢谢您的关心。","alt":"voice_cn/char_158_milu/cn_009.mp3"}],"闲置":[{"url":"bwiki:7/7e/e3qjy3ezzzzwr6d91wypae4u23ighqu.mp3","text":"我想稍微睡一下......","alt":"voice_cn/char_158_milu/cn_010.mp3"}],"报到":[{"url":"bwiki:0/05/j8z5xv3l9sru4exo7odg7zz40ossfzg.mp3","text":"狙击手守林人。为了复仇，我需要强大力量的帮助。","alt":"voice_cn/char_158_milu/cn_011.mp3"}],"作战记录":[{"url":"bwiki:1/1c/lu2fs50491vuv5wb9hxqgbg1kuxwlpt.mp3","text":"我需要更多的力量。","alt":"voice_cn/char_158_milu/cn_012.mp3"}],"精英化1":[{"url":"bwiki:0/06/lff36684cequing5ojsfn2fb348nras.mp3","text":"感谢您的任命。","alt":"voice_cn/char_158_milu/cn_013.mp3"}],"精英化2":[{"url":"bwiki:b/b2/1ke5ah6dqrkj6nzyxdwdicihjmnsfx0.mp3","text":"任命，感谢。从今以后，也请将我的力量用于正途，否则......","alt":"voice_cn/char_158_milu/cn_014.mp3"}],"编入":[{"url":"bwiki:3/33/o1chzyqxv9drbmt31llygs562qblkv9.mp3","text":"组队完成。","alt":"voice_cn/char_158_milu/cn_017.mp3"}],"任命队长":[{"url":"bwiki:f/f4/dy7l5y1jecea3ctzebrx5hoy8o8al7d.mp3","text":"了解。","alt":"voice_cn/char_158_milu/cn_018.mp3"}],"行动出发":[{"url":"bwiki:a/a0/3zifw8qm5mpqiu360xyrp60slonknfi.mp3","text":"全体干员出击。","alt":"voice_cn/char_158_milu/cn_019.mp3"}],"行动开始":[{"url":"bwiki:e/e6/g5mmdi14sqbc7vokaahykrcvnehmnam.mp3","text":"发现敌情，立即采取行动。","alt":"voice_cn/char_158_milu/cn_020.mp3"}],"选中":[{"url":"bwiki:7/76/e1zugvkzoa8hpj8e8clvpcpw1gar21t.mp3","text":"了解。","alt":"voice_cn/char_158_milu/cn_021.mp3"},{"url":"bwiki:5/51/kmhi10dnovm5wmdvx05uc0oyh4x1qn2.mp3","text":"请下达指令。","alt":"voice_cn/char_158_milu/cn_022.mp3"}],"部署":[{"url":"bwiki:2/27/pl7jl9q0zpphqk4y2n3jllvkkrmvozd.mp3","text":"现在进行索敌。","alt":"voice_cn/char_158_milu/cn_023.mp3"},{"url":"bwiki:e/ee/szxhlwxb2y3214tmuyttcms8moyxfaa.mp3","text":"到达目标地点。","alt":"voice_cn/char_158_milu/cn_024.mp3"}],"技能":[{"url":"bwiki:4/4e/mc26jp739syskt318uv3gx3xbo4rjl7.mp3","text":"援护。","alt":"voice_cn/char_158_milu/cn_025.mp3"},{"url":"bwiki:4/42/1r8ge5lzt4t6ot4kjawhakdfu6emej0.mp3","text":"瞄准。","alt":"voice_cn/char_158_milu/cn_026.mp3"},{"url":"bwiki:1/19/jpvhsfah6nj87yrfimiyj6jy147wfvy.mp3","text":"发射。","alt":"voice_cn/char_158_milu/cn_027.mp3"},{"url":"bwiki:c/cb/8kzvmc1obzqyo7hfhafiv68fzcmwlmj.mp3","text":"开火！","alt":"voice_cn/char_158_milu/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:0/01/g4gl0hojn24uwbyjluhmj0kphdsrzuc.mp3","text":"我会一直走下去，直到彻底实现复仇那天。","alt":"voice_cn/char_158_milu/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:5/52/hjtlymtv7zlxr1fvl0kr3yupm27rvyz.mp3","text":"作战结束。歼灭了所有目标。","alt":"voice_cn/char_158_milu/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:7/7c/b6kbpm3dwnnxgvw7p0an613ldk4rvko.mp3","text":"战斗结束。有必要确认残余敌人的情况。","alt":"voice_cn/char_158_milu/cn_031.mp3"}],"失败":[{"url":"bwiki:2/25/16q5yg17dhgcniqgnfqwe09hbn4bsng.mp3","text":"马上撤退......","alt":"voice_cn/char_158_milu/cn_032.mp3"}],"进驻":[{"url":"bwiki:6/65/bhynsfoe1ekdcuq9z1vuv5gjlw8gxuq.mp3","text":"不习惯热闹的房间......","alt":"voice_cn/char_158_milu/cn_033.mp3"}],"戳一下":[{"url":"bwiki:4/42/ju88o91balo0zqzkfsnfgf2pwybfeuo.mp3","text":"啊......","alt":"voice_cn/char_158_milu/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:e/ef/bf5ves88b32a97jm27cc4bis23cgqfj.mp3","text":"那个，摸我的角的话，有点为难......很痒......","alt":"voice_cn/char_158_milu/cn_036.mp3"}],"标题":[{"url":"bwiki:b/b1/gb3a31w9rpe4ure4ru1qfr1eeady7at.mp3","text":"明日方舟。","alt":"voice_cn/char_158_milu/cn_037.mp3"}],"新年":[{"url":"bwiki:6/65/ryjhpc85gvhcmifphknyh1eo9r3y753.mp3","text":"新年？虽然有些太过吵闹，但是之前在森林里，我们也有这样的日子......我们一起围着篝火唱歌，用藤条编织手串互相赠送......博士想听我们当地的那些歌吗？我还记得它们。","alt":"voice_cn/char_158_milu/cn_038.mp3"}],"问候":[{"url":"bwiki:5/55/p7fkmxgyodp6rs5qe56otpbeuazyrli.mp3","text":"嗯？博士啊。","alt":"voice_cn/char_158_milu/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:8/8f/ev4toohj1332nxq818qaotbw1li08bz.mp3","text":"我正在警戒四周，没有问题。","alt":"voice/char_158_milu/cn_001.mp3"}],"交谈":[{"url":"bwiki:c/c7/rbnz4eyiy6bdenpo6dp9mmeygsgrhw3.mp3","text":"一些注视着你的视线是饱含恶意的。即使在罗德岛，您也并不安全。","alt":"voice/char_158_milu/cn_002.mp3"},{"url":"bwiki:0/05/5qf2vu673tku79zf9afp4oh581mr48e.mp3","text":"没必要害怕那些阴影中的敌人，这些罪人无论用什么方法躲藏，都欺骗不了我的眼睛。","alt":"voice/char_158_milu/cn_003.mp3"},{"url":"bwiki:d/d2/luzp6mpt1fcvw6gphhg6z0mukjcvdrm.mp3","text":"即使牺牲我的生命，也一定要完成这次复仇。","alt":"voice/char_158_milu/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:2/24/rgqfgoa49qdma8kykw3klpdfu83ahs1.mp3","text":"我的族人和朋友，都葬身在故乡的森林里。只有落叶能掩埋他们。","alt":"voice/char_158_milu/cn_005.mp3"},{"url":"bwiki:1/1c/iagnu23x7jauvn0xyu1dopiq07gacsu.mp3","text":"这把弩是为了审判罪人制造的。终有一天，我要用它降下最后的裁决。","alt":"voice/char_158_milu/cn_006.mp3"}],"信赖":[{"url":"bwiki:8/86/lzqydyvh9r1kj954ez35ebxkxfhur94.mp3","text":"陨星。她曾经是我的朋友。我的故乡被摧毁的那天，只有我们几个人设法逃了出来。","alt":"voice/char_158_milu/cn_007.mp3"},{"url":"bwiki:d/d3/krwry4tfprnhke576f46b2ftzekreu3.mp3","text":"我一直在找那个告密者，把叛军引向故乡的罪人......会是陨星吗？不，我、我不认为是她——","alt":"voice/char_158_milu/cn_008.mp3"},{"url":"bwiki:b/b7/244ub3v16x7kzbto6ywitepy5d7tdl6.mp3","text":"——我睡着了？抱、抱歉，最近巡逻的时间增加了......不，即使您说没关系也......谢谢您的关心。","alt":"voice/char_158_milu/cn_009.mp3"}],"闲置":[{"url":"bwiki:7/7b/9y4qy8rgxd52ex2aji8olpp06w608n1.mp3","text":"我想稍微睡一下......","alt":"voice/char_158_milu/cn_010.mp3"}],"报到":[{"url":"bwiki:a/af/1hhebfawayxkhwfqwgihkk8l4cutdf8.mp3","text":"狙击手守林人。为了复仇，我需要强大力量的帮助。","alt":"voice/char_158_milu/cn_011.mp3"}],"作战记录":[{"url":"bwiki:8/8a/d3b448n5mp5h05x93a9o89w3ss08qo2.mp3","text":"我需要更多的力量。","alt":"voice/char_158_milu/cn_012.mp3"}],"精英化1":[{"url":"bwiki:2/28/hkndoq02ysjwpkbjpbivlh37fg1u7g2.mp3","text":"感谢您的任命。","alt":"voice/char_158_milu/cn_013.mp3"}],"精英化2":[{"url":"bwiki:3/30/fwma3vpwglsog6aotjge1rzueuemh94.mp3","text":"任命，感谢。从今以后，也请将我的力量用于正途，否则......","alt":"voice/char_158_milu/cn_014.mp3"}],"编入":[{"url":"bwiki:0/02/388vt7hbhqkp5yupi6gfq0r2lvvrzjn.mp3","text":"组队完成。","alt":"voice/char_158_milu/cn_017.mp3"}],"任命队长":[{"url":"bwiki:8/8b/t7g91bw8sydkujum14mvz9r9khwqb8y.mp3","text":"了解。","alt":"voice/char_158_milu/cn_018.mp3"}],"行动出发":[{"url":"bwiki:2/2e/jq0pou6dz93um182ew8a50xg0s1mtv4.mp3","text":"全体干员出击。","alt":"voice/char_158_milu/cn_019.mp3"}],"行动开始":[{"url":"bwiki:e/eb/sk59fhy9727su0byw1y41rxinb3umgv.mp3","text":"发现敌情，立即采取行动。","alt":"voice/char_158_milu/cn_020.mp3"}],"选中":[{"url":"bwiki:6/68/te325e6b4jwli8cs6szhnp8ub9rzr4u.mp3","text":"了解。","alt":"voice/char_158_milu/cn_021.mp3"},{"url":"bwiki:e/e4/f83wf11eq3zea7e8qfy1u0kuj1jxn9v.mp3","text":"请下达指令。","alt":"voice/char_158_milu/cn_022.mp3"}],"部署":[{"url":"bwiki:1/17/4hm5tgsn8jv48l3zwkepy3hfa71011r.mp3","text":"现在进行索敌。","alt":"voice/char_158_milu/cn_023.mp3"},{"url":"bwiki:e/ea/n1g1cof16bft1nafgxge6s23nbnxi27.mp3","text":"到达目标地点。","alt":"voice/char_158_milu/cn_024.mp3"}],"技能":[{"url":"bwiki:6/6d/7zfhvrbepaes4hr7dtuk9ia971roelr.mp3","text":"援护。","alt":"voice/char_158_milu/cn_025.mp3"},{"url":"bwiki:c/cd/762iis6vp8qh4616o47u6ohtqm5jg4p.mp3","text":"瞄准。","alt":"voice/char_158_milu/cn_026.mp3"},{"url":"bwiki:3/35/kt9zbvfko4vuac4hescckwbxy3nukia.mp3","text":"发射。","alt":"voice/char_158_milu/cn_027.mp3"},{