lt":"voice_cn/char_241_panda/cn_030.mp3"},{"url":"bwiki:6/65/3s0dj47i5a30p3al86j9q11nxhhae7m.mp3","text":"这就完了？我热身还没做好呢。","alt":"voice_custom/char_241_panda_cn_topolect/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:b/bf/gmwjtwwynpp4tahjvyh9h70j7eqpijq.mp3","text":"别想那么多啦，受点伤没什么大不了的。","alt":"voice_cn/char_241_panda/cn_031.mp3"},{"url":"bwiki:4/4e/j6unequupaeoy3w2ct8uvw9ygkatwdm.mp3","text":"别想那么多啦，受点伤没什么大不了的。","alt":"voice_custom/char_241_panda_cn_topolect/cn_031.mp3"}],"失败":[{"url":"bwiki:4/4e/dz2h84uib4x9lb239ad5ncwh20gxr3m.mp3","text":"不行......好想回家睡觉......","alt":"voice_cn/char_241_panda/cn_032.mp3"},{"url":"bwiki:0/05/27n1c2zo98cmybg3rems2ekkck2jjgi.mp3","text":"不行......好想回家睡觉......","alt":"voice_custom/char_241_panda_cn_topolect/cn_032.mp3"}],"进驻":[{"url":"bwiki:5/57/0q5r9sejna4ugige29688b10my9yl6j.mp3","text":"还挺时髦的嘛！","alt":"voice_cn/char_241_panda/cn_033.mp3"},{"url":"bwiki:8/8c/jlpgy91rieky7wzxamknzhufnicpvn1.mp3","text":"还挺时髦的嘛！","alt":"voice_custom/char_241_panda_cn_topolect/cn_033.mp3"}],"戳一下":[{"url":"bwiki:f/f3/rjemoiicbrzv5l6ua13v8xrg0g4zg85.mp3","text":"唉唉！头会昏的！","alt":"voice_cn/char_241_panda/cn_034.mp3"},{"url":"bwiki:9/95/s48fqazbn2ouasl3mb4fkf19xyqdo7b.mp3","text":"唉唉！头会昏的！","alt":"voice_custom/char_241_panda_cn_topolect/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:9/91/5h6n12g52jlw48ffuidm3h9oiv0rogr.mp3","text":"嘿嘿，博士，想不想要我的签名？附赠我们两个的合照哦！","alt":"voice_cn/char_241_panda/cn_036.mp3"},{"url":"bwiki:0/06/r6guhjhs9nez4b7thqg02g715ovyrxz.mp3","text":"嘿嘿，博士，想不想要我的签名？附赠我们两个的合照哦！","alt":"voice_custom/char_241_panda_cn_topolect/cn_036.mp3"}],"标题":[{"url":"bwiki:9/94/ccxphziiwaev4nvgt87fto8m7ecut0y.mp3","text":"明日方舟。","alt":"voice_cn/char_241_panda/cn_037.mp3"},{"url":"bwiki:6/66/02u76da0xp9lma9e618ea20lmdd8mbp.mp3","text":"明日方舟。","alt":"voice_custom/char_241_panda_cn_topolect/cn_037.mp3"}],"新年":[{"url":"bwiki:5/5a/1koutecm2bbb5cffzmz5y4x6d6iessm.mp3","text":"元旦快乐！之前每年这个时候，各个电影院里都会上映我主演的电影，而且场场爆满，座无虚席哦！不过，总沉浸在过去里可不好，拳头要向前挥，人也要向前走嘛。今天就忘掉所有伤感的事吧！","alt":"voice_cn/char_241_panda/cn_038.mp3"},{"url":"bwiki:5/51/tt5yuc1pmd8y2f3peh22zo2coq62092.mp3","text":"元旦快乐！之前每年这个时候，各个电影院里都会上映我主演的电影，而且场场爆满，座无虚席哦！不过，总沉浸在过去里可不好，拳头要向前挥，人也要向前走嘛。今天就忘掉所有伤感的事吧！","alt":"voice_custom/char_241_panda_cn_topolect/cn_038.mp3"}],"问候":[{"url":"bwiki:5/5a/7be562fcyjm69sqj1za6dpuvtw5eo1m.mp3","text":"博士！有没有好好吃早饭呢！","alt":"voice_cn/char_241_panda/cn_042.mp3"},{"url":"bwiki:8/8e/ihn1stou2k4icsg03q4m14urhyp4sns.mp3","text":"博士！有没有好好吃早饭呢！","alt":"voice_custom/char_241_panda_cn_topolect/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:5/58/sjpdfifpyfcgtjsn7fa3g62705ojy7e.mp3","text":"真的只能这样站着吗？不可以做其他事情？好~无~聊~啊~","alt":"voice/char_241_panda/cn_001.mp3"}],"交谈":[{"url":"bwiki:8/8f/to53la9ajr00agaoh9uem7y7nw30147.mp3","text":"这个拳甲真的不重哦，你看，我一个女孩子也能轻松带在身上的东西，能沉到哪里去嘛。","alt":"voice/char_241_panda/cn_002.mp3"},{"url":"bwiki:a/a3/g5ffecairk2k7h5hbeqq1ia7lc5aq70.mp3","text":"和我并肩作战过？唔，我不记得了——行侠仗义本来就是我的职责嘛~","alt":"voice/char_241_panda/cn_003.mp3"},{"url":"bwiki:b/ba/lwozol1ugwv13xedh44jpumguk88mdm.mp3","text":"哈，那个叫猎蜂的拳手，真的很厉害！忍不住让人使出真拳脚呢。她收藏的蜂蜜也很好吃！博士下次也一起去吧！不过，先得学会如何打拳才行哦。","alt":"voice/char_241_panda/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:7/76/hnuugk9qh1jtl25dwfp5coeey84w3gs.mp3","text":"在看电影期刊？......嗯？没错啊，这篇报道里的当红功夫影星就是我本人~唉~？不信？呜哇，你看，这不就是我的脸吗？！为什么不信！","alt":"voice/char_241_panda/cn_005.mp3"},{"url":"bwiki:f/fc/hlmr50x0lemwi7yoe86a1e6sngeqhxv.mp3","text":"脱离过去的生活有没有什么遗憾？当然有啦。这个世界对感染者很严厉，有许多地方我都再也去不了，真可惜。","alt":"voice/char_241_panda/cn_006.mp3"}],"信赖":[{"url":"bwiki:9/99/77rhukit0mc09n5hnl64p4623wht384.mp3","text":"附近的城市有小吃街呢。这边是糖果店？好像也不错。哦？游乐场？！博士博士，我能请一天假出去玩吗！","alt":"voice/char_241_panda/cn_007.mp3"},{"url":"bwiki:0/04/qebd3dos960qudu2fdxh5j1v9c6nsl9.mp3","text":"对罗德岛的生活满不满意，呀，嘛，说实话......比电影本身都有趣！！有人切磋，有地方吃好吃的，工作就是行善！太完美了！","alt":"voice/char_241_panda/cn_008.mp3"},{"url":"bwiki:8/8d/pzr1jdh0wiu1c12gczyo0e2yb8xgvrg.mp3","text":"博士，你看这个剧本怎么样！嗯？主演？是你和我啦。其中有一幕是我们从三十楼上跳下来然后滑行，超酷的！喂！别走啊！等一下！","alt":"voice/char_241_panda/cn_009.mp3"}],"闲置":[{"url":"bwiki:c/cf/2szdtzxlgqqve8rnkdgltgd1txlyj5z.mp3","text":"博士在小憩，我也稍微偷个懒好了，唔......沙发......好软......","alt":"voice/char_241_panda/cn_010.mp3"}],"报到":[{"url":"bwiki:d/df/pb6mt3spqcl3y9vz4mohbkli2epszn2.mp3","text":"以前在哪儿见过我？那肯定是在银幕上啦~不过现在的我叫食铁兽呢，以后的工作安排就麻烦你了哦。","alt":"voice/char_241_panda/cn_011.mp3"}],"作战记录":[{"url":"bwiki:a/aa/8k0tbgd3h5ihho51od6fi5wupihfhpz.mp3","text":"没有了？再看一会儿嘛，马上就要到最精彩的部分了！","alt":"voice/char_241_panda/cn_012.mp3"}],"精英化1":[{"url":"bwiki:9/97/pjl4b5q95a1ge3siabujeuwzb5wj1yu.mp3","text":"晋~升~，欸嘿嘿，谢谢~","alt":"voice/char_241_panda/cn_013.mp3"}],"精英化2":[{"url":"bwiki:8/81/j6w9gc5wedcrkepn7ztb75oodf6gwul.mp3","text":"机会难得，就让你见识见识真正的拳法吧！","alt":"voice/char_241_panda/cn_014.mp3"}],"编入":[{"url":"bwiki:e/ea/ommg8a0p7gab71yr0w4jvpnlc3xmqr5.mp3","text":"好！是时候大显身手了！","alt":"voice/char_241_panda/cn_017.mp3"}],"任命队长":[{"url":"bwiki:9/90/elbkh0vycr82ho6qamnbz81g8zvqyng.mp3","text":"唉唉，当队长吗？我不是很擅长哦！","alt":"voice/char_241_panda/cn_018.mp3"}],"行动出发":[{"url":"bwiki:7/70/3uty2ce8yiz3s6e1i42si1bbrbi5iik.mp3","text":"这一战一定会很精彩！","alt":"voice/char_241_panda/cn_019.mp3"}],"行动开始":[{"url":"bwiki:3/3a/od8zsehoi4ev60zvgzit01iqssx9vsd.mp3","text":"在下食铁兽，请赐教！","alt":"voice/char_241_panda/cn_020.mp3"}],"选中":[{"url":"bwiki:3/39/eabap4dvx64wo9u9pilvn1pcjb5fu7r.mp3","text":"嗯嗯。","alt":"voice/char_241_panda/cn_021.mp3"},{"url":"bwiki:e/ed/qrcaprz2t0mmm0f757y3kck4rhvy707.mp3","text":"要上了！","alt":"voice/char_241_panda/cn_022.mp3"}],"部署":[{"url":"bwiki:9/9a/014drych2flg7pqcw8342tl3fm3g7qy.mp3","text":"好！","alt":"voice/char_241_panda/cn_023.mp3"},{"url":"bwiki:5/5d/k1ac0uvloplrzgeof5875bunsnab8r0.mp3","text":"大展拳脚咯！","alt":"voice/char_241_panda/cn_024.mp3"}],"技能":[{"url":"bwiki:8/8d/00crt55yeu99omekf94n3cm4vyt2chy.mp3","text":"咿~~~呀！","alt":"voice/char_241_panda/cn_025.mp3"},{"url":"bwiki:0/00/sg4bf9p5iqzoz4mmg5zf39bqjy7unkh.mp3","text":"这可是我电影里的经典桥段！","alt":"voice/char_241_panda/cn_026.mp3"},{"url":"bwiki:4/4d/g2w1uruio86wuopjougedy84rqbxd8d.mp3","text":"曲中生直，柔能生刚！","alt":"voice/char_241_panda/cn_027.mp3"},{"url":"bwiki:0/03/j0y3e25awoq8zxe51cggbjbhthfi6jm.mp3","text":"就算是电影明星，也是有真功夫的！","alt":"voice/char_241_panda/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:0/0d/jykn8z6njst5nbpbzj4dwta0uf0omgc.mp3","text":"喔，哇哦，结束了吗！","alt":"voice/char_241_panda/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:3/32/o6iwqrv0660a9moi1t1v34x8gq6q2wc.mp3","text":"这就完了？我热身还没做好呢。","alt":"voice/char_241_panda/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:0/06/d9uqljq9uszzxirkjjjuofpu1pa9l94.mp3","text":"别想那么多啦，受点伤没什么大不了的。","alt":"voice/char_241_panda/cn_031.mp3"}],"失败":[{"url":"bwiki:8/8e/pobw0b4rdwspywqbf7gb5uvpmziqw5v.mp3","text":"不行......好想回家睡觉......","alt":"voice/char_241_panda/cn_032.mp3"}],"进驻":[{"url":"bwiki:5/5f/j7rxwa6hjaa83kvx4i5sws9hflwew8d.mp3","text":"还挺时髦的嘛！","alt":"voice/char_241_panda/cn_033.mp3"}],"戳一下":[{"url":"bwiki:c/c3/szxttb86d3v8kioknvanw9xx06eqkmy.mp3","text":"唉唉！头会昏的！","alt":"voice/char_241_panda/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:4/4a/apc1na5buyzky5yrflt18xxvfn7r0m3.mp3","text":"嘿嘿，博士，想不想要我的签名？附赠我们两个的合照哦！","alt":"voice/char_241_panda/cn_036.mp3"}],"标题":[{"url":"bwiki:f/f4/9or3ngf691njr92eq6foxzb8kvwuria.mp3","text":"明日方舟。","alt":"voice/char_241_panda/cn_037.mp3"}],"新年":[{"url":"bwiki:9/9f/1upgbcm14p9shgsmgs88djrgrp6xqry.mp3","text":"元旦快乐！之前每年这个时候，各个电影院里都会上映我主演的电影，而且场场爆满，座无虚席哦！不过，总沉浸在过去里可不好，拳头要向前挥，人也要向前走嘛。今天就忘掉所有伤感的事吧！","alt":"voice/char_241_panda/cn_038.mp3"}],"问候":[{"url":"bwiki:8/8a/0afkltfuaorchyp5zvg6nj96j7uq093.mp3","text":"博士！有没有好好吃早饭呢！","alt":"voice/char_241_panda/cn_042.mp3"}]}}