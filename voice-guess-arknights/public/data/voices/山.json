[{"url":"bwiki:9/9d/36f0fr4x7qerj17fdvdsdvqjdg4mtgs.mp3","text":"明日方舟。","alt":"voice/char_264_f12yin/cn_037.mp3"}],"新年":[{"url":"bwiki:6/6e/3c794rwnrpessez85w78vavn500qt7u.mp3","text":"我已经很久没有对新年有过感觉了，你知道，囚犯们对明天和未来总是没有期待的。不过现在是在罗德岛，我也应该改变一下自己了。新年快乐，博士。","alt":"voice/char_264_f12yin/cn_038.mp3"}],"问候":[{"url":"bwiki:9/96/ih6o7vjfozs3wfnt2ptb8qq1p65lzuw.mp3","text":"保持警惕，博士。","alt":"voice/char_264_f12yin/cn_042.mp3"}]}}