{"中文":{"登录":[{"url":"bwiki:f/f3/4swbm9ixunvvckn416j03g7sk3dd3ys.mp3","text":"那个，您提交给凯尔希医生的报告书，最后几处笔迹已经乱七八糟了......请别再熬夜了......","alt":"voice_cn/char_117_myrrh/cn_001.mp3"}],"交谈":[{"url":"bwiki:9/91/gpvh07kcwlrszhtnjzdz35pemsw5rfz.mp3","text":"这里到处都是没见过的东西呢......！啊，东张西望好像不太好，对不起......","alt":"voice_cn/char_117_myrrh/cn_002.mp3"},{"url":"bwiki:3/37/c8q7nkqy327q4l6mrgroxpmhpnu0a6c.mp3","text":"虽然草药确实很苦，但还是希望大家更关注它的药效......","alt":"voice_cn/char_117_myrrh/cn_003.mp3"},{"url":"bwiki:9/91/1lsukb4zknwzenr329g4tys39h0fab4.mp3","text":"那个，博士，哈默妮的病情，还没有好转吗......嗯，我知道了，我工作回来就去照顾她。","alt":"voice_cn/char_117_myrrh/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:b/b5/fctnjo1as6csuqpv771tkoa9j2sjmmr.mp3","text":"我的草药很苦，不受欢迎......呜呜......但我只会调配苦味的药......您说多听取下大家的意见比较好？我、我能行吗？我不太擅长说话......但我会努力试试的。","alt":"voice_cn/char_117_myrrh/cn_005.mp3"},{"url":"bwiki:b/be/1neykztoxynk8owmpmmb68bs8p4dkq4.mp3","text":"小时候，我和哈默妮常常跑去各种地方探险。嗯，是的，我们是在城区的废墟中长大的，那时候的我们，非常想看一看外面的世界......","alt":"voice_cn/char_117_myrrh/cn_006.mp3"}],"信赖":[{"url":"bwiki:5/5c/4cd6pjcxg2vut7eojbfj13raqac8mll.mp3","text":"哈默妮是我的第一个，也是最好的朋友......可是，她也是因为我，变成了现在的样子......她因为矿石病而缩短的生命，我一定要为她夺回来。","alt":"voice_cn/char_117_myrrh/cn_007.mp3"},{"url":"bwiki:9/92/i94xsiqza9s156fmk21kfi6ltxkmipp.mp3","text":"听了调香师小姐的建议，我在草药中混合了香料，果然赢得了大家的喜爱！拿出勇气来听取大家的意见，真是太好了......","alt":"voice_cn/char_117_myrrh/cn_008.mp3"},{"url":"bwiki:f/fc/awbyhrhrzwfu02xqnq08sfg8t0lywy5.mp3","text":"哈默妮说，最近的我，变得比以前更有精神了，您也这样觉得吗？一定是因为有博士及时指点我，如果没有您，我该怎么办呢......","alt":"voice_cn/char_117_myrrh/cn_009.mp3"}],"闲置":[{"url":"bwiki:e/e5/qc3bn9w0kk67pwpy93o3p6o7zmo67ry.mp3","text":"博士......是不是睡着了？这下可以仔细观察博士的办公室了呢......","alt":"voice_cn/char_117_myrrh/cn_010.mp3"}],"报到":[{"url":"bwiki:e/ed/4l1mrvmtswt4od1c4uj3n31k3a13t47.mp3","text":"那个，我是草药师末药.....这个代号是凯尔希医生为我指定的，据说，它指的是“生命的短暂”，医生说，她希望我要牢记这个寓意......","alt":"voice_cn/char_117_myrrh/cn_011.mp3"}],"作战记录":[{"url":"bwiki:f/fb/84l3llsx31p174zijfcmtegp8ievy69.mp3","text":"非常感谢......！这样就能做出更好的药了......！","alt":"voice_cn/char_117_myrrh/cn_012.mp3"}],"精英化1":[{"url":"bwiki:1/19/0s71vo0u6wo54ge45dmz2ldjs15ovpv.mp3","text":"这就叫做......晋升？是这样的吗......？职位什么的，我还不是很懂......","alt":"voice_cn/char_117_myrrh/cn_013.mp3"}],"精英化2":[{"url":"bwiki:a/ad/s2m4e86gbwsfpydworyv8z7hrbq2m61.mp3","text":"以前常常和哈默妮一起四处探索......这样的秘境和废墟。越是危险的地方，就越能收集罕见的药材。","alt":"voice_cn/char_117_myrrh/cn_014.mp3"}],"编入":[{"url":"bwiki:8/8a/47gj72qc516hhgj0ell3wz0ha9g4lid.mp3","text":"那个，我尽量不拖大家的后腿......","alt":"voice_cn/char_117_myrrh/cn_017.mp3"}],"任命队长":[{"url":"bwiki:4/4a/a251eh2v60u6cs2s20s800ks2u5h5zy.mp3","text":"就从努力直视大家的眼睛开始......","alt":"voice_cn/char_117_myrrh/cn_018.mp3"}],"行动出发":[{"url":"bwiki:1/13/9yc44oyarixzfpb6t4sm0rxxy68ab2h.mp3","text":"啊，博士，我要出发了。","alt":"voice_cn/char_117_myrrh/cn_019.mp3"}],"行动开始":[{"url":"bwiki:5/5a/4gl1gvtus1q3o5ov36p16vs3znh8g1q.mp3","text":"各位，我不会让你们受伤的......！","alt":"voice_cn/char_117_myrrh/cn_020.mp3"}],"选中":[{"url":"bwiki:6/64/pj16mu0z9cbux6bcedlzkiturxpezw2.mp3","text":"我在。","alt":"voice_cn/char_117_myrrh/cn_021.mp3"},{"url":"bwiki:f/f3/0q2myq7vyvbqkrekcyfwflzvpt9w5mk.mp3","text":"来了。","alt":"voice_cn/char_117_myrrh/cn_022.mp3"}],"部署":[{"url":"bwiki:c/c6/c1dd2sd7wocbp790rae9eb7krvu29tv.mp3","text":"我要小心一点。","alt":"voice_cn/char_117_myrrh/cn_023.mp3"},{"url":"bwiki:5/5c/0bxm34mimu8vg1qt1qywb8jh1h3b4j5.mp3","text":"有没有需要治疗的人呢？","alt":"voice_cn/char_117_myrrh/cn_024.mp3"}],"技能":[{"url":"bwiki:d/d1/brk1ozxu8kx3bdjpueigg6n8hjcx3s2.mp3","text":"要、要扔得准一点......","alt":"voice_cn/char_117_myrrh/cn_025.mp3"},{"url":"bwiki:3/30/l5l3opxtmv9k33rps5ncpz9zsg58e6i.mp3","text":"药来了！","alt":"voice_cn/char_117_myrrh/cn_026.mp3"},{"url":"bwiki:6/6d/n8c4w4c0urnh7l1kdhulk1tljwtw711.mp3","text":"这是药，请收下！","alt":"voice_cn/char_117_myrrh/cn_027.mp3"},{"url":"bwiki:d/da/5gdid9m4mbc8lo2j2m0s2kf97x168f9.mp3","text":"没关系，可以治好的......！","alt":"voice_cn/char_117_myrrh/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:5/55/fa47m9gmb663ocv42uw34j2lscj2oeg.mp3","text":"赢了？真的吗？这么严酷的战斗都能......博士真的好厉害......！","alt":"voice_cn/char_117_myrrh/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:e/e9/lr422cq5tvq6fqv4sohth4fxz3jbngj.mp3","text":"大家，这次的药效......算了，回去再问吧......","alt":"voice_cn/char_117_myrrh/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:2/25/h4lai6cc9wglwx28pbtgts31djaw2s4.mp3","text":"唔唔，手忙脚乱的......没犯大错真是太好了......","alt":"voice_cn/char_117_myrrh/cn_031.mp3"}],"失败":[{"url":"bwiki:5/56/mz5m2s2fhlrkr52sffmhj2z48n86x4a.mp3","text":"药瓶......药瓶全都碎掉了.....","alt":"voice_cn/char_117_myrrh/cn_032.mp3"}],"进驻":[{"url":"bwiki:9/96/sle3zs91if3esbshqqxtrn9ecexn7o1.mp3","text":"唔，我觉得衣服上还残留着草药的味道......","alt":"voice_cn/char_117_myrrh/cn_033.mp3"}],"戳一下":[{"url":"bwiki:f/f7/hxuhjyqar0th48c29h3q7ss3h862nyz.mp3","text":"唔哇！","alt":"voice_cn/char_117_myrrh/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:2/26/ehwsvmf2yyn98oby5atqc5uluw1isha.mp3","text":"博士，那个，最近我调制了安定情绪的汤药。对身体是有好处的，只是确实有点苦......","alt":"voice_cn/char_117_myrrh/cn_036.mp3"}],"标题":[{"url":"bwiki:e/e8/hwnjfomsrqdtykbeori81i264ooxrwh.mp3","text":"明日方舟。","alt":"voice_cn/char_117_myrrh/cn_037.mp3"}],"新年":[{"url":"bwiki:4/47/j4064874q1pbf9wihstjdynb2elotmx.mp3","text":"博士，新年好。我正在准备开春要种植的药草的种子。希望它们可以茁壮成长，也希望，今年不要用到它们......","alt":"voice_cn/char_117_myrrh/cn_038.mp3"}],"问候":[{"url":"bwiki:1/1d/rg09lecxectmbj6g2lc42g6nw2xrbut.mp3","text":"早、早上好，博士。","alt":"voice_cn/char_117_myrrh/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:e/ef/96zjo9zl7ejn9atsiqx71uwntmuj8ge.mp3","text":"那个，您提交给凯尔希医生的报告书，最后几处笔迹已经乱七八糟了......请别再熬夜了......","alt":"voice/char_117_myrrh/cn_001.mp3"}],"交谈":[{"url":"bwiki:4/44/0dgxbrlql94yhgt85mjdjvaxlxsqhej.mp3","text":"这里到处都是没见过的东西呢......！啊，东张西望好像不太好，对不起......","alt":"voice/char_117_myrrh/cn_002.mp3"},{"url":"bwiki:2/27/jqiq6jccm8i06gvwt4c77r2dqmejghc.mp3","text":"虽然草药确实很苦，但还是希望大家更关注它的药效......","alt":"voice/char_117_myrrh/cn_003.mp3"},{"url":"bwiki:5/5b/puuo1d41evdrwffjoot98yydja6wk8x.mp3","text":"那个，博士，哈默妮的病情，还没有好转吗......嗯，我知道了，我工作回来就去照顾她。","alt":"voice/char_117_myrrh/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:b/b0/3ao6gm3brls733miex6pbl85ootf02k.mp3","text":"我的草药很苦，不受欢迎......呜呜......但我只会调配苦味的药......您说多听取下大家的意见比较好？我、我能行吗？我不太擅长说话......但我会努力试试的。","alt":"voice/char_117_myrrh/cn_005.mp3"},{"url":"bwiki:4/4e/su4kdnrp0e7ipwiv3s82zzz74u06g11.mp3","text":"小时候，我和哈默妮常常跑去各种地方探险。嗯，是的，我们是在城区的废墟中长大的，那时候的我们，非常想看一看外面的世界......","alt":"voice/char_117_myrrh/cn_006.mp3"}],"信赖":[{"url":"bwiki:6/6e/jv31yys0ao1erzuiqzbyxhbngaur2h5.mp3","text":"哈默妮是我的第一个，也是最好的朋友......可是，她也是因为我，变成了现在的样子......她因为矿石病而缩短的生命，我一定要为她夺回来。","alt":"voice/char_117_myrrh/cn_007.mp3"},{"url":"bwiki:0/0c/cp5z22k9mukj5a0az6jtz3xhq3kgpr6.mp3","text":"听了调香师小姐的建议，我在草药中混合了香料，果然赢得了大家的喜爱！拿出勇气来听取大家的意见，真是太好了......","alt":"voice/char_117_myrrh/cn_008.mp3"},{"url":"bwiki:b/bd/dekc3gptrmud527xvsakpz2ahycw85c.mp3","text":"哈默妮说，最近的我，变得比以前更有精神了，您也这样觉得吗？一定是因为有博士及时指点我，如果没有您，我该怎么办呢......","alt":"voice/char_117_myrrh/cn_009.mp3"}],"闲置":[{"url":"bwiki:a/a1/b1cy2d4i449omnpsphdhfydyi4wlfo1.mp3","text":"博士......是不是睡着了？这下可以仔细观察博士的办公室了呢......","alt":"voice/char_117_myrrh/cn_010.mp3"}],"报到":[{"url":"bwiki:a/af/hn2x6h459uzynxwo3l466tnevjpzdkw.mp3","text":"那个，我是草药师末药.....这个代号是凯尔希医生为我指定的，据说，它指的是“生命的短暂”，医生说，她希望我要牢记这个寓意......","alt":"voice/char_117_myrrh/cn_011.mp3"}],"作战记录":[{"url":"bwiki:c/ca/n9d8x05ij3bg8a30sf56c2piew6hfrn.mp3","text":"非常感谢......！这样就能做出更好的药了......！","alt":"voice/char_117_myrrh/cn_012.mp3"}],"精英化1":[{"url":"bwiki:a/a4/4q41bc7ixdo9ufuoe0zys67qw28w94e.mp3","text":"这就叫做......晋升？是这样的吗......？职位什么的，我还不是很懂......","alt":"voice/char_117_myrrh/cn_013.mp3"}],"精英化2":[{"url":"bwiki:8/8e/s5g3amcakl5ax88f0oenx70i75c4yw9.mp3","text":"以前常常和哈默妮一起四处探索......这样的秘境和废墟。越是危险的地方，就越能收集罕见的药材。","alt":"voice/char_117_myrrh/cn_014.mp3"}],"编入":[{"url":"bwiki:6/6c/8kzxrf14emif3spiu9o776tbh4ow33m.mp3","text":"那个，我尽量不拖大家的后腿......","alt":"voice/char_117_myrrh/cn_017.mp3"}],"任命队长":[{"url":"bwiki:0/0e/oq3jo3tmekcuys3864ylhdnuevcw5ag.mp3","text":"就从努力直视大家的眼睛开始......","alt":"voice/char_117_myrrh/cn_018.mp3"}],"行动出发":[{"url":"bwiki:e/eb/0quf8hnn051232pf5lnblqfni29tzir.mp3","text":"啊，博士，我要出发了。","alt":"voice/char_117_myrrh/cn_019.mp3"}],"行动开始":[{"url":"bwiki:6/6a/mce7a