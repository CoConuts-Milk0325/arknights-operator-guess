{"中文":{"登录":[{"url":"bwiki:a/a7/ry0u69g6uv8dfpbje81wwqd87abotr9.mp3","text":"原来您也需要像大公司职员一样做文书工作，量还不小，需要帮忙么。","alt":"voice_cn/char_431_ashlok/cn_001.mp3"}],"交谈":[{"url":"bwiki:6/61/97lgw5sff34ri1x6hmde1lzs7ck6okj.mp3","text":"想不到耀骑士也会接受雇佣，罗德岛真是家神奇的公司。","alt":"voice_cn/char_431_ashlok/cn_002.mp3"},{"url":"bwiki:d/d1/tw0wec79bcy8vs6j5es8nylg8agtnew.mp3","text":"骑士或许能够跌倒后爬起来，感染者可没机会享受这种仁慈。","alt":"voice_cn/char_431_ashlok/cn_003.mp3"},{"url":"bwiki:b/b9/467ies7130d341g7ucy3bgkdk1shtuo.mp3","text":"咳咳，武器好像出了些问题，咳咳咳，工坊哪里走？那里吗，好，谢谢，咳，咳咳。","alt":"voice_cn/char_431_ashlok/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:4/4e/oqmx1sa149rvh2iwjnzvztc433h8l9o.mp3","text":"如果骑士贵族能够切实履行他们的誓言和职责，感染者的处境本不应该这般窘迫。只是......贵族......卡西米尔人宁愿与大公司签安保合同，也不可能相信一位骑士贵族会去除暴安良。","alt":"voice_cn/char_431_ashlok/cn_005.mp3"},{"url":"bwiki:2/2e/74o9448aopahh6d3kwbdrv6zymp9igc.mp3","text":"他们都说家族是因为我的感染而没落，一切都是我的错。哼，这就是骑士贵族，一无是处，只知道欺侮弱者。","alt":"voice_cn/char_431_ashlok/cn_006.mp3"}],"信赖":[{"url":"bwiki:6/63/ku6ny6ixho7ddk36mzz79xvjhkro607.mp3","text":"查丝汀娜和我搭话喜欢加上封号......为什么，“灰毫”这个词对她来说很特别吗？","alt":"voice_cn/char_431_ashlok/cn_007.mp3"},{"url":"bwiki:0/0a/k2u60h5gry4kyz179vzpmxv9kafw9j0.mp3","text":"我和索娜是在团体混战赛上认识的，那是场苦战，但初次见面的我们很快就达成了共识一起应对其他选手，最后，她用剑取走我的积分，接着当场给我道了歉......于是我们就搭伙一起行动了。","alt":"voice_cn/char_431_ashlok/cn_008.mp3"},{"url":"bwiki:d/d4/0f17057kps5a73lmwifnjb30rwe8p73.mp3","text":"故乡已经回不去了，我所能做的，只有和索娜她们一起探寻前路。呵......成为感染者骑士虽然不怎么好，但至少还有抗争的机会，未来再悲苦，总比现在要光明。","alt":"voice_cn/char_431_ashlok/cn_009.mp3"}],"闲置":[{"url":"bwiki:8/8b/j05z7cgasvryqgibfjchuzqy78l3j8e.mp3","text":"适时休息吧，赛后恢复与日常训练同等重要。","alt":"voice_cn/char_431_ashlok/cn_010.mp3"}],"报到":[{"url":"bwiki:4/49/257c85yr5vp8wtfbyr95k2hcogbov3t.mp3","text":"红松骑士团，“灰毫”，格蕾纳蒂。感谢罗德岛的接纳。","alt":"voice_cn/char_431_ashlok/cn_011.mp3"}],"作战记录":[{"url":"bwiki:e/eb/kj0sitfzt9mdv9me7pqpffx38bdgsy8.mp3","text":"协作突击？嗯，配合很默契。","alt":"voice_cn/char_431_ashlok/cn_012.mp3"}],"精英化1":[{"url":"bwiki:7/75/5phrufo6swckyg1xcoyjrw80m4h8uwk.mp3","text":"这是资格认证奖章吗？哦......抱歉，我不太了解罗德岛的规定。谢谢。","alt":"voice_cn/char_431_ashlok/cn_013.mp3"}],"精英化2":[{"url":"bwiki:5/55/osaxbjte4blh2micold31axetw766wd.mp3","text":"“炮声轰鸣，胜利已在眼前。”","alt":"voice_cn/char_431_ashlok/cn_014.mp3"}],"编入":[{"url":"bwiki:5/5c/8yzygc5tq2rbmn5hegmzvwtquwdyabh.mp3","text":"听从您的调遣。","alt":"voice_cn/char_431_ashlok/cn_017.mp3"}],"任命队长":[{"url":"bwiki:6/60/4a30cw6fytupbsrcgx3o12at3vr4h7r.mp3","text":"需要我指挥？好。","alt":"voice_cn/char_431_ashlok/cn_018.mp3"}],"行动出发":[{"url":"bwiki:e/e1/id9bs2vb82aco4no5y3thix36twz6rz.mp3","text":"愿各位凯旋。","alt":"voice_cn/char_431_ashlok/cn_019.mp3"}],"行动开始":[{"url":"bwiki:6/69/btt6qha9xtqyryyjs874bb3pptr4x1m.mp3","text":"准备好，对手接近了！","alt":"voice_cn/char_431_ashlok/cn_020.mp3"}],"选中":[{"url":"bwiki:c/cf/ibepeoba906osj9zpxz8o281iq0lzkj.mp3","text":"嗯。","alt":"voice_cn/char_431_ashlok/cn_021.mp3"},{"url":"bwiki:d/d7/dsshv04a2roztt22r15hitpm56ka9eb.mp3","text":"下令吧。","alt":"voice_cn/char_431_ashlok/cn_022.mp3"}],"部署":[{"url":"bwiki:5/59/ry63poxbs8wqnw3by1irq2ljl2bi84u.mp3","text":"战斗可没有点到为止的说法。","alt":"voice_cn/char_431_ashlok/cn_023.mp3"},{"url":"bwiki:4/4c/gar1nlmck8e4md7kyur3202o0h5454d.mp3","text":"比赛开始了。","alt":"voice_cn/char_431_ashlok/cn_024.mp3"}],"技能":[{"url":"bwiki:8/8f/jq7ddonpa98wldprboq8kweriazi9fz.mp3","text":"填弹！","alt":"voice_cn/char_431_ashlok/cn_025.mp3"},{"url":"bwiki:0/0e/dsu75rqa4d201kskn38f52jk7sjy2xu.mp3","text":"炮击只是第一步。","alt":"voice_cn/char_431_ashlok/cn_026.mp3"},{"url":"bwiki:1/1e/kumbe3kxwliznzgxm7degsfndazy89f.mp3","text":"防守，进攻！","alt":"voice_cn/char_431_ashlok/cn_027.mp3"},{"url":"bwiki:2/24/btxfdoy731ry7yl6ju50qwsqja1rfwl.mp3","text":"我会赢下这一场！","alt":"voice_cn/char_431_ashlok/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:3/39/k391140a97farx42x7frdz2dm2xuscs.mp3","text":"精彩，这就是指挥的艺术，受教了。","alt":"voice_cn/char_431_ashlok/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:9/9a/43pi0db9ta2ddo34z21kbcvuk674p7f.mp3","text":"看来您很擅长指挥团体战。","alt":"voice_cn/char_431_ashlok/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:e/e4/tguf33wb67uo87ciuetepuj4v5i96az.mp3","text":"赛场上被多拿一分，胜算就少一分。","alt":"voice_cn/char_431_ashlok/cn_031.mp3"}],"失败":[{"url":"bwiki:d/d3/rp7gt1angdyzqbfz781c5hpznbmpom8.mp3","text":"咳咳......是我的......错吗......","alt":"voice_cn/char_431_ashlok/cn_032.mp3"}],"进驻":[{"url":"bwiki:a/a5/t6o1qqrrmb8v9m3rwvgbwvdftmg9hcz.mp3","text":"还好装备不太占空间。","alt":"voice_cn/char_431_ashlok/cn_033.mp3"}],"戳一下":[{"url":"bwiki:c/ca/qn9oo8sm7p1xwuxjhthuvl9d642nge1.mp3","text":"哼？","alt":"voice_cn/char_431_ashlok/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:6/67/s1vkvsntvm655cnzsybemgrybbz91su.mp3","text":"粉丝的礼物？送到您这里了？真抱歉，给您添麻烦了。","alt":"voice_cn/char_431_ashlok/cn_036.mp3"}],"标题":[{"url":"bwiki:c/cf/187aawf9ri2da7em1dqh0jvpvi1oiou.mp3","text":"明日方舟。","alt":"voice_cn/char_431_ashlok/cn_037.mp3"}],"新年":[{"url":"bwiki:f/f7/kp5amarv9h6cx6sk5mrywie031vglgq.mp3","text":"索娜应该还在睡觉，艾沃娜在训练场，查丝汀娜在塔楼望风，至于我......我还没想好。博士，如果是普通的罗德岛干员，在这一天会做些什么呢？","alt":"voice_cn/char_431_ashlok/cn_038.mp3"}],"问候":[{"url":"bwiki:8/88/bhdvjdemjzutvy6ecvfvgn6a2zcvpoj.mp3","text":"今天有什么任务？","alt":"voice_cn/char_431_ashlok/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:1/19/mcfofdl0unrgzx092en5aq8uad7lgjh.mp3","text":"原来您也需要像大公司职员一样做文书工作，量还不小，需要帮忙么。","alt":"voice/char_431_ashlok/cn_001.mp3"}],"交谈":[{"url":"bwiki:1/1f/h2l04re2cs911w1v21fy4nhxxdb5tt8.mp3","text":"想不到耀骑士也会接受雇佣，罗德岛真是家神奇的公司。","alt":"voice/char_431_ashlok/cn_002.mp3"},{"url":"bwiki:f/f7/rn39uomfspfhy6lffbwb0r9nquyrz3a.mp3","text":"骑士或许能够跌倒后爬起来，感染者可没机会享受这种仁慈。","alt":"voice/char_431_ashlok/cn_003.mp3"},{"url":"bwiki:0/00/dktavgn7dojlmm647ado8g9jes5a7z7.mp3","text":"咳咳，武器好像出了些问题，咳咳咳，工坊哪里走？那里吗，好，谢谢，咳，咳咳。","alt":"voice/char_431_ashlok/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:9/9e/f09gsepi0cyjg23cf4eh9nr8rkhzedo.mp3","text":"如果骑士贵族能够切实履行他们的誓言和职责，感染者的处境本不应该这般窘迫。只是......贵族......卡西米尔人宁愿与大公司签安保合同，也不可能相信一位骑士贵族会去除暴安良。","alt":"voice/char_431_ashlok/cn_005.mp3"},{"url":"bwiki:b/b1/fli8y9q2sk7vxyx1h1ia7fl5jjidhff.mp3","text":"他们都说家族是因为我的感染而没落，一切都是我的错。哼，这就是骑士贵族，一无是处，只知道欺侮弱者。","alt":"voice/char_431_ashlok/cn_006.mp3"}],"信赖":[{"url":"bwiki:a/a2/fmr2k9m30l0wyb21a39telsu9tbppyh.mp3","text":"查丝汀娜和我搭话喜欢加上封号......为什么，“灰毫”这个词对她来说很特别吗？","alt":"voice/char_431_ashlok/cn_007.mp3"},{"url":"bwiki:5/51/bfq3izb7e2jhrb4ol70csso3h9y91xl.mp3","text":"我和索娜是在团体混战赛上认识的，那是场苦战，但初次见面的我们很快就达成了共识一起应对其他选手，最后，她用剑取走我的积分，接着当场给我道了歉......于是我们就搭伙一起行动了。","alt":"voice/char_431_ashlok/cn_008.mp3"},{"url":"bwiki:a/ad/kkz1tkghmr700uutucokkz1mc2xy9wj.mp3","text":"故乡已经回不去了，我所能做的，只有和索娜她们一起探寻前路。呵......成为感染者骑士虽然不怎么好，但至少还有抗争的机会，未来再悲苦，总比现在要光明。","alt":"voice/char_431_ashlok/cn_009.mp3"}],"闲置":[{"url":"bwiki:7/7a/ecp3t947htxvlbn9kpdbjcsj5zlxzrb.mp3","text":"适时休息吧，赛后恢复与日常训练同等重要。","alt":"voice/char_431_ashlok/cn_010.mp3"}],"报到":[{"url":"bwiki:b/b8/3wihyt0j9fpnu21ezb7bh08juq6hboe.mp3","text":"红松骑士团，“灰毫”，格蕾纳蒂。感谢罗德岛的接纳。","alt":"voice/char_431_ashlok/cn_011.mp3"}],"作战记录":[{"url":"bwiki:7/7e/1pnuswiu5a4dtgnccngbhd3y63n3nbl.mp3","text":"协作突击？嗯，配合很默契。","alt":"voice/char_431_ashlok/cn_012.mp3"}],"精英化1":[{"url":"bwiki:b/b5/b2r4pt0l1zx6mve1iflz2t0gaohtgc1.mp3","text":"这是资格认证奖章吗？哦......抱歉，我不太了解罗德岛的规定。谢谢。","alt":"voice/char_431_ashlok/cn_013.mp3"}],"精英化2":[{"url":"bwiki:a/ad/7jcozeu14ny8tl3pvstk48ogio9iaqr.mp3","text":"“炮声轰鸣，胜利已在眼前。”","alt":"voice/char_431_ashlok/cn_014.mp3"}],"编入":[{"url":"bwiki:4/44/14vqoz9dc9rfe21foqkfopilt4pncsc.mp3","text":"听从您的调遣。","alt":"voice/char_431_ashlok/cn_017.mp3"}],"任命队长":[{"url":"bwiki:7/7c/6zpcxgpdz623ugpdupm7hcfg1c8my1l.mp3","text":"需要我指挥？好。","alt":"voice/char_431_ashlok/cn_018.mp3"}],"行动出发":[{"url":"bwiki:6/65/qfk5ckyi1gf9tdskpu9ysy9oci32rvw.mp3","text":"愿各位凯旋。","alt":"voice/char_431_ashlok/cn_019.mp3"}],"行动开始":[{"url":"bwiki:a/ad/tln4p9maixpw347bry8dnue7cmj2bcp.mp3","text":"准备好，对手接近了！","alt":"voice/char_431_ashlok/cn_020.mp3"}],"选中":[{"url":"bwiki:7/70/cnec95do9tkc3l7rpacrlu8jl00tekx.mp3","text":"嗯。","alt":"voice/char_431_ashlok/cn_021.mp3"},{"url":"bwiki:c/c9/36qd4i1kz0ryn9g8z2fhn1n19tkcv4a.mp3","text":"下令吧。","alt":"voice/char_431_ashlok/cn_022.mp3"}],"部署":[{"url":"bwiki:2/24/g5ia7m3pfy69nu5oifd59fhzze1mtvj.mp3","text":"战斗可没有点