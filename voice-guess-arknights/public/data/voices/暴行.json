{"中文":{"登录":[{"url":"bwiki:5/50/ceitfjmw9048x3poigwg3if58qzncvp.mp3","text":"嘿嘿！博士，今天又需要我来帮忙做些什么呢？","alt":"voice_cn/char_230_savage/cn_001.mp3"}],"交谈":[{"url":"bwiki:4/49/kwrh9c1sryxu9v5rd2zg4ddykastqju.mp3","text":"平时的工作基本都是些作战任务，砸坏这砸坏那的......偶尔像这样整理整理文件，感觉也不错。","alt":"voice_cn/char_230_savage/cn_002.mp3"},{"url":"bwiki:1/1c/cdpe8gnpjjyvqqn2k09zx5lxukgd2tr.mp3","text":"我在雷姆必拓时也会负责些其它工作，像是矿物的开采啦，用电磁法进行地质勘探啦，嗯......很难理解吧，简单点说，就是把阻碍砸碎，然后往下挖！","alt":"voice_cn/char_230_savage/cn_003.mp3"},{"url":"bwiki:5/54/khc2bkjgdzyyi0w2ftqe0getxyjv0sy.mp3","text":"阿米娅身上的担子可是很重的，要是我能帮她分担些就好了......博士，你也是，有什么需要我的地方，一定要说哦！","alt":"voice_cn/char_230_savage/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:2/21/leqy09y5bxrcn8b0hdqxkgja5hy9gl9.mp3","text":"提供掩护、清空路线、控制战局——即使不能像各位重装干员一样化作队员们的屏障，我也能用我自己的方式保护大家！","alt":"voice_cn/char_230_savage/cn_005.mp3"},{"url":"bwiki:3/32/4sleef9l9iha9ir08bcx4ocdfb8u6fy.mp3","text":"我......我保护好大家了吗？真是太好了......以后也请让我一直一直，待在博士和阿米娅妹妹的身边吧。","alt":"voice_cn/char_230_savage/cn_006.mp3"}],"信赖":[{"url":"bwiki:4/4c/gh9m96ph856udkbixiddffng6wef5aa.mp3","text":"博士，想吃卷心菜蔬果沙拉配蘑菇馅饼吗？嗯嗯，我做了三份哦，你的我的，还有阿米娅妹妹的。以前，阿米娅妹妹可是很喜欢吃我做的馅饼的！","alt":"voice_cn/char_230_savage/cn_007.mp3"},{"url":"bwiki:7/73/e9ypc5ehhzidx50zd11p98zn6jcru7k.mp3","text":"想想橄榄球场上的跑卫，一往无前，突破敌阵，为队友开辟前进的道路！然后倒下，将前方交给队友！！这，这，这难道不是跟我的工作一模一样吗！太帅了吧！虽然不包含最后的倒下环节就是了。","alt":"voice_cn/char_230_savage/cn_008.mp3"},{"url":"bwiki:f/fe/t51c8xcho2xusgpic9gtwywbe17repv.mp3","text":"只要能这样守在你和阿米娅身边，对我来说就足够了。记忆只是过去的一部分，而未来却是无限宽广的。我与阿米娅妹妹，以后也会和博士你一起，创造出更多的回忆。","alt":"voice_cn/char_230_savage/cn_009.mp3"}],"闲置":[{"url":"bwiki:8/8b/asi4lgkv9wltbc88hh9gj21nucddgfq.mp3","text":"博士如果没什么事的话......不如跟我一起去购置晚饭材料吧!","alt":"voice_cn/char_230_savage/cn_010.mp3"}],"报到":[{"url":"bwiki:5/56/2t6ql56x2ayd6q6ak3i24s55ja0eyn1.mp3","text":"博士，来自雷姆必拓的干员暴行向你报到！我一得到你和阿米娅的消息，就立刻赶过来帮忙啦！什么？你什么都不记得？唉唉？！","alt":"voice_cn/char_230_savage/cn_011.mp3"}],"作战记录":[{"url":"bwiki:3/3d/j5s4ucnc71c33m7xonfntd1sg1q3x7j.mp3","text":"哦哦！原来如此原来如此......嗯嗯！","alt":"voice_cn/char_230_savage/cn_012.mp3"}],"精英化1":[{"url":"bwiki:b/bc/4p9izibt5qq0njsjsj8ehxfmljbuwmj.mp3","text":"由你来指挥的话，我很放心哦。谢谢博士，我不会辜负你的期望的！","alt":"voice_cn/char_230_savage/cn_013.mp3"}],"精英化2":[{"url":"bwiki:c/c2/909ip4fc2wouapuvvfvs19wzg77wgfw.mp3","text":"别担心，博士。再多敌人也无所谓——只要博士你还在我身后，我就会把面前所有的困难，全都击碎。","alt":"voice_cn/char_230_savage/cn_014.mp3"}],"编入":[{"url":"bwiki:8/86/2cxsvdmqmmsak4khkt8u4j0ousqussp.mp3","text":"暴行，就位！","alt":"voice_cn/char_230_savage/cn_017.mp3"}],"任命队长":[{"url":"bwiki:b/bb/8og1hh7wn0a5gslgblbu25ixqq0ype7.mp3","text":"大家好好跟上我吧！","alt":"voice_cn/char_230_savage/cn_018.mp3"}],"行动出发":[{"url":"bwiki:b/bf/acm54hnolfyuilpr1krtec36e4tkf9a.mp3","text":"突击开始！","alt":"voice_cn/char_230_savage/cn_019.mp3"}],"行动开始":[{"url":"bwiki:a/a5/bqehuwr39vfadteiexk1k1zi012rxum.mp3","text":"目标位置已确定！突击！！","alt":"voice_cn/char_230_savage/cn_020.mp3"}],"选中":[{"url":"bwiki:6/6c/q0wwf7w8elf7v7xjy1t4jbv2lhw1fxj.mp3","text":"我准备好了！","alt":"voice_cn/char_230_savage/cn_021.mp3"},{"url":"bwiki:f/fd/28zm3m6vemmvk0vvnl80bpn62u0noe4.mp3","text":"下一步是......？","alt":"voice_cn/char_230_savage/cn_022.mp3"}],"部署":[{"url":"bwiki:9/9c/k7kx77uvjwtrpo1f9lftbop8s89saiq.mp3","text":"交给我了！","alt":"voice_cn/char_230_savage/cn_023.mp3"},{"url":"bwiki:0/0d/62uqiw61ljqa0e1ipfrgfbayah1zgjn.mp3","text":"这个敌人是我的！","alt":"voice_cn/char_230_savage/cn_024.mp3"}],"技能":[{"url":"bwiki:a/a0/7m6ia3ax9nf4nc7iol0dfkhj0quhz7x.mp3","text":"吼啊——！","alt":"voice_cn/char_230_savage/cn_025.mp3"},{"url":"bwiki:e/e3/l4qwugrpwjphd6jv7pxrputywyn9dst.mp3","text":"Mjolnir-3出力全开!","alt":"voice_cn/char_230_savage/cn_026.mp3"},{"url":"bwiki:0/01/dkh565qxtz96wrzc6at7zqtbe8a1nbt.mp3","text":"简单!不是什么问题！","alt":"voice_cn/char_230_savage/cn_027.mp3"},{"url":"bwiki:a/aa/8iya4gzlepadyptecrkctmcip669esg.mp3","text":"准备完毕!","alt":"voice_cn/char_230_savage/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:b/b2/6dor1g9d45xv36yukow2cnqvnilh7t3.mp3","text":"哼哼，看来不管是怎样困难的任务都难不倒我们！","alt":"voice_cn/char_230_savage/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:4/44/7vfprrkek874nxbxhnf9ova6tjm98ic.mp3","text":"啊？这就结束了？简单简单!","alt":"voice_cn/char_230_savage/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:6/6d/1f41c9mbww5mue1ejgqx5kwunf4askc.mp3","text":"......也算发挥的勉强及格吧。","alt":"voice_cn/char_230_savage/cn_031.mp3"}],"失败":[{"url":"bwiki:3/39/6bg7u5bbd0glz2vl883gd0evazfxa2j.mp3","text":"前面太危险了！还是先从这里撤退......！","alt":"voice_cn/char_230_savage/cn_032.mp3"}],"进驻":[{"url":"bwiki:b/b3/dixh7j7gwgxni2n4yx64awbxgxunego.mp3","text":"......欸！这样的细致的工作交给我没关系吗？","alt":"voice_cn/char_230_savage/cn_033.mp3"}],"戳一下":[{"url":"bwiki:0/00/e5p77frbvw0395lp0o09evq2jneqysz.mp3","text":"嗯？嗯嗯嗯 ？","alt":"voice_cn/char_230_savage/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:e/eb/9av8tn90o2n6hnhrsfsqdocsgjexpdn.mp3","text":"今天的工作也顺利地完成了！","alt":"voice_cn/char_230_savage/cn_036.mp3"}],"标题":[{"url":"bwiki:7/7f/edl6fpw0p3dem53iogo6hxrmp0tcgqd.mp3","text":"明日方舟。","alt":"voice_cn/char_230_savage/cn_037.mp3"}],"新年":[{"url":"bwiki:f/f5/j6g6ro940d0exk05mqd6dm0lh41rauo.mp3","text":"博士和阿米娅妹妹新年快乐！祝阿米娅新的一年快快长高，祝博士......啊，就祝博士，今年工作可以轻松一点，不用经常加班吧！","alt":"voice_cn/char_230_savage/cn_038.mp3"}],"问候":[{"url":"bwiki:5/5e/2wzywuewpon3adudyjzeltooi4halhe.mp3","text":"呀嗬~！博士早上好啊~！","alt":"voice_cn/char_230_savage/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:f/fc/2kt0h3tos3urbppf5xkqbgsq5yqrxff.mp3","text":"嘿嘿！博士，今天又需要我来帮忙做些什么呢？","alt":"voice/char_230_savage/cn_001.mp3"}],"交谈":[{"url":"bwiki:2/26/bz4g35mn6ayim8yw0xnxh0sdvrrdolq.mp3","text":"平时的工作基本都是些作战任务，砸坏这砸坏那的......偶尔像这样整理整理文件，感觉也不错。","alt":"voice/char_230_savage/cn_002.mp3"},{"url":"bwiki:6/66/pepq1guurp7f74z00qluiqwau9ry3bg.mp3","text":"我在雷姆必拓时也会负责些其它工作，像是矿物的开采啦，用电磁法进行地质勘探啦，嗯......很难理解吧，简单点说，就是把阻碍砸碎，然后往下挖！","alt":"voice/char_230_savage/cn_003.mp3"},{"url":"bwiki:9/98/3ryfif6xnggo8rwjadrkd1vos26mi2v.mp3","text":"阿米娅身上的担子可是很重的，要是我能帮她分担些就好了......博士，你也是，有什么需要我的地方，一定要说哦！","alt":"voice/char_230_savage/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:9/97/p448qowuyiohsg607yblbmqfxjcrk6h.mp3","text":"提供掩护、清空路线、控制战局——即使不能像各位重装干员一样化作队员们的屏障，我也能用我自己的方式保护大家！","alt":"voice/char_230_savage/cn_005.mp3"},{"url":"bwiki:d/d5/du92u8p5b2z14h0af423htciabutf2u.mp3","text":"我......我保护好大家了吗？真是太好了......以后也请让我一直一直，待在博士和阿米娅妹妹的身边吧。","alt":"voice/char_230_savage/cn_006.mp3"}],"信赖":[{"url":"bwiki:1/12/6t5px5oiptg1h6f4ani1k575velfpq1.mp3","text":"博士，想吃卷心菜蔬果沙拉配蘑菇馅饼吗？嗯嗯，我做了三份哦，你的我的，还有阿米娅妹妹的。以前，阿米娅妹妹可是很喜欢吃我做的馅饼的！","alt":"voice/char_230_savage/cn_007.mp3"},{"url":"bwiki:2/22/9a9bble7fljklxagivco1rrkk6li3ke.mp3","text":"想想橄榄球场上的跑卫，一往无前，突破敌阵，为队友开辟前进的道路！然后倒下，将前方交给队友！！这，这，这难道不是跟我的工作一模一样吗！太帅了吧！虽然不包含最后的倒下环节就是了。","alt":"voice/char_230_savage/cn_008.mp3"},{"url":"bwiki:4/46/5had5l13oj5pdxl1yru8bduzxdsmq8g.mp3","text":"只要能这样守在你和阿米娅身边，对我来说就足够了。记忆只是过去的一部分，而未来却是无限宽广的。我与阿米娅妹妹，以后也会和博士你一起，创造出更多的回忆。","alt":"voice/char_230_savage/cn_009.mp3"}],"闲置":[{"url":"bwiki:7/72/odipius38j5h6h7rvbt943do8o1psw0.mp3","text":"博士如果没什么事的话......不如跟我一起去购置晚饭材料吧!","alt":"voice/char_230_savage/cn_010.mp3"}],"报到":[{"url":"bwiki:f/fc/3puylwfrucm62i0ubmobxbcpn5bqjb1.mp3","text":"博士，来自雷姆必拓的干员暴行向你报到！我一得到你和阿米娅的消息，就立刻赶过来帮忙啦！什么？你什么都不记得？唉唉？！","alt":"voice/char_230_savage/cn_011.mp3"}],"作战记录":[{"url":"bwiki:b/b0/edzp0d8putf28gyqzj1s5q7uapafe35.mp3","text":"哦哦！原来如此原来如此......嗯嗯！","alt":"voice/char_230_savage/cn_012.mp3"}],"精英化1":[{"url":"bwiki:d/dc/cbbhoy4dbnjrlbglqhmjotety1iuw4l.mp3","text":"由你来指挥的话，我很放心哦。谢谢博士，我不会辜负你的期望的！","alt":"voice/char_230_savage/cn_013.mp3"}],"精英化2":[{"url":"bwiki:a/ac/dbcrpsdqwmtchqu2sy15f93xld0eb7c.mp3","text":"别担心，博士。再多敌人也无所谓——只要博士你还在我身后，我就会把面前所有的困难，全都击碎。","alt":"voice/char_230_savage/cn_014.mp3"}],"编入":[{"url":"bwiki:3/3f/hu7ql302sxpvgylejysen1bff87i74x.mp3","text":"暴行，就位！","alt":"voice/char_230_savage/cn_017.mp3"}],"任命队长":[{"url":"bwiki:3/30/aa32n5v8itmdwb9jf7ayfb4cit78pz1.mp3","text":"大家好好跟上我吧！","alt":"voice/char_230_savage/cn_018.mp3"}],"行动出发":[{"url":"bwiki:c/c9/c12p82297devq7qjish9nxtawzjawol.mp3","text":"突击开始！","alt":"voice/char_230_savage/cn_019.mp3"}],"行动开始":[{"url":"bwiki:5/5e/aseizv3f1t3z657zq9prpt7e94h4dxw.mp3","text":"目标位置已确定！突击！！","alt":"voice/char_230_savage/cn_020.mp3"}]