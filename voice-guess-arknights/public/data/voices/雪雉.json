,"alt":"voice_custom/char_383_snsant_cn_topolect/cn_027.mp3"},{"url":"bwiki:0/06/j8ybqqy7p1ja7zxz9lusvvq6jmpwrai.mp3","text":"装备状态不错！","alt":"voice_custom/char_383_snsant_cn_topolect/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:f/f1/5cb3wmphy1aibwozg0h4tp0nxdhe6gp.mp3","text":"只要我们齐心协力，没有迈不过去的坎，博士！","alt":"voice_cn/char_383_snsant/cn_029.mp3"},{"url":"bwiki:5/5f/2ihma1swbrv72oo4lxe4bdt4ojl5dt2.mp3","text":"只要我们齐心协力，没有迈不过去的坎，博士！","alt":"voice_custom/char_383_snsant_cn_topolect/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:8/8f/5fqeh6c9l7zbct18xr815tozglrtiwl.mp3","text":"没有一丁点浪费，完美的胜利！","alt":"voice_cn/char_383_snsant/cn_030.mp3"},{"url":"bwiki:a/ad/s1skb7shs20ovh2gxyrc1n7h8ly2a22.mp3","text":"没有一丁点浪费，完美的胜利！","alt":"voice_custom/char_383_snsant_cn_topolect/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:c/c5/awhutlnlb9wyw9ahdqezl9n24g5htai.mp3","text":"有逃跑的敌人，要、要追吗？","alt":"voice_cn/char_383_snsant/cn_031.mp3"},{"url":"bwiki:8/8d/1vn3td6jx0r84shsefwtmi9reopu2ng.mp3","text":"有逃跑的敌人，要、要追吗？","alt":"voice_custom/char_383_snsant_cn_topolect/cn_031.mp3"}],"失败":[{"url":"bwiki:b/b6/c9nzb2b5s6myyrbg8lghy6m9x5f253y.mp3","text":"我、我去把那些损坏的零件都收集起来，至少可以减少损失......","alt":"voice_cn/char_383_snsant/cn_032.mp3"},{"url":"bwiki:1/1c/otf06qo99z0ibfefdg2utbpz8ativoc.mp3","text":"我、我去把那些损坏的零件都收集起来，至少可以减少损失......","alt":"voice_custom/char_383_snsant_cn_topolect/cn_032.mp3"}],"进驻":[{"url":"bwiki:5/58/622q2hw4vcza0ljnroac6vc3n0r0p4k.mp3","text":"唔啊，这就是罗德岛的内部吗，好羡慕......","alt":"voice_cn/char_383_snsant/cn_033.mp3"},{"url":"bwiki:f/fb/nnm4wlpxpe9e95t3sivmh78xeza1wjz.mp3","text":"唔啊，这就是罗德岛的内部吗，好羡慕......","alt":"voice_custom/char_383_snsant_cn_topolect/cn_033.mp3"}],"戳一下":[{"url":"bwiki:7/79/mgu8yl4kufpwobyfdihmhbdmox81wcx.mp3","text":"咿呀！","alt":"voice_cn/char_383_snsant/cn_034.mp3"},{"url":"bwiki:7/7b/8gmih79m2r1uyhemgv435blq53346sw.mp3","text":"咿呀！","alt":"voice_custom/char_383_snsant_cn_topolect/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:1/1e/2m5f4we5cb07g24kodvcme04lar4mzi.mp3","text":"博士？","alt":"voice_cn/char_383_snsant/cn_036.mp3"},{"url":"bwiki:f/f8/ccanf3zxda7ytb2oaibw47etgumqcjz.mp3","text":"博士？","alt":"voice_custom/char_383_snsant_cn_topolect/cn_036.mp3"}],"标题":[{"url":"bwiki:b/b3/7np33ctzugr2xsmxgp4fbvz32wc353j.mp3","text":"明日方舟。","alt":"voice_cn/char_383_snsant/cn_037.mp3"},{"url":"bwiki:4/43/ihctrf93hek0mbho5phkatulpox2qc7.mp3","text":"明日方舟。","alt":"voice_custom/char_383_snsant_cn_topolect/cn_037.mp3"}],"新年":[{"url":"bwiki:f/f3/a1w244c7vudi65ubcbazucnr8rp1xh9.mp3","text":"原来今天是节日吗？怪不得食堂准备了丰盛的自助餐，终于可以好好吃一顿了，嘿嘿。说起来，罗德岛的节日真的好多啊，如果用这些时间再去打一份工的话，是不是可以多赚一点经费呢......","alt":"voice_cn/char_383_snsant/cn_038.mp3"},{"url":"bwiki:0/08/lxlv63ok1492zuceihd8xx7ajqnie0v.mp3","text":"原来今天是节日吗？怪不得食堂准备了丰盛的自助餐，终于可以好好吃一顿了，嘿嘿。说起来，罗德岛的节日真的好多啊，如果用这些时间再去打一份工的话，是不是可以多赚一点经费呢......","alt":"voice_custom/char_383_snsant_cn_topolect/cn_038.mp3"}],"问候":[{"url":"bwiki:8/8f/1xvzyy40cwam953ouheq4jv8vfajgjm.mp3","text":"您好，博士。","alt":"voice_cn/char_383_snsant/cn_042.mp3"},{"url":"bwiki:6/6d/2wdku7b66qslmqdx9duto4rlk8gyabx.mp3","text":"您好，博士。","alt":"voice_custom/char_383_snsant_cn_topolect/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:5/51/h6b66c07orsi0lx676ubkdj8nwknlin.mp3","text":"博、博士！不好意思，能让一下吗？你脚下有一枚硬币......","alt":"voice/char_383_snsant/cn_001.mp3"}],"交谈":[{"url":"bwiki:b/b0/qb5zr6wfsbrka3uzr2bxn1ju4sv8xyc.mp3","text":"我的理想就是让整个泰拉......啊，不，还是先从龙门......不，首先要让罗德岛认可我，或者，让博士你由衷地表扬我！对，暂时就是这个理想......","alt":"voice/char_383_snsant/cn_002.mp3"},{"url":"bwiki:1/13/49hopdhnsmx3mhel2ohwavxszunoghv.mp3","text":"呜，昨天离开办公室的时候忘记关灯了......欸？罗德岛有发电室所以不需要缴纳电费？真的？那以后岂不是能吃得起晚饭了？","alt":"voice/char_383_snsant/cn_003.mp3"},{"url":"bwiki:9/90/rcurlq0flsmn9gjy7ui9wxo0ydey2uz.mp3","text":"这就是杰西卡订购的源石弹药......呃？博、博士，这个金额是不是算错了？还是说这是什么偏远小国的货币？不是？就是龙门币？原原原原来如此，我我我没事，只是有点意意意意外。","alt":"voice/char_383_snsant/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:2/25/bi7yn5zelubap4a712h604pxswq1cx6.mp3","text":"矿石病......唔，虽然有点超出我的专业领域，但似乎是个值得探讨的方向......可是如果再多出一个课题，就要从一日两餐变成两日一餐了，呜......","alt":"voice/char_383_snsant/cn_005.mp3"},{"url":"bwiki:0/04/h36tfth4balh9v8d1zr53sqrja5hd82.mp3","text":"勤俭节约是一种美德，但其实对我而言，更接近一种习惯吧......别、别看我这样，如果朋友或者博士你真的需要帮助的话，我还是会慷慨解囊的！真的！","alt":"voice/char_383_snsant/cn_006.mp3"}],"信赖":[{"url":"bwiki:8/8f/50nde85ntb9qmpzb9csin6dvnlqbry9.mp3","text":"您想看看我的钩爪？可以是可以......但是千万不要碰这个按钮，还有握住握把的时候小心拇指......等等，缠绳索方法也不对，还有——啊，抱歉，别在意我，您接着看吧......","alt":"voice/char_383_snsant/cn_007.mp3"},{"url":"bwiki:5/5c/l6i3ban0dqvadqb5iln7d353v63aw4x.mp3","text":"等我成为万众瞩目的大科学家，赚到好多好多的钱之后，我一定要每日三餐都加上甜点，和杰西卡一样，然后，毫无负担地为龙门建设出一份力，嗯......如果有那一天呢。","alt":"voice/char_383_snsant/cn_008.mp3"},{"url":"bwiki:6/61/ixntx308l99lrw3yufnnovjgci86xms.mp3","text":"钱可是很重要的，回龙门之前，我拒绝过研究所的一大笔挽留费，所以我的自研课题全泡汤了......不过还是回家更重要啦，钱可以再攒，而且现在我已经不会因为数字太大而头晕目眩了！","alt":"voice/char_383_snsant/cn_009.mp3"}],"闲置":[{"url":"bwiki:7/76/oldzvdbr8g6abfdf5011lpqfj4c8dxe.mp3","text":"......睡着了？那剩下的就交给我吧，虽然肚子有点饿。","alt":"voice/char_383_snsant/cn_010.mp3"}],"报到":[{"url":"bwiki:c/cf/thv30hvc87dfog9pb1hb9wwr94ujx0n.mp3","text":"呜，我的头！不好意思，您、您就是博士？初次见面，我叫雪雉，对不起，不该低着头走路的......","alt":"voice/char_383_snsant/cn_011.mp3"}],"作战记录":[{"url":"bwiki:8/84/aftwsc29qgzhygjj0d2ueathul7fofj.mp3","text":"唔啊，这可真不是加把劲就能学得来的呀......","alt":"voice/char_383_snsant/cn_012.mp3"}],"精英化1":[{"url":"bwiki:a/af/8q7q7x2rv7z4cwfgqsnpgiqnj1dgdt1.mp3","text":"诶诶？晋、晋升吗？稍微感觉到了一点压力，不过没关系，这样就离出人头地更进一步了！","alt":"voice/char_383_snsant/cn_013.mp3"}],"精英化2":[{"url":"bwiki:6/64/rgrkjw6v8sanuomiknzdxzr52gpcw27.mp3","text":"“天道酬勤”，你说对吧，博士？","alt":"voice/char_383_snsant/cn_014.mp3"}],"编入":[{"url":"bwiki:7/79/hlmwo7wolsisnbipejna9ddycq26y72.mp3","text":"没关系，只要像训练时那样好好努力就行了，呜......","alt":"voice/char_383_snsant/cn_017.mp3"}],"任命队长":[{"url":"bwiki:5/53/mnagz6m957n9evrtl16a95bfueaoj32.mp3","text":"让我、我来做队长吗？我真的不懂战斗的事情喔？","alt":"voice/char_383_snsant/cn_018.mp3"}],"行动出发":[{"url":"bwiki:7/7d/pib3mitu6l72rqbfnkhnuqo6uwf29dr.mp3","text":"钩爪检查完毕，深呼吸，我可以的！","alt":"voice/char_383_snsant/cn_019.mp3"}],"行动开始":[{"url":"bwiki:d/d3/a23d3u364l4png2ft5nrsl23524c5m1.mp3","text":"发现敌人！","alt":"voice/char_383_snsant/cn_020.mp3"}],"选中":[{"url":"bwiki:8/86/02xwimi5uq25altnk0xv1cimsvqi7k5.mp3","text":"我、我吗？","alt":"voice/char_383_snsant/cn_021.mp3"},{"url":"bwiki:3/3b/3477mzmqz79piy0ypekytspitbkqeet.mp3","text":"我尽力！","alt":"voice/char_383_snsant/cn_022.mp3"}],"部署":[{"url":"bwiki:8/87/kdyv72e3h6lf3lk9tgutmpifnlw5ial.mp3","text":"钩爪，不会出问题吧？","alt":"voice/char_383_snsant/cn_023.mp3"},{"url":"bwiki:9/9b/i3ixg9ygvfbe2mkqhz9tt5g8v0031dt.mp3","text":"第一次 ，离战场这么近......","alt":"voice/char_383_snsant/cn_024.mp3"}],"技能":[{"url":"bwiki:4/4b/6kxoq8om1axd5t8i803cmah0c500as1.mp3","text":"钩爪准备！","alt":"voice/char_383_snsant/cn_025.mp3"},{"url":"bwiki:b/b8/9jjczwvid2ub14l8zre1ozokgcc1j5q.mp3","text":"别动喔，这样会轻松点！","alt":"voice/char_383_snsant/cn_026.mp3"},{"url":"bwiki:4/43/ig38rvjjmf1k72rsnkqlb70acu7o0go.mp3","text":"好、好重！","alt":"voice/char_383_snsant/cn_027.mp3"},{"url":"bwiki:2/21/iu28vcg37fpxiqgw17o1zffiobyem1m.mp3","text":"装备状态不错！","alt":"voice/char_383_snsant/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:1/13/g2wj3g7ovm2can962mpjab7deocyj31.mp3","text":"只要我们齐心协力，没有迈不过去的坎，博士！","alt":"voice/char_383_snsant/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:1/1d/e03a3mtx0y4vfpk6o5whm3fub53gmd7.mp3","text":"没有一丁点浪费，完美的胜利！","alt":"voice/char_383_snsant/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:7/7b/rf7n5sp6bohuieju605qrxtlbsiyaci.mp3","text":"有逃跑的敌人，要、要追吗？","alt":"voice/char_383_snsant/cn_031.mp3"}],"失败":[{"url":"bwiki:0/0f/i1azuhujt4f86brpyqg1rbu5md02kit.mp3","text":"我、我去把那些损坏的零件都收集起来，至少可以减少损失......","alt":"voice/char_383_snsant/cn_032.mp3"}],"进驻":[{"url":"bwiki:b/bc/p6smwbsv1veqc64quvb0ulac1iucw6z.mp3","text":"唔啊，这就是罗德岛的内部吗，好羡慕......","alt":"voice/char_383_snsant/cn_033.mp3"}],"戳一下":[{"url":"bwiki:0/01/8s43kh3nr33k44mwti316onhtq9kviz.mp3","text":"咿呀！","alt":"voice/char_383_snsant/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:a/aa/pvi8n3zl839mh5qzj0hvj5rya4rpvxv.mp3","text":"博士？","alt":"voice/char_383_snsant/cn_036.mp3"}],"标题":[{"url":"bwiki:3/3a/dimoqtjqu292949ng8djkrpl04kf243.mp3","text":"明日方舟。","alt":"voice/char_383_snsant/cn_037.mp3"}],"新年":[{"url":"bwiki:4/42/6f2ll67tyxgpumh7eypztmdepos4shr.mp3","text":"原来今天是节日吗？怪不得食堂准备了丰盛的自助餐，终于可以好好吃一顿了，嘿嘿。说起来，罗德岛的节日真的好多啊，如果用这些时间再去打一份工的话，是不是可以多赚一点经费呢......","alt":"voice/char_383_snsant/cn_038.mp3"}],"问候":[{"url":"bwiki:6/6b/7ggrd290ws2zpaz11se3tng526rhf9n.mp3","text":"您好，博士。","alt":"voice/char_383_snsant/cn_042.mp3"}]}}