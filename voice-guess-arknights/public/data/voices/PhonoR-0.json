/char_4136_phonor/cn_025.mp3"},{"url":"bwiki:4/4d/ggv37lt8kd60n7880jijmocrz5vfas4.mp3","text":"“恶言成锋。”","alt":"voice/char_4136_phonor/cn_026.mp3"},{"url":"bwiki:d/dd/aubwzwgzu9zlqaql021wkpe4h1df9if.mp3","text":"“怒语为焰。”","alt":"voice/char_4136_phonor/cn_027.mp3"},{"url":"bwiki:1/11/j6oi2hvjxm5utj7c8eu1wnka9uerrc9.mp3","text":"嘶，我新做的涂装......","alt":"voice/char_4136_phonor/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:8/87/pybast5n3qss2u8ptgtkxhfcug7q8v6.mp3","text":"愿胜利长驻，更愿安宁长留。","alt":"voice/char_4136_phonor/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:5/54/rt37torttuy915yyi493wrbupftzspn.mp3","text":"终究是来之不易......","alt":"voice/char_4136_phonor/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:0/00/r0firrirj6j6bevgsr1muzqpldlg5iq.mp3","text":"很抱歉，博士，我的力量终归有限，和真正的女妖之力相去甚远。","alt":"voice/char_4136_phonor/cn_031.mp3"}],"失败":[{"url":"bwiki:3/34/ra0xhmm9dhdcc43puym0k1l4pqha8ie.mp3","text":"请不要因此而伤感，博士。一生是漫长的，当下的失利待到将来再看，也不过是一段无足轻重的回忆。","alt":"voice/char_4136_phonor/cn_032.mp3"}],"进驻":[{"url":"bwiki:4/41/huvfsbuugc0h6tcz2u2ol1ws0hx44hz.mp3","text":"我很喜欢这间屋子的内部结构，适合声音的传播，每次我留下的祷言都能扩散得很远。","alt":"voice/char_4136_phonor/cn_033.mp3"}],"戳一下":[{"url":"bwiki:e/e3/7r3pcc6zw0y9o8a7im5i8tvhbcybdpg.mp3","text":"博士，我身上有种咒言——不经允许便碰触我的人会变得倒霉。啊，请不要慌张，我已经默许您的触碰了。","alt":"voice/char_4136_phonor/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:f/fa/clrd1n675xzpu8r2dmoo5o7w2806nor.mp3","text":"博士，有件事我想听听您的意见，舰船上的合唱团想邀请我担任女高音......","alt":"voice/char_4136_phonor/cn_036.mp3"}],"标题":[{"url":"bwiki:5/56/9m2lkznv0td6sp6xruap6tjku5fb304.mp3","text":"明日方舟。","alt":"voice/char_4136_phonor/cn_037.mp3"}],"新年":[{"url":"bwiki:e/e3/2aa9tn0ibcnrzpxwm3s97p62chy91mt.mp3","text":"博士，您今天的进食量已经接近健康监测的红线了，或许需要克制一些。哦，请不要这样看我，我......算了，今天是新年夜，您多吃一些也没有关系的。","alt":"voice/char_4136_phonor/cn_038.mp3"}],"问候":[{"url":"bwiki:0/05/mx6wk89puwcpvj1r6nnelbixbiooamb.mp3","text":"晚安，博士，愿您好梦。","alt":"voice/char_4136_phonor/cn_042.mp3"}]}}