{"中文":{"登录":[{"url":"bwiki:f/f6/eyqtb3914texx1z5kystmhb9e4d7rqz.mp3","text":"博士，我来找你玩啦~","alt":"voice_cn/char_151_myrtle/cn_001.mp3"}],"交谈":[{"url":"bwiki:6/61/8znztdcq6m724p6kze1xukflhuem3wm.mp3","text":"博士，你可不要小看我，在我的老家，第一大道还有三条商店街的孩子们可都是听我号令的。","alt":"voice_cn/char_151_myrtle/cn_002.mp3"},{"url":"bwiki:b/b3/3bynlfc6wntxtlfkwzent7n43yjbvnq.mp3","text":"虽然杜林肯定是因为懒得想才直接拿我们族的名字当代号，但是这样我就被占便宜了欸，“杜林的桃金娘”，听起来不像是她的所有物了吗？","alt":"voice_cn/char_151_myrtle/cn_003.mp3"},{"url":"bwiki:5/55/pje2x54thtpbwhu6l5pqup65i2f0kf0.mp3","text":"这里的器械虽然原理我都懂，但是用起来感觉好奇怪欸，有的有好多多余的部分，有的又意外的简便。","alt":"voice_cn/char_151_myrtle/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:b/b6/1w6kqktm6nlqp0acwtxtyfqq41gr7xg.mp3","text":"这面旗子？啊，博士你眼光不错喔，这面布是我家的桌布，因为怎么也弄不脏所以离家前被我偷偷带出来了，啊哈哈，爸爸现在肯定气死了。","alt":"voice_cn/char_151_myrtle/cn_005.mp3"},{"url":"bwiki:0/0e/3r3tgw93ravuywfzdgv34hx988aiaqh.mp3","text":"欸，我的苹果很厉害吗？唔，在我家那边很普通吧。博士你要玩或者拿去研究的话可以借你，别弄坏了就行~","alt":"voice_cn/char_151_myrtle/cn_006.mp3"}],"信赖":[{"url":"bwiki:7/7a/227n4kfkghektngehn4iwuz337ftfrw.mp3","text":"地上虽然有很多我还不适应的地方，不过好吃的东西真的有好多，我最喜欢罗德岛的食堂啦！","alt":"voice_cn/char_151_myrtle/cn_007.mp3"},{"url":"bwiki:3/39/rnu22utfq3dmpknmu3e6cbwvqwl2afq.mp3","text":"博士，我必须要严肃地指出一个事实，那就是，我已经成年了！而且在杜林里，我的身高是偏高的！你要告诉其他人，不要看到我就下意识地摸我头，还给我塞零食！","alt":"voice_cn/char_151_myrtle/cn_008.mp3"},{"url":"bwiki:1/15/mcpjn22e7i92js8hp0r19mz2m7th6ju.mp3","text":"我说，博士，你对我的家乡感兴趣吗？我可以带你回去看看！不过，因为回家要走超久的路，所以等我有心情的时候再说吧~","alt":"voice_cn/char_151_myrtle/cn_009.mp3"}],"闲置":[{"url":"bwiki:a/a9/aq8ckxdb1yq7y5a5f53mfuxh0dg46u4.mp3","text":"博士要休息一下吗，那我旗子借你盖盖。","alt":"voice_cn/char_151_myrtle/cn_010.mp3"}],"报到":[{"url":"bwiki:b/bf/sf64k0wotcw08x2gdneuqq9htoxwxiz.mp3","text":"我来报到啦！你就是博士对吧？可以叫我桃金娘，杜林族的桃金娘。杜林说在这里能找到工作，所以，有什么我能做的事吗？别看我个子小，我还挺厉害的哦。","alt":"voice_cn/char_151_myrtle/cn_011.mp3"}],"作战记录":[{"url":"bwiki:b/b0/c9jjhoojt5wbg9ir8yfp5mimn6vr93i.mp3","text":"嗯，嗯......这场打的有意思，还有吗，博士？","alt":"voice_cn/char_151_myrtle/cn_012.mp3"}],"精英化1":[{"url":"bwiki:6/60/h0pg9jq8t7dgtmhz75jzh4klu125sa5.mp3","text":"咦，我升职了吗？那我可不可以去一些之前不能去的地方看看？","alt":"voice_cn/char_151_myrtle/cn_013.mp3"}],"精英化2":[{"url":"bwiki:9/96/9votenax6ayw6a48ycd8iri0aimvb9k.mp3","text":"我一开始就说了嘛，我可是挺厉害的呢！嗯——哼！","alt":"voice_cn/char_151_myrtle/cn_014.mp3"}],"编入":[{"url":"bwiki:3/36/rnc7e7b7fz8njc02ie840tsn730ztqy.mp3","text":"任务？我去我去！","alt":"voice_cn/char_151_myrtle/cn_017.mp3"}],"任命队长":[{"url":"bwiki:9/9b/aof82byqedja8e46byewu0xl9hcfwch.mp3","text":"大家不要离我太远哦。","alt":"voice_cn/char_151_myrtle/cn_018.mp3"}],"行动出发":[{"url":"bwiki:a/a5/rgl454snuaronelexxhqk4hzl764c8e.mp3","text":"出——发——！","alt":"voice_cn/char_151_myrtle/cn_019.mp3"}],"行动开始":[{"url":"bwiki:5/52/iebel7b6mqqicd9e64pp2claz8ylzd1.mp3","text":"有我在，大家放心上吧！","alt":"voice_cn/char_151_myrtle/cn_020.mp3"}],"选中":[{"url":"bwiki:b/b1/fay62g9zvoh1enjorb5ftsfb8n8mor6.mp3","text":"嗯？","alt":"voice_cn/char_151_myrtle/cn_021.mp3"},{"url":"bwiki:b/b4/ohlgaqocuk316b932xzyyh51uxrz74d.mp3","text":"呼啊，差点睡着了......","alt":"voice_cn/char_151_myrtle/cn_022.mp3"}],"部署":[{"url":"bwiki:0/02/o2mxxf6kwjxrhr3shftb4y58xgpf0v6.mp3","text":"博士，这里景色还不错欸！","alt":"voice_cn/char_151_myrtle/cn_023.mp3"},{"url":"bwiki:9/97/5f4roraevpw635y0pi3lnr9pnghdnai.mp3","text":"我来帮助其他人！","alt":"voice_cn/char_151_myrtle/cn_024.mp3"}],"技能":[{"url":"bwiki:6/6c/n0rq8ouqpaf68ig5zgffzisjy9zqgj5.mp3","text":"我可要认真起来啦！","alt":"voice_cn/char_151_myrtle/cn_025.mp3"},{"url":"bwiki:f/fc/ehof5jt8t6aahp8qhf8sp9u2cnifnbn.mp3","text":"大家快来我身边~","alt":"voice_cn/char_151_myrtle/cn_026.mp3"},{"url":"bwiki:1/1b/ljreovanp1fbr6j5n1yl1nywfmwfiek.mp3","text":"小苹果，今天也拜托你啦。","alt":"voice_cn/char_151_myrtle/cn_027.mp3"}],"高难胜利":[{"url":"bwiki:2/20/32sfdgwfhuyr84ji2p80hzo48jyfhdc.mp3","text":"呼、呼，累死我了，博士，我想回去睡觉。","alt":"voice_cn/char_151_myrtle/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:4/41/6gp35f8wcal0es4en88twx98ywf03fs.mp3","text":"大获全胜！博士，我有派上用场吧？","alt":"voice_cn/char_151_myrtle/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:7/7f/mi6736knhieikhgxgbpitwi4moqc2i4.mp3","text":"赢了就好嘛，博士，妈妈说过，斤斤计较老得快哦。","alt":"voice_cn/char_151_myrtle/cn_031.mp3"}],"失败":[{"url":"bwiki:c/cd/8tztu3cvcor77xpd1mdq8ovfjjbdnca.mp3","text":"大家快跑！","alt":"voice_cn/char_151_myrtle/cn_032.mp3"}],"进驻":[{"url":"bwiki:a/ac/0m358gfuz3visphutggf3zs8oegid22.mp3","text":"哇，罗德岛真大！","alt":"voice_cn/char_151_myrtle/cn_033.mp3"}],"戳一下":[{"url":"bwiki:0/05/fnwcissy3ht5xnwfcxhxhpokq8q16d5.mp3","text":"咦，这样好有趣！","alt":"voice_cn/char_151_myrtle/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:5/57/cgezmc100zkca53xvs2xofrr7s78bta.mp3","text":"食堂为什么不能24小时都开着呢？","alt":"voice_cn/char_151_myrtle/cn_036.mp3"}],"标题":[{"url":"bwiki:8/88/6b09me728dhjwh3xr0byustt2rof31q.mp3","text":"明日方舟。","alt":"voice_cn/char_151_myrtle/cn_037.mp3"}],"新年":[{"url":"bwiki:7/73/p2cv8ew7ijetl21blcma4n100mz3432.mp3","text":"把旗子取下来，这边打一个结，好，布兜这样就做好了！啊博士，你也在呀。走吧，让我们去把食堂里好吃的扫荡一空！新年第一天，就由大吃一顿开始吧！","alt":"voice_cn/char_151_myrtle/cn_038.mp3"}],"问候":[{"url":"bwiki:8/82/frccnqinp8val9p2g7rkokpq3of8r1y.mp3","text":"博士，有什么有趣的事情吗？","alt":"voice_cn/char_151_myrtle/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:3/34/12ossb9xvk0d9maplod9g9jdjq1i67l.mp3","text":"博士，我来找你玩啦~","alt":"voice/char_151_myrtle/cn_001.mp3"}],"交谈":[{"url":"bwiki:7/72/kiavwarscg9n8ocrkxs63m8lxefh7kv.mp3","text":"博士，你可不要小看我，在我的老家，第一大道还有三条商店街的孩子们可都是听我号令的。","alt":"voice/char_151_myrtle/cn_002.mp3"},{"url":"bwiki:f/fb/sy2ken451axw4ptuspyog8uq749e4zn.mp3","text":"虽然杜林肯定是因为懒得想才直接拿我们族的名字当代号，但是这样我就被占便宜了欸，“杜林的桃金娘”，听起来不像是她的所有物了吗？","alt":"voice/char_151_myrtle/cn_003.mp3"},{"url":"bwiki:1/1d/6hi3z9gymyvczk5ssfkuu5i2dh4vb52.mp3","text":"这里的器械虽然原理我都懂，但是用起来感觉好奇怪欸，有的有好多多余的部分，有的又意外的简便。","alt":"voice/char_151_myrtle/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:4/47/2yon71dax7ydg8vk2095llz6pxh7khe.mp3","text":"这面旗子？啊，博士你眼光不错喔，这面布是我家的桌布，因为怎么也弄不脏所以离家前被我偷偷带出来了，啊哈哈，爸爸现在肯定气死了。","alt":"voice/char_151_myrtle/cn_005.mp3"},{"url":"bwiki:5/57/e5nloocr0x33rf9n66lte1v6um367c5.mp3","text":"欸，我的苹果很厉害吗？唔，在我家那边很普通吧。博士你要玩或者拿去研究的话可以借你，别弄坏了就行~","alt":"voice/char_151_myrtle/cn_006.mp3"}],"信赖":[{"url":"bwiki:a/a6/ecvdapgtgc3ewgvccbac4hqr5ex5tds.mp3","text":"地上虽然有很多我还不适应的地方，不过好吃的东西真的有好多，我最喜欢罗德岛的食堂啦！","alt":"voice/char_151_myrtle/cn_007.mp3"},{"url":"bwiki:0/0e/2kf0i68ngqcrjof70du3l2e3sve8n99.mp3","text":"博士，我必须要严肃地指出一个事实，那就是，我已经成年了！而且在杜林里，我的身高是偏高的！你要告诉其他人，不要看到我就下意识地摸我头，还给我塞零食！","alt":"voice/char_151_myrtle/cn_008.mp3"},{"url":"bwiki:6/6d/sz2yw3cov2hqfskk4k1fpoz8lla4cfn.mp3","text":"我说，博士，你对我的家乡感兴趣吗？我可以带你回去看看！不过，因为回家要走超久的路，所以等我有心情的时候再说吧~","alt":"voice/char_151_myrtle/cn_009.mp3"}],"闲置":[{"url":"bwiki:e/e2/0kvpa6pc5051gkrbfag4zs5c2gyhqn8.mp3","text":"博士要休息一下吗，那我旗子借你盖盖。","alt":"voice/char_151_myrtle/cn_010.mp3"}],"报到":[{"url":"bwiki:3/31/nc64bwvtyidkot9d6pbczeu8r4k4elw.mp3","text":"我来报到啦！你就是博士对吧？可以叫我桃金娘，杜林族的桃金娘。杜林说在这里能找到工作，所以，有什么我能做的事吗？别看我个子小，我还挺厉害的哦。","alt":"voice/char_151_myrtle/cn_011.mp3"}],"作战记录":[{"url":"bwiki:3/39/56k5hbfaeycl3yontbnedlvxq9xloy2.mp3","text":"嗯，嗯......这场打的有意思，还有吗，博士？","alt":"voice/char_151_myrtle/cn_012.mp3"}],"精英化1":[{"url":"bwiki:1/1b/h1oc9coah6pmi6lafutih3okwalo0bd.mp3","text":"咦，我升职了吗？那我可不可以去一些之前不能去的地方看看？","alt":"voice/char_151_myrtle/cn_013.mp3"}],"精英化2":[{"url":"bwiki:9/97/lwjd4bowt3yv5ld4nfvyra03jhxp45g.mp3","text":"我一开始就说了嘛，我可是挺厉害的呢！嗯——哼！","alt":"voice/char_151_myrtle/cn_014.mp3"}],"编入":[{"url":"bwiki:0/00/giocekqfb9xpz99ujvzzqssvibnl56z.mp3","text":"任务？我去我去！","alt":"voice/char_151_myrtle/cn_017.mp3"}],"任命队长":[{"url":"bwiki:a/a5/gd5rxhj93mt9tzavfw291vhb5q2av3z.mp3","text":"大家不要离我太远哦。","alt":"voice/char_151_myrtle/cn_018.mp3"}],"行动出发":[{"url":"bwiki:1/1d/4gujkkwhmmu9npqhs2h0wj5by9091jb.mp3","text":"出——发——！","alt":"voice/char_151_myrtle/cn_019.mp3"}],"行动开始":[{"url":"bwiki:c/c6/ft79ml03syliz83cqh5lxp66dma4jf6.mp3","text":"有我在，大家放心上吧！","alt":"voice/char_151_myrtle/cn_020.mp3"}],"选中":[{"url":"bwiki:f/fb/op3ifce5a9kew0jr2062jqothqiittu.mp3","text":"嗯？","alt":"voice/char_151_myrtle/cn_021.mp3"},{"url":"bwiki:f/fb/l9ytitusi9zkci365pc0wqnl1pebe7y.mp3","text":"呼啊，差点睡着了......","alt":"voice/char_151_myrtle/cn_022.mp3"}],"部署":[{"url":"bwiki:3/3e/k2fl79hb7zid9q3o4o2ad63op5dxwsr.mp3","text":"博士，这里景色还不错欸！","alt":"voice/char_151_myrtle/cn_023.mp3"},{"url":"bwiki:c/c4/q2yzvtg7b9x2n13n95nikrfc6b7lhtc.mp3","text":"我来帮助其他人！","alt":"voice/char_151_myrtle/cn_024.mp3"}],"技能":[{"url":"bwiki:4/4b/5mz77cf176mb47te7kwtfp3nx56jkv6.mp3","text":"我可要认真起来啦！","alt":"voice/char_151_myrtle/cn_025.mp3"},{"url":"bwiki:4/4d/chh8zs8j7j06g3wj00nx833obsxaex5.mp3","text":"大家快来我身边~","alt":"voice/char_151_myrtle/cn_026.mp3"},{"url":"bwiki:3/34/tedpeh93d123r3kfrk9mdhnmiysj9df.mp3","text":"小苹果，今天也拜托你啦。","alt":"voice/char_151_myrtle/cn_027.mp3"}],"高难胜利":[{"url":"bwiki:a/ab/j2gqk3sgmuljd48jhungyc78gbhi1nm.mp3","text":"呼、呼，累死我了，博士，我想回去睡觉。","alt":"voice/char_151_myrtle/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:6/6e/dze7letghzpdcs1eserelowxc9cryn0.mp3","text":"大获全胜！博士，我有派上用场吧？","alt":"voice/char_151_myrtle/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:f/fc/3uautyduxep6jmstp4ml1mvmyyhga2k.mp3","text":"赢了就好嘛，博士，妈妈说过，斤斤计较老得快哦。","alt":"voice/char_151_myrtle/cn_031.mp3"}],"失败":[{"url":"bwiki:8/80/8lrdbds489iz4luwuud1pxix3m6omgr.mp3","text":"大家快跑！","alt":"voice/char_151_myrtle/cn_032.mp3"}],"进驻":[{"url":"bwiki:3/30/i45trq2ps3e1o49mqfs6n4yg7xo3lpz.mp3","text":"哇，罗德岛真大！","alt":"voice/char_151_myrtle/cn_033.mp3"}],"戳一下":[{"url":"bwiki:d/d2/1bbpa2n7fa1hgg7weixpy41yim1dtpv.mp3","text":"咦，这样好有趣！","alt":"voice/char_151_myrtle/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:4/43/tm8odcyjygktdyfdmql4yxynwp41jk1.mp3","text":"食堂为什么不能24小时都开着呢？","alt":"voice/char_151_myrtle/cn_036.mp3"}],"标题":[{"url":"bwiki:7/70/neiymq3viw7nvysgyesm37009l35o26.mp3","text":"明日方舟。","alt":"voice/char_151_myrtle/cn_037.mp3"}],"新年":[{"url":"bwiki:4/4c/aezoqvfz6cv7vkgqodkleh50g5bjv7h.mp3","text":"把旗子取下来，这边打一个结，好，布兜这样就做好了！啊博士，你也在呀。走吧，让我们去把食堂里好吃的扫荡一空！新年第一天，就由大吃一顿开始吧！","alt":"voice/char_151_myrtle/cn_038.mp3"}],"问候":[{"url":"bwiki:c/c7/ae1ogycfu6ix5ipzg669hklzmv3djmc.mp3","text":"博士，有什么有趣的事情吗？","alt":"voice/char_151_myrtle/cn_042.mp3"}]}}