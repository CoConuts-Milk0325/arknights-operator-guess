"}],"行动出发":[{"url":"bwiki:d/df/lzuxddkpn1vhb1dtkbzb83r4x3r6mgg.mp3","text":"赶紧。","alt":"voice/char_1051_headb2/cn_019.mp3"}],"行动开始":[{"url":"bwiki:3/33/bk2s4ubi3pwfsygd7yzushcsdc2wovz.mp3","text":"哼，希望对面比看上去要强。","alt":"voice/char_1051_headb2/cn_020.mp3"}],"选中":[{"url":"bwiki:e/e6/kblco2jax3tizivy3m0ddnygx5oiw9h.mp3","text":"让我去人多的地方。","alt":"voice/char_1051_headb2/cn_021.mp3"},{"url":"bwiki:5/5a/tehvrzj9la99d9mdmthi7yjr41hxjn8.mp3","text":"你的判断是？","alt":"voice/char_1051_headb2/cn_022.mp3"}],"部署":[{"url":"bwiki:6/63/7lt5ukkfox97i3ygjxqruk07k2zx44x.mp3","text":"我来了，都稳住。","alt":"voice/char_1051_headb2/cn_023.mp3"},{"url":"bwiki:2/27/j9da96or9fmr6isbf1i1tbtg64irslk.mp3","text":"要上了！","alt":"voice/char_1051_headb2/cn_024.mp3"}],"技能":[{"url":"bwiki:a/a3/piuy78abminauhkc43s6mlpc4bikvic.mp3","text":"不要命的就过来！","alt":"voice/char_1051_headb2/cn_025.mp3"},{"url":"bwiki:d/d3/pu9bcwscoimtjqubkfcf0lvoyvso9cv.mp3","text":"下一个是谁？","alt":"voice/char_1051_headb2/cn_026.mp3"},{"url":"bwiki:8/81/72qu0zye6v1whk70pnhv5ma4l83emkc.mp3","text":"人人为我，我为人人！","alt":"voice/char_1051_headb2/cn_027.mp3"},{"url":"bwiki:f/f3/959mnk30idyjbu3z4jbwix7u4avm9og.mp3","text":"跟我冲！","alt":"voice/char_1051_headb2/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:6/6c/03zk49r75tsleuta7bnmz66lzrezlm2.mp3","text":"呵......尽兴！","alt":"voice/char_1051_headb2/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:7/77/cftsjoibhsp16j6kh0t8yqyo2zd9az3.mp3","text":"这种强度，只够我热身。","alt":"voice/char_1051_headb2/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:9/96/jjr6runwa3nv5xz6s0zmk4lokj8c6v0.mp3","text":"跑得倒挺快......","alt":"voice/char_1051_headb2/cn_031.mp3"}],"失败":[{"url":"bwiki:f/f8/32wjshx5tav4x0dus5ml4i18by7mpll.mp3","text":"嘁，后面交给我，下次别这么丢人了。","alt":"voice/char_1051_headb2/cn_032.mp3"}],"进驻":[{"url":"bwiki:f/fa/k6hb4u306b9hvqmki6rs22z7oadc2qr.mp3","text":"呼，回来了......","alt":"voice/char_1051_headb2/cn_033.mp3"}],"戳一下":[{"url":"bwiki:3/34/7dorycfnsmqfrv92tkcss0l8ahkad66.mp3","text":"你很闲吗......算了，随你便。","alt":"voice/char_1051_headb2/cn_034.mp3"}],"信赖触摸":[{"url":