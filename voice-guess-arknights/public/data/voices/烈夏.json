450560qvmhovl4wvob2j4jw67fam5.mp3","text":"博士，你要去医疗部吗？我正好和你一起去！","alt":"voice/char_194_leto/cn_036.mp3"}],"标题":[{"url":"bwiki:a/a3/pyz4etl9rhpne3ofbje82dgyjjp16b8.mp3","text":"明日方舟。","alt":"voice/char_194_leto/cn_037.mp3"}],"新年":[{"url":"bwiki:9/9f/7h4ikau08qpkz3lgltxyggw5lgjctk0.mp3","text":"博士，今晚自治团也会举办宴会，不用说，你肯定会来吧？哦对了，妈妈最近身体好了不少，打算过两天自己也张罗一桌，但是两个人太冷清了，所以让我问问你要不要来？","alt":"voice/char_194_leto/cn_038.mp3"}],"问候":[{"url":"bwiki:a/ab/ssoepssjzuemijq10d38u2m3q9z79p7.mp3","text":"博士，来一杯吗？","alt":"voice/char_194_leto/cn_042.mp3"}]}}