{"中文":{"登录":[{"url":"bwiki:9/94/ltk95jl34ux2njbxrd08ttdp13e8pfj.mp3","text":"啊~啊~~要让我守在您身边吗？这样的指示~真是令我心跳加速呢~~","alt":"voice_cn/char_237_gravel/cn_001.mp3"}],"交谈":[{"url":"bwiki:4/4f/5svzqh5yundszb6jd29etc6d0d4738k.mp3","text":"......真是有意思呢。","alt":"voice_cn/char_237_gravel/cn_002.mp3"},{"url":"bwiki:6/6a/h0sr10xuucsv8kqgrt629u1cx6yy0xm.mp3","text":"不用管我哦，请继续您的工作就好~","alt":"voice_cn/char_237_gravel/cn_003.mp3"},{"url":"bwiki:9/90/kimqxxk2y2d1kne40eglycdjh6lpf7a.mp3","text":"嗯？我在看什么？在看你哟。","alt":"voice_cn/char_237_gravel/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:4/4d/oqqks4r1rm97x9el12zs68xofkwjy2h.mp3","text":"如果您需要的话，我也会尽力去变强的~","alt":"voice_cn/char_237_gravel/cn_005.mp3"},{"url":"bwiki:5/58/cfijgz3d91ksgk0tqd766p2aidg8pfx.mp3","text":"嘻嘻......这样一来，您就不必担心会受到突然袭击了哦~因为——我可一直在你的身边呐~","alt":"voice_cn/char_237_gravel/cn_006.mp3"}],"信赖":[{"url":"bwiki:9/9a/ipq2pma9sesaeogrchcfstzxw9uqbor.mp3","text":"您也稍微对我有些兴趣了吗？我可是一直对您很感兴趣呢。","alt":"voice_cn/char_237_gravel/cn_007.mp3"},{"url":"bwiki:a/a7/mhegsmpwxy70ujzz98blzsrldnfodul.mp3","text":"最近这段时间承蒙您照顾了，以卡西米尔骑士之名起誓，必定以身回报此恩......唔，不习惯？我怎么说也是正规骑士出身，说辞总是学过几句的呢。","alt":"voice_cn/char_237_gravel/cn_008.mp3"},{"url":"bwiki:8/89/7b3clegj0u1ux8g2n45ldttm9t3pb4c.mp3","text":"自从我被拐到卡西米尔后，已经很久没人对我这样温柔了。所以您若是不嫌弃，以骑士的荣耀起誓，我砾，不，我塞诺蜜将永远侍奉于您左右。","alt":"voice_cn/char_237_gravel/cn_009.mp3"}],"闲置":[{"url":"bwiki:2/2c/ihj39d39mgv1i02xq6ihgwnllm4e6xm.mp3","text":"我守在这里，有没有让你感到心跳加速呢？","alt":"voice_cn/char_237_gravel/cn_010.mp3"}],"报到":[{"url":"bwiki:d/db/oha9a10y7jcseg5mvfr8t8z3li6ftzu.mp3","text":"啾——嗯？怎么脸红了？这只是初见的问候，可没什么其他的意思哦。那么，卡西米尔骑士砾，就请您多有包涵啦，嘻嘻。","alt":"voice_cn/char_237_gravel/cn_011.mp3"}],"作战记录":[{"url":"bwiki:4/42/bksziypz5sdcx4bjdcc8n0gmwx2ur22.mp3","text":"罗德岛的战术都是博士您安排的吗？这就令人很感兴趣了呢......","alt":"voice_cn/char_237_gravel/cn_012.mp3"}],"精英化1":[{"url":"bwiki:0/05/5tf0wfxvetrgp78i93bvuvg5nl4kjki.mp3","text":"这是博士您的认可吗？真开心！！","alt":"voice_cn/char_237_gravel/cn_013.mp3"}],"精英化2":[{"url":"bwiki:8/88/4jxggllb4r3jrj83nblj9xp4523bc9o.mp3","text":"这是意味着您很需要我对吧？嘻嘻......","alt":"voice_cn/char_237_gravel/cn_014.mp3"}],"编入":[{"url":"bwiki:2/22/e5ul6qf0a751gduhxeqyvlz21ev3rql.mp3","text":"一起行动吗？嘻嘻......","alt":"voice_cn/char_237_gravel/cn_017.mp3"}],"任命队长":[{"url":"bwiki:6/6c/kaux7lmp1qn70y061lqq3qff1rbnhun.mp3","text":"被选中了呢~","alt":"voice_cn/char_237_gravel/cn_018.mp3"}],"行动出发":[{"url":"bwiki:0/01/5taiint9ghhfk109ce7zptm489pbaa7.mp3","text":"我们一起去吧~","alt":"voice_cn/char_237_gravel/cn_019.mp3"}],"行动开始":[{"url":"bwiki:b/bc/3ewvmsmuj7lc96icp2jijw934xjr0ja.mp3","text":"把敌人给......嘻嘻......","alt":"voice_cn/char_237_gravel/cn_020.mp3"}],"选中":[{"url":"bwiki:d/d6/s90tk0pn55o964hptubv0eq9vmcts5u.mp3","text":"嗯？","alt":"voice_cn/char_237_gravel/cn_021.mp3"},{"url":"bwiki:9/95/eg2axxizf6lh6s4ahtlpd3qg8948pjg.mp3","text":"您有指示？","alt":"voice_cn/char_237_gravel/cn_022.mp3"}],"部署":[{"url":"bwiki:9/9d/eiw2e2309zysvaht4hyazu2e1pv6wp2.mp3","text":"就这里了！","alt":"voice_cn/char_237_gravel/cn_023.mp3"},{"url":"bwiki:0/0a/sf960qneyqz4edneubans1zttlnbjtk.mp3","text":"是个好阵地。","alt":"voice_cn/char_237_gravel/cn_024.mp3"}],"技能":[{"url":"bwiki:2/2e/p1ji36pg30bf4chn7jx313lpcohtn1e.mp3","text":"我是你的影子。","alt":"voice_cn/char_237_gravel/cn_025.mp3"},{"url":"bwiki:e/e0/cnm3nde9kzmc40u6y1jqyon5m4orxoj.mp3","text":"嘻嘻......","alt":"voice_cn/char_237_gravel/cn_026.mp3"},{"url":"bwiki:2/21/fve0pbe1z7jfbis2pn2dh6yi3me4sqh.mp3","text":"你走得了吗？","alt":"voice_cn/char_237_gravel/cn_027.mp3"},{"url":"bwiki:8/89/877yycagkfuu5wehmm7yjz5y1r45ksd.mp3","text":"鼠群，聚集起来吧！","alt":"voice_cn/char_237_gravel/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:c/cd/544wxoy20vdomm8doy7elhljggbs6z6.mp3","text":"您的战术真的是完美无缺呢~","alt":"voice_cn/char_237_gravel/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:5/59/7oj32osr5wiwl6ngy7i1dp6k3sefo5m.mp3","text":"刀还没染红就结束了，嘻嘻......","alt":"voice_cn/char_237_gravel/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:a/a3/1cjbrtxn3ztkag7gw0yt7n2d7cw89h4.mp3","text":"逃吧，你们还能逃多远呢。","alt":"voice_cn/char_237_gravel/cn_031.mp3"}],"失败":[{"url":"bwiki:e/ea/qg2fs2838uuevckqxx2wcoomg2yjc02.mp3","text":"对不起，我......又失误了吗......","alt":"voice_cn/char_237_gravel/cn_032.mp3"}],"进驻":[{"url":"bwiki:8/8d/4wnrxv9yby4va9x4shdqh3sp44upwfg.mp3","text":"这个房间，好像有很多可以躲藏的地方呢~","alt":"voice_cn/char_237_gravel/cn_033.mp3"}],"戳一下":[{"url":"bwiki:5/5d/eeheidrbklbqslc0uiv6ojqaivbaqts.mp3","text":"嘻嘻......","alt":"voice_cn/char_237_gravel/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:7/74/6qjnb1gsdyyzp8zgxddnpjj88j1yikp.mp3","text":"是的，我在这里，一直都在呢......","alt":"voice_cn/char_237_gravel/cn_036.mp3"}],"标题":[{"url":"bwiki:9/92/7gvaw4gihmx61g8rsf7mu7f9twrw0co.mp3","text":"明日方舟。","alt":"voice_cn/char_237_gravel/cn_037.mp3"}],"新年":[{"url":"bwiki:0/03/l1izo9czvxm4tsn86rrljh3k7q8vj4q.mp3","text":"新年快乐，博士，请给我您的手——啾——嗯？为什么突然做这种事？亲吻缔结守护誓约之人的手，就是我们卡西米尔骑士庆祝新年的仪式呀~没有听说过？您也要关心关心这方面的事情呀。","alt":"voice_cn/char_237_gravel/cn_038.mp3"}],"问候":[{"url":"bwiki:f/f5/k1ky052lrm5m4o1kgqeib3040dcgzjb.mp3","text":"今天还好吗，博士~","alt":"voice_cn/char_237_gravel/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:0/0b/9mj1eh8epo968gmikbxapo1dnynq5dd.mp3","text":"啊~啊~~要让我守在您身边吗？这样的指示~真是令我心跳加速呢~~","alt":"voice/char_237_gravel/cn_001.mp3"}],"交谈":[{"url":"bwiki:5/57/5u6s75oatvvqfjprtcizyd21f7uxiia.mp3","text":"......真是有意思呢。","alt":"voice/char_237_gravel/cn_002.mp3"},{"url":"bwiki:0/08/kfmewsr8g598dkkel7sat1pihjrq58w.mp3","text":"不用管我哦，请继续您的工作就好~","alt":"voice/char_237_gravel/cn_003.mp3"},{"url":"bwiki:0/04/40oqc91qzjk6y1ka5509c8y3a16kcif.mp3","text":"嗯？我在看什么？在看你哟。","alt":"voice/char_237_gravel/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:a/ac/ex9nhiq4f8vjtgujsvmiadhxbjwnzm6.mp3","text":"如果您需要的话，我也会尽力去变强的~","alt":"voice/char_237_gravel/cn_005.mp3"},{"url":"bwiki:6/6d/2ubwnh1c0yrj2dsm9f8yn27hjnals8h.mp3","text":"嘻嘻......这样一来，您就不必担心会受到突然袭击了哦~因为——我可一直在你的身边呐~","alt":"voice/char_237_gravel/cn_006.mp3"}],"信赖":[{"url":"bwiki:0/0f/heliritp2j8exwsqu7ne5ayx1iip0ft.mp3","text":"您也稍微对我有些兴趣了吗？我可是一直对您很感兴趣呢。","alt":"voice/char_237_gravel/cn_007.mp3"},{"url":"bwiki:1/1d/74itfl93n8p9axbr2h9s45vfgbylaul.mp3","text":"最近这段时间承蒙您照顾了，以卡西米尔骑士之名起誓，必定以身回报此恩...