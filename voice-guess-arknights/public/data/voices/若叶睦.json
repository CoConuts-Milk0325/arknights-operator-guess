{"中文":{"登录":[{"url":"bwiki:7/79/kb9h2zyunxh1p3a1ag5d5p2h9c84y4d.mp3","text":"没什么事的话……我会在这里安静待着。","alt":"voice/char_4183_mortis/cn_001.mp3"}],"交谈":[{"url":"bwiki:8/85/cudeskpneczq8zpkwp83jumdjtltxmc.mp3","text":"我是什么时候出现的？在你进入活动室之前，我就在了......","alt":"voice/char_4183_mortis/cn_002.mp3"},{"url":"bwiki:1/1e/a03au79hyfe5vt7sasnyl3u9r7gjnzp.mp3","text":"这里……很适合种蔬菜。","alt":"voice/char_4183_mortis/cn_003.mp3"},{"url":"bwiki:1/1f/9jfx3eme6bc4s67kcpu5bftl0k4v3ew.mp3","text":"希望我弹吉他吗？知道了。","alt":"voice/char_4183_mortis/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:b/b2/bt94jjuj7bmeuhobo8fxves2nyf05ra.mp3","text":"这是调香师小姐给我的香水。葛罗莉亚也在用的。","alt":"voice/char_4183_mortis/cn_005.mp3"},{"url":"bwiki:9/94/ejkiv1nbjqjj8j4rdzbyt17wy0utb8e.mp3","text":"嘿嘿……回应了大家的期待的感觉，还不坏。","alt":"voice/char_4183_mortis/cn_006.mp3"}],"信赖":[{"url":"bwiki:c/cd/ta6ym0b73i5ca8qiwkvf2kowx55cnas.mp3","text":"即使是博士你，也会有犹豫不决的时候吗？我也经常这样......","alt":"voice/char_4183_mortis/cn_007.mp3"},{"url":"bwiki:8/83/4v289q3o64f3zq4fauhq0xq3d8qz37x.mp3","text":"祥说过，我们都是“一丘之貉”……","alt":"voice/char_4183_mortis/cn_008.mp3"},{"url":"bwiki:f/f9/tj4fdtohambigwgpudooca8c0jzriat.mp3","text":"这里，谁都不认识森南和阿隆……","alt":"voice/char_4183_mortis/cn_009.mp3"}],"闲置":[{"url":"bwiki:5/55/hif0h0clg3ocgfhheo7147ool9r17hb.mp3","text":"你起来了？抱歉。","alt":"voice/char_4183_mortis/cn_010.mp3"}],"报到":[{"url":"bwiki:a/aa/7774b021psjpalg7yaik1shob1nko80.mp3","text":"若叶睦……请多多指教。","alt":"voice/char_4183_mortis/cn_011.mp3"}],"作战记录":[{"url":"bwiki:5/52/c6ylp0ei24awuabkc2zjpuiy86h58ct.mp3","text":"我看得出来，这些不是表演，它们真的死掉了。","alt":"voice/char_4183_mortis/cn_012.mp3"}],"精英化1":[{"url":"bwiki:3/39/m66k3iv5vdg6ojfta1a2np3xuxni3px.mp3","text":"还需要，更加努力地练习……","alt":"voice/char_4183_mortis/cn_013.mp3"}],"精英化2":[{"url":"bwiki:1/12/3dolgh3nff50w0h34y26naaib3fpx09.mp3","text":"这是......对我的认可吗？","alt":"voice/char_4183_mortis/cn_014.mp3"}],"编入":[{"url":"bwiki:f/f5/gugv0lltcldghln4k66b5vb63r2tz1f.mp3","text":"好的。","alt":"voice/char_4183_mortis/cn_017.mp3"}],"任命队长":[{"url":"bwiki:1/17/o93eecvx381i4989oxs4r1schxq71i5.mp3","text":"祥比我更合适。","alt":"voice/char_4183_mortis/cn_018.mp3"}],"行动出发":[{"url":"bwiki:4/4c/24ndm9p6ba60ird6nv3t1i9bgff3emv.mp3","text":"开始吧。","alt":"voice/char_4183_mortis/cn_019.mp3"}],"行动开始":[{"url":"bwiki:f/fe/b93ac9l7nthy1qd0uj9im7xakcbekqx.mp3","text":"它们在靠近。","alt":"voice/char_4183_mortis/cn_020.mp3"}],"选中":[{"url":"bwiki:1/1a/e0pif3si1a345kl5b2l0ls7c52xxnqj.mp3","text":"准备好了。","alt":"voice/char_4183_mortis/cn_021.mp3"},{"url":"bwiki:c/c1/jf7wwj6t92dol50c631zjqrov9n7fdq.mp3","text":"我已经做好觉悟。","alt":"voice/char_4183_mortis/cn_022.mp3"}],"部署":[{"url":"bwiki:3/38/l98lr8z0u3jq2i10a7ikqz1f95p0imx.mp3","text":"只能这样了……","alt":"voice/char_4183_mortis/cn_023.mp3"},{"url":"bwiki:8/83/nuyv21uc7fpzxi2yhd2aouckwq4k8ia.mp3","text":"一定不能出错。","alt":"voice/char_4183_mortis/cn_024.mp3"}],"技能":[{"url":"bwiki:4/4b/18u160r3vrbpw35v9bug8phro6ay5lo.mp3","text":"我会试试……","alt":"voice/char_4183_mortis/cn_025.mp3"},{"url":"bwiki:7/79/ci6g4zkpb2410867xow9323yuz4clyl.mp3","text":"这些敌人也没有那么恐怖。","alt":"voice/char_4183_mortis/cn_026.mp3"},{"url":"bwiki:5/56/2ax63rv6jy4irrv8guhpktgjf4u95p0.mp3","text":"只要什么都不去想……","alt":"voice/char_4183_mortis/cn_027.mp3"},{"url":"bwiki:6/6d/rax0zltual6sgt7pq60s57vi85cial4.mp3","text":"就像训练的那样。","alt":"voice/char_4183_mortis/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:1/14/nf9gjlobpulpqradwe0cybzxhwsoq25.mp3","text":"太好了。","alt":"voice/char_4183_mortis/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:3/3e/h2021e1ynys712s4z0k2492mgrm56o1.mp3","text":"这次，没有失败了。","alt":"voice/char_4183_mortis/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:c/cd/j7ay55oyfuwme9hql96fhy6wsyjiuf0.mp3","text":"多谢你的帮助……","alt":"voice/char_4183_mortis/cn_031.mp3"}],"失败":[{"url":"bwiki:0/0b/k1cvpl3qkgdv6yyxorc49ii4gveihji.mp3","text":"我又把事情搞砸了……","alt":"voice/char_4183_mortis/cn_032.mp3"}],"进驻":[{"url":"bwiki:4/4c/1dznwapp9eqybiuxwpyna3sfg95yk5l.mp3","text":"我会待在这里。","alt":"voice/char_4183_mortis/cn_033.mp3"}],"戳一下":[{"url":"bwiki:7/7f/0h7f8uu4j6fr3ipqg2ifgfwmtxpd2n7.mp3","text":"怎么了？","alt":"voice/char_4183_mortis/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:4/47/k7q7o85y74ljpglsbwv03wo9teydzba.mp3","text":"我正在练习。","alt":"voice/char_4183_mortis/cn_036.mp3"}],"标题":[{"url":"bwiki:3/3d/6jk9t7mtun8fwg6afowfik72l0qw8ep.mp3","text":"明日方舟。","alt":"voice/char_4183_mortis/cn_037.mp3"}],"新年":[{"url":"bwiki:3/30/rnwgz7wkycj3c6tluyuf0bpwtkiid5u.mp3","text":"刚才我在舞台上参加了表演。不，并不是Ave&#160;Mujica的演出，是罗德岛大家一起的戏剧。扮演了一棵树。","alt":"voice/char_4183_mortis/cn_038.mp3"}],"问候":[{"url":"bwiki:c/c3/fxr1yywmfm2zcgpg4ia7u2odpwawvk8.mp3","text":"博士。昨晚我没做噩梦，您呢？","alt":"voice/char_4183_mortis/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:7/79/kb9h2zyunxh1p3a1ag5d5p2h9c84y4d.mp3","text":"没什么事的话……我会在这里安静待着。","alt":"voice/char_4183_mortis/cn_001.mp3"}],"交谈":[{"url":"bwiki:8/85/cudeskpneczq8zpkwp83jumdjtltxmc.mp3","text":"我是什么时候出现的？在你进入活动室之前，我就在了......","alt":"voice/char_4183_mortis/cn_002.mp3"},{"url":"bwiki:1/1e/a03au79hyfe5vt7sasnyl3u9r7gjnzp.mp3","text":"这里……很适合种蔬菜。","alt":"voice/char_4183_mortis/cn_003.mp3"},{"url":"bwiki:1/1f/9jfx3eme6bc4s67kcpu5bftl0k4v3ew.mp3","text":"希望我弹吉他吗？知道了。","alt":"voice/char_4183_mortis/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:b/b2/bt94jjuj7bmeuhobo8fxves2nyf05ra.mp3","text":"这是调香师小姐给我的香水。葛罗莉亚也在用的。","alt":"voice/char_4183_mortis/cn_005.mp3"},{"url":"bwiki:9/94/ejkiv1nbjqjj8j4rdzbyt17wy0utb8e.mp3","text":"嘿嘿……回应了大家的期待的感觉，还不坏。","alt":"voice/char_4183_mortis/cn_006.mp3"}],"信赖":[{"url":"bwiki:c/cd/ta6ym0b73i5ca8qiwkvf2kowx55cnas.mp3","text":"即使是博士你，也会有犹豫不决的时候吗？我也经常这样......","alt":"voice/char_4183_mortis/cn_007.mp3"},{"url":"bwiki:8/83/4v289q3o64f3zq4fauhq0xq3d8qz37x.mp3","text":"祥说过，我们都是“一丘之貉”……","alt":"voice/char_4183_mortis/cn_008.mp3"},{"url":"bwiki:f/f9/tj4fdtohambigwgpudooca8c0jzriat.mp3","text":"这里，谁都不认识森南和阿隆……","alt":"voice/char_4183_mortis/cn_009.mp3"}],"闲置":[{"url":"bwiki:5/55/hif0h0clg3ocgfhheo7147ool9r17hb.mp3","text":"你起来了？抱歉。","alt":"voice/char_4183_mortis/cn_010.mp3"}],"报到":[{"url":"bwiki:a/aa/7774b021psjpalg7yaik1shob1nko80.mp3","text":"若叶睦……请多多指教。","alt":"voice/c