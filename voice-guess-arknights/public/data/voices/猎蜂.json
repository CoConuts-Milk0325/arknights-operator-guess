{"中文":{"登录":[{"url":"bwiki:4/40/q1pycjks0qhk56nwheyhtpwisjq1dq8.mp3","text":"老板，我们去吃饭吧，这回轮到老板请客！欸，上次也是？不记得不记得啦。","alt":"voice_cn/char_137_brownb/cn_001.mp3"}],"交谈":[{"url":"bwiki:2/21/edd93gdv3x8ylzg2vlz83mcm8g6ttoc.mp3","text":"以理服人？打不过的话就锻炼到打得过为止，是这个道理，我懂！","alt":"voice_cn/char_137_brownb/cn_002.mp3"},{"url":"bwiki:1/1e/tkpajxiksi5upn30hjg35jsffdkhijf.mp3","text":"蜂蜜真好喝，但收集起来真是麻烦。前几天去采蜜的时候啊......我被蛰得不轻啊。","alt":"voice_cn/char_137_brownb/cn_003.mp3"},{"url":"bwiki:a/a4/gs5xo3upxj98danosnug2rz5putcwa1.mp3","text":"这对指虎？这可是我的宝贝。我的全胜战绩，可全是靠它打出来的！","alt":"voice_cn/char_137_brownb/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:4/4f/3c0ekzs9ftbzdoure5fwh4b6gubioku.mp3","text":"地下格斗的规则，可比你知道的复杂多了。好多搞不清楚规则就参赛的人，都把命给丢了哦。","alt":"voice_cn/char_137_brownb/cn_005.mp3"},{"url":"bwiki:b/b4/qe9r49shg1nv60mmv2f3vpp2b6xj25k.mp3","text":"矿石病？那个怎么样都无所谓啦。管他是感染者还是别的什么人，只要一拳打昏，谁来还不都是一样嘛~","alt":"voice_cn/char_137_brownb/cn_006.mp3"}],"信赖":[{"url":"bwiki:8/8d/j5zm32jyl7sv34of92dpybwthyd9mmq.mp3","text":"啊？厨房里那条鱼？哈，这会儿已经在我的胃里了！","alt":"voice_cn/char_137_brownb/cn_007.mp3"},{"url":"bwiki:7/7c/0r3l77xrmyo4c3cg381uu9bcgiite7g.mp3","text":"欸？为什么要翻这份名册？哼哼，老板这就不懂了吧，不给自己增加点熟人，回头不就没有打架的对手了吗？","alt":"voice_cn/char_137_brownb/cn_008.mp3"},{"url":"bwiki:4/44/dwb7hiv1vwr6dh32g4zvn2cxn59z80m.mp3","text":"以前，我其实就是为了吃上饭才去打比赛的。但现在，在我来到罗德岛之后，这种烦恼就再也没有过了。真的很感谢你，老板！","alt":"voice_cn/char_137_brownb/cn_009.mp3"}],"闲置":[{"url":"bwiki:e/e3/2n13f4k3tqwnp57tail4bp7tzqcm5t8.mp3","text":"有烤鱼的味道！","alt":"voice_cn/char_137_brownb/cn_010.mp3"}],"报到":[{"url":"bwiki:e/e8/2fetgxkpx0n7ghpcs433fkfxd9itbdy.mp3","text":"哟！老板您眼光不错嘛！世上最强的地下拳手，就是我猎蜂！","alt":"voice_cn/char_137_brownb/cn_011.mp3"}],"作战记录":[{"url":"bwiki:e/eb/4smq1l7tsgesn3mxt72yvgqsojk8qo9.mp3","text":"学习对我来说太难了，还是放我出去打一架吧~","alt":"voice_cn/char_137_brownb/cn_012.mp3"}],"精英化1":[{"url":"bwiki:3/36/8y48woqlmroxtfbcl5wag9mzda3canp.mp3","text":"哈哈，看来你还是蛮中意我的！","alt":"voice_cn/char_137_brownb/cn_013.mp3"}],"精英化2":[{"url":"bwiki:d/d6/m092othq4809nzvjvj8ags9cjwnmhuv.mp3","text":"你这么提拔我，我又怎么能辜负你呢？就等我到了战场上再大显身手吧，老板！","alt":"voice_cn/char_137_brownb/cn_014.mp3"}],"编入":[{"url":"bwiki:5/5f/hvncmo8rui74eluvbbm1oxaqdzqufxm.mp3","text":"我来了！","alt":"voice_cn/char_137_brownb/cn_017.mp3"}],"任命队长":[{"url":"bwiki:5/5f/l0rpfn0vgc830zj831147ktbg86v3kz.mp3","text":"好！打赢之后我请各位吃饭！","alt":"voice_cn/char_137_brownb/cn_018.mp3"}],"行动出发":[{"url":"bwiki:5/57/38uatthxdovkfsjnoziwxccat0kbzxl.mp3","text":"没人能在我拳下挺过三回合！","alt":"voice_cn/char_137_brownb/cn_019.mp3"}],"行动开始":[{"url":"bwiki:6/63/si6pjp43gq4udx1innkiw7joo9w25s2.mp3","text":"想被我痛揍的，就是你们这帮家伙吗？","alt":"voice_cn/char_137_brownb/cn_020.mp3"}],"选中":[{"url":"bwiki:3/34/mgiwwv3e0qx3zwxjfezanxpqhg7luzp.mp3","text":"咋了？","alt":"voice_cn/char_137_brownb/cn_021.mp3"},{"url":"bwiki:7/71/0791z6hi8za4vgbcu07o8p0wv3a5yvp.mp3","text":"要上吗？","alt":"voice_cn/char_137_brownb/cn_022.mp3"}],"部署":[{"url":"bwiki:6/68/805uexgdxbp497ny1ey9afuzxz7xacw.mp3","text":"好叻。","alt":"voice_cn/char_137_brownb/cn_023.mp3"},{"url":"bwiki:d/d4/rpecqehymgrjcyd5v65ixetp564i2c0.mp3","text":"好，就这么办。","alt":"voice_cn/char_137_brownb/cn_024.mp3"}],"技能":[{"url":"bwiki:9/9e/66r5dp3k03h0rzbsgnmrd499fccmmb4.mp3","text":"吃我一拳！","alt":"voice_cn/char_137_brownb/cn_025.mp3"},{"url":"bwiki:c/c7/kujzgw1l747e08olx53eui487wbqnj9.mp3","text":"别想跑！","alt":"voice_cn/char_137_brownb/cn_026.mp3"},{"url":"bwiki:f/f2/7p9lj4915tk1xto3ppb7b2kh84jt2xi.mp3","text":"打打打打打！","alt":"voice_cn/char_137_brownb/cn_027.mp3"},{"url":"bwiki:d/da/c8gyr9p4iwwslrns4pzapoyovaztwfd.mp3","text":"来啊来啊，还有谁！","alt":"voice_cn/char_137_brownb/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:5/57/6cf76z6z6mupyipzc0o4pri1sp9ne01.mp3","text":"对手越强，我的斗志就越旺！","alt":"voice_cn/char_137_brownb/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:1/1a/lvazifnkwr6jyxlp5h0g2wdxchrxcef.mp3","text":"全撂倒了，老板，来看看我这辉煌的战果吧！","alt":"voice_cn/char_137_brownb/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:c/ca/s0higbt4rcs94v8ge2w1zctiis6oaso.mp3","text":"收工啦，大家回去好好吃一顿！","alt":"voice_cn/char_137_brownb/cn_031.mp3"}],"失败":[{"url":"bwiki:8/87/mtuos3uujvp17f10402a7ueaqt1m3bw.mp3","text":"真疼......老板呢？没事吧？","alt":"voice_cn/char_137_brownb/cn_032.mp3"}],"进驻":[{"url":"bwiki:9/96/h21a6ohuf0l14fikz97zo34lnuhtkdx.mp3","text":"这个房间比我以前住过的都要好！","alt":"voice_cn/char_137_brownb/cn_033.mp3"}],"戳一下":[{"url":"bwiki:f/f2/hv2ba0e525m0pmxhrjy6o7fxolawsgs.mp3","text":"嗯嗯？","alt":"voice_cn/char_137_brownb/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:2/22/rutwbevy4x2zqfj2zvibxuqkax3akek.mp3","text":"有好吃的给我吗？太棒了，老板！","alt":"voice_cn/char_137_brownb/cn_036.mp3"}],"标题":[{"url":"bwiki:f/fe/3t20znephl9sc8tlgk0i6t8mscvzt2o.mp3","text":"明日方舟。","alt":"voice_cn/char_137_brownb/cn_037.mp3"}],"新年":[{"url":"bwiki:2/22/of5b8y4zwc96i8zwja6veva6smeux60.mp3","text":"嘿嘿嘿嘿......老板！老板你在这啊，我刚和他们喝了蜂蜜！有稳定工资就是好，我都能自己买这么多蜜了，要是之前，我还要自己去采，被蜇可疼了......老板万岁！","alt":"voice_cn/char_137_brownb/cn_038.mp3"}],"问候":[{"url":"bwiki:c/cc/chhl09hzfi2n1m72tf49egg428gz0bb.mp3","text":"早啊老板。","alt":"voice_cn/char_137_brownb/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:8/80/idp4agombju5nkpw8wf3djlbose0c8c.mp3","text":"老板，我们去吃饭吧，这回轮到老板请客！欸，上次也是？不记得不记得啦。","alt":"voice/char_137_brownb/cn_001.mp3"}],"交谈":[{"url":"bwiki:b/b2/oei3aziiibiu56xg6x8tdnkbzmdw6wu.mp3","text":"以理服人？打不过的话就锻炼到打得过为止，是这个道理，我懂！","alt":"voice/char_137_brownb/cn_002.mp3"},{"url":"bwiki:8/8a/9ycznu9maxa1ng6pd830qheq4mluo0u.mp3","text":"蜂蜜真好喝，但收集起来真是麻烦。前几天去采蜜的时候啊......我被蛰得不轻啊。","alt":"voice/char_137_brownb/cn_003.mp3"},{"url":"bwiki:b/b3/c18cu9q0r1t8neqzuqfzo95lb6z3src.mp3","text":"这对指虎？这可是我的宝贝。我的全胜战绩，可全是靠它打出来的！","alt":"voice/char_137_brownb/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:d/d0/f2jidv5ww89ty1qafn5p176kh92mtdo.mp3","text":"地下格斗的规则，可比你知道的复杂多了。好多搞不清楚规则就参赛的人，都把命给丢了哦。","alt":"voice/char_137_brownb/cn_005.mp3"},{"url":"bwiki:c/cf/74jpw4t055pin9rnt9unz021oy6jcyk.mp3","text":"矿石病？那个怎么样都无所谓啦。管他是感染者还是别的什么人，只要一拳打昏，谁来还不都是一样嘛~","alt":"voice/char_137_brownb/cn_006.mp3"}],"信赖":[{"url":"bwiki:0/0e/gj59a8ygwbe8xe88weg0f3eohd8cbzr.mp3","text":"啊？厨房里那条鱼？哈，这会儿已经在我的胃里了！","alt":"voice/char_137_brownb/cn_007.mp3"},{"url":"bwiki:9/9c/08dnw8uqhjm9