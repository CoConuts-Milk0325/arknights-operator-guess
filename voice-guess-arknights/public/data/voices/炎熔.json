也不那么准确，如果过程中混入了杂音，得出的结果往往不怎么清晰。","alt":"voice/char_121_lava/cn_031.mp3"}],"失败":[{"url":"bwiki:a/a8/p52m4b3kfu91ef6ia76e8goja2pw9oa.mp3","text":"可恶......邪念怎么那么强......","alt":"voice/char_121_lava/cn_032.mp3"}],"进驻":[{"url":"bwiki:9/97/qj6f0x3m2zjdcvr4l781bqy2mq4nloa.mp3","text":"好了够了，我喜欢一个人待着。","alt":"voice/char_121_lava/cn_033.mp3"}],"戳一下":[{"url":"bwiki:b/b8/03ehzjn2yyn5nwbb2csr96ga686oig8.mp3","text":"别碰我！哇啊啊！","alt":"voice/char_121_lava/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:f/f3/b7s3nudnxrigp6lxbqxudpvt79u0mvv.mp3","text":"别、别以为这么做就能赚取我的好感啊！","alt":"voice/char_121_lava/cn_036.mp3"}],"标题":[{"url":"bwiki:5/5e/qgltoze4h996x8ub7fu22a9m3ihl03y.mp3","text":"明日方舟。","alt":"voice/char_121_lava/cn_037.mp3"}],"新年":[{"url":"bwiki:b/bf/htt4yogt3me0x982e7hbook5gh6j3er.mp3","text":"博士，我一点都不胖吧？刚才我想吃炸羽兽肉，芙蓉那家伙居然把皮给我去掉了！那可是油滋滋的皮欸！！今天也被她看着不能吃这不能吃那的，我待会儿肯定要和她吵......算了，哼。","alt":"voice/char_121_lava/cn_038.mp3"}],"问候":[{"url":"bwiki:e/e4/nhi7xw4a1mriz0pk4qq1dclkvwfwyci.mp3","text":"是博士啊。早。","alt":"voice/char_121_lava/cn_042.mp3"}]}}