p3"}],"戳一下":[{"url":"bwiki:d/dd/eirhr4pn7qhgqu1r79rqkzj31mwrcad.mp3","text":"耳朵？","alt":"voice/char_433_windft/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:6/61/2iob4lxfhfu82ieix2rfcrc5vmj39az.mp3","text":"我按照博士的样子焊了一个小铁人，哈哈哈哈......","alt":"voice/char_433_windft/cn_036.mp3"}],"标题":[{"url":"bwiki:5/51/eu2kvgsalbidkb0etesao34usm9n72f.mp3","text":"明日方舟。","alt":"voice/char_433_windft/cn_037.mp3"}],"新年":[{"url":"bwiki:9/9e/4bs8ia1yizl846wcvleqt9rc4cz079c.mp3","text":"小时候没能好好地庆祝过一次，长大后有条件庆祝了，却没能和家人一起。我要是能赚到更多的钱就好了，这样平时就可以请几天假回去看看他们，也不会心疼工资。这就是我的新年目标。","alt":"voice/char_433_windft/cn_038.mp3"}],"问候":[{"url":"bwiki:4/4b/8tj5p2wv7afssf4ulvtiv4o7vof39q7.mp3","text":"博士，等下去玩极限飞盘吗？","alt":"voice/char_433_windft/cn_042.mp3"}]}}