3b/2alz85y0sekkl7y7dvmbkljs4y01g6r.mp3","text":"快点快点，都动起来！","alt":"voice_custom/char_308_swire_cn_topolect/cn_026.mp3"},{"url":"bwiki:1/1d/h8otz463vwegpcfg6im8xi0e8lzdkge.mp3","text":"龙门有龙门的骄傲！","alt":"voice_custom/char_308_swire_cn_topolect/cn_027.mp3"},{"url":"bwiki:7/76/o7hkttzkbetw82xeqahj7gbptiokmlq.mp3","text":"该沽出了！","alt":"voice_custom/char_308_swire_cn_topolect/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:2/29/q93qyj6vsy1aowpi0r6aov4kzzebkzw.mp3","text":"好呀，战斗和商业是一样的，风险与回报并存！","alt":"voice_cn/char_308_swire/cn_029.mp3"},{"url":"bwiki:a/a2/iuzv5tj5v77tjnarjul2g88wfl8xxlx.mp3","text":"好呀，战斗和商业是一样的，风险与回报并存！","alt":"voice_custom/char_308_swire_cn_topolect/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:2/28/hcz0b0q234xc53262bdeil8mq5o0zqb.mp3","text":"资本，就该是兼并和收购！胜利，就该是侦破和搜捕！","alt":"voice_cn/char_308_swire/cn_030.mp3"},{"url":"bwiki:3/37/mog0y5jadswttgtvwdz08d594116zal.mp3","text":"资本，就该是兼并和收购！胜利，就该是侦破和搜捕！","alt":"voice_custom/char_308_swire_cn_topolect/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:3/32/1zk76076tm3edzx4ppa6hi09l66so7d.mp3","text":"不太好，不太好！你还可以做的更好吧？加油，我会和你一起努力的！","alt":"voice_cn/char_308_swire/cn_031.mp3"},{"url":"bwiki:c/cb/thqxk495yytsh1vt1lny1te2jvsa3rr.mp3","text":"不太好，不太好！你还可以做的更好吧？加油，我会和你一起努力的！","alt":"voice_custom/char_308_swire_cn_topolect/cn_031.mp3"}],"失败":[{"url":"bwiki:5/50/b7cz89ukpti9uzs9ly3yvbqkcq4jb0l.mp3","text":"太、太丢脸了！我居然......居然犯下这种失误！","alt":"voice_cn/char_308_swire/cn_032.mp3"},{"url":"bwiki:5/55/amr1z8lvm9uw342jq62mdybr668v8i1.mp3","text":"太、太丢脸了！我居然......居然犯下这种失误！","alt":"voice_custom/char_308_swire_cn_topolect/cn_032.mp3"}],"进驻":[{"url":"bwiki:e/e4/4kj7gy9nfqtxg24s6t0bplfgjtgi6om.mp3","text":"还、还不赖......不，这房间还可以再装修下吧！","alt":"voice_cn/char_308_swire/cn_033.mp3"},{"url":"bwiki:e/e7/orc4exdwqgl6e3hcmo8no4xtytnos9p.mp3","text":"还、还不赖......不，这房间还可以再装修下吧！","alt":"voice_custom/char_308_swire_cn_topolect/cn_033.mp3"}],"戳一下":[{"url":"bwiki:3/35/osouwve64524y2b09ufpnj5rl2ntfem.mp3","text":"大、大胆！","alt":"voice_cn/char_308_swire/cn_034.mp3"},{"url":"bwiki:d/d8/m0idcohutw6tz230p2qmvhtifvs3mdn.mp3","text":"大、大胆！","alt":"voice_custom/char_308_swire_cn_topolect/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:f/fe/qmsmtiu5l5jvljk5eutn577kbh3vz0s.mp3","text":"一......一起吃晚饭吧？我，我来买单好了！","alt":"voice_cn/char_308_swire/cn_036.mp3"},{"url":"bwiki:7/73/7vi8lztzwr36n5rrg9iaaxxku5qaj67.mp3","text":"一......一起吃晚饭吧？我，我来买单好了！","alt":"voice_custom/char_308_swire_cn_topolect/cn_036.mp3"}],"标题":[{"url":"bwiki:d/dd/4wtxbmkg7llq55ouyntd6mfn4aehqpy.mp3","text":"明日方舟。","alt":"voice_cn/char_308_swire/cn_037.mp3"},{"url":"bwiki:c/ca/rdmx3weud2drexd33awx315dnvzlxu7.mp3","text":"明日方舟。","alt":"voice_custom/char_308_swire_cn_topolect/cn_037.mp3"}],"新年":[{"url":"bwiki:c/cb/4yh8jq3usmvleoaz9zp3w6c4jts6ycj.mp3","text":"新年好！都在这里聚齐了，挺热闹的啊！我带了点龙门本地小吃......才、才不是专门给你们带的，是我自己要吃！对了，要是陈晖洁来吃，记得让她给我付钱。辛苦费！","alt":"voice_cn/char_308_swire/cn_038.mp3"},{"url":"bwiki:2/28/5w5z9g9ujhn35od5xfnerjffg5nr306.mp3","text":"新年好！都在这里聚齐了，挺热闹的啊！我带了点龙门本地小吃......才、才不是专门给你们带的，是我自己要吃！对了，要是陈晖洁来吃，记得让她给我付钱。辛苦费！","alt":"voice_custom/char_308_swire_cn_topolect/cn_038.mp3"}],"问候":[{"url":"bwiki:a/a8/h7vtoi3nu69txpbxoyj4ygzmhva887m.mp3","text":"嗷呜，博士！","alt":"voice_cn/char_308_swire/cn_042.mp3"},{"url":"bwiki:5/50/kmufodjqn4swdilp3vjna5l8ce4vryg.mp3","text":"嗷呜，博士！","alt":"voice_custom/char_308_swire_cn_topolect/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:b/b4/n3kaithxzudfgpg7w6upoznbhg5orea.mp3","text":"博士，我们的每一分钟，都很重要！一分钟，就有可能是数百万的亏损和额外的伤亡！欸，咖啡？请帮我加一包黄糖，多点奶沫，谢谢！","alt":"voice/char_308_swire/cn_001.mp3"}],"交谈":[{"url":"bwiki:7/7e/7wzgnjf26fp4m80lpb23kxfnxptqbc5.mp3","text":"虽然有人和我说你们是个黑幕重重的公司，走道里有很多可怕的感染者四处游荡，但我觉得，根本就是夸大其词嘛。罗德岛的干员都在为了更好的生活而奋斗，这不是和龙门警员们一模一样嘛！","alt":"voice/char_308_swire/cn_002.mp3"},{"url":"bwiki:f/fd/43y3at0syqfx9kcfindni87979giguw.mp3","text":"我说，教官办公室的布局，可以调整一下吧？至少加一些装饰，像是手织地毯，或者原子主义画作什么的？现在的办公室也太朴素了，虽然杜宾说她无所谓，但我的工作热情可是会下降的......","alt":"voice/char_308_swire/cn_003.mp3"},{"url":"bwiki:0/0b/gz2yit2cv0o3e2a4h8ykbwrcmv3r0c0.mp3","text":"唉，那个讨厌的陈，在不在这里？在近卫局的时候，一旦在过道上碰见她，就会被她恶狠狠地盯着，弄得我也开始怀疑自己是不是做错什么了！我不就是......有点，想要接管近卫局而已嘛！","alt":"voice/char_308_swire/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:9/9c/oja5oa4ymiqx9ofsjmvabs5nf9z81o1.mp3","text":"锻炼也是，学习也是，训练也是，研究竞争对手和市场变化也是......全都不能落下！","alt":"voice/char_308_swire/cn_005.mp3"},{"url":"bwiki:5/57/02yloqthdb00jl10deruhf2lifvo2ub.mp3","text":"虽然家族同意我暂时放下家族事业，但我很清楚，龙门想要发展，既要有治安和秩序的维护，也要有商业与金融的推动。无论是哪一个领域，只要龙门需要我，我就会投身其中！","alt":"voice/char_308_swire/cn_006.mp3"}],"信赖":[{"url":"bwiki:f/f5/5fimnsadxl5sgaez92439qoe69i9jq2.mp3","text":"龙门各署的工作是很复杂的。维护治安，保护民众，疏导交通，贸易协管......唉，每天都忙到腰酸背痛。不过，只要我和部下们做的事对龙门有益我就，哈哈，心满意足！","alt":"voice/char_308_swire/cn_007.mp3"},{"url":"bwiki:9/9b/96azx65tud11qt3nc43u0d0rp5xx7y1.mp3","text":"博士，为什么罗德岛的训练课程这么短？......资金有限？这怎么行，我要申请调去商务部门！虽、虽然我不喜欢经商，但如果你需要的话，我做这个也......也可以！","alt":"voice/char_308_swire/cn_008.mp3"},{"url":"bwiki:7/78/7dh9pciw1tspnppiw9mvskjoc10cpie.mp3","text":"其实我们龙门很需要博士你这样的人才，所以，所以......唔，如果你不喜欢办案，银行业和管理业也可以哦！我，我能为你准备很多机会的！啊？即使在罗德岛也可以合作？......哎呀！！","alt":"voice/char_308_swire/cn_009.mp3"}],"闲置":[{"url":"bwiki:8/86/78um4tv5lk9srxe7vef0cbqdemmugdg.mp3","text":"唔咕咕......好，好累啊......果然连续值班......会......呼......呼......","alt":"voice/char_308_swire/cn_010.mp3"}],"报到":[{"url":"bwiki:b/bb/6hxy9adpnjb99fpqps6odcmsaeiso6o.mp3","text":"龙门高级警司诗怀雅，现在，作为训练顾问，受聘于罗德岛。博士，为了龙门的未来，我们两人可得好好相处！","alt":"voice/char_308_swire/cn_011.mp3"}],"作战记录":[{"url":"bwiki:6/63/ql8dfmilx3nyg5w3dgth5hn45hwfp6k.mp3","text":"唔唔，这样运用战术理论的话，也行得通！","alt":"voice/char_308_swire/cn_012.mp3"}],"精英化1":[{"url":"bwiki:a/a0/ffwbohzd3jrtr3iyl04z3hbggcu071y.mp3","text":"晋升？唔，我在龙门的地位也不会提高吧？但如果你喜欢的话，我、我......要我接受，也不是不行！","alt":"voice/char_308_swire/cn_013.mp3"}],"精英化2":[{"url":"bwiki:c/c5/bm6tz7oep0sfs6aojp8fwebr6ihiqoo.mp3","text":"也许，你想通过我和龙门缔结友好关系；或者，罗德岛需要我的能力；哪怕，你对我有其它需要......我没法全部保证。但，我会是你最忠诚的伙伴。","alt":"voice/char_308_swire/cn_014.mp3"}],"编入":[{"url":"bwiki:9/9d/6c766vyk17rhur3npygoxhw4cy4g7sf.mp3","text":"终于，需要我的智慧了吗！","alt":"voice/char_308_swire/cn_017.mp3"}],"任命队长":[{"url":"bwiki:3/37/t2kfctptkhf5g0s5rgztbe0tkhm3gxn.mp3","text":"可要好好听从我的指挥！","alt":"voice/char_308_swire/cn_018.mp3"}],"行动出发":[{"url":"bwiki:e/e1/96sbk1v12g0pmbst67t688owikiizou.mp3","text":"一口气消灭他们，就能节省开销！","alt":"voice/char_308_swire/cn_019.mp3"}],"行动开始":[{"url":"bwiki:d/de/4q4uvzc7xe8gz0vlob9xw5ks9c2rx4z.mp3","text":"快点解决吧，可别浪费我宝贵的时间啊！","alt":"voice/char_308_swire/cn_020.mp3"}],"选中":[{"url":"bwiki:5/5a/mt1jjy6xe0q8p7uvcrges042fiwfghr.mp3","text":"哈？","alt":"voice/char_308_swire/cn_021.mp3"},{"url":"bwiki:c/c8/j2p8dysjrykuuicdnde2xvru2g8iptt.mp3","text":"敌人的战术，我已经看得很清楚了！","alt":"voice/char_308_swire/cn_022.mp3"}],"部署":[{"url":"bwiki:f/f0/mr6ujtqvbhwx8hr8aqr33wd1e31vsu7.mp3","text":"我的战场，可不只是这里！","alt":"voice/char_308_swire/cn_023.mp3"},{"url":"bwiki:a/ab/sibvhuk1ovfktz34owowq7zlfdswlzc.mp3","text":"哪怕是竞争对手，也需要一点教育！","alt":"voice/char_308_swire/cn_024.mp3"}],"技能":[{"url":"bwiki:f/fb/fismf36lvgy7fw9d8by18amcing3wk3.mp3","text":"时间就是金钱！","alt":"voice/char_308_swire/cn_025.mp3"},{"url":"bwiki:4/40/9qp88ml68p43wujyby2ci48r0u9ydwp.mp3","text":"快点快点，都动起来！","alt":"voice/char_308_swire/cn_026.mp3"},{"url":"bwiki:8/8a/fjp70mkh0hkcvum34vivr74d0qit4j8.mp3","text":"龙门有龙门的骄傲！","alt":"voice/char_308_swire/cn_027.mp3"},{"url":"bwiki:0/0c/tn8z6nyk2ayz7jvwkydfr380qqvdgo6.mp3","text":"该沽出了！","alt":"voice/char_308_swire/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:8/84/fghgs5kshpcpt4lia4lhk7sidho7r2j.mp3","text":"好呀，战斗和商业是一样的，风险与回报并存！","alt":"voice/char_308_swire/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:e/e5/a0yy463lipon3d0921brd4uw3n54k40.mp3","text":"资本，就该是兼并和收购！胜利，就该是侦破和搜捕！","alt":"voice/char_308_swire/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:b/b7/ab8lhejxvorz26jpwaaoj4h9048uv2s.mp3","text":"不太好，不太好！你还可以做的更好吧？加油，我会和你一起努力的！","alt":"voice/char_308_swire/cn_031.mp3"}],"失败":[{"url":"bwiki:7/7b/a4ui3l0pzn7c7yfg1qbiv9ftvyqi5xj.mp3","text":"太、太丢脸了！我居然......居然犯下这种失误！","alt":"voice/char_308_swire/cn_032.mp3"}],"进驻":[{"url":"bwiki:6/6d/ghkidn4ndglcp4v75enhkg3i1jmbcpd.mp3","text":"还、还不赖......不，这房间还可以再装修下吧！","alt":"voice/char_308_swire/cn_033.mp3"}],"戳一下":[{"u