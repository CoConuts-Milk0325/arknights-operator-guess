{"中文":{"登录":[{"url":"bwiki:e/ed/8syj5rr4pn57wsvctjt3c64vb4rbiez.mp3","text":"博士，今天值班的人是我。","alt":"voice_cn/char_107_liskam/cn_001.mp3"}],"交谈":[{"url":"bwiki:6/68/gjutdmy1svxoytfhyemv9fipofdfwmm.mp3","text":"无论什么任务都要认真对待，这是我们专业保全的基本原则。","alt":"voice_cn/char_107_liskam/cn_002.mp3"},{"url":"bwiki:f/ff/ml3yxkmke3g14hyob1a6xjcp330tzhj.mp3","text":"其实，我很不擅长应付芙兰卡这样的人。当初是怎么和她成为搭档的，我到现在都不清楚......","alt":"voice_cn/char_107_liskam/cn_003.mp3"},{"url":"bwiki:e/ee/eoci45bhuqipq8l5ffqus8i05099ugk.mp3","text":"进入BSW必须经过严格的选拔。我很矮小，也没有优秀的法术天赋和血统，所以被大家说是绝对不可能过关的，就连我自己也曾这样认为......","alt":"voice_cn/char_107_liskam/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:9/92/7o93ibtcqe6imlxeien51bgnf3lpp39.mp3","text":"BSW作为安保公司是顶级的，它也很适合我。只是，在罗德岛的时候，我会感觉更加自由一点。","alt":"voice_cn/char_107_liskam/cn_005.mp3"},{"url":"bwiki:7/70/qlczf369nu3372cwx4q8e5kad2j68iv.mp3","text":"能走到这一步，真是不可思议啊！简直就像真正的龙一样......！啊，咳咳，不、不，只要对作战有利，别的怎样都好啦！","alt":"voice_cn/char_107_liskam/cn_006.mp3"}],"信赖":[{"url":"bwiki:1/10/oqbkdgrv4xzjxg1c9s0actn03qxtv4e.mp3","text":"博士，您能这样信任我，真的非常感谢。","alt":"voice_cn/char_107_liskam/cn_007.mp3"},{"url":"bwiki:7/7b/9ipcrkzdqnnbj4n8tdtahf6t1iihf4j.mp3","text":"我比看上去更好相处，熟识我的人都这么说。博士也这么想吗？","alt":"voice_cn/char_107_liskam/cn_008.mp3"},{"url":"bwiki:c/c5/j9wuhij5dh0hfe9klgkfq08m6b40oap.mp3","text":"芙兰卡又和您说我在黑钢时的事？啊啊啊，真是的......别相信她说的话啊！","alt":"voice_cn/char_107_liskam/cn_009.mp3"}],"闲置":[{"url":"bwiki:f/fd/tkgycpu5fqy055awax9ed8t8vaaqenw.mp3","text":"博士......现在还是工作时间哦。","alt":"voice_cn/char_107_liskam/cn_010.mp3"}],"报到":[{"url":"bwiki:3/30/fweakmnkcwvn0qemadqvbem4a5btqc0.mp3","text":"重装干员雷蛇，待命中。我曾参与数次要人保全、据点攻坚、人质解救、威胁肃清的特种行动。在此次派遣行动期间，我会严格保障您的人身安全。","alt":"voice_cn/char_107_liskam/cn_011.mp3"}],"作战记录":[{"url":"bwiki:2/20/ntw69f48wpk2q2xzc5l8ehsc74xk3qx.mp3","text":"升级完成。","alt":"voice_cn/char_107_liskam/cn_012.mp3"}],"精英化1":[{"url":"bwiki:0/0d/7ij46w12ir90xoz26bd8zxe3vw3jpx8.mp3","text":"非常感谢您的任命，博士。","alt":"voice_cn/char_107_liskam/cn_013.mp3"}],"精英化2":[{"url":"bwiki:3/3b/stxbniwe1yyc53dbbkuyvktd0eouxyk.mp3","text":"谢谢您，博士。作为您的干员，我将全身心地投入到保护罗德岛的工作中。","alt":"voice_cn/char_107_liskam/cn_014.mp3"}],"编入":[{"url":"bwiki:0/08/2o70aoi854249034ldad59yxbugu5no.mp3","text":"准备完毕。","alt":"voice_cn/char_107_liskam/cn_017.mp3"}],"任命队长":[{"url":"bwiki:4/4d/nm39adg1yyydgwfbbrhs7ytwuf0yyw1.mp3","text":"了解，我会严格要求队员们遵守罗德岛的行为准则和秩序。","alt":"voice_cn/char_107_liskam/cn_018.mp3"}],"行动出发":[{"url":"bwiki:f/f2/1v8xi0y3lf4izbj5x93vizu9e14ebqt.mp3","text":"出击许可已经下达。","alt":"voice_cn/char_107_liskam/cn_019.mp3"}],"行动开始":[{"url":"bwiki:b/be/c883xbed7d7ax8hh10q4hjnfzw8hciu.mp3","text":"等待下一步指示。","alt":"voice_cn/char_107_liskam/cn_020.mp3"}],"选中":[{"url":"bwiki:2/23/6xdw4j553me0fjdkrh0uqdhrr6fl3gw.mp3","text":"我已就位。","alt":"voice_cn/char_107_liskam/cn_021.mp3"},{"url":"bwiki:b/b0/8zkvrn6fbai4348fbfqes1lwg5sc8fg.mp3","text":"雷蛇，准备完毕。","alt":"voice_cn/char_107_liskam/cn_022.mp3"}],"部署":[{"url":"bwiki:3/36/d5v935opx25u0tybdbzghqbix35w09j.mp3","text":"视野清晰。","alt":"voice_cn/char_107_liskam/cn_023.mp3"},{"url":"bwiki:9/99/43k6fx42bhbufgzw63mn5ydpjlfj8is.mp3","text":"时刻准备。","alt":"voice_cn/char_107_liskam/cn_024.mp3"}],"技能":[{"url":"bwiki:f/f5/n30uc67hangeb4lp0wen5v8en3we453.mp3","text":"雷鸣。","alt":"voice_cn/char_107_liskam/cn_025.mp3"},{"url":"bwiki:2/2b/7nu6g6se7o1n910q9vopm4av421lod0.mp3","text":"闪电风暴。","alt":"voice_cn/char_107_liskam/cn_026.mp3"},{"url":"bwiki:7/73/sjzjwbvbe3ukbyjgrof7zmamb5nfgy1.mp3","text":"一人一颗子弹。","alt":"voice_cn/char_107_liskam/cn_027.mp3"},{"url":"bwiki:a/a8/5p1972r0rl6rlk3nio7z36kp504beee.mp3","text":"充能！","alt":"voice_cn/char_107_liskam/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:2/2c/l0w6wxnh53ze57snk7dofsxoc7hqt8h.mp3","text":"这算什么，我和芙兰卡可经历过更惨烈的战斗。","alt":"voice_cn/char_107_liskam/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:f/fe/454s0u64hktxi2i17a40hgwvgrxsdi4.mp3","text":"清除。已经镇压全部目标。","alt":"voice_cn/char_107_liskam/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:3/36/6dxu9u43sw5px0qgv2gksrchwhcnyhd.mp3","text":"安全，此区域已被肃清。","alt":"voice_cn/char_107_liskam/cn_031.mp3"}],"失败":[{"url":"bwiki:7/71/aby4ee5egv63dfdjjjdjbn3m8s5tfsu.mp3","text":"救护班和伤员一起撤退！能战斗的人和我一起阻挡敌人!","alt":"voice_cn/char_107_liskam/cn_032.mp3"}],"进驻":[{"url":"bwiki:9/9c/h6p93kua9whxckkdymdyk92fpkht7da.mp3","text":"这房间会漏电吗？有没有做好保护措施？","alt":"voice_cn/char_107_liskam/cn_033.mp3"}],"戳一下":[{"url":"bwiki:9/92/nhxmsiml2mz3hyrst4g4a2qeav0cuco.mp3","text":"请小心触电。","alt":"voice_cn/char_107_liskam/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:2/2c/awhvqkmlachub33esntnoks1151hjli.mp3","text":"医生，芙兰卡的治疗还在进行吗？对了，工作之外博士请好好休息。","alt":"voice_cn/char_107_liskam/cn_036.mp3"}],"标题":[{"url":"bwiki:3/3c/htqnrs1qhdvik4957irjrplv1cfpugr.mp3","text":"明日方舟。","alt":"voice_cn/char_107_liskam/cn_037.mp3"}],"新年":[{"url":"bwiki:5/50/px41xxv0wyysi8q48ulfywlkp1ekwd8.mp3","text":"新年快乐！博士，芙兰卡说我之前准备的那套说辞太标准化了，没有意思，而且没人会专门提前准备新年贺词的......我也不知道还应该说些什么了，那就单纯地祝您新年快乐好了，新年快乐。","alt":"voice_cn/char_107_liskam/cn_038.mp3"}],"问候":[{"url":"bwiki:7/78/dmfinsmq4bb9ehydpajdtnowunin2m9.mp3","text":"早上好，博士。","alt":"voice_cn/char_107_liskam/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:a/a8/no7s8qumpcxzoisuxk38vyn79gv8991.mp3","text":"博士，今天值班的人是我。","alt":"voice/char_107_liskam/cn_001.mp3"}],"交谈":[{"url":"bwiki:d/da/5omzjwjqdxlgl6evarxb1j34qccr0b2.mp3","text":"无论什么任务都要认真对待，这是我们专业保全的基本原则。","alt":"voice/char_107_liskam/cn_002.mp3"},{"url":"bwiki:b/b8/bjcbzsrizag5pa1crxkqnb4d6bnd698.mp3","text":"其实，我很不擅长应付芙兰卡这样的人。当初是怎么和她成为搭档的，我到现在都不清楚......","alt":"voice/char_107_liskam/cn_003.mp3"},{"url":"bwiki:a/a3/8oqvsq1chcy3b1vonmkfnxs01c0it9v.mp3","text":"进入BSW必须经过严格的选拔。我很矮小，也没有优秀的法术天赋和血统，所以被大家说是绝对不可能过关的，就连我自己也曾这样认为......","alt":"voice/char_107_liskam/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:9/94/1bftrdyfk5mg3hq6sv3zw2ydmo8gbob.mp3","text":"BSW作为安保公司是顶级的，它也很适合我。只是，在罗德岛的时候，我会感觉更加自由一点。","alt":"voice/char_107_liskam/cn_005.mp3"},{"url":"bwiki:4/4c/4chyxj30fjr2r0wvfbqmfcc67vnu0s5.mp3","text":"能走到这一步，真是不可思议啊！简直就像真正的龙一样......！啊，咳咳，不、不，只要对作战有利，别的怎样都好啦！","alt":"voice/char_107_liskam/cn_006.mp3"}],"信赖":[{"url":"bwiki:3/3f/t2plvkuqw0ry9j454w8l9s9rk9h6lyr.mp3","text":"博士，您能这样信任我，真的非常感谢。","alt":"voice/char_107_liskam/cn_007.mp3"},{"url":"bwiki:f/f2/tkg8kp8887ww8u44yaeizjtjq2qt6v3.mp3","text":"我比看上去更好相处，熟识我的人都这么说。博士也这么想吗？","alt":"voice/char_107_liskam/cn_008.mp3"},{"url":"bwiki:a/a1/7bxdgf38d65hi4lisf0jl0gze0w9y7i.mp3","text":"芙兰卡又和您说我在黑钢时的事？啊啊啊，真是的......别相信她说的话啊！","alt":"voice/char_107_liskam/cn_009.mp3"}],"闲置":[{"url":"bwiki:d/d4/ewh0nanieptgq5r3k1w7nlrwpy25e5s.mp3","text":"博士......现在还是工作时间哦。","alt":"voice/char_107_liskam/cn_010.mp3"}],"报到":[{"url":"bwiki:a/a6/7rigken82qp5a4428tle21equsur9dg.mp3","text":"重装干员雷蛇，待命中。我曾参与数次要人保全、据点攻坚、人质解救、威胁肃清的特种行动。在此次派遣行动期间，我会严格保障您的人身安全。","alt":"voice/char_107_liskam/cn_011.mp3"}],"作战记录":[{"url":"bwiki:f/f8/0e3q0z0i9rmmk70fqjuerla0yfz4zrd.mp3","text":"升级完成。","alt":"voice/char_107_liskam/cn_012.mp3"}],"精英化1":[{"url":"bwiki:5/50/q3p3ois90d8n46kmw6rlbrec52ubpvc.mp3","text":"非常感谢您的任命，博士。","alt":"voice/char_107_liskam/cn_013.mp3"}],"精英化2":[{"url":"bwiki:e/ea/686v0tj6tpe9yjwmw6gfu78bz9eqr6t.mp3","text":"谢谢您，博士。作为您的干员，我将全身心地投入到保护罗德岛的工作中。","alt":"voice/char_107_liskam/cn_014.mp3"}],"编入":[{"url":"bwiki:b/bf/3kx9hnhklc25m3jwvvqpa0kpbaxdqg1.mp3","text":"准备完毕。","alt":"voice/char_107_liskam/cn_017.mp3"}],"任命队长":[{"url":"bwiki:8/8c/2abzf5xi9lr8gn18pqqxtuhzxbq24ur.mp3","text":"了解，我会严格要求队员们遵守罗德岛的行为准则和秩序。","alt":"voice/char_107_liskam/cn_018.mp3"}],"行动出发":[{"url":"bwiki:f/f7/e5kv0f15o2l50h6p5ihwkpxg33h4fg3.mp3","text":"出击许可已经下达。","alt":"voice/char_107_liskam/cn_019.mp3"}],"行动开始":[{"url":"bwiki:c/c9/fk4d85cbas0h96pgyrye3ldy8nj0sf5.mp3","text":"等待下一步指示。","alt":"voice/char_107_liskam/cn_020.mp3"}],"选中":[{"url":"bwiki:c/c5/aiguf8ps1i18ez66dqktba7vuvhpzqc.mp3","text":"我已就位。","alt":"voice/char_107_liskam/cn_021.mp3"},{"url":"bwiki:8/8f/ejv2aidc9bixa4r05rxbytbm3sn5vmr.mp3","text":"雷蛇，准备完毕。","alt":"voice/char_107_liskam/cn_022.mp3"}],"部署":[{"url":"bwiki:7/78/jlhqb7ndo53922w7rk4jtpacwl0o1sk.mp3","text":"视野清晰。","alt":"voice/char_107_liskam/cn_023.mp3"},{"url":"bwiki:0/0c/q2fxxqs7swpb3xe8dnpa9e42v8sl5kw.mp3","text":"时刻准备。","alt":"voice/ch