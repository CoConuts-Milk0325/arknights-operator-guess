{"中文":{"登录":[{"url":"bwiki:2/29/kul1ikuf25dubxmu1i2ulk57uldp0c6.mp3","text":"你叫我来，是有新的狩猎任务吗？哦，没有吗......","alt":"voice_cn/char_190_clour/cn_001.mp3"}],"交谈":[{"url":"bwiki:a/af/4cwlene3aqi48p8yawymxrk908qwc1a.mp3","text":"这个爪形吊坠？是我的复仇的纪念品，那些伤害过我同伴的乌萨斯佣兵会把类似的东西当成狗牌，所以我才不会认错他们。","alt":"voice_cn/char_190_clour/cn_002.mp3"},{"url":"bwiki:e/e9/ij4ovl7m3zxhvcdowgz6mhic6adzryw.mp3","text":"我的左手是在一次狩猎中被野兽撕碎的，幸好一位机械师帮我制作了义肢，我才能重新拉动弓弦。","alt":"voice_cn/char_190_clour/cn_003.mp3"},{"url":"bwiki:b/bb/dz647ja9zfecnwbcoewbm6jidn2f364.mp3","text":"若是以前，我绝对会把嘲讽我伤痕的家伙一箭一箭地射成筛子！不过现在......呵，为了那种人动手，真是一点都不值得。","alt":"voice_cn/char_190_clour/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:e/e3/p4l3wals2k3tm2i3c9re5j4gwuxe9r1.mp3","text":"若是有实在难以决断的事就凭直觉去选择，身体是不会骗人的，这可是资深猎手的经验。","alt":"voice_cn/char_190_clour/cn_005.mp3"},{"url":"bwiki:7/7f/6d1v4nne4a44wi5p1w05b2fn7enzdpn.mp3","text":"自从同伴们逝去之后，我一个人生活很久了，所以这种每天都要和人打交道的日子，我还不太适应......但既然你给了我充分的信任，任用我，那我一定得回报你。","alt":"voice_cn/char_190_clour/cn_006.mp3"}],"信赖":[{"url":"bwiki:3/37/buplthju48o674i4uf9ektsbdp0c87j.mp3","text":"呃，义肢手指好像被小石子卡住了？讨厌，得去找机械师调整一下......不、不用你帮忙，我一个人也能行！","alt":"voice_cn/char_190_clour/cn_007.mp3"},{"url":"bwiki:c/c2/kstudzyhbfn3nunlake8r2jfz2d9erc.mp3","text":"你说，今后不会让我再失去同伴了？哼，是不是在说大话，我可是要亲眼见证的！","alt":"voice_cn/char_190_clour/cn_008.mp3"},{"url":"bwiki:2/29/0ht8of64ofce2uegnt9azfulef769i0.mp3","text":"这里的医生说可以抹去我身上新添的伤疤，但我拒绝了。我要留着它们，因为这是为你战斗时留下的......你，能明白我的意思吗？","alt":"voice_cn/char_190_clour/cn_009.mp3"}],"闲置":[{"url":"bwiki:4/44/sgt18wrjwff74dl4ajaou2i52dfj5hz.mp3","text":"睡着了？这个人什么场合都睡得着吗？这种体质倒是挺像我们猎人的......","alt":"voice_cn/char_190_clour/cn_010.mp3"}],"报到":[{"url":"bwiki:4/49/1qy1r8t9o8z3kv1sbfncybpag2q77nd.mp3","text":"红云，猎人。给我工作吧，你不会失望的。","alt":"voice_cn/char_190_clour/cn_011.mp3"}],"作战记录":[{"url":"bwiki:0/03/r2u1b6yrqnl8i7qc7xj214ncv9vl08x.mp3","text":"还可以观看更多一些吗？","alt":"voice_cn/char_190_clour/cn_012.mp3"}],"精英化1":[{"url":"bwiki:9/94/olcsgrfyt4hvv34ll6ycnc7pixc9i18.mp3","text":"谢谢你，可......让我这样的人晋升，真的没问题吗？","alt":"voice_cn/char_190_clour/cn_013.mp3"}],"精英化2":[{"url":"bwiki:4/47/o19tzwx1788e4p7000fd2q25134aypy.mp3","text":"矿石病也好，剩下的生命也好，已经全都无所谓了。现在让我最快乐的事，不就是和你一起并肩作战吗？","alt":"voice_cn/char_190_clour/cn_014.mp3"}],"编入":[{"url":"bwiki:3/36/f9wtjuuhkozmv2eogkypty7n3sf11wk.mp3","text":"来了。","alt":"voice_cn/char_190_clour/cn_017.mp3"}],"任命队长":[{"url":"bwiki:7/73/4pmg685d8tkj9rwoibl98zhu2ak5vgr.mp3","text":"要我当队长？我......真的合适吗？","alt":"voice_cn/char_190_clour/cn_018.mp3"}],"行动出发":[{"url":"bwiki:8/85/s93s7kt2upi3hp5puatnapbj59jeowu.mp3","text":"大捕猎，即将开幕！","alt":"voice_cn/char_190_clour/cn_019.mp3"}],"行动开始":[{"url":"bwiki:1/10/cqippmec2shx8pcjo7qs6x5wbkmttbp.mp3","text":"踏入陷阱的你们，还没明白自己的处境吗？","alt":"voice_cn/char_190_clour/cn_020.mp3"}],"选中":[{"url":"bwiki:2/29/gh0ieulkgjtcqiygv2477ogo259507i.mp3","text":"让我上。","alt":"voice_cn/char_190_clour/cn_021.mp3"},{"url":"bwiki:f/fc/q0qohmez462sqx1tdbgr4zg7il7clu2.mp3","text":"下令吧。","alt":"voice_cn/char_190_clour/cn_022.mp3"}],"部署":[{"url":"bwiki:8/82/rs4sop2k0i0nz11rndcobl54xn1oy3l.mp3","text":"我闻到风中的猎物气味了。","alt":"voice_cn/char_190_clour/cn_023.mp3"},{"url":"bwiki:2/24/gmraefk6ox0wryypbfhubhv9pzoz8gi.mp3","text":"我就在这等着。","alt":"voice_cn/char_190_clour/cn_024.mp3"}],"技能":[{"url":"bwiki:4/47/bngd9ciwr7q2cg6hy70fcg9c7y5y5ga.mp3","text":"再不逃的话，你就只有一个下场了！","alt":"voice_cn/char_190_clour/cn_025.mp3"},{"url":"bwiki:1/1f/sdr09zy43dgu1ifbpik9zy2qnqljzkd.mp3","text":"别小看荒野的子民！","alt":"voice_cn/char_190_clour/cn_026.mp3"},{"url":"bwiki:8/80/4ei83ys7wyyg7y9g22wn16n505orx0m.mp3","text":"再看这一箭！","alt":"voice_cn/char_190_clour/cn_027.mp3"},{"url":"bwiki:0/0d/hu80d9ysnh0gddl7l4fmbdmdk4cjsg1.mp3","text":"这一箭，绝对会射穿你的喉咙！","alt":"voice_cn/char_190_clour/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:b/b1/0oh15lg7coaby7awnmhd47nqthtq3z7.mp3","text":"再强大的猎物，也只是猎物而已。","alt":"voice_cn/char_190_clour/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:f/f4/j7k5kecq19876uehrtq84fly9650laq.mp3","text":"真厉害。如果你生在叙拉古，一定会是位技艺超绝的猎人。","alt":"voice_cn/char_190_clour/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:2/21/m1w0g4vakuigzj13xpklqad6rmp9wpv.mp3","text":"猎物逃走了，我去追。","alt":"voice_cn/char_190_clour/cn_031.mp3"}],"失败":[{"url":"bwiki:e/e6/78sm33h42djir2ynzztyytu5httndlm.mp3","text":"不能就这样结束......","alt":"voice_cn/char_190_clour/cn_032.mp3"}],"进驻":[{"url":"bwiki:0/07/gyydsyvzc9xsmxbb32bxvs5is2rvs33.mp3","text":"有墙和天花板，已经是很棒的屋子了啊。","alt":"voice_cn/char_190_clour/cn_033.mp3"}],"戳一下":[{"url":"bwiki:9/92/dt3m9br45a6b9ntsfv843l4nsl9kw4a.mp3","text":"呣......","alt":"voice_cn/char_190_clour/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:1/11/k1r99mdac9ji8bl7sf35wywgt9vvli5.mp3","text":"......今天的安排吗？帮你做任务，对着敌人射箭，把箭射光；任务结束，吃饭睡觉。就这么简单。","alt":"voice_cn/char_190_clour/cn_036.mp3"}],"标题":[{"url":"bwiki:7/71/imyjabtg0putmvcq94oj9uy0fyb1x79.mp3","text":"明日方舟。","alt":"voice_cn/char_190_clour/cn_037.mp3"}],"新年":[{"url":"bwiki:9/95/36umdse8dhio7gkrj7wb8bf11n260y0.mp3","text":"大家都在庆祝新年啊......在荒野的时候可没有这么安逸的环境，取出一点腌好的肉，再吃几颗储藏的莓果，来庆祝自己又活了一年。或许也不是什么值得庆祝的事吧......","alt":"voice_cn/char_190_clour/cn_038.mp3"}],"问候":[{"url":"bwiki:e/e7/3iaoo5qow0undg9zgg7flj6j9jv6wet.mp3","text":"哈，是你啊。","alt":"voice_cn/char_190_clour/cn_042.mp3"}]},"日文":{"登录":[{"url":"bwiki:c/c3/75savdc2dbhvw344p0vwwu9y2t55g7v.mp3","text":"你叫我来，是有新的狩猎任务吗？哦，没有吗......","alt":"voice/char_190_clour/cn_001.mp3"}],"交谈":[{"url":"bwiki:d/d1/p8ip3pq9axieoy81v7h26koicqm5jkn.mp3","text":"这个爪形吊坠？是我的复仇的纪念品，那些伤害过我同伴的乌萨斯佣兵会把类似的东西当成狗牌，所以我才不会认错他们。","alt":"voice/char_190_clour/cn_002.mp3"},{"url":"bwiki:f/fe/hkgk4lhy0jkp8op43z2v4x01txc6thv.mp3","text":"我的左手是在一次狩猎中被野兽撕碎的，幸好一位机械师帮我制作了义肢，我才能重新拉动弓弦。","alt":"voice/char_190_clour/cn_003.mp3"},{"url":"bwiki:2/2b/59o34u7z3m8xed25lokqgjlyq1k8j09.mp3","text":"若是以前，我绝对会把嘲讽我伤痕的家伙一箭一箭地射成筛子！不过现在......呵，为了那种人动手，真是一点都不值得。","alt":"voice/char_190_clour/cn_004.mp3"}],"晋升交谈":[{"url":"bwiki:6/6f/7t46yhcj1vip47rae1rcgskahphbftu.mp3","text":"若是有实在难以决断的事就凭直觉去选择，身体是不会骗人的，这可是资深猎手的经验。","alt":"voice/char_190_clour/cn_005.mp3"},{"url":"bwiki:4/47/kp7xedjghqk1i491ay31f8peffp8hjs.mp3","text":"自从同伴们逝去之后，我一个人生活很久了，所以这种每天都要和人打交道的日子，我还不太适应......但既然你给了我充分的信任，任用我，那我一定得回报你。","alt":"voice/char_190_clour/cn_006.mp3"}],"信赖":[{"url":"bwiki:a/a4/pfizw23k6ix1uwclekdyomp25fql821.mp3","text":"呃，义肢手指好像被小石子卡住了？讨厌，得去找机械师调整一下......不、不用你帮忙，我一个人也能行！","alt":"voice/char_190_clour/cn_007.mp3"},{"url":"bwiki:4/4a/2rdg6kdr9ayanbniyh81t95lfsms8ui.mp3","text":"你说，今后不会让我再失去同伴了？哼，是不是在说大话，我可是要亲眼见证的！","alt":"voice/char_190_clour/cn_008.mp3"},{"url":"bwiki:5/53/kopjeuf0tr0d294atr6r0cda9nqf4dq.mp3","text":"这里的医生说可以抹去我身上新添的伤疤，但我拒绝了。我要留着它们，因为这是为你战斗时留下的......你，能明白我的意思吗？","alt":"voice/char_190_clour/cn_009.mp3"}],"闲置":[{"url":"bwiki:e/e1/l2e13m7kmvfafvfvvvxrrar46h5ybxp.mp3","text":"睡着了？这个人什么场合都睡得着吗？这种体质倒是挺像我们猎人的......","alt":"voice/char_190_clour/cn_010.mp3"}],"报到":[{"url":"bwiki:a/a6/jqzv41gfukiezpler5l8kia4yj9y8c1.mp3","text":"红云，猎人。给我工作吧，你不会失望的。","alt":"voice/char_190_clour/cn_011.mp3"}],"作战记录":[{"url":"bwiki:9/9a/50b3jnctqarirfx6xdzhm8pvblmc9jb.mp3","text":"还可以观看更多一些吗？","alt":"voice/char_190_clour/cn_012.mp3"}],"精英化1":[{"url":"bwiki:c/cd/ged1rodul9tvciolxzbjffjpbwzxitr.mp3","text":"谢谢你，可......让我这样的人晋升，真的没问题吗？","alt":"voice/char_190_clour/cn_013.mp3"}],"精英化2":[{"url":"bwiki:c/c3/smdjyi62xywn1abosbies1q4eno5uv7.mp3","text":"矿石病也好，剩下的生命也好，已经全都无所谓了。现在让我最快乐的事，不就是和你一起并肩作战吗？","alt":"voice/char_190_clour/cn_014.mp3"}],"编入":[{"url":"bwiki:9/99/r48js9gmh4hnbdcm9x6cdbljdu00iln.mp3","text":"来了。","alt":"voice/char_190_clour/cn_017.mp3"}],"任命队长":[{"url":"bwiki:1/19/h8nemt15vpjelvm8tbt4tsciwj8tj12.mp3","text":"要我当队长？我......真的合适吗？","alt":"voice/char_190_clour/cn_018.mp3"}],"行动出发":[{"url":"bwiki:5/5a/1zswv4e9vh8wu3ljc1q5g63np4myowi.mp3","text":"大捕猎，即将开幕！","alt":"voice/char_190_clour/cn_019.mp3"}],"行动开始":[{"url":"bwiki:6/6d/blitjistfs57n2j51ph4d3impd84izq.mp3","text":"踏入陷阱的你们，还没明白自己的处境吗？","alt":"voice/char_190_clour/cn_020.mp3"}],"选中":[{"url":"bwiki:4/42/c2b4fcdoufoadqsz8c19crp4nl8le4c.mp3","text":"让我上。","alt":"voice/char_190_clour/cn_021.mp3"},{"url":"bwiki:8/80/n74x26quz97dt4lwm4gqevjt7kzy7tf.mp3","text":"下令吧。","alt":"voice/char_190_clour/cn_022.mp3"}],"部署":[{"url":"bwiki:2/2a/1jd70au2s0wj5tvh80gg020bt0odo89.mp3","text":"我闻到风中的猎物气味了。","alt":"voice/char_190_clour/cn_023.mp3"},{"url":"bwiki:6/6b/j7cg88i9qv8umay4bcyzitw33c0klfu.mp3","text":"我就在这等着。","alt":"voice/char_190_clour/cn_024.mp3"}],"技能":[{"url":"bwiki:2/2a/9nshuscqvh6aticpomx6odfl8uemwhz.mp3","text":"再不逃的话，你就只有一个下场了！","alt":"voice/char_190_clour/cn_025.mp3"},{"url":"bwiki:d/d0/c3dldnpiuzzqzo4zhkea4n6iaz1zkcl.mp3","text":"别小看荒野的子民！","alt":"voice/char_190_clour/cn_026.mp3"},{"url":"bwiki:4/40/pv4up3fw6a4qud2yze5pdv6renwxgsc.mp3","text":"再看这一箭！","alt":"voice/char_190_clour/cn_027.mp3"},{"url":"bwiki:1/19/3fph3edvf3gbxrgr7c6ll6nujk610bw.mp3","text":"这一箭，绝对会射穿你的喉咙！","alt":"voice/char_190_clour/cn_028.mp3"}],"高难胜利":[{"url":"bwiki:3/34/233c665epcqk5lhwbwiyaif6f424ji7.mp3","text":"再强大的猎物，也只是猎物而已。","alt":"voice/char_190_clour/cn_029.mp3"}],"3星胜利":[{"url":"bwiki:d/dc/2szl49wxa27yfta1duxml61jcfemtr0.mp3","text":"真厉害。如果你生在叙拉古，一定会是位技艺超绝的猎人。","alt":"voice/char_190_clour/cn_030.mp3"}],"非3星胜利":[{"url":"bwiki:1/1a/h4nz4879wqdcjyuipwpvwzcpfj8wp53.mp3","text":"猎物逃走了，我去追。","alt":"voice/char_190_clour/cn_031.mp3"}],"失败":[{"url":"bwiki:0/06/sfjsu9tpfl4i1lkyop8snt597ywscvu.mp3","text":"不能就这样结束......","alt":"voice/char_190_clour/cn_032.mp3"}],"进驻":[{"url":"bwiki:d/d8/ctt5iyvr7ds4cwoza7pt8x8nr1a8xh1.mp3","text":"有墙和天花板，已经是很棒的屋子了啊。","alt":"voice/char_190_clour/cn_033.mp3"}],"戳一下":[{"url":"bwiki:9/95/l7l19eygisskbnc4zswlgbfted89h4i.mp3","text":"呣......","alt":"voice/char_190_clour/cn_034.mp3"}],"信赖触摸":[{"url":"bwiki:a/ac/5w3zpyu0s68kzptqbte4gjg3bsbqoe5.mp3","text":"......今天的安排吗？帮你做任务，对着敌人射箭，把箭射光；任务结束，吃饭睡觉。就这么简单。","alt":"voice/char_190_clour/cn_036.mp3"}],"标题":[{"url":"bwiki:6/65/ozhpud6af3oe9rjegudrmvkx0h2v8e3.mp3","text":"明日方舟。","alt":"voice/char_190_clour/cn_037.mp3"}],"新年":[{"url":"bwiki:0/0f/p4yopzz0n1b7hy5aapqnk9o5bt2oki2.mp3","text":"大家都在庆祝新年啊......在荒野的时候可没有这么安逸的环境，取出一点腌好的肉，再吃几颗储藏的莓果，来庆祝自己又活了一年。或许也不是什么值得庆祝的事吧......","alt":"voice/char_190_clour/cn_038.mp3"}],"问候":[{"url":"bwik